import PadicHodge.GroupScheme.PDivisibleHom
import PadicHodge.GroupScheme.EtaleInvariants
import Mathlib.RingTheory.Ideal.IdempotentFG
import Mathlib.RingTheory.Smooth.Fiber

/-!
# Finite flat group schemes killed by an invertible integer are étale

Let `G = Spec A` be a finite flat commutative group scheme over a noetherian ring `R`, killed by
`n` (i.e. `id^n = 1` in `G(A)`) with `n` invertible in `R`. Then `G` is étale
(`isEtale_of_univPt_pow_eq_one`). In particular every layer `G_v` of a `p`-divisible group over a
noetherian ring in which `p` is invertible (e.g. a `p`-adic field `K`, or `ℚ_p`) is étale
(`PDivGroup.isEtale_of_isUnit`): the generic fibre of a `p`-divisible group over `O_K` is étale
([Hong, Ch. II, Cor. 1.3.11] for finite flat group schemes over `K`, via Cartier's theorem).

Proof (standard; written up here, it avoids Cartier's theorem): let `I = ker ε`, `T = A/I²` and
`q : A → T` the projection, a point of `G(T)`. In the convolution ring `Hom_R(A, T)`, the
deviation `d = q - ε` takes values in the square-zero ideal `I/I²`, so `d * d = 0` and
`q^n = (1 + d)^n = 1 + n d`. As `q^n = 1`, `n d = 0`, so `d = 0`: every `x ∈ I` lies in `I²`.
Hence `I = I²` is generated by an idempotent `f` (`Ideal.isIdempotentElem_iff_of_fg`), and the
group law shows that `A` is formally unramified (`formallyUnramified_of_ker_counit`, the argument
of `formallyUnramified_of_connectedComponentHom_eq` with `1 - e₀` replaced by `f`).
-/

noncomputable section

open Coalgebra WithConv TensorProduct

namespace PadicHodge

universe u

namespace FFGroupScheme

variable {R : Type u} [CommRing R] (G : FFGroupScheme R)

/-- The augmentation ideal `I = ker ε`. -/
abbrev augIdeal : Ideal G.A := RingHom.ker (Bialgebra.counitAlgHom R G.A)

/-- If `ker ε` is generated by an idempotent, `A` is formally unramified. -/
theorem formallyUnramified_of_ker_counit {f : G.A} (hf : IsIdempotentElem f)
    (hI : G.augIdeal = Ideal.span {f}) : Algebra.FormallyUnramified R G.A := by
  rw [Algebra.FormallyUnramified.iff_comp_injective]
  intro B _ _ I hI2 f₁ f₂ hf₁₂
  have hker : ∀ a : G.A, counit (R := R) a = 0 → a * f = a := by
    intro a ha
    have : a ∈ G.augIdeal := ha
    rw [hI] at this
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp this
    rw [mul_assoc, hf.eq]
  have hf0 : counit (R := R) f = 0 := by
    have : f ∈ G.augIdeal := by rw [hI]; exact Ideal.mem_span_singleton_self f
    exact this
  let F₁ : G.points B := toConv f₁
  let F₂ : G.points B := toConv f₂
  have hH : (G.postComp (Ideal.Quotient.mkₐ R I)) (F₁ * F₂⁻¹) = 1 := by
    rw [map_mul, map_inv, mul_inv_eq_one]
    exact WithConv.ofConv_injective hf₁₂
  have hmem : ∀ x : G.A, counit (R := R) x = 0 → ofConv (F₁ * F₂⁻¹) x ∈ I := by
    intro x hx
    have := congrArg (fun F : G.points (B ⧸ I) => ofConv F x) hH
    change Ideal.Quotient.mk I (ofConv (F₁ * F₂⁻¹) x) = algebraMap R _ (counit (R := R) x)
      at this
    rw [hx, map_zero, Ideal.Quotient.eq_zero_iff_mem] at this
    exact this
  have hH0 : ∀ a : G.A, counit (R := R) a = 0 → ofConv (F₁ * F₂⁻¹) a = 0 := by
    intro a ha
    have : ofConv (F₁ * F₂⁻¹) a ∈ I ^ 2 := by
      rw [← hker a ha, map_mul, pow_two]
      exact Ideal.mul_mem_mul (hmem a ha) (hmem _ hf0)
    rw [hI2] at this
    exact Ideal.mem_bot.mp this
  have hH1 : F₁ * F₂⁻¹ = 1 := by
    apply WithConv.ofConv_injective
    ext a
    have := hH0 (a - algebraMap R G.A (counit (R := R) a)) (by simp)
    rw [map_sub, AlgHom.commutes, sub_eq_zero] at this
    rw [this]
    rfl
  exact congrArg ofConv (mul_inv_eq_one.mp hH1)

/-- `(1 + d)^n = 1 + n d` if `d² = 0`. -/
theorem one_add_pow_of_sq_eq_zero {W : Type*} [Ring W] {d : W} (hd : d * d = 0) (n : ℕ) :
    (1 + d) ^ n = 1 + (n : W) * d := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, ih, add_mul, one_mul, mul_add, mul_one, mul_assoc, hd, mul_zero, add_zero,
      Nat.cast_succ, add_mul, one_mul]
    abel

/-- If `G` is killed by `n` and `n` is invertible in `R`, then `ker ε = (ker ε)²`. -/
theorem augIdeal_le_sq {n : ℕ} (hn : IsUnit (n : R)) (hG : G.univPt ^ n = 1) :
    G.augIdeal ≤ G.augIdeal ^ 2 := by
  set I := G.augIdeal
  set q : G.A →ₐ[R] G.A ⧸ I ^ 2 := Ideal.Quotient.mkₐ R (I ^ 2)
  set W := WithConv (G.A →ₗ[R] G.A ⧸ I ^ 2)
  set u : W := toConv q.toLinearMap
  set d : W := u - 1
  -- `d` takes values in `I / I²`
  have hdI : ∀ y : G.A, ofConv d y ∈ I.map (Ideal.Quotient.mk (I ^ 2)) := by
    intro y
    have : ofConv d y = Ideal.Quotient.mk (I ^ 2) (y - algebraMap R G.A (counit (R := R) y)) := by
      change q y - (algebraMap R (G.A ⧸ I ^ 2)) (counit (R := R) y) = _
      rw [map_sub]
      rfl
    rw [this]
    refine Ideal.mem_map_of_mem _ ?_
    change counit (R := R) (y - algebraMap R G.A (counit (R := R) y)) = 0
    simp
  have hJ : ∀ a b : G.A ⧸ I ^ 2, a ∈ I.map (Ideal.Quotient.mk (I ^ 2)) →
      b ∈ I.map (Ideal.Quotient.mk (I ^ 2)) → a * b = 0 := by
    intro a b ha hb
    obtain ⟨a', ha', rfl⟩ :=
      (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp ha
    obtain ⟨b', hb', rfl⟩ :=
      (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hb
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, pow_two]
    exact Ideal.mul_mem_mul ha' hb'
  have hdd : d * d = 0 := by
    apply WithConv.ofConv_injective
    ext x
    rw [LinearMap.convMul_apply]
    change _ = (0 : G.A ⧸ I ^ 2)
    induction comul (R := R) x with
    | zero => simp
    | add z z' hz hz' => rw [map_add, map_add, hz, hz', add_zero]
    | tmul a b => simpa using hJ _ _ (hdI a) (hdI b)
  -- `u^n = 1`
  have hun : u ^ n = 1 := by
    have h1 : toConv (ofConv (G.postComp q G.univPt)).toLinearMap = u := rfl
    rw [← h1, ← AlgHom.toLinearMap_convPow, ← map_pow, hG, map_one]
    rfl
  have hnd : (n : R) • d = 0 := by
    have : u = 1 + d := by simp [d]
    rw [this, one_add_pow_of_sq_eq_zero hdd, add_eq_left] at hun
    rw [Nat.cast_smul_eq_nsmul, nsmul_eq_mul]
    exact hun
  have hd0 : d = 0 := by
    obtain ⟨c, hc⟩ := hn
    have : d = ((c⁻¹ : Rˣ) : R) • ((n : R) • d) := by
      rw [← hc, smul_smul, Units.inv_mul, one_smul]
    rw [this, hnd, smul_zero]
  intro x hx
  have := congrArg (fun F : W => ofConv F x) hd0
  change q x - algebraMap R _ (counit (R := R) x) = 0 at this
  have hx0 : counit (R := R) x = 0 := hx
  rw [hx0, map_zero, sub_zero] at this
  exact Ideal.Quotient.eq_zero_iff_mem.mp this

/-- **A finite flat group scheme killed by an integer invertible in the (noetherian) base is
étale.** -/
theorem isEtale_of_univPt_pow_eq_one [IsNoetherianRing R] {n : ℕ} (hn : IsUnit (n : R))
    (hG : G.univPt ^ n = 1) : G.IsEtale := by
  have : IsNoetherianRing G.A := Algebra.FiniteType.isNoetherianRing R G.A
  have hfg : G.augIdeal.FG := IsNoetherian.noetherian _
  have hidem : IsIdempotentElem G.augIdeal :=
    le_antisymm Ideal.mul_le_left (by rw [← pow_two]; exact G.augIdeal_le_sq hn hG)
  obtain ⟨f, hf, hI⟩ := (Ideal.isIdempotentElem_iff_of_fg _ hfg).mp hidem
  have := G.formallyUnramified_of_ker_counit hf hI
  have : Algebra.FinitePresentation R G.A :=
    Algebra.FinitePresentation.of_finiteType.mp inferInstance
  exact Algebra.Etale.of_formallyUnramified_of_flat

end FFGroupScheme

namespace PDivGroup

/-- **The layers of a `p`-divisible group over a noetherian ring with `p` invertible are
étale** (e.g. over a `p`-adic field: the generic fibre of a `p`-divisible group over `O_K`). -/
theorem isEtale_of_isUnit {R : Type u} [CommRing R] [IsNoetherianRing R] {p : ℕ}
    (G : PDivGroup R p) (hp : IsUnit (p : R)) (v : ℕ) : (G.G v).IsEtale :=
  (G.G v).isEtale_of_univPt_pow_eq_one (n := p ^ v) (by rw [Nat.cast_pow]; exact hp.pow v)
    (G.pow_eq_one v _ _)

end PDivGroup

end PadicHodge
