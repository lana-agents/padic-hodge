import PadicHodge.GroupScheme.EtaleFrobenius
import PadicHodge.GroupScheme.TateRep
import PadicHodge.HodgeTate.Trivialization

/-!
# `V_p G` is Hodge–Tate of weight `0` for étale `p`-divisible groups over `ℤ_p`

For a `p`-divisible group `G` over `ℤ_p` with étale layers:

* `coordField G k = ℚ_p(G_w(ℚ̄_p), w ≤ k)`: the field generated by the coordinates `φ(a)` of all
  points `φ : A_w → ℚ̄_p`, `w ≤ k`; it is finite, Galois-stable, unramified
  (`EtaleFrobenius.lean`) and rigid (`EtaleUnramified.lean`: points congruent modulo the maximal
  ideal are equal), i.e. `IsUnrStable` (`isUnrStable_coordField`);
* the matrix `A(σ) ∈ GL_h(ℤ_p)` of `σ` on `T_p G` in a basis adapted to the levels is
  `≡ 1 mod p^k` on `Gal(ℚ̄_p/coordField G k)` (`tateMatrix_fix`);
* **`isHodgeTate_tateRep_of_etale`**: by Hilbert 90 for the completed unramified tower
  (`Hilbert90.exists_hilbert90`), `ℂ_p ⊗ V_p G` is trivialised over `ℂ_p`, so `V_p G` is
  Hodge–Tate with all `h` Hodge–Tate weights equal to `0` (for every finite `L/ℚ_p`).
-/

noncomputable section

open WithConv TensorProduct IsLocalRing PadicHodge.Hilbert90

namespace PadicHodge

namespace PDivGroup

variable {p : ℕ} [hp : Fact p.Prime] (G : PDivGroup ℤ_[p] p)

local notation "K" => PadicAlgCl p

/-- The coordinates of the points of the layers `G_w`, `w ≤ k`. -/
def coordSet (k : ℕ) : Set K :=
  {z | ∃ w ≤ k, ∃ φ : (G.G w).A →ₐ[ℤ_[p]] K, ∃ a, φ a = z}

/-- The field generated by the points of the layers `G_w`, `w ≤ k`. -/
def coordField (k : ℕ) : IntermediateField ℚ_[p] K :=
  IntermediateField.adjoin ℚ_[p] (G.coordSet k)

theorem coordSet_mono (k : ℕ) : G.coordSet k ⊆ G.coordSet (k + 1) := by
  rintro _ ⟨w, hw, φ, a, rfl⟩
  exact ⟨w, hw.trans (Nat.le_succ k), φ, a, rfl⟩

theorem coordField_mono (k : ℕ) : G.coordField k ≤ G.coordField (k + 1) :=
  IntermediateField.adjoin.mono _ _ _ (G.coordSet_mono k)

theorem gal_mem_coordSet (σ : GalQp p) {k : ℕ} {z : K} (hz : z ∈ G.coordSet k) :
    σ z ∈ G.coordSet k := by
  obtain ⟨w, hw, φ, a, rfl⟩ := hz
  exact ⟨w, hw, ((σ : K →ₐ[ℚ_[p]] K).restrictScalars ℤ_[p]).comp φ, a, rfl⟩

theorem gal_mem_coordField (σ : GalQp p) {k : ℕ} {z : K} (hz : z ∈ G.coordField k) :
    σ z ∈ G.coordField k := by
  have h1 : σ z ∈ (G.coordField k).map (σ : K →ₐ[ℚ_[p]] K) :=
    (IntermediateField.map_mem_map _ _).mpr hz
  rw [coordField, IntermediateField.adjoin_map] at h1
  refine (IntermediateField.adjoin_le_iff.mpr ?_) h1
  rintro _ ⟨y, hy, rfl⟩
  exact IntermediateField.subset_adjoin _ _ (G.gal_mem_coordSet σ hy)

theorem norm_coord_le_one {w : ℕ} (φ : (G.G w).A →ₐ[ℤ_[p]] K) (a : (G.G w).A) :
    ‖φ a‖ ≤ 1 :=
  norm_le_one_of_isIntegral norm_algebraMap_padicInt_le_one φ (Algebra.IsIntegral.isIntegral a)

theorem norm_le_one_of_mem_coordSet {k : ℕ} {z : K} (hz : z ∈ G.coordSet k) : ‖z‖ ≤ 1 := by
  obtain ⟨w, -, φ, a, rfl⟩ := hz
  exact G.norm_coord_le_one φ a

variable {G} (hG : ∀ v, (G.G v).IsEtale)

include hG in
theorem frobClosed_coordSet (k : ℕ) : FrobClosed (p := p) (G.coordSet k) := by
  rintro _ ⟨w, hw, φ, a, rfl⟩
  haveI : Algebra.Etale ℤ_[p] (G.G w).A := hG w
  obtain ⟨N, hN, hper⟩ := exists_frobenius_period (p := p) (G.G w).A
  obtain ⟨b, hb⟩ := hper a
  refine ⟨N, hN, φ b, ⟨w, hw, φ, b, rfl⟩, ?_⟩
  rw [← map_pow, ← map_sub, hb, map_mul, map_natCast]

theorem finite_algHom (w : ℕ) : Finite ((G.G w).A →ₐ[ℤ_[p]] K) := by
  have h1 : Nat.card (((G.baseChange ℚ_[p]).G w).points K) ≠ 0 := by
    rw [(G.baseChange ℚ_[p]).card_points_padicAlgCl w]
    exact pow_ne_zero _ hp.out.ne_zero
  have h2 : Finite (((G.G w).baseChange ℚ_[p]).points K) := Nat.finite_of_card_ne_zero h1
  have h3 : Finite ((G.G w).points K) :=
    Finite.of_equiv _ ((G.G w).baseChangePointsEquiv (S := ℚ_[p]) K).toEquiv
  exact Finite.of_equiv _ (WithConv.equiv ((G.G w).A →ₐ[ℤ_[p]] K))

theorem finiteDimensional_coordField (k : ℕ) : FiniteDimensional ℚ_[p] (G.coordField k) := by
  classical
  let bas := fun w => Module.Free.chooseBasis ℤ_[p] (G.G w).A
  let F : Set K := ⋃ w ∈ Finset.range (k + 1), ⋃ φ : (G.G w).A →ₐ[ℤ_[p]] K,
    Set.range fun i => φ (bas w i)
  have hF : F.Finite := by
    refine Set.Finite.biUnion (Finset.finite_toSet _) fun w _ => ?_
    haveI := G.finite_algHom w
    exact Set.finite_iUnion fun φ => Set.finite_range _
  have hFS : F ⊆ G.coordSet k := by
    intro z hz
    simp only [F, Set.mem_iUnion, Finset.mem_range, Set.mem_range] at hz
    obtain ⟨w, hw, φ, i, rfl⟩ := hz
    exact ⟨w, by omega, φ, _, rfl⟩
  have hSF : G.coordSet k ⊆ IntermediateField.adjoin ℚ_[p] F := by
    rintro _ ⟨w, hw, φ, a, rfl⟩
    rw [← (bas w).sum_repr a, map_sum]
    refine IntermediateField.sum_mem _ fun i _ => ?_
    rw [map_smul, Algebra.smul_def, IsScalarTower.algebraMap_apply ℤ_[p] ℚ_[p] K]
    refine IntermediateField.mul_mem _ (IntermediateField.algebraMap_mem _ _) ?_
    refine IntermediateField.subset_adjoin _ _ ?_
    simp only [F, Set.mem_iUnion, Finset.mem_range, Set.mem_range]
    exact ⟨w, by omega, φ, i, rfl⟩
  have heq : G.coordField k = IntermediateField.adjoin ℚ_[p] F :=
    le_antisymm (IntermediateField.adjoin_le_iff.mpr hSF)
      (IntermediateField.adjoin.mono _ _ _ hFS)
  rw [heq]
  haveI : Finite F := hF.to_subtype
  exact IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x

include hG in
/-- **The fields `coordField G k` are Galois-stable, unramified and rigid.** -/
theorem isUnrStable_coordField (k : ℕ) : IsUnrStable (G.coordField k) where
  stable σ z hz := G.gal_mem_coordField σ hz
  unr z hz hz1 := unr_adjoin (fun _ h => G.norm_le_one_of_mem_coordSet h)
    (frobClosed_coordSet hG k) hz hz1
  rigid σ hσ := by
    have hfix : ∀ z ∈ G.coordSet k, σ z = z := by
      rintro _ ⟨w, hw, φ, a, rfl⟩
      haveI : Algebra.Etale ℤ_[p] (G.G w).A := hG w
      have h1 := algHom_eq_of_norm_sub_lt_one φ
        (((σ : K →ₐ[ℚ_[p]] K).restrictScalars ℤ_[p]).comp φ) (G.norm_coord_le_one φ)
        (fun b => by
          rw [norm_sub_rev]
          exact hσ _ (IntermediateField.subset_adjoin _ _ ⟨w, hw, φ, b, rfl⟩)
            (G.norm_coord_le_one φ b))
      exact (DFunLike.congr_fun h1 a).symm
    have hle : G.coordField k ≤ IntermediateField.fixedField (Subgroup.zpowers σ) := by
      refine IntermediateField.adjoin_le_iff.mpr fun z hz => ?_
      rw [SetLike.mem_coe, IntermediateField.mem_fixedField_iff]
      intro f hf
      have hσ' : σ ∈ MulAction.stabilizer (GalQp p) z := hfix z hz
      exact (Subgroup.zpowers_le.mpr hσ') hf
    intro z hz
    exact (IntermediateField.mem_fixedField_iff _ _).mp (hle hz) σ
      (Subgroup.mem_zpowers σ)

/-! ### The matrix of the Galois action on `T_p G` -/

variable (G)

/-- `σ` fixing `coordField G k` fixes the level-`k` points of the generic fibre. -/
theorem galTate_level_eq {k : ℕ} (σ : GalQp p) (hσ : ∀ z ∈ G.coordField k, σ z = z)
    (x : (G.baseChange ℚ_[p]).TateModule K) :
    ((G.baseChange ℚ_[p]).galTate σ x).1 k = x.1 k := by
  apply WithConv.ofConv_injective
  set φ : ℚ_[p] ⊗[ℤ_[p]] (G.G k).A →ₐ[ℚ_[p]] K := ofConv (x.1 k)
  change (σ : K →ₐ[ℚ_[p]] K).comp φ = φ
  refine Algebra.TensorProduct.ext (Subsingleton.elim _ _) (AlgHom.ext fun a => ?_)
  exact hσ _ (IntermediateField.subset_adjoin _ _
    ⟨k, le_rfl, (φ.restrictScalars ℤ_[p]).comp Algebra.TensorProduct.includeRight, a, rfl⟩)

local instance : NeZero p := ⟨hp.out.ne_zero⟩

/-- A `ℤ_p`-basis of `T_p G(ℚ̄_p)` adapted to the levels, with its coordinate system. -/
theorem exists_tateBasis_lin : ∃ (t : Fin (G.baseChange ℚ_[p]).height →
      (G.baseChange ℚ_[p]).TateModule K)
    (e : (Fin (G.baseChange ℚ_[p]).height → ℤ_[p]) ≃ₗ[ℤ_[p]]
      Additive ((G.baseChange ℚ_[p]).TateModule K)),
    (∀ v, Function.Bijective ((G.baseChange ℚ_[p]).phiLevel K t v)) ∧
      ∀ c, e c = (G.baseChange ℚ_[p]).phiLin K t c := by
  obtain ⟨t, hlev, hphi⟩ := (G.baseChange ℚ_[p]).exists_tateBasis
  refine ⟨t, LinearEquiv.ofBijective ((G.baseChange ℚ_[p]).phiLin _ t)
    ⟨fun c c' h => ?_, fun x => ?_⟩, hlev, fun c => rfl⟩
  · have := hphi.1 (congrArg Additive.toMul h)
    exact Multiplicative.ofAdd.injective this
  · obtain ⟨c, hc⟩ := hphi.2 (Additive.toMul x)
    exact ⟨Multiplicative.toAdd c, congrArg Additive.ofMul hc⟩

end PDivGroup

end PadicHodge

namespace PadicHodge

namespace PDivGroup

variable {p : ℕ} [hp : Fact p.Prime] (G : PDivGroup ℤ_[p] p)

local notation "K" => PadicAlgCl p

/-- The matrix of `σ` acting on `T_p G(ℚ̄_p)` in a `ℤ_p`-basis `bT`. -/
def tateMatrix {h : ℕ} (bT : Module.Basis (Fin h) ℤ_[p]
    (Additive ((G.baseChange ℚ_[p]).TateModule K))) :
    GalQp p →* Matrix (Fin h) (Fin h) ℤ_[p] where
  toFun σ := LinearMap.toMatrix bT bT ((G.baseChange ℚ_[p]).galLin σ)
  map_one' := by
    have : (G.baseChange ℚ_[p]).galLin 1 = LinearMap.id := LinearMap.ext fun x => rfl
    rw [this, LinearMap.toMatrix_id]
  map_mul' σ τ := by
    have : (G.baseChange ℚ_[p]).galLin (σ * τ) =
        (G.baseChange ℚ_[p]).galLin σ ∘ₗ (G.baseChange ℚ_[p]).galLin τ :=
      LinearMap.ext fun x => rfl
    rw [this, LinearMap.toMatrix_comp bT bT bT]

theorem norm_p_padicInt_eq : ‖(p : ℤ_[p])‖ = ‖(p : K)‖ := by
  have : ((p : ℚ_[p]) : K) = (p : K) := by simp
  rw [← this, PadicAlgCl.norm_extends, PadicInt.norm_p, Padic.norm_p]

local instance : NeZero p := ⟨hp.out.ne_zero⟩

/-- **`A(σ) ≡ 1 mod p^k` on `Gal(ℚ̄_p / coordField G k)`.** -/
theorem tateMatrix_fix (t : Fin (G.baseChange ℚ_[p]).height → (G.baseChange ℚ_[p]).TateModule K)
    (e : (Fin (G.baseChange ℚ_[p]).height → ℤ_[p]) ≃ₗ[ℤ_[p]]
      Additive ((G.baseChange ℚ_[p]).TateModule K))
    (hlev : ∀ v, Function.Bijective ((G.baseChange ℚ_[p]).phiLevel K t v))
    (he : ∀ c, e c = (G.baseChange ℚ_[p]).phiLin K t c) (k : ℕ) (ν : GalQp p)
    (hν : ∀ z ∈ G.coordField k, ν z = z) (i j : Fin (G.baseChange ℚ_[p]).height) :
    ‖G.tateMatrix ((Pi.basisFun ℤ_[p] _).map e) ν i j -
      (1 : Matrix (Fin (G.baseChange ℚ_[p]).height) _ ℤ_[p]) i j‖ ≤ ‖(p : ℤ_[p])‖ ^ k := by
  classical
  set bT := (Pi.basisFun ℤ_[p] (Fin (G.baseChange ℚ_[p]).height)).map e
  set c := e.symm ((G.baseChange ℚ_[p]).galLin ν (bT j))
  have hA : G.tateMatrix bT ν i j = c i := by
    simp [tateMatrix, LinearMap.toMatrix_apply, bT, c]
  have hbT : bT j = e (Pi.single j 1) := by simp [bT]
  have hlevel : (Additive.toMul (e c)).1 k = (Additive.toMul (e (Pi.single j 1))).1 k := by
    rw [LinearEquiv.apply_symm_apply, ← hbT]
    exact G.galTate_level_eq ν hν _
  rw [he, he] at hlevel
  change ((G.baseChange ℚ_[p]).phi K t (Multiplicative.ofAdd c)).1 k =
    ((G.baseChange ℚ_[p]).phi K t (Multiplicative.ofAdd (Pi.single j 1))).1 k at hlevel
  rw [phi_apply, phi_apply] at hlevel
  have h1 := congrFun (congrArg Multiplicative.toAdd ((hlev k).1 hlevel)) i
  simp only [toAdd_ofAdd] at h1
  rw [← sub_eq_zero, ← map_sub, ← RingHom.mem_ker, PadicInt.ker_toZModPow,
    ← PadicInt.norm_le_pow_iff_mem_span_pow] at h1
  rw [hA, Matrix.one_apply]
  have h2 : (Pi.single j (1 : ℤ_[p]) : Fin (G.baseChange ℚ_[p]).height → ℤ_[p]) i =
      if i = j then 1 else 0 := by
    rw [Pi.single_apply]
  rw [← h2, PadicInt.norm_p, inv_pow, ← zpow_natCast, ← zpow_neg]
  exact h1

variable {G} (hG : ∀ v, (G.G v).IsEtale)

include hG in
/-- **`V_p G` is Hodge–Tate with all Hodge–Tate weights `0`** for a `p`-divisible group `G` over
`ℤ_p` with étale layers (Hilbert 90 for `\hat{ℚ_p^{ur}}`), over every finite `L / ℚ_p`. -/
theorem isHodgeTate_tateRep_of_etale (L : IntermediateField ℚ_[p] K) [FiniteDimensional ℚ_[p] L] :
    IsHodgeTate ((G.baseChange ℚ_[p]).tateRep L) ∧
      (htWeights ((G.baseChange ℚ_[p]).tateRep L)).count 0 = G.height := by
  obtain ⟨t, e, hlev, he⟩ := G.exists_tateBasis_lin
  set bT := (Pi.basisFun ℤ_[p] (Fin (G.baseChange ℚ_[p]).height)).map e
  set A := G.tateMatrix bT
  haveI : ∀ k, FiniteDimensional ℚ_[p] (G.coordField k) := G.finiteDimensional_coordField
  obtain ⟨X, hX, hXinv⟩ := exists_hilbert90 (A := A) (Mk := G.coordField)
    (isUnrStable_coordField hG) G.coordField_mono (fun k ν hν i j => by
      have := G.tateMatrix_fix t e hlev he k ν hν i j
      rw [norm_p_padicInt_eq] at this
      have h1 : ‖A ν i j - (1 : Matrix (Fin (G.baseChange ℚ_[p]).height) _ ℤ_[p]) i j‖ =
          ‖algebraMap ℤ_[p] K (A ν i j) -
            (1 : Matrix (Fin (G.baseChange ℚ_[p]).height) _ K) i j‖ := by
        rw [← norm_algebraMap_padicInt, map_sub, Matrix.one_apply, Matrix.one_apply]
        split_ifs <;> simp
      rw [Matrix.sub_apply, AK, Matrix.map_apply, ← h1]
      exact this)
  have key := isHodgeTate_of_matrix ((G.baseChange ℚ_[p]).tateRep L)
    (Algebra.TensorProduct.basis ℚ_[p] bT) X hX (fun σ => by
      have h1 : LinearMap.toMatrix (Algebra.TensorProduct.basis ℚ_[p] bT)
          (Algebra.TensorProduct.basis ℚ_[p] bT) ((G.baseChange ℚ_[p]).tateRep L σ) =
          (A (σ.restrictScalars ℚ_[p])).map (algebraMap ℤ_[p] ℚ_[p]) :=
        LinearMap.toMatrix_baseChange _ _ _ _
      rw [h1, Matrix.map_map]
      have h2 : (algebraMap ℚ_[p] ℂ_[p]) ∘ (algebraMap ℤ_[p] ℚ_[p]) =
          toCp ∘ algebraMap ℤ_[p] K := by
        funext a
        simp only [Function.comp_apply, UniformSpace.Completion.algebraMap_def,
          IsScalarTower.algebraMap_apply ℤ_[p] ℚ_[p] K]
        rfl
      rw [h2, ← Matrix.map_map]
      exact hXinv (σ.restrictScalars ℚ_[p]))
  rw [finrank_tateRep] at key
  exact key

end PDivGroup

end PadicHodge
