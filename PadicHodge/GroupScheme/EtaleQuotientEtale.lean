import PadicHodge.GroupScheme.EtaleQuotient
import Mathlib.RingTheory.Smooth.Fiber
import Mathlib.RingTheory.TensorProduct.Quotient

/-!
# `G^{et}` is étale, and the kernel of `G → G^{et}` is `G⁰`

Let `G = Spec A` be a finite flat commutative group scheme over a complete local ring `R`, with
connected component `π : A → A⁰ = A / (1 - e₀)` (`e₀ = idemConn`) and étale quotient
`G^{et} = Spec A^{et}` (`GroupScheme/EtaleQuotient.lean`). Standard arguments, written up here:

* `idemConn_mem_etaleInvariants`: **`e₀ ∈ A^{et}`** (the indicator of `G⁰` is
  `G⁰`-invariant). With `X = (id ⊗ π)(Δ e₀) ∈ A ⊗ A⁰`: applying `id ⊗ π` to
  `(e₀ ⊗ e₀) Δ(1 - e₀) = 0` gives `(e₀ ⊗ 1) X = e₀ ⊗ 1`; the idempotent `((1 - e₀) ⊗ 1) X` is
  killed by `id ⊗ ε`, hence lies in the ideal generated by `1 ⊗ ker ε ⊆ 1 ⊗ m_{A⁰}`, which is
  contained in the radical of `m_R (A ⊗ A⁰)` (`A⁰` is local and finite over `R`), so it vanishes
  (`eq_zero_of_isIdempotentElem_of_map_eq_zero`).
* `mul_idemConn_of_mem_etaleInvariants`: `b e₀ = ε(b) e₀` for `b ∈ A^{et}`.
* `map_ker_counitEt`: **the kernel of `G → G^{et}` is `G⁰`**: the ideal of `A` generated by the
  augmentation ideal of `A^{et}` is `(1 - e₀)`; equivalently
  `tensorQuotEquiv : A ⊗_{A^{et}} (A^{et} / ker ε) ≃ A⁰`.
* `formallyUnramified_of_connectedComponentHom_eq`: if `G⁰` is trivial (`π = ε`), then `A` is
  formally unramified over `R`. Proof via the infinitesimal lifting criterion and the group
  structure: for `f₁, f₂ : A → B` agreeing modulo a square-zero ideal `I`, the point
  `h = f₁ f₂⁻¹ ∈ G(B)` reduces to `1` modulo `I`, so `h(ker ε) ⊆ I`; since every `a ∈ ker ε`
  satisfies `a = a (1 - e₀)` with `1 - e₀ ∈ ker ε`, `h(ker ε) ⊆ I² = 0` and `h = 1`.
* `isEtale_iff` (`R` noetherian): **`G` is étale iff `G⁰` is trivial** (flat + finitely presented
  + formally unramified is étale, Mathlib `Algebra.Etale.of_formallyUnramified_of_flat`; the
  converse is `connectedComponentHom_eq_of_isEtale`).
* `idemConn_etaleQuotient`, `isEtale_etaleQuotient`: **`G^{et}` is étale** (over a complete local
  PID): its connected-component idempotent is `e₀`, and `b e₀ = ε(b) e₀` on `A^{et}`.

**Open**: faithful flatness of `A` over `A^{et}` and `|G| = |G⁰| · |G^{et}|`.
-/

noncomputable section

open Coalgebra HopfAlgebra IsLocalRing TensorProduct WithConv

namespace PadicHodge

universe u

section Radical

variable {R : Type*} [CommRing R] [IsLocalRing R] {B : Type*} [CommRing B] [Algebra R B]

/-- For a local ring `B` finite over the local ring `R`, `m_B ⊆ √(m_R B)`. -/
theorem maximalIdeal_le_radical_fiberIdeal [IsLocalRing B] [Module.Finite R B] :
    maximalIdeal B ≤ (fiberIdeal R B).radical := by
  rw [Ideal.radical_eq_sInf]
  refine le_sInf fun P ⟨hle, hP⟩ => ?_
  have hc : (P.comap (algebraMap R B)).IsMaximal := by
    have h1 : maximalIdeal R ≤ P.comap (algebraMap R B) := Ideal.map_le_iff_le_comap.mp hle
    rw [← (maximalIdeal.isMaximal R).eq_of_le (hP.comap (algebraMap R B)).ne_top h1]
    exact maximalIdeal.isMaximal R
  exact (IsLocalRing.eq_maximalIdeal (Ideal.isMaximal_of_isIntegral_of_isMaximal_comap P hc)).ge

/-- Let `B` be local and finite over `R` with an `R`-point `φ`, and `C` finite over `R`. An
idempotent of `C ⊗ B` killed by `id ⊗ φ` vanishes. -/
theorem eq_zero_of_isIdempotentElem_of_map_eq_zero {C : Type*} [CommRing C] [Algebra R C]
    [Module.Finite R C] [IsLocalRing B] [Module.Finite R B] (φ : B →ₐ[R] R)
    {f : C ⊗[R] B} (hf : IsIdempotentElem f)
    (h0 : Algebra.TensorProduct.map (AlgHom.id R C) φ f = 0) : f = 0 := by
  apply eq_zero_of_isIdempotentElem_of_mem_radical (R := R) hf
  set ρ : C ⊗[R] B →ₐ[R] C ⊗[R] B :=
    Algebra.TensorProduct.map (AlgHom.id R C) ((Algebra.ofId R B).comp φ)
  have hρ : ρ f = 0 := by
    have : ρ = (Algebra.TensorProduct.map (AlgHom.id R C) (Algebra.ofId R B)).comp
        (Algebra.TensorProduct.map (AlgHom.id R C) φ) := by
      rw [← Algebra.TensorProduct.map_comp]
      rfl
    rw [this, AlgHom.comp_apply, h0, map_zero]
  have key : ∀ z : C ⊗[R] B, z - ρ z ∈ (fiberIdeal R (C ⊗[R] B)).radical := by
    intro z
    induction z with
    | zero => simp
    | add x y hx hy =>
      rw [map_add, add_sub_add_comm]
      exact add_mem hx hy
    | tmul c b =>
      have hb : b - algebraMap R B (φ b) ∈ (fiberIdeal R B).radical := by
        apply maximalIdeal_le_radical_fiberIdeal
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        have := hu.map φ
        simp at this
      have : c ⊗ₜ[R] b - ρ (c ⊗ₜ[R] b) = (c ⊗ₜ[R] (1 : B)) *
          Algebra.TensorProduct.includeRight (b - algebraMap R B (φ b)) := by
        simp only [ρ, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, AlgHom.comp_apply,
          Algebra.ofId_apply, map_sub, Algebra.TensorProduct.includeRight_apply]
        rw [mul_sub, Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, one_mul, one_mul]
      rw [this]
      exact Ideal.mul_mem_left _ _ (map_mem_radical_fiberIdeal _ hb)
  simpa [hρ] using key f

end Radical

namespace FFGroupScheme

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsAdicComplete (maximalIdeal R) R]
  (G : FFGroupScheme R)

theorem connectedComponentHom_idemConn : G.connectedComponentHom G.idemConn = 1 :=
  mk_eq_one_of_span_one_sub _

theorem counit_idemConn : counit (R := R) G.idemConn = 1 :=
  G.isPointIdempotent_idemConn.apply_eq_one

/-! ### `e₀ ∈ A^{et}` -/

/-- The idempotent `e₀` of `G⁰` is `G⁰`-invariant. -/
theorem idemConn_mem_etaleInvariants : G.idemConn ∈ G.etaleInvariants := by
  rw [mem_etaleInvariants]
  set e := G.idemConn
  set π : G.A →ₐ[R] G.connectedComponent.A :=
    (G.connectedComponentHom : G.A →ₐ[R] G.connectedComponent.A)
  set X := G.coactConn e
  have he := G.isPointIdempotent_idemConn
  have hπe : π e = 1 := G.connectedComponentHom_idemConn
  have h1 : (e ⊗ₜ[R] (1 : G.connectedComponent.A)) * X = e ⊗ₜ[R] 1 := by
    have h := congrArg (Algebra.TensorProduct.map (AlgHom.id R G.A) π)
      he.tmul_mul_comul_one_sub
    rw [map_mul, map_zero, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, hπe] at h
    have hX : Algebra.TensorProduct.map (AlgHom.id R G.A) π (comul (R := R) (1 - e)) =
        1 - X := by
      change Algebra.TensorProduct.map (AlgHom.id R G.A) π
        (Bialgebra.comulAlgHom R G.A (1 - e)) = 1 - X
      rw [map_sub, map_sub, map_one, map_one]
      rfl
    rw [hX, mul_sub, mul_one, sub_eq_zero] at h
    exact h.symm
  have h2 : ((1 - e) ⊗ₜ[R] (1 : G.connectedComponent.A)) * X = 0 := by
    refine eq_zero_of_isIdempotentElem_of_map_eq_zero
      (Bialgebra.counitAlgHom R G.connectedComponent.A) ?_ ?_
    · have h3 : IsIdempotentElem ((1 - e) ⊗ₜ[R] (1 : G.connectedComponent.A)) := by
        rw [IsIdempotentElem, Algebra.TensorProduct.tmul_mul_tmul,
          he.isIdempotentElem.one_sub.eq, mul_one]
      exact h3.mul (he.isIdempotentElem.map G.coactConn)
    · have hlin : ∀ x : G.A ⊗[R] G.A,
          Algebra.TensorProduct.map (AlgHom.id R G.A)
            (Bialgebra.counitAlgHom R G.connectedComponent.A)
            (Algebra.TensorProduct.map (AlgHom.id R G.A) π x) =
          (counit (R := R) (A := G.A)).lTensor G.A x := by
        intro x
        induction x with
        | zero => simp
        | tmul a b => rfl
        | add x y hx hy => simp only [map_add, hx, hy]
      have hY : Algebra.TensorProduct.map (AlgHom.id R G.A)
          (Bialgebra.counitAlgHom R G.connectedComponent.A) X = e ⊗ₜ 1 :=
        (hlin _).trans (lTensor_counit_comul e)
      rw [map_mul, Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply, hY,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, sub_mul, one_mul,
        he.isIdempotentElem.eq, sub_self, zero_tmul]
  have hX : X = (e ⊗ₜ[R] (1 : G.connectedComponent.A) + (1 - e) ⊗ₜ[R] 1) * X := by
    rw [← add_tmul, add_sub_cancel, ← Algebra.TensorProduct.one_def, one_mul]
  rw [hX, add_mul, h1, h2, add_zero]

/-- On `A^{et}`, `b e₀ = ε(b) e₀`. -/
theorem mul_idemConn_of_mem_etaleInvariants {b : G.A} (hb : b ∈ G.etaleInvariants) :
    b * G.idemConn = counit (R := R) b • G.idemConn := by
  have h := G.connectedComponentHom_of_mem_etaleInvariants hb
  change Ideal.Quotient.mk G.connIdeal b =
    Ideal.Quotient.mk G.connIdeal (algebraMap R G.A (counit (R := R) b)) at h
  rw [Ideal.Quotient.eq] at h
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h
  have h0 : (b - algebraMap R G.A (counit (R := R) b)) * G.idemConn = 0 := by
    rw [← hc, mul_assoc, sub_mul, one_mul, G.isPointIdempotent_idemConn.isIdempotentElem.eq,
      sub_self, mul_zero]
  rw [sub_mul, sub_eq_zero] at h0
  rw [h0, Algebra.smul_def]

/-! ### The étale criterion -/

/-- Postcomposition with an algebra map `S → S'` is a group homomorphism `G(S) → G(S')`. -/
def pointsMap {S S' : Type*} [CommRing S] [Algebra R S] [CommRing S'] [Algebra R S']
    (φ : S →ₐ[R] S') : G.points S →* G.points S' where
  toFun f := toConv (φ.comp (ofConv f))
  map_one' := by
    apply WithConv.ofConv_injective
    ext a
    simp [AlgHom.convOne_apply]
  map_mul' f g := by
    apply WithConv.ofConv_injective
    exact AlgHom.comp_convMul_distrib φ f g

/-- If `G⁰` is trivial, `A` is formally unramified over `R`. -/
theorem formallyUnramified_of_connectedComponentHom_eq
    (h : ∀ a : G.A, G.connectedComponentHom a = algebraMap R _ (counit (R := R) a)) :
    Algebra.FormallyUnramified R G.A := by
  rw [Algebra.FormallyUnramified.iff_comp_injective]
  intro B _ _ I hI f₁ f₂ hf
  set e := G.idemConn
  have hker : ∀ a : G.A, counit (R := R) a = 0 → a * (1 - e) = a := by
    intro a ha
    have h0 := h a
    rw [ha, map_zero] at h0
    change Ideal.Quotient.mk G.connIdeal a = 0 at h0
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq_zero_iff_mem.mp h0)
    rw [mul_assoc, G.isPointIdempotent_idemConn.isIdempotentElem.one_sub.eq]
  have he1 : counit (R := R) (1 - e) = 0 := by
    rw [map_sub, Bialgebra.counit_one, G.counit_idemConn, sub_self]
  let F₁ : G.points B := toConv f₁
  let F₂ : G.points B := toConv f₂
  have hH : G.pointsMap (Ideal.Quotient.mkₐ R I) (F₁ * F₂⁻¹) = 1 := by
    rw [map_mul, map_inv, mul_inv_eq_one]
    exact WithConv.ofConv_injective hf
  have hmem : ∀ x : G.A, counit (R := R) x = 0 → ofConv (F₁ * F₂⁻¹) x ∈ I := by
    intro x hx
    have := congrArg (fun F : G.points (B ⧸ I) => ofConv F x) hH
    change Ideal.Quotient.mk I (ofConv (F₁ * F₂⁻¹) x) = algebraMap R _ (counit (R := R) x)
      at this
    rw [hx, map_zero, Ideal.Quotient.eq_zero_iff_mem] at this
    exact this
  have hH0 : ∀ a : G.A, counit (R := R) a = 0 → ofConv (F₁ * F₂⁻¹) a = 0 := by
    intro a ha
    have : ofConv (F₁ * F₂⁻¹) a ∈ I ^ 2 := by
      rw [← hker a ha, map_mul, pow_two]
      exact Ideal.mul_mem_mul (hmem a ha) (hmem _ he1)
    rw [hI] at this
    exact Ideal.mem_bot.mp this
  have hH1 : F₁ * F₂⁻¹ = 1 := by
    apply WithConv.ofConv_injective
    ext a
    have := hH0 (a - algebraMap R G.A (counit (R := R) a)) (by simp)
    rw [map_sub, AlgHom.commutes, sub_eq_zero] at this
    rw [this]
    rfl
  exact congrArg ofConv (mul_inv_eq_one.mp hH1)

/-- **`G` is étale iff `G⁰` is trivial** (`R` noetherian). -/
theorem isEtale_iff [IsNoetherianRing R] :
    G.IsEtale ↔ ∀ a : G.A, G.connectedComponentHom a = algebraMap R _ (counit (R := R) a) := by
  refine ⟨G.connectedComponentHom_eq_of_isEtale, fun h => ?_⟩
  have := G.formallyUnramified_of_connectedComponentHom_eq h
  have : Algebra.FinitePresentation R G.A :=
    Algebra.FinitePresentation.of_finiteType.mp inferInstance
  exact Algebra.Etale.of_formallyUnramified_of_flat

/-! ### The étale quotient -/

variable [IsDomain R] [IsPrincipalIdealRing R]

omit [IsDomain R] [IsPrincipalIdealRing R] in
/-- **The kernel of `G → G^{et}` is `G⁰`**: the augmentation ideal of `A^{et}` generates the ideal
`(1 - e₀)` of `G⁰` in `A`. -/
theorem map_ker_counitEt :
    (RingHom.ker G.counitEt).map G.etaleInvariants.val = G.connIdeal := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro b hb
    rw [Ideal.mem_comap]
    have h := G.connectedComponentHom_of_mem_etaleInvariants b.2
    have h0 : counit (R := R) (b : G.A) = 0 := hb
    rw [h0, map_zero] at h
    exact Ideal.Quotient.eq_zero_iff_mem.mp h
  · rw [connIdeal, Ideal.span_le, Set.singleton_subset_iff]
    have hm : 1 - G.idemConn ∈ G.etaleInvariants :=
      sub_mem (one_mem _) G.idemConn_mem_etaleInvariants
    have hk : (⟨1 - G.idemConn, hm⟩ : G.etaleInvariants) ∈ RingHom.ker G.counitEt := by
      rw [RingHom.mem_ker]
      change counit (R := R) (1 - G.idemConn) = 0
      rw [map_sub, Bialgebra.counit_one, G.counit_idemConn, sub_self]
    exact Ideal.mem_map_of_mem G.etaleInvariants.val hk

/-- `A ⊗_{A^{et}} (A^{et} / ker ε) ≅ A⁰`: the fiber of `G → G^{et}` over the identity is `G⁰`. -/
def tensorQuotEquiv : G.A ⊗[G.etaleInvariants] (G.etaleInvariants ⧸ RingHom.ker G.counitEt) ≃ₐ[G.A]
    G.A ⧸ G.connIdeal :=
  (Algebra.TensorProduct.quotIdealMapEquivTensorQuot G.A (RingHom.ker G.counitEt)).symm.trans
    (Ideal.quotientEquivAlgOfEq G.A G.map_ker_counitEt)

/-- The connected-component idempotent of `G^{et}` is `e₀`. -/
theorem idemConn_etaleQuotient :
    G.etaleQuotient.idemConn = ⟨G.idemConn, G.idemConn_mem_etaleInvariants⟩ := by
  set x : G.etaleQuotient.A := ⟨G.idemConn, G.idemConn_mem_etaleInvariants⟩
  have he := G.isPointIdempotent_idemConn
  refine G.etaleQuotient.isPointIdempotent_idemConn.unique ⟨?_, he.apply_eq_one, fun b => ?_⟩
  · exact Subtype.ext he.isIdempotentElem.eq
  · have h0 : b * x - Bialgebra.counitAlgHom R G.etaleQuotient.A b • x = 0 :=
      Subtype.ext (sub_eq_zero.mpr (G.mul_idemConn_of_mem_etaleInvariants
        (b : G.etaleInvariants).2))
    rw [h0]
    exact zero_mem _

/-- The connected component of `G^{et}` is trivial. -/
theorem connectedComponentHom_etaleQuotient (b : G.etaleQuotient.A) :
    G.etaleQuotient.connectedComponentHom b = algebraMap R _ (counit (R := R) b) :=
  G.etaleQuotient.connectedComponentHom_eq_of_mul_idemConn (fun b => by
    rw [idemConn_etaleQuotient]
    exact Subtype.ext (G.mul_idemConn_of_mem_etaleInvariants (b : G.etaleInvariants).2)) b

/-- **`G^{et}` is étale.** -/
theorem isEtale_etaleQuotient : G.etaleQuotient.IsEtale :=
  (G.etaleQuotient.isEtale_iff).mpr G.connectedComponentHom_etaleQuotient

end FFGroupScheme

end PadicHodge
