import PadicHodge.Hilbert90.Main
import PadicHodge.GroupScheme.EtaleUnramified
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Algebra.CharP.Reduced

/-!
# The points of an étale group scheme over `ℤ_p` generate unramified fields

For a finite étale `ℤ_p`-algebra `A` (finite free as a module):

* `exists_frobenius_period`: Frobenius on `A / p` is periodic: there is `N ≥ 1` with
  `a^{p^N} ≡ a mod p` for all `a ∈ A` (`A/p` is finite and reduced, since `pA` is radical by
  formal unramifiedness, `Algebra.FormallyUnramified.isRadical_map_isMaximal`; an injective
  self-map of a finite set is a permutation of finite order).

For a set `S ⊆ ℚ̄_p` of images of `ℤ_p`-algebra maps from finite étale `ℤ_p`-algebras which is
closed under these (`FrobClosed`):

* `periodic_adjoin`: every `d` in the `ℤ_p`-algebra `D` generated by `S` satisfies
  `d^{p^N} − d ∈ p D` for some `N ≥ 1` (computation in the characteristic-`p` ring `D / p`);
* `norm_eq_pow_of_mem_adjoin`: `|d| ∈ |p|^ℕ` for `0 ≠ d ∈ D` (if `|d| < 1` then
  `|d| = |d^{p^N} − d| = |p| |e|` with `e ∈ D` and `|e| > |d|`; induction);
* **`unr_adjoin`**: `|z| < 1 ⇒ |z| ≤ |p|` on the field `ℚ_p(S) = D[1/p]`: it is unramified.

Standard arguments, written up here.
-/

noncomputable section

open IsLocalRing

namespace PadicHodge

namespace Hilbert90

variable {p : ℕ} [hp : Fact p.Prime]

local notation "K" => PadicAlgCl p

section Frobenius

variable (A : Type*) [CommRing A] [Algebra ℤ_[p] A] [Module.Free ℤ_[p] A]
  [Module.Finite ℤ_[p] A] [Algebra.Etale ℤ_[p] A]

/-- **Frobenius on `A / p` is periodic** for a finite étale `ℤ_p`-algebra `A`. -/
theorem exists_frobenius_period :
    ∃ N, 0 < N ∧ ∀ a : A, ∃ b : A, a ^ (p ^ N) - a = (p : A) * b := by
  classical
  set I : Ideal A := (maximalIdeal ℤ_[p]).map (algebraMap ℤ_[p] A)
  have hI : I = Ideal.span {(p : A)} := by
    simp only [I, PadicInt.maximalIdeal_eq_span_p, Ideal.map_span, Set.image_singleton,
      map_natCast]
  have hrad : I.IsRadical :=
    Algebra.FormallyUnramified.isRadical_map_isMaximal ℤ_[p] A (maximalIdeal ℤ_[p])
  -- reduce to the quotient
  suffices hQ : ∃ N, 0 < N ∧ ∀ x : A ⧸ I, x ^ (p ^ N) = x by
    obtain ⟨N, hN, hx⟩ := hQ
    refine ⟨N, hN, fun a => ?_⟩
    have := hx (Ideal.Quotient.mk I a)
    rw [← map_pow, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem, hI,
      Ideal.mem_span_singleton'] at this
    obtain ⟨b, hb⟩ := this
    exact ⟨b, by rw [← hb, mul_comm]⟩
  by_cases hnt : Nontrivial (A ⧸ I)
  swap
  · rw [not_nontrivial_iff_subsingleton] at hnt
    exact ⟨1, one_pos, fun x => Subsingleton.elim _ _⟩
  have hp0 : ((p : ℕ) : A ⧸ I) = 0 := by
    rw [← map_natCast (Ideal.Quotient.mk I), Ideal.Quotient.eq_zero_iff_mem, hI]
    exact Ideal.subset_span rfl
  haveI : CharP (A ⧸ I) p := (CharP.charP_iff_prime_eq_zero hp.out).mpr hp0
  haveI : IsReduced (A ⧸ I) := by
    refine ⟨fun x ⟨n, hn⟩ => ?_⟩
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem] at hn
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact hrad ⟨n, hn⟩
  -- `A / I` is finite
  haveI : Finite (A ⧸ I) := by
    let bA := Module.Free.chooseBasis ℤ_[p] A
    let ι := Module.Free.ChooseBasisIndex ℤ_[p] A
    let f : (ι → Fin p) → A ⧸ I := fun c =>
      Ideal.Quotient.mk I (∑ i, ((c i : ℕ) : A) * bA i)
    refine Finite.of_surjective f fun x => ?_
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    set r := bA.repr a
    refine ⟨fun i => ⟨PadicInt.zmodRepr (r i), PadicInt.zmodRepr_lt_p _⟩, ?_⟩
    rw [Ideal.Quotient.eq]
    have hsum : ∑ i, r i • bA i = a := bA.sum_repr a
    have hdiff : ∑ i, (((PadicInt.zmodRepr (r i) : ℕ) : A)) * bA i - a =
        ∑ i, algebraMap ℤ_[p] A ((PadicInt.zmodRepr (r i) : ℤ_[p]) - r i) * bA i := by
      rw [← hsum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Algebra.smul_def, map_sub, sub_mul, map_natCast]
    change ∑ i, (((PadicInt.zmodRepr (r i) : ℕ) : A)) * bA i - a ∈ I
    rw [hdiff]
    refine Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ?_)
    rw [← neg_sub, neg_mem_iff]
    exact PadicInt.sub_zmodRepr_mem _
  -- Frobenius is a permutation of finite order
  have hinj : Function.Injective (frobenius (A ⧸ I) p) := frobenius_inj _ p
  have hbij : Function.Bijective (frobenius (A ⧸ I) p) := hinj.bijective_of_finite
  let π : Equiv.Perm (A ⧸ I) := Equiv.ofBijective _ hbij
  obtain ⟨N, hN, hπ⟩ := (isOfFinOrder_of_finite π).exists_pow_eq_one
  refine ⟨N, hN, fun x => ?_⟩
  have := congrArg (fun g : Equiv.Perm (A ⧸ I) => g x) hπ
  simp only [Equiv.Perm.coe_pow, Equiv.Perm.coe_one, id_eq] at this
  rw [← iterate_frobenius]
  exact this

end Frobenius

/-- `S` is a union of images of `ℤ_p`-algebra maps from finite étale `ℤ_p`-algebras. -/
def FrobClosed (S : Set K) : Prop :=
  ∀ z ∈ S, ∃ N, 0 < N ∧ ∃ e ∈ S, z ^ (p ^ N) - z = (p : K) * e

theorem norm_algebraMap_le_one (r : ℤ_[p]) : ‖algebraMap ℤ_[p] K r‖ ≤ 1 := by
  rw [norm_algebraMap_padicInt]; exact PadicInt.norm_le_one r

variable {S : Set (PadicAlgCl p)} (hS1 : ∀ z ∈ S, ‖z‖ ≤ 1)

include hS1 in
theorem norm_le_one_of_mem_adjoin {d : K} (hd : d ∈ Algebra.adjoin ℤ_[p] S) : ‖d‖ ≤ 1 := by
  induction hd using Algebra.adjoin_induction with
  | mem x hx => exact hS1 x hx
  | algebraMap r => exact norm_algebraMap_le_one r
  | add x y _ _ hx hy => exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le hx hy)
  | mul x y _ _ hx hy => rw [norm_mul]; exact mul_le_one₀ hx (norm_nonneg _) hy

omit hp in
theorem pow_pow_mul_eq {R : Type*} [Monoid R] {x : R} {N : ℕ} (hx : x ^ (p ^ N) = x) (m : ℕ) :
    x ^ (p ^ (N * m)) = x := by
  induction m with
  | zero => simp
  | succ m ih => rw [Nat.mul_succ, pow_add, pow_mul, ih, hx]

variable (hS : FrobClosed (p := p) S)

include hS1 hS in
/-- **Frobenius periodicity modulo `p`** on the `ℤ_p`-algebra generated by `S`. -/
theorem periodic_adjoin {d : K} (hd : d ∈ Algebra.adjoin ℤ_[p] S) :
    ∃ N, 0 < N ∧ ∃ e ∈ Algebra.adjoin ℤ_[p] S, d ^ (p ^ N) - d = (p : K) * e := by
  set D := Algebra.adjoin ℤ_[p] S
  set J : Ideal D := Ideal.span {(p : D)}
  have hJ : ∀ x : D, Ideal.Quotient.mk J x = 0 ↔ ∃ e ∈ D, (x : K) = (p : K) * e := by
    intro x
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton']
    constructor
    · rintro ⟨e, he⟩
      exact ⟨e, e.2, by rw [← he, Subalgebra.coe_mul, mul_comm]; rfl⟩
    · rintro ⟨e, he, hxe⟩
      exact ⟨⟨e, he⟩, Subtype.ext (by rw [Subalgebra.coe_mul, hxe, mul_comm]; rfl)⟩
  have hnt : Nontrivial (D ⧸ J) := by
    rw [Ideal.Quotient.nontrivial_iff]
    intro htop
    have h1 : (1 : D) ∈ J := htop ▸ Submodule.mem_top
    rw [← Ideal.Quotient.eq_zero_iff_mem, hJ] at h1
    obtain ⟨e, he, h1e⟩ := h1
    have hn := congrArg norm h1e
    rw [OneMemClass.coe_one, norm_one, norm_mul] at hn
    have := norm_le_one_of_mem_adjoin hS1 he
    have := norm_p_lt_one (p := p)
    nlinarith [norm_nonneg (p : K), norm_nonneg e]
  haveI : CharP (D ⧸ J) p := by
    rw [CharP.charP_iff_prime_eq_zero hp.out]
    rw [← map_natCast (Ideal.Quotient.mk J), Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span rfl
  suffices hQ : ∃ N, 0 < N ∧ (Ideal.Quotient.mk J ⟨d, hd⟩) ^ (p ^ N) =
      Ideal.Quotient.mk J ⟨d, hd⟩ by
    obtain ⟨N, hN, h⟩ := hQ
    rw [← map_pow, ← sub_eq_zero, ← map_sub, hJ] at h
    exact ⟨N, hN, h⟩
  induction hd using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨N, hN, e, he, hxe⟩ := hS x hx
    refine ⟨N, hN, ?_⟩
    rw [← map_pow, ← sub_eq_zero, ← map_sub, hJ]
    exact ⟨e, Algebra.subset_adjoin he, hxe⟩
  | algebraMap r =>
    refine ⟨1, one_pos, ?_⟩
    have hr : r ^ p - r ∈ maximalIdeal ℤ_[p] := by
      rw [← PadicInt.ker_toZMod, RingHom.mem_ker, map_sub, map_pow, ZMod.pow_card, sub_self]
    rw [PadicInt.maximalIdeal_eq_span_p, Ideal.mem_span_singleton'] at hr
    obtain ⟨s, hs⟩ := hr
    rw [pow_one, ← map_pow, ← sub_eq_zero, ← map_sub, hJ]
    refine ⟨algebraMap ℤ_[p] K s, Subalgebra.algebraMap_mem _ s, ?_⟩
    change (algebraMap ℤ_[p] K r) ^ p - algebraMap ℤ_[p] K r = _
    rw [← map_pow, ← map_sub, ← hs, map_mul, map_natCast, mul_comm]
  | add x y hx hy ihx ihy =>
    obtain ⟨N₁, hN₁, h₁⟩ := ihx
    obtain ⟨N₂, hN₂, h₂⟩ := ihy
    refine ⟨N₁ * N₂, Nat.mul_pos hN₁ hN₂, ?_⟩
    have e1 : (⟨x + y, Subalgebra.add_mem _ hx hy⟩ : D) = ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
    rw [e1, map_add, add_pow_char_pow, pow_pow_mul_eq h₁, mul_comm, pow_pow_mul_eq h₂]
  | mul x y hx hy ihx ihy =>
    obtain ⟨N₁, hN₁, h₁⟩ := ihx
    obtain ⟨N₂, hN₂, h₂⟩ := ihy
    refine ⟨N₁ * N₂, Nat.mul_pos hN₁ hN₂, ?_⟩
    have e1 : (⟨x * y, Subalgebra.mul_mem _ hx hy⟩ : D) = ⟨x, hx⟩ * ⟨y, hy⟩ := rfl
    rw [e1, map_mul, mul_pow, pow_pow_mul_eq h₁, mul_comm N₁ N₂, pow_pow_mul_eq h₂]

include hS1 hS in
/-- **Absolute values on `D` are powers of `|p|`.** -/
theorem norm_eq_pow_of_mem_adjoin {d : K} (hd : d ∈ Algebra.adjoin ℤ_[p] S) (hd0 : d ≠ 0) :
    ∃ n : ℕ, ‖d‖ = ‖(p : K)‖ ^ n := by
  set P := ‖(p : K)‖
  have hP0 : 0 < P := norm_p_pos
  have hP1 : P < 1 := norm_p_lt_one
  suffices H : ∀ j : ℕ, ∀ d ∈ Algebra.adjoin ℤ_[p] S, P ^ j < ‖d‖ → ∃ n : ℕ, ‖d‖ = P ^ n by
    obtain ⟨j, hj⟩ := exists_pow_lt_of_lt_one (norm_pos_iff.mpr hd0) hP1
    exact H j d hd hj
  intro j
  induction j with
  | zero =>
    intro d hd h
    rw [pow_zero] at h
    exact absurd (norm_le_one_of_mem_adjoin hS1 hd) (not_le.mpr h)
  | succ j ih =>
    intro d hd h
    rcases (norm_le_one_of_mem_adjoin hS1 hd).lt_or_eq with hlt | heq
    · obtain ⟨N, hN, e, he, hde⟩ := periodic_adjoin hS1 hS hd
      have hdpos : 0 < ‖d‖ := lt_of_le_of_lt (pow_nonneg hP0.le _) h
      have hlt' : ‖d ^ (p ^ N)‖ < ‖d‖ := by
        rw [norm_pow]
        have h2 : 1 < p ^ N := Nat.one_lt_pow hN.ne' hp.out.one_lt
        calc ‖d‖ ^ (p ^ N) < ‖d‖ ^ 1 := pow_lt_pow_right_of_lt_one₀ hdpos hlt h2
          _ = ‖d‖ := pow_one _
      have hnorm : ‖d ^ (p ^ N) - d‖ = ‖d‖ := by
        rw [sub_eq_add_neg, IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm (by
          rw [norm_neg]; exact hlt'.ne), norm_neg]
        exact max_eq_right hlt'.le
      rw [hde, norm_mul] at hnorm
      have he' : P ^ j < ‖e‖ := by
        have : P ^ j * P < ‖e‖ * P := by
          rw [← pow_succ, mul_comm, hnorm]; exact h
        exact lt_of_mul_lt_mul_right this hP0.le
      obtain ⟨n, hn⟩ := ih e he he'
      exact ⟨n + 1, by rw [← hnorm, hn, pow_succ, mul_comm]⟩
    · exact ⟨0, by rw [heq, pow_zero]⟩

include hS1 hS in
/-- **The field generated by `S` is unramified**: `|z| < 1 ⇒ |z| ≤ |p|`. -/
theorem unr_adjoin {z : K} (hz : z ∈ IntermediateField.adjoin ℚ_[p] S) (hz1 : ‖z‖ < 1) :
    ‖z‖ ≤ ‖(p : K)‖ := by
  set P := ‖(p : K)‖
  have hP0 : 0 < P := norm_p_pos
  have hP1 : P < 1 := norm_p_lt_one
  rcases eq_or_ne z 0 with rfl | hz0
  · rw [norm_zero]; exact hP0.le
  -- `p^m z ∈ D`
  have key : ∀ w ∈ Algebra.adjoin ℚ_[p] S, ∃ m : ℕ, (p : K) ^ m * w ∈ Algebra.adjoin ℤ_[p] S := by
    intro w hw
    induction hw using Algebra.adjoin_induction with
    | mem x hx => exact ⟨0, by rw [pow_zero, one_mul]; exact Algebra.subset_adjoin hx⟩
    | algebraMap c =>
      obtain ⟨m, hm⟩ : ∃ m : ℕ, ‖(p : ℚ_[p]) ^ m * c‖ ≤ 1 := by
        rcases eq_or_ne c 0 with rfl | hc
        · exact ⟨0, by simp⟩
        obtain ⟨m, hm⟩ := exists_pow_lt_of_lt_one (inv_pos.mpr (norm_pos_iff.mpr hc))
          (show ‖(p : ℚ_[p])‖ < 1 from Padic.norm_p_lt_one)
        refine ⟨m, ?_⟩
        rw [norm_mul, norm_pow]
        have := mul_lt_mul_of_pos_right hm (norm_pos_iff.mpr hc)
        rw [inv_mul_cancel₀ (norm_pos_iff.mpr hc).ne'] at this
        exact this.le
      refine ⟨m, ?_⟩
      have : (p : K) ^ m * algebraMap ℚ_[p] K c =
          algebraMap ℤ_[p] K ⟨(p : ℚ_[p]) ^ m * c, hm⟩ := by
        rw [IsScalarTower.algebraMap_apply ℤ_[p] ℚ_[p] K]
        simp
      rw [this]
      exact Subalgebra.algebraMap_mem _ _
    | add x y _ _ hx hy =>
      obtain ⟨m₁, h₁⟩ := hx
      obtain ⟨m₂, h₂⟩ := hy
      refine ⟨m₁ + m₂, ?_⟩
      have : (p : K) ^ (m₁ + m₂) * (x + y) =
          (p : K) ^ m₂ * ((p : K) ^ m₁ * x) + (p : K) ^ m₁ * ((p : K) ^ m₂ * y) := by ring
      rw [this]
      exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ (Subalgebra.pow_mem _
        (Subalgebra.natCast_mem _ p) _) h₁) (Subalgebra.mul_mem _ (Subalgebra.pow_mem _
        (Subalgebra.natCast_mem _ p) _) h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨m₁, h₁⟩ := hx
      obtain ⟨m₂, h₂⟩ := hy
      refine ⟨m₁ + m₂, ?_⟩
      have : (p : K) ^ (m₁ + m₂) * (x * y) = ((p : K) ^ m₁ * x) * ((p : K) ^ m₂ * y) := by
        ring
      rw [this]
      exact Subalgebra.mul_mem _ h₁ h₂
  have hz' : z ∈ (IntermediateField.adjoin ℚ_[p] S).toSubalgebra := hz
  rw [IntermediateField.adjoin_toSubalgebra_of_isAlgebraic
    (fun x _ => Algebra.IsAlgebraic.isAlgebraic x)] at hz'
  obtain ⟨m, hm⟩ := key z hz'
  have hne : (p : K) ^ m * z ≠ 0 := mul_ne_zero (pow_ne_zero _ p_ne_zero) hz0
  obtain ⟨n, hn⟩ := norm_eq_pow_of_mem_adjoin hS1 hS hm hne
  rw [norm_mul, norm_pow] at hn
  -- `P^m |z| = P^n` with `|z| < 1`, so `n > m`
  have hlt : P ^ n < P ^ m := by
    rw [← hn]
    calc P ^ m * ‖z‖ < P ^ m * 1 := mul_lt_mul_of_pos_left hz1 (pow_pos hP0 _)
      _ = P ^ m := mul_one _
  have hmn : m < n := (pow_lt_pow_iff_right_of_lt_one₀ hP0 hP1).mp hlt
  have hz' : ‖z‖ = P ^ (n - m) := by
    have h1 : P ^ n = P ^ m * P ^ (n - m) := by rw [← pow_add]; congr 1; omega
    rw [h1] at hn
    exact mul_left_cancel₀ (pow_pos hP0 _).ne' hn
  rw [hz']
  calc P ^ (n - m) ≤ P ^ 1 := pow_le_pow_of_le_one hP0.le hP1.le (by omega)
    _ = P := pow_one P

end Hilbert90

end PadicHodge
