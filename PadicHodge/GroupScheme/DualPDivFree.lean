import PadicHodge.GroupScheme.CartierChar
import PadicHodge.GroupScheme.CartierDualPDiv
import PadicHodge.GroupScheme.DualBaseChange

/-!
# The Cartier dual of a `p`-divisible group over a general base

[Hong, Prop. 2.1.7 (2), Def. 2.1.8] / [BC, §7.2]: for a `p`-divisible group `G = (G_v)` over
`R`, the Cartier duals `G_v^∨` with the transposes `quot_v^∨ : G_v^∨ → G_{v+1}^∨` of the
quotient maps form a `p`-divisible group `G^∨` ([Hong] deduces this from the exact sequence
`G_{v+1} → G_{v+1} → G_v → 0` of Prop. 2.1.7 (1) and exactness of Cartier duality). Over `ℚ_p`
this is `PDivGroup.dualPDiv` (`CartierDualPDiv.lean`, by
étaleness and counting). Here we prove it over an arbitrary base for `p`-divisible groups whose
layers satisfy the freeness conditions that hold for `F[p^∞]` of a `p`-divisible formal group
law ([Hong, Prop. 2.2.10, proof]; `FormalGroup/DualPDivFGL.lean`), packaged as
`PDivGroup.DualPDivData`:

* a retraction `r_v : A_{v+1} → A_v` of `quot_v^* : A_v → A_{v+1}` which is `A_v`-linear
  (e.g. the coordinate of `1` in an `A_v`-basis of `A_{v+1}` containing `1`);
* the restriction `res_v : A_{v+1} ↠ A_1` (`G_1 ↪ G_{v+1}`), whose kernel is generated by
  `quot_v^*(ker ε)` (scheme-theoretically, `ker(quot_v) = G_1`);
* `[p^v] : G_{v+1} → G_{v+1}` factors as `G_{v+1} → G_1 ↪ G_{v+1}` with `A_1 → A_{v+1}`
  split injective.

Standard arguments, written up here:

* `HopfInvariants.eq_of_invariant` (**invariants of a coaction**): for a commutative Hopf algebra
  `A`, a sub-Hopf algebra `q : A' → A` with an `A'`-linear retraction `r` (`r(1) = 1`), and
  `π : A ↠ C` with `ker π ⊆ A · q(ker ε)`, every `z ∈ S ⊗ A` with `(S ⊗ ρ)(z) = z ⊗ 1`
  (`ρ = (id ⊗ π) ∘ Δ`) lies in `S ⊗ q(A')`. Proof: the map
  `Φ : A ⊗ A → A`, `x ⊗ y ↦ q r(x S(y₍₁₎)) y₍₂₎` (the inverse of the Galois map
  `x ⊗_{A'} y ↦ (x ⊗ 1) ρ(y)` followed by `r ⊗ id`, compare `galoisEquiv` in
  `EtaleQuotientOrder.lean`) kills `A ⊗ ker π`, satisfies `Φ ∘ Δ = id` and `Φ(a ⊗ 1) = q r(a)`.
* `PDivGroup.dual_quot_surjective'`: `quot_v^∨` is a closed immersion (`F ↦ F ∘ r_v` is a
  section of the transpose).
* `PDivGroup.exists_dual_quot_eq'` (kernel condition): a point `y ∈ G_{v+1}^∨(S)` is a
  group-like `χ ∈ S ⊗ A_{v+1}` (`CartierChar.lean`); `y^{p^v} = 1` gives
  `(S ⊗ [p^v]^*)(χ) = 1`, hence `(S ⊗ res_v)(χ) = 1`, hence `χ` is `G_1`-invariant, hence
  `χ ∈ S ⊗ quot_v^*(A_v)` and `y` factors through `quot_v^∨`.
* `PDivGroup.dualPDivOf`: the `p`-divisible group `G^∨` (height `h`, `|G_v^∨| = p^{hv}`);
  `tateModule_dualPDivOf`: `T_p(G^∨) = DualTate G`; `dualPDivOfBaseChangeTateEquiv`: for
  `G` over `R` with `ℚ_p`-algebra structure, `T_p((G^∨)_{ℚ_p}) ≃* T_p((G_{ℚ_p})^∨)`.
-/

noncomputable section

open Coalgebra HopfAlgebra WithConv TensorProduct

namespace PadicHodge

universe u

namespace HopfInvariants

variable {R : Type*} [CommRing R] {A A' : Type*} [CommRing A] [HopfAlgebra R A] [CommRing A']
  [HopfAlgebra R A']

/-- A bialgebra map between commutative Hopf algebras commutes with the antipodes. -/
theorem antipode_comp_bialgHom (q : A' →ₐc[R] A) :
    (antipodeAlgHom R A).comp (q : A' →ₐ[R] A) = (q : A' →ₐ[R] A).comp (antipodeAlgHom R A') := by
  have h1 : (toConv ((antipodeAlgHom R A).comp (q : A' →ₐ[R] A)) * toConv (q : A' →ₐ[R] A) :
      WithConv (A' →ₐ[R] A)) = 1 := by
    have := AlgHom.convMul_comp_bialgHom_distrib (toConv (antipodeAlgHom R A))
      (toConv (AlgHom.id R A)) q
    rw [AlgHom.antipode_id_cancel] at this
    simp only [AlgHom.id_comp] at this
    apply WithConv.ofConv_injective
    rw [← this]
    ext a
    simp [AlgHom.convOne_def]
  exact congrArg ofConv (eq_inv_of_mul_eq_one_left h1)

variable (R A) in
/-- `γ : x ⊗ y ↦ x S(y₍₁₎) ⊗ y₍₂₎`. -/
def gam : A ⊗[R] A →ₐ[R] A ⊗[R] A :=
  Algebra.TensorProduct.productMap (Algebra.TensorProduct.includeLeft : A →ₐ[R] A ⊗[R] A)
    ((Algebra.TensorProduct.map (antipodeAlgHom R A) (AlgHom.id R A)).comp
      (Bialgebra.comulAlgHom R A))

theorem map_antipode_id_apply (w : A ⊗[R] A) :
    Algebra.TensorProduct.map (antipodeAlgHom R A) (AlgHom.id R A) w =
      (antipode R).rTensor A w := by
  induction w using TensorProduct.induction_on with
  | zero => simp
  | tmul x y => simp
  | add w w' hw hw' => rw [map_add, hw, hw', map_add]

theorem gam_tmul (x y : A) : gam R A (x ⊗ₜ y) =
    (x ⊗ₜ[R] (1 : A)) * (antipode R).rTensor A (comul y) := by
  rw [gam, Algebra.TensorProduct.productMap_apply_tmul, AlgHom.comp_apply,
    map_antipode_id_apply]
  rfl

theorem tmul_one_mul_rTensor (x : A) (w : A ⊗[R] A) :
    (x ⊗ₜ[R] (1 : A)) * (antipode R).rTensor A w =
      (LinearMap.mul' R A ∘ₗ (antipode R).lTensor A).rTensor A
        ((TensorProduct.assoc R A A A).symm (x ⊗ₜ w)) := by
  induction w using TensorProduct.induction_on with
  | zero => simp
  | tmul y z => simp [Algebra.TensorProduct.tmul_mul_tmul]
  | add w w' hw hw' => rw [map_add, mul_add, hw, hw', tmul_add, map_add, map_add]

theorem gam_eq (w : A ⊗[R] A) :
    gam R A w = (LinearMap.mul' R A ∘ₗ (antipode R).lTensor A).rTensor A
      ((TensorProduct.assoc R A A A).symm (comul.lTensor A w)) := by
  induction w using TensorProduct.induction_on with
  | zero => simp
  | tmul x y => rw [gam_tmul, tmul_one_mul_rTensor, LinearMap.lTensor_tmul]
  | add w w' hw hw' => rw [map_add, hw, hw', map_add, map_add, map_add]

/-- `γ(Δ a) = 1 ⊗ a`. -/
theorem gam_comul (a : A) : gam R A (comul a) = 1 ⊗ₜ a := by
  rw [gam_eq, coassoc_symm_apply, ← LinearMap.rTensor_comp_apply, LinearMap.comp_assoc,
    HopfAlgebra.mul_antipode_lTensor_comul, LinearMap.rTensor_comp_apply, rTensor_counit_comul]
  simp

theorem gam_tmul_one (a : A) : gam R A (a ⊗ₜ 1) = a ⊗ₜ 1 := by
  rw [gam, Algebra.TensorProduct.productMap_left_apply]
  rfl

variable (q : A' →ₐc[R] A) (r : A →ₗ[R] A')

theorem gam_one_tmul (b : A') : gam R A (1 ⊗ₜ q b) =
    Algebra.TensorProduct.map (q : A' →ₐ[R] A) (q : A' →ₐ[R] A)
      (Algebra.TensorProduct.map (antipodeAlgHom R A') (AlgHom.id R A') (comul b)) := by
  have h : (Algebra.TensorProduct.map (antipodeAlgHom R A) (AlgHom.id R A)).comp
      ((Algebra.TensorProduct.map (q : A' →ₐ[R] A) (q : A' →ₐ[R] A)).comp
        (Bialgebra.comulAlgHom R A')) =
      (Algebra.TensorProduct.map (q : A' →ₐ[R] A) (q : A' →ₐ[R] A)).comp
        ((Algebra.TensorProduct.map (antipodeAlgHom R A') (AlgHom.id R A')).comp
          (Bialgebra.comulAlgHom R A')) := by
    rw [← AlgHom.comp_assoc, ← Algebra.TensorProduct.map_comp, antipode_comp_bialgHom,
      AlgHom.id_comp, ← AlgHom.comp_id (q : A' →ₐ[R] A), Algebra.TensorProduct.map_comp,
      AlgHom.comp_id, AlgHom.comp_assoc]
  have h2 := congrArg (fun φ => φ b) h
  rw [BialgHom.map_comp_comulAlgHom] at h2
  rw [gam, Algebra.TensorProduct.productMap_right_apply]
  exact h2

/-- `Ψ : x ⊗ y ↦ q(r(x)) y`. -/
def psiMap : A ⊗[R] A →ₗ[R] A := LinearMap.mul' R A ∘ₗ ((q : A' →ₗ[R] A) ∘ₗ r).rTensor A

theorem psiMap_tmul (x y : A) : psiMap q r (x ⊗ₜ y) = q (r x) * y := by
  simp [psiMap]

theorem psiMap_mul (hr : ∀ b x, r (q b * x) = b * r x) (u : A ⊗[R] A) (w : A' ⊗[R] A') :
    psiMap q r (u * Algebra.TensorProduct.map (q : A' →ₐ[R] A) (q : A' →ₐ[R] A) w) =
      psiMap q r u * q (LinearMap.mul' R A' w) := by
  induction u using TensorProduct.induction_on with
  | zero => simp
  | add u u' hu hu' => rw [add_mul, map_add, hu, hu', map_add, add_mul]
  | tmul x y =>
    induction w using TensorProduct.induction_on with
    | zero => simp
    | add w w' hw hw' => rw [map_add, mul_add, map_add, hw, hw', map_add, map_add, mul_add]
    | tmul b b' =>
      rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.tmul_mul_tmul, psiMap_tmul,
        psiMap_tmul, LinearMap.mul'_apply, mul_comm x]
      change q (r (q b * x)) * (y * q b') = q (r x) * y * q (b * b')
      rw [hr, map_mul, map_mul]
      ring

theorem lmul_map_antipode_comul (b : A') :
    LinearMap.mul' R A' (Algebra.TensorProduct.map (antipodeAlgHom R A') (AlgHom.id R A')
      (comul b)) = algebraMap R A' (counit b) := by
  rw [map_antipode_id_apply, mul_antipode_rTensor_comul_apply]

/-- `Φ = Ψ ∘ γ : x ⊗ y ↦ q r(x S(y₍₁₎)) y₍₂₎`. -/
def phi : A ⊗[R] A →ₗ[R] A := psiMap q r ∘ₗ (gam R A).toLinearMap

theorem phi_apply (w : A ⊗[R] A) : phi q r w = psiMap q r (gam R A w) := rfl

theorem phi_comul (hr1 : r 1 = 1) (a : A) : phi q r (comul a) = a := by
  rw [phi_apply, gam_comul, psiMap_tmul, hr1, map_one, one_mul]

theorem phi_tmul_one (a : A) : phi q r (a ⊗ₜ 1) = q (r a) := by
  rw [phi_apply, gam_tmul_one, psiMap_tmul, mul_one]

theorem phi_tmul_mul (hr : ∀ b x, r (q b * x) = b * r x) (x a : A) (b : A') :
    phi q r (x ⊗ₜ (a * q b)) = phi q r (x ⊗ₜ a) * algebraMap R A (counit b) := by
  rw [phi_apply, phi_apply]
  have : x ⊗ₜ[R] (a * q b) = (x ⊗ₜ[R] a) * ((1 : A) ⊗ₜ[R] q b) := by
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
  rw [this, map_mul, gam_one_tmul, psiMap_mul q r hr, lmul_map_antipode_comul]
  congr 1
  exact AlgHom.commutes (q : A' →ₐ[R] A) _

theorem phi_tmul_eq_zero (hr : ∀ b x, r (q b * x) = b * r x) {y : A}
    (hy : y ∈ Ideal.span ((q : A' → A) '' {b | counit (R := R) b = 0})) (x : A) :
    phi q r (x ⊗ₜ y) = 0 := by
  suffices h : ∀ a x, phi q r (x ⊗ₜ (a * y)) = 0 by simpa using h 1 x
  induction hy using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨b, hb, rfl⟩ := hz
    intro a x
    rw [phi_tmul_mul q r hr, Set.mem_setOf_eq.mp hb, map_zero, mul_zero]
  | zero => intro a x; simp
  | add z z' _ _ hz hz' => intro a x; rw [mul_add, tmul_add, map_add, hz, hz', add_zero]
  | smul c z _ hz => intro a x; rw [smul_eq_mul, ← mul_assoc]; exact hz _ _

/-- **Invariants of the coaction `ρ = (id ⊗ π) ∘ Δ`.** If `z ∈ S ⊗ A` satisfies
`(S ⊗ ρ)(z) = z ⊗ 1`, then `z = (S ⊗ q r)(z)`, so `z ∈ S ⊗ q(A')`. -/
theorem eq_of_invariant {C : Type*} [CommRing C] [Algebra R C] (π : A →ₐ[R] C)
    (hπ : Function.Surjective π)
    (hker : RingHom.ker π ≤ Ideal.span ((q : A' → A) '' {b | counit (R := R) b = 0}))
    (hr : ∀ b x, r (q b * x) = b * r x) (hr1 : r 1 = 1)
    (S : Type*) [CommRing S] [Algebra R S] (z : S ⊗[R] A)
    (hz : ((π.toLinearMap.lTensor A) ∘ₗ comul).lTensor S z =
      (Algebra.TensorProduct.includeLeft : A →ₐ[R] A ⊗[R] C).toLinearMap.lTensor S z) :
    z = ((q : A' →ₗ[R] A) ∘ₗ r).lTensor S z := by
  set K := LinearMap.ker π.toLinearMap
  have hex : Function.Exact (K.subtype.lTensor A) (π.toLinearMap.lTensor A) :=
    _root_.lTensor_exact A (LinearMap.exact_subtype_ker_map _) hπ
  have hex2 : Function.Exact ((K.subtype.lTensor A).lTensor S)
      ((π.toLinearMap.lTensor A).lTensor S) :=
    _root_.lTensor_exact S hex (LinearMap.lTensor_surjective A hπ)
  have h0 : phi q r ∘ₗ K.subtype.lTensor A = 0 := by
    refine TensorProduct.ext' fun x y => ?_
    exact phi_tmul_eq_zero q r hr (hker y.2) x
  set inlA := (Algebra.TensorProduct.includeLeft : A →ₐ[R] A ⊗[R] A).toLinearMap
  have hinl : π.toLinearMap.lTensor A ∘ₗ inlA =
      (Algebra.TensorProduct.includeLeft : A →ₐ[R] A ⊗[R] C).toLinearMap := by
    ext a
    simp [inlA]
  set w := comul.lTensor S z - inlA.lTensor S z
  have hw : (π.toLinearMap.lTensor A).lTensor S w = 0 := by
    rw [map_sub, ← LinearMap.lTensor_comp_apply, ← LinearMap.lTensor_comp_apply, hinl, hz,
      sub_self]
  obtain ⟨u, hu⟩ := (hex2 w).mp hw
  have h1 : (phi q r).lTensor S w = 0 := by
    rw [← hu, ← LinearMap.lTensor_comp_apply, h0, LinearMap.lTensor_zero, LinearMap.zero_apply]
  have hc : phi q r ∘ₗ comul = LinearMap.id := LinearMap.ext (phi_comul q r hr1)
  have hl : phi q r ∘ₗ inlA = (q : A' →ₗ[R] A) ∘ₗ r := LinearMap.ext (phi_tmul_one q r)
  rw [map_sub, ← LinearMap.lTensor_comp_apply, ← LinearMap.lTensor_comp_apply, hc, hl,
    LinearMap.lTensor_id, LinearMap.id_apply, sub_eq_zero] at h1
  exact h1

end HopfInvariants

/-! ### Evaluation of elements of `S ⊗ A` at linear forms -/

namespace FFGroupScheme

variable {R : Type u} [CommRing R] (G : FFGroupScheme R) (S : Type*) [CommRing S] [Algebra R S]

/-- `S ⊗ F : S ⊗_R A → S`, `s ⊗ a ↦ F(a) s`. -/
def evS (F : G.A →ₗ[R] R) : S ⊗[R] G.A →ₗ[R] S :=
  (TensorProduct.rid R S).toLinearMap ∘ₗ F.lTensor S

theorem evS_tmul (F : G.A →ₗ[R] R) (s : S) (a : G.A) : G.evS S F (s ⊗ₜ a) = F a • s := by
  simp [evS]

theorem evS_lTensor (F : G.A →ₗ[R] R) (f : G.A →ₗ[R] G.A) (z : S ⊗[R] G.A) :
    G.evS S F (f.lTensor S z) = G.evS S (F ∘ₗ f) z := by
  rw [evS, evS, LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.lTensor_comp_apply]

theorem evS_one (F : G.A →ₗ[R] R) : G.evS S F 1 = algebraMap R S (F 1) := by
  rw [Algebra.TensorProduct.one_def, evS_tmul, Algebra.smul_def, mul_one]

theorem eq_sum_evS {ι : Type*} [Fintype ι] (b : Module.Basis ι R G.A) (z : S ⊗[R] G.A) :
    z = ∑ i, G.evS S (b.coord i) z ⊗ₜ b i := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul s a =>
    simp only [evS_tmul, TensorProduct.smul_tmul, ← TensorProduct.tmul_sum,
      Module.Basis.coord_apply, Module.Basis.sum_repr]
  | add x y hx hy =>
    conv_lhs => rw [hx, hy]
    simp only [map_add, TensorProduct.add_tmul, Finset.sum_add_distrib]

/-- Elements of `S ⊗ A` are determined by their values at all linear forms. -/
theorem ext_evS {z z' : S ⊗[R] G.A} (h : ∀ F, G.evS S F z = G.evS S F z') : z = z' := by
  let b := Module.Free.chooseBasis R G.A
  rw [G.eq_sum_evS S b z, G.eq_sum_evS S b z']
  simp only [h]

/-- **`χ_ψ` evaluated at `F ∈ A^∨` is `ψ(F)`.** -/
theorem evS_charOf (ψ : G.dual.points S) (F : G.A →ₗ[R] R) :
    G.evS S F (G.charOf S ψ) = ofConv ψ (toConv F) := by
  classical
  let b := Module.Free.chooseBasis R G.A
  let L : (G.A →ₗ[R] R) →ₗ[R] S := (ofConv ψ).toLinearMap ∘ₗ
    ((WithConv.linearEquiv R (G.A →ₗ[R] R)).symm.toLinearMap :
      (G.A →ₗ[R] R) →ₗ[R] G.dual.A)
  have hL : ∀ x, ofConv ψ (toConv x) = L x := fun x => rfl
  rw [charOf, pairing_eq_sum G _ b, map_sum, hL]
  conv_rhs => rw [← b.sum_dual_apply_smul_coord F, map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_smul, ← hL]
  change G.evS S F ((1 ⊗ₜ b i) * (ofConv ψ (toConv (b.coord i)) ⊗ₜ 1)) = _
  rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one, evS_tmul]

theorem map_id_apply_eq_lTensor {M N : Type*} [CommRing M] [Algebra R M] [CommRing N]
    [Algebra R N] (f : M →ₐ[R] N) (z : S ⊗[R] M) :
    Algebra.TensorProduct.map (AlgHom.id R S) f z = f.toLinearMap.lTensor S z := rfl

/-- **Invariance of characters**: if `(S ⊗ π)(χ_ψ) = 1` for an algebra map `π : A → C`, then
`χ_ψ` is invariant under the coaction `ρ = (id ⊗ π) ∘ Δ`: `(S ⊗ ρ)(χ_ψ) = χ_ψ ⊗ 1`. -/
theorem charOf_invariant {C : Type*} [CommRing C] [Algebra R C] (π : G.A →ₐ[R] C)
    (ψ : G.dual.points S) (hψ : π.toLinearMap.lTensor S (G.charOf S ψ) = 1) :
    ((π.toLinearMap.lTensor G.A) ∘ₗ comul).lTensor S (G.charOf S ψ) =
      (Algebra.TensorProduct.includeLeft : G.A →ₐ[R] G.A ⊗[R] C).toLinearMap.lTensor S
        (G.charOf S ψ) := by
  set χ := G.charOf S ψ
  let Φ := Algebra.TensorProduct.map (AlgHom.id R S)
    (Algebra.TensorProduct.map (AlgHom.id R G.A) π)
  have hc := congrArg Φ (G.charOf_comul S ψ)
  rw [map_mul] at hc
  have e1 : Φ (G.comulS S χ) = ((π.toLinearMap.lTensor G.A) ∘ₗ comul).lTensor S χ := by
    simp only [Φ, map_id_apply_eq_lTensor]
    rw [← LinearMap.lTensor_comp_apply]
    rfl
  have e2 : Φ (G.inlS S χ) =
      (Algebra.TensorProduct.includeLeft : G.A →ₐ[R] G.A ⊗[R] C).toLinearMap.lTensor S χ := by
    simp only [Φ, map_id_apply_eq_lTensor]
    rw [← LinearMap.lTensor_comp_apply]
    congr 2
    ext a
    simp
  have e3 : Φ (G.inrS S χ) = 1 := by
    have h : (Algebra.TensorProduct.map (AlgHom.id R G.A) π).toLinearMap ∘ₗ
        (Algebra.TensorProduct.includeRight : G.A →ₐ[R] G.A ⊗[R] G.A).toLinearMap =
        (Algebra.TensorProduct.includeRight : C →ₐ[R] G.A ⊗[R] C).toLinearMap ∘ₗ
          π.toLinearMap := by
      ext a
      simp
    simp only [Φ, map_id_apply_eq_lTensor]
    rw [← LinearMap.lTensor_comp_apply, h, LinearMap.lTensor_comp_apply, hψ,
      Algebra.TensorProduct.one_def, LinearMap.lTensor_tmul]
    simp [Algebra.TensorProduct.one_def]
  rw [e1, e2, e3, mul_one] at hc
  exact hc

end FFGroupScheme

/-! ### Data for the Cartier dual -/

namespace PDivGroup

open FFGroupScheme

variable {R : Type u} [CommRing R] {p : ℕ}

/-- **Freeness data for the Cartier dual of a `p`-divisible group** `G` (they hold for `F[p^∞]`,
`FormalGroup/DualPDivFGL.lean`):

* `retr v : A_{v+1} → A_v`, an `A_v`-linear retraction of `quot_v^* : A_v → A_{v+1}`;
* `res v : A_{v+1} ↠ A_1` (the closed immersion `G_1 ↪ G_{v+1}`), with kernel generated by
  `quot_v^*(ker ε)`;
* `mulP v : A_1 → A_{v+1}` with `mulP v ∘ res v = [p^v]^*` and an `R`-linear retraction
  `mulPRetr v`. -/
structure DualPDivData (G : PDivGroup R p) where
  /-- the retraction `A_{v+1} → A_v` -/
  retr : ∀ v, (G.G (v + 1)).A →ₗ[R] (G.G v).A
  retr_mul : ∀ v b x, retr v (G.quot v b * x) = b * retr v x
  retr_one : ∀ v, retr v 1 = 1
  /-- the restriction `A_{v+1} ↠ A_1` -/
  res : ∀ v, (G.G (v + 1)).A →ₐ[R] (G.G 1).A
  res_surjective : ∀ v, Function.Surjective (res v)
  ker_res : ∀ v, RingHom.ker (res v) ≤
    Ideal.span ((G.quot v : (G.G v).A → (G.G (v + 1)).A) '' {b | counit (R := R) b = 0})
  /-- `[p^v] : G_{v+1} → G_1` -/
  mulP : ∀ v, (G.G 1).A →ₗ[R] (G.G (v + 1)).A
  mulP_res : ∀ v a, mulP v (res v a) = ofConv ((G.G (v + 1)).univPt ^ (p ^ v)) a
  /-- a retraction of `mulP v` -/
  mulPRetr : ∀ v, (G.G (v + 1)).A →ₗ[R] (G.G 1).A
  mulPRetr_mulP : ∀ v c, mulPRetr v (mulP v c) = c

variable {G : PDivGroup R p}

theorem DualPDivData.retr_quot (D : DualPDivData G) (v : ℕ) (b : (G.G v).A) :
    D.retr v (G.quot v b) = b := by
  simpa [D.retr_one] using D.retr_mul v b 1

/-- **`quot_v^∨ : G_v^∨ → G_{v+1}^∨` is a closed immersion.** -/
theorem DualPDivData.dual_quot_surjective (D : DualPDivData G) (v : ℕ) :
    Function.Surjective (G.quot v).dual := by
  intro F
  refine ⟨toConv (ofConv (show Cartier.Dual R (G.G v).A from F) ∘ₗ D.retr v),
    WithConv.ofConv_injective ?_⟩
  ext b
  exact congrArg (fun a => ofConv (show Cartier.Dual R (G.G v).A from F) a) (D.retr_quot v b)

theorem DualPDivData.mulP_one (D : DualPDivData G) (v : ℕ) : D.mulP v 1 = 1 := by
  have := D.mulP_res v 1
  rwa [map_one (D.res v), map_one (ofConv ((G.G (v + 1)).univPt ^ (p ^ v)))] at this

/-- `y^{p^v} = 1` gives `(S ⊗ res_v)(χ_y) = 1`. -/
theorem DualPDivData.res_charOf (D : DualPDivData G) (v : ℕ) (S : Type u) [CommRing S]
    [Algebra R S] (y : (G.G (v + 1)).dual.points S) (hy : y ^ (p ^ v) = 1) :
    (D.res v).toLinearMap.lTensor S ((G.G (v + 1)).charOf S y) = 1 := by
  have h1 : (ofConv ((G.G (v + 1)).univPt ^ (p ^ v))).toLinearMap.lTensor S
      ((G.G (v + 1)).charOf S y) = 1 := by
    apply (G.G (v + 1)).ext_evS S
    intro F
    rw [evS_lTensor, evS_charOf, evS_one]
    have := congrArg (fun z : (G.G (v + 1)).dual.points S => ofConv z (toConv F)) hy
    rw [pow_apply_univPt, dual_univPt_pow_apply] at this
    rw [this, AlgHom.convOne_apply]
    rfl
  have h2 : (D.mulP v).lTensor S ((D.res v).toLinearMap.lTensor S ((G.G (v + 1)).charOf S y)) =
      (D.mulP v).lTensor S 1 := by
    rw [← LinearMap.lTensor_comp_apply,
      show D.mulP v ∘ₗ (D.res v).toLinearMap =
          (ofConv ((G.G (v + 1)).univPt ^ (p ^ v))).toLinearMap from
        LinearMap.ext (D.mulP_res v), h1, Algebra.TensorProduct.one_def,
      Algebra.TensorProduct.one_def, LinearMap.lTensor_tmul, D.mulP_one]
  have hinj : Function.Injective ((D.mulP v).lTensor S) := by
    intro a b hab
    have := congrArg ((D.mulPRetr v).lTensor S) hab
    rwa [← LinearMap.lTensor_comp_apply, ← LinearMap.lTensor_comp_apply,
      show D.mulPRetr v ∘ₗ D.mulP v = LinearMap.id from LinearMap.ext (D.mulPRetr_mulP v),
      LinearMap.lTensor_id, LinearMap.id_apply, LinearMap.id_apply] at this
  exact hinj h2

/-- **Kernel condition for `G^∨`**: a point of `G_{v+1}^∨(S)` killed by `p^v` comes from
`G_v^∨(S)`. -/
theorem DualPDivData.exists_dual_quot_eq (D : DualPDivData G) (v : ℕ) (S : Type u) [CommRing S]
    [Algebra R S] (y : (G.G (v + 1)).dual.points S) (hy : y ^ (p ^ v) = 1) :
    ∃ x, (G.quot v).dual.mapPoints S x = y := by
  set χ := (G.G (v + 1)).charOf S y
  have hres := D.res_charOf v S y hy
  have hinv := (G.G (v + 1)).charOf_invariant S (D.res v) y hres
  have hχ := HopfInvariants.eq_of_invariant (G.quot v) (D.retr v) (D.res v)
    (D.res_surjective v) (D.ker_res v) (D.retr_mul v) (D.retr_one v) S χ hinv
  set π : (G.G (v + 1)).dual.A →ₐ[R] (G.G v).dual.A :=
    ((G.quot v).dual : (G.G (v + 1)).dual.A →ₐ[R] (G.G v).dual.A)
  have hyJ : RingHom.ker π.toRingHom ≤ RingHom.ker (ofConv y).toRingHom := by
    intro F hF
    have hF' : ofConv F ∘ₗ (G.quot v : (G.G v).A →ₗ[R] (G.G (v + 1)).A) = 0 := by
      ext b
      exact congrArg (fun F' : (G.G v).dual.A => ofConv F' b) (RingHom.mem_ker.mp hF)
    rw [RingHom.mem_ker]
    change ofConv y (toConv (ofConv F)) = 0
    rw [← evS_charOf]
    change (G.G (v + 1)).evS S _ χ = 0
    rw [hχ, evS_lTensor, ← LinearMap.comp_assoc, hF', LinearMap.zero_comp]
    simp [evS]
  refine ⟨toConv (AlgHom.liftOfSurjective π (D.dual_quot_surjective v) (ofConv y) hyJ), ?_⟩
  apply WithConv.ofConv_injective
  exact AlgHom.liftOfSurjective_comp π (D.dual_quot_surjective v) (ofConv y) hyJ

variable [Nontrivial R] (D : DualPDivData G)

/-- **The Cartier dual `p`-divisible group** `G^∨ = (G_v^∨, quot_v^∨)` of a `p`-divisible group
with `DualPDivData`. -/
def dualPDivOf : PDivGroup R p where
  height := G.height
  G v := (G.G v).dual
  order_eq v := by rw [FFGroupScheme.order_dual, G.order_eq]
  incl v := (G.quot v).dual
  incl_surjective v := D.dual_quot_surjective v
  range_eq v S _ _ y := by
    constructor
    · rintro ⟨x, rfl⟩
      rw [← map_pow, (G.G v).dual.pow_eq_one_of_univPt (G.dual_univPt_pow_eq_one v) x, map_one]
    · exact D.exists_dual_quot_eq v S y

@[simp] theorem dualPDivOf_G (v : ℕ) : (dualPDivOf D).G v = (G.G v).dual := rfl

@[simp] theorem dualPDivOf_height : (dualPDivOf D).height = G.height := rfl

theorem dualPDivOf_incl (v : ℕ) : (dualPDivOf D).incl v = (G.quot v).dual := rfl

/-- **`|G_v^∨| = p^{hv}`.** -/
theorem order_dualPDivOf (v : ℕ) : ((dualPDivOf D).G v).order = p ^ (G.height * v) :=
  (dualPDivOf D).order_eq v

/-- **`T_p(G^∨) = lim_v G_v^∨` along `i_v^∨`** (the second argument `DualTate G` of the Cartier
pairing on Tate modules). -/
theorem tateModule_dualPDivOf [NeZero p] (S : Type u) [CommRing S] [Algebra R S] :
    (dualPDivOf D).TateModule S = G.DualTate S := by
  ext y
  constructor
  · intro hy v
    apply (dualPDivOf D).mapPoints_injective v S
    change (G.quot v).dual.mapPoints S (y v) =
      (G.quot v).dual.mapPoints S ((G.incl v).dual.mapPoints S (y (v + 1)))
    rw [G.dual_quot_incl]
    exact hy v
  · intro hy v
    change (G.quot v).dual.mapPoints S (y v) = y (v + 1) ^ p
    rw [hy v, G.dual_quot_incl]
    rfl

end PDivGroup

/-! ### Compatibility with base change to a field `F` (e.g. `ℚ_p`, `K'`) -/

namespace PDivGroup

open FFGroupScheme

variable {R : Type} [CommRing R] [Nontrivial R] {p : ℕ} [hp : Fact p.Prime]
  (F : Type) [Field F] [CharZero F] [Algebra F (PadicAlgCl p)] [Algebra R F]
  {G : PDivGroup R p} (D : DualPDivData G) (T : Type) [CommRing T] [Algebra R T]
  [Algebra F T] [IsScalarTower R F T]

/-- **Levelwise**: `(G_v^∨)_F(T) ≃* ((G_v)_F)^∨(T)` (both are `G_v^∨(T)`). -/
def dualPDivOfBaseChangePointsEquiv (v : ℕ) :
    (((dualPDivOf D).baseChange F).G v).points T ≃*
      (((G.baseChange F).dualPDiv).G v).points T :=
  ((G.G v).dual.baseChangePointsEquiv T).trans
    ((G.G v).dualBaseChangePointsEquiv (S := F) (T := T)).symm

/-- **Cartier duality commutes with base change to `F`** on Tate modules:
`T_p((G^∨)_F)(T) ≃* T_p((G_F)^∨)(T)`, both identified with `T_p(G^∨)(T) = DualTate G T`
(`baseChangeTateEquiv`, `tateModule_dualPDivOf`, `dualTateBaseChangeEquiv`,
`tateModule_dualPDiv`). -/
def dualPDivOfBaseChangeTateEquiv :
    ((dualPDivOf D).baseChange F).TateModule T ≃*
      ((G.baseChange F).dualPDiv).TateModule T :=
  (((dualPDivOf D).baseChangeTateEquiv T).trans
    (MulEquiv.subgroupCongr (tateModule_dualPDivOf D T))).trans
    (((G.dualTateBaseChangeEquiv (S := F) T).symm).trans
      (MulEquiv.subgroupCongr ((G.baseChange F).tateModule_dualPDiv T).symm))

theorem dualPDivOfBaseChangeTateEquiv_apply (x : ((dualPDivOf D).baseChange F).TateModule T)
    (v : ℕ) :
    ((dualPDivOfBaseChangeTateEquiv F D T x : ((G.baseChange F).dualPDiv).TateModule T) :
      (v : ℕ) → (((G.baseChange F).dualPDiv).G v).points T) v =
      dualPDivOfBaseChangePointsEquiv F D T v ((x : (v : ℕ) →
        (((dualPDivOf D).baseChange F).G v).points T) v) := rfl

end PDivGroup

end PadicHodge
