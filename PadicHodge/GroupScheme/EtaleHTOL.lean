import PadicHodge.FormalGroup.OLFrob
import PadicHodge.GroupScheme.EtaleHT

/-!
# `V_p G` is Hodge–Tate of weight `0` for étale `p`-divisible groups over `O_{K'}`

The analogue of `GroupScheme/EtaleHT.lean` over the ring of integers `O_L = O_{K'}` (`OL L`) of a
finite extension `L = K'` of `ℚ_p` inside `ℚ̄_p`, with `G_L = Gal(ℚ̄_p/L)` in place of
`Gal(ℚ̄_p/ℚ_p)` and a uniformiser `π_L` in place of `p`.

Points of finite étale `O_L`-algebras (`OL.*` and `PDivGroup.*Et` lemmas below):

* `norm_le_one_et`: `R`-algebra maps `B → ℚ̄_p` from integral `O_L`-algebras land in `|z| ≤ 1`;
* `frob_et`: for `B` finite free étale over `O_L`, `φ(b)^{p^N} − φ(b) = π_L φ(c)` (Frobenius is
  periodic on `B / π_L B`, `Hilbert90.exists_frobenius_period_local`, since `κ_L` is finite,
  `OL.instFiniteResidueField`);
* `algHom_eq_et`: two such maps which are congruent modulo `m_{ℚ̄_p}` agree.

For a `p`-divisible group `G` over `O_L` with étale layers:

* `coordFieldOL G k = L(G_w(ℚ̄_p), w ≤ k)`, the field generated over `L` by the coordinates of
  the points of the layers `G_w`, `w ≤ k`; it is finite over `L` and `G_L`-stable, unramified
  relative to `π_L` and rigid (`isUnrStableOver_coordFieldOL`, via
  `Hilbert90.isUnrStableOver_adjoin`);
* `tateMatrixOL_fix`: the matrix of `σ ∈ G_L` on `T_p G` (in a basis adapted to the levels) is
  `≡ 1 mod p^k`, hence `mod π_L^k`, on `Gal(ℚ̄_p/coordFieldOL G k)`;
* **`isHodgeTate_tateRepOver_of_etale_OL`**: by Hilbert 90 for the completed unramified tower over
  `L` (`Hilbert90.exists_hilbert90_over`), `V_p(G_L)` is Hodge–Tate as a `G_L`-representation
  with all `h` Hodge–Tate weights equal to `0`.
-/

noncomputable section

open WithConv TensorProduct IsLocalRing PadicHodge.Hilbert90

namespace PadicHodge

variable {p : ℕ} [hp : Fact p.Prime] {L : IntermediateField ℚ_[p] (PadicAlgCl p)}

local notation "K" => PadicAlgCl p

local instance instNormalL : Normal L (PadicAlgCl p) :=
  Normal.tower_top_of_normal ℚ_[p] L (PadicAlgCl p)

namespace OL

/-! ### Points of finite étale `O_L`-algebras -/

theorem norm_le_one_et {B : Type*} [CommRing B] [Algebra (OL L) B] [Algebra.IsIntegral (OL L) B]
    (φ : B →ₐ[OL L] PadicAlgCl p) (b : B) : ‖φ b‖ ≤ 1 :=
  norm_le_one_of_isIntegral norm_algebraMap_le_one φ (Algebra.IsIntegral.isIntegral b)

variable [FiniteDimensional ℚ_[p] L]

/-- **Frobenius periodicity modulo `π_L`** on finite free étale `O_L`-algebras. -/
theorem exists_frobenius_period_et (B : Type*) [CommRing B] [Algebra (OL L) B]
    [Module.Free (OL L) B] [Module.Finite (OL L) B] [Algebra.Etale (OL L) B] :
    ∃ N, 0 < N ∧ ∀ a : B, ∃ b : B, a ^ (p ^ N) - a = algebraMap (OL L) B (uniformizer L) * b :=
  exists_frobenius_period_local p_mem (uniformizer L) maximalIdeal_eq B

theorem frob_et {B : Type*} [CommRing B] [Algebra (OL L) B] {N : ℕ}
    {a b : B} (hab : a ^ (p ^ N) - a = algebraMap (OL L) B (uniformizer L) * b)
    (φ : B →ₐ[OL L] PadicAlgCl p) :
    φ a ^ (p ^ N) - φ a = algebraMap L (PadicAlgCl p) (uniformizerL L) * φ b := by
  have h := congrArg φ hab
  rwa [map_sub, map_pow, map_mul, AlgHom.commutes] at h

end OL

namespace PDivGroup

variable [FiniteDimensional ℚ_[p] L] (G : PDivGroup (OL L) p)

/-! ### The field generated by the points over `L` -/

/-- The coordinates of the points of the layers `G_w`, `w ≤ k`. -/
def coordSetOL (k : ℕ) : Set K :=
  {z | ∃ w ≤ k, ∃ φ : (G.G w).A →ₐ[OL L] K, ∃ a, φ a = z}

/-- The field generated over `L` by the points of the layers `G_w`, `w ≤ k`. -/
def coordFieldOL (k : ℕ) : IntermediateField L K :=
  IntermediateField.adjoin L (G.coordSetOL k)

omit [FiniteDimensional ℚ_[p] L] in
theorem coordSetOL_mono (k : ℕ) : G.coordSetOL k ⊆ G.coordSetOL (k + 1) := by
  rintro _ ⟨w, hw, φ, a, rfl⟩
  exact ⟨w, hw.trans (Nat.le_succ k), φ, a, rfl⟩

omit [FiniteDimensional ℚ_[p] L] in
theorem coordFieldOL_mono (k : ℕ) : G.coordFieldOL k ≤ G.coordFieldOL (k + 1) :=
  IntermediateField.adjoin.mono _ _ _ (G.coordSetOL_mono k)

omit [FiniteDimensional ℚ_[p] L] in
theorem gal_mem_coordSetOL (σ : K ≃ₐ[L] K) {k : ℕ} {z : K} (hz : z ∈ G.coordSetOL k) :
    σ z ∈ G.coordSetOL k := by
  obtain ⟨w, hw, φ, a, rfl⟩ := hz
  exact ⟨w, hw, ((σ : K →ₐ[L] K).restrictScalars (OL L)).comp φ, a, rfl⟩

omit [FiniteDimensional ℚ_[p] L] in
theorem norm_le_one_of_mem_coordSetOL {k : ℕ} {z : K} (hz : z ∈ G.coordSetOL k) : ‖z‖ ≤ 1 := by
  obtain ⟨w, -, φ, a, rfl⟩ := hz
  exact OL.norm_le_one_et φ a

omit [FiniteDimensional ℚ_[p] L] in
theorem finite_algHom_OL (w : ℕ) : Finite ((G.G w).A →ₐ[OL L] K) := by
  have h1 : Nat.card ((G.G w).points K) ≠ 0 := by
    rw [G.card_points_sepClosed K Hilbert90.p_ne_zero w]
    exact pow_ne_zero _ hp.out.ne_zero
  have h2 : Finite ((G.G w).points K) := Nat.finite_of_card_ne_zero h1
  exact Finite.of_equiv _ (WithConv.equiv ((G.G w).A →ₐ[OL L] K))

instance : Algebra.IsAlgebraic L K :=
  Algebra.IsAlgebraic.extendScalars (algebraMap ℚ_[p] L).injective

omit [FiniteDimensional ℚ_[p] L] in
theorem finiteDimensional_coordFieldOL (k : ℕ) : FiniteDimensional L (G.coordFieldOL k) := by
  classical
  let bas := fun w => Module.Free.chooseBasis (OL L) (G.G w).A
  let F : Set K := ⋃ w ∈ Finset.range (k + 1), ⋃ φ : (G.G w).A →ₐ[OL L] K,
    Set.range fun i => φ (bas w i)
  have hF : F.Finite := by
    refine Set.Finite.biUnion (Finset.finite_toSet _) fun w _ => ?_
    haveI := G.finite_algHom_OL w
    exact Set.finite_iUnion fun φ => Set.finite_range _
  have hFS : F ⊆ G.coordSetOL k := by
    intro z hz
    simp only [F, Set.mem_iUnion, Finset.mem_range, Set.mem_range] at hz
    obtain ⟨w, hw, φ, i, rfl⟩ := hz
    exact ⟨w, by omega, φ, _, rfl⟩
  have hSF : G.coordSetOL k ⊆ IntermediateField.adjoin L F := by
    rintro _ ⟨w, hw, φ, a, rfl⟩
    rw [← (bas w).sum_repr a, map_sum]
    refine IntermediateField.sum_mem _ fun i _ => ?_
    rw [map_smul, Algebra.smul_def, IsScalarTower.algebraMap_apply (OL L) L K]
    refine IntermediateField.mul_mem _ (IntermediateField.algebraMap_mem _ _) ?_
    refine IntermediateField.subset_adjoin _ _ ?_
    simp only [F, Set.mem_iUnion, Finset.mem_range, Set.mem_range]
    exact ⟨w, by omega, φ, i, rfl⟩
  have heq : G.coordFieldOL k = IntermediateField.adjoin L F :=
    le_antisymm (IntermediateField.adjoin_le_iff.mpr hSF)
      (IntermediateField.adjoin.mono _ _ _ hFS)
  rw [heq]
  haveI : Finite F := hF.to_subtype
  exact IntermediateField.finiteDimensional_adjoin fun x _ =>
    (Algebra.IsAlgebraic.isAlgebraic x).isIntegral

variable {G} (hG : ∀ v, (G.G v).IsEtale)

include hG in
theorem frobClosedOver_coordSetOL (k : ℕ) :
    FrobClosedOver L (OL.uniformizerL L) (G.coordSetOL k) := by
  rintro _ ⟨w, hw, φ, a, rfl⟩
  haveI : Algebra.Etale (OL L) (G.G w).A := hG w
  obtain ⟨N, hN, hper⟩ := OL.exists_frobenius_period_et (L := L) (G.G w).A
  obtain ⟨b, hb⟩ := hper a
  exact ⟨N, hN, φ b, Algebra.subset_adjoin (Or.inl ⟨w, hw, φ, b, rfl⟩), OL.frob_et hb φ⟩

include hG in
/-- **The fields `coordFieldOL G k` are `G_L`-stable, unramified relative to `π_L` and
rigid.** -/
theorem isUnrStableOver_coordFieldOL (k : ℕ) :
    IsUnrStableOver L (OL.uniformizerL L) (G.coordFieldOL k) :=
  isUnrStableOver_adjoin OL.uniformizerL_ne_zero OL.norm_uniformizerL_lt_one
    (OL.frobPeriodicMod L) (fun _ h => G.norm_le_one_of_mem_coordSetOL h)
    (frobClosedOver_coordSetOL hG k) (fun σ _ hz => G.gal_mem_coordSetOL σ hz)
    (fun σ hσ => by
      rintro _ ⟨w, hw, φ, a, rfl⟩
      haveI : Algebra.Etale (OL L) (G.G w).A := hG w
      have h1 := algHom_eq_of_norm_sub_lt_one φ
        (((σ : K →ₐ[L] K).restrictScalars (OL L)).comp φ) (OL.norm_le_one_et φ)
        (fun b => by
          rw [norm_sub_rev]
          exact hσ _ ⟨w, hw, φ, b, rfl⟩)
      exact (DFunLike.congr_fun h1 a).symm)

/-! ### The matrix of the Galois action on `T_p G` -/

variable (G)

omit [FiniteDimensional ℚ_[p] L] in
/-- `σ ∈ G_L` fixing `coordFieldOL G k` fixes the level-`k` points of the generic fibre. -/
theorem galTate_level_eq_OL {k : ℕ} (σ : K ≃ₐ[L] K) (hσ : ∀ z ∈ G.coordFieldOL k, σ z = z)
    (x : (G.baseChange L).TateModule K) :
    ((G.baseChange L).galTate σ x).1 k = x.1 k := by
  apply WithConv.ofConv_injective
  set φ : L ⊗[OL L] (G.G k).A →ₐ[L] K := ofConv (x.1 k)
  change (σ : K →ₐ[L] K).comp φ = φ
  refine Algebra.TensorProduct.ext (Subsingleton.elim _ _) (AlgHom.ext fun a => ?_)
  exact hσ _ (IntermediateField.subset_adjoin _ _
    ⟨k, le_rfl, (φ.restrictScalars (OL L)).comp Algebra.TensorProduct.includeRight, a, rfl⟩)

local instance : NeZero p := ⟨hp.out.ne_zero⟩

omit [FiniteDimensional ℚ_[p] L] in
/-- A `ℤ_p`-basis of `T_p G(ℚ̄_p)` adapted to the levels, with its coordinate system. -/
theorem exists_tateBasis_lin_OL : ∃ (t : Fin (G.baseChange L).height →
      (G.baseChange L).TateModule K)
    (e : (Fin (G.baseChange L).height → ℤ_[p]) ≃ₗ[ℤ_[p]]
      Additive ((G.baseChange L).TateModule K)),
    (∀ v, Function.Bijective ((G.baseChange L).phiLevel K t v)) ∧
      ∀ c, e c = (G.baseChange L).phiLin K t c := by
  obtain ⟨t, hlev, hphi⟩ := (G.baseChange L).exists_tateBasis
  refine ⟨t, LinearEquiv.ofBijective ((G.baseChange L).phiLin _ t)
    ⟨fun c c' h => ?_, fun x => ?_⟩, hlev, fun c => rfl⟩
  · have := hphi.1 (congrArg Additive.toMul h)
    exact Multiplicative.ofAdd.injective this
  · obtain ⟨c, hc⟩ := hphi.2 (Additive.toMul x)
    exact ⟨Multiplicative.toAdd c, congrArg Additive.ofMul hc⟩

/-- The matrix of `σ ∈ G_L` acting on `T_p G(ℚ̄_p)` in a `ℤ_p`-basis `bT`. -/
def tateMatrixOL {h : ℕ} (bT : Module.Basis (Fin h) ℤ_[p]
    (Additive ((G.baseChange L).TateModule K))) :
    (K ≃ₐ[L] K) →* Matrix (Fin h) (Fin h) ℤ_[p] where
  toFun σ := LinearMap.toMatrix bT bT ((G.baseChange L).galLin σ)
  map_one' := by
    have : (G.baseChange L).galLin 1 = LinearMap.id := LinearMap.ext fun x => rfl
    rw [this, LinearMap.toMatrix_id]
  map_mul' σ τ := by
    have : (G.baseChange L).galLin (σ * τ) =
        (G.baseChange L).galLin σ ∘ₗ (G.baseChange L).galLin τ :=
      LinearMap.ext fun x => rfl
    rw [this, LinearMap.toMatrix_comp bT bT bT]

omit [FiniteDimensional ℚ_[p] L] in
/-- **`A(σ) ≡ 1 mod p^k` on `Gal(ℚ̄_p / coordFieldOL G k)`.** -/
theorem tateMatrixOL_fix (t : Fin (G.baseChange L).height → (G.baseChange L).TateModule K)
    (e : (Fin (G.baseChange L).height → ℤ_[p]) ≃ₗ[ℤ_[p]]
      Additive ((G.baseChange L).TateModule K))
    (hlev : ∀ v, Function.Bijective ((G.baseChange L).phiLevel K t v))
    (he : ∀ c, e c = (G.baseChange L).phiLin K t c) (k : ℕ) (ν : K ≃ₐ[L] K)
    (hν : ∀ z ∈ G.coordFieldOL k, ν z = z) (i j : Fin (G.baseChange L).height) :
    ‖G.tateMatrixOL ((Pi.basisFun ℤ_[p] _).map e) ν i j -
      (1 : Matrix (Fin (G.baseChange L).height) _ ℤ_[p]) i j‖ ≤ ‖(p : ℤ_[p])‖ ^ k := by
  classical
  set bT := (Pi.basisFun ℤ_[p] (Fin (G.baseChange L).height)).map e
  set c := e.symm ((G.baseChange L).galLin ν (bT j))
  have hA : G.tateMatrixOL bT ν i j = c i := by
    simp [tateMatrixOL, LinearMap.toMatrix_apply, bT, c]
  have hbT : bT j = e (Pi.single j 1) := by simp [bT]
  have hlevel : (Additive.toMul (e c)).1 k = (Additive.toMul (e (Pi.single j 1))).1 k := by
    rw [LinearEquiv.apply_symm_apply, ← hbT]
    exact G.galTate_level_eq_OL ν hν _
  rw [he, he] at hlevel
  change ((G.baseChange L).phi K t (Multiplicative.ofAdd c)).1 k =
    ((G.baseChange L).phi K t (Multiplicative.ofAdd (Pi.single j 1))).1 k at hlevel
  rw [phi_apply, phi_apply] at hlevel
  have h1 := congrFun (congrArg Multiplicative.toAdd ((hlev k).1 hlevel)) i
  simp only [toAdd_ofAdd] at h1
  rw [← sub_eq_zero, ← map_sub, ← RingHom.mem_ker, PadicInt.ker_toZModPow,
    ← PadicInt.norm_le_pow_iff_mem_span_pow] at h1
  rw [hA, Matrix.one_apply]
  have h2 : (Pi.single j (1 : ℤ_[p]) : Fin (G.baseChange L).height → ℤ_[p]) i =
      if i = j then 1 else 0 := by
    rw [Pi.single_apply]
  rw [← h2, PadicInt.norm_p, inv_pow, ← zpow_natCast, ← zpow_neg]
  exact h1

/-- `|p| ≤ |π_L|`. -/
theorem norm_p_le_norm_uniformizerL :
    ‖(p : K)‖ ≤ ‖algebraMap L K (OL.uniformizerL L)‖ := by
  have h := norm_le_of_frobPeriodicMod (OL.frobPeriodicMod L) (c := (p : L))
    (by rw [map_natCast]; exact norm_p_lt_one)
  rwa [map_natCast] at h

variable {G} in
include hG in
/-- **`V_p(G_L)` is Hodge–Tate with all Hodge–Tate weights `0`** as a representation of
`G_L = Gal(ℚ̄_p/L)`, for a `p`-divisible group `G` over `O_L` with étale layers (Hilbert 90 for
the completed maximal unramified extension of `L`). -/
theorem isHodgeTate_tateRepOver_of_etale_OL :
    IsHodgeTate (G.baseChange L).tateRepOver ∧
      (htWeights (G.baseChange L).tateRepOver).count 0 = G.height := by
  obtain ⟨t, e, hlev, he⟩ := G.exists_tateBasis_lin_OL
  set bT := (Pi.basisFun ℤ_[p] (Fin (G.baseChange L).height)).map e
  set A := G.tateMatrixOL bT
  haveI : ∀ k, FiniteDimensional L (G.coordFieldOL k) := G.finiteDimensional_coordFieldOL
  obtain ⟨X, hX, hXinv⟩ := exists_hilbert90_over (A := A) (Mk := G.coordFieldOL)
    OL.uniformizerL_ne_zero OL.norm_uniformizerL_lt_one (isUnrStableOver_coordFieldOL hG)
    G.coordFieldOL_mono (fun k ν hν i j => by
      have := G.tateMatrixOL_fix t e hlev he k ν hν i j
      rw [norm_p_padicInt_eq] at this
      have h1 : ‖A ν i j - (1 : Matrix (Fin (G.baseChange L).height) _ ℤ_[p]) i j‖ =
          ‖algebraMap ℤ_[p] K (A ν i j) -
            (1 : Matrix (Fin (G.baseChange L).height) _ K) i j‖ := by
        rw [← norm_algebraMap_padicInt, map_sub, Matrix.one_apply, Matrix.one_apply]
        split_ifs <;> simp
      rw [Matrix.sub_apply, AK, Matrix.map_apply, ← h1]
      exact this.trans (pow_le_pow_left₀ (norm_nonneg _) (norm_p_le_norm_uniformizerL (L := L)) k))
  have key := isHodgeTate_of_matrix (G.baseChange L).tateRepOver
    (Algebra.TensorProduct.basis ℚ_[p] bT) X hX (fun σ => by
      have h1 : LinearMap.toMatrix (Algebra.TensorProduct.basis ℚ_[p] bT)
          (Algebra.TensorProduct.basis ℚ_[p] bT) ((G.baseChange L).tateRepOver σ) =
          (A σ).map (algebraMap ℤ_[p] ℚ_[p]) :=
        LinearMap.toMatrix_baseChange _ _ _ _
      rw [h1, Matrix.map_map]
      have h2 : (algebraMap ℚ_[p] ℂ_[p]) ∘ (algebraMap ℤ_[p] ℚ_[p]) =
          toCp ∘ algebraMap ℤ_[p] K := by
        funext a
        simp only [Function.comp_apply, UniformSpace.Completion.algebraMap_def,
          IsScalarTower.algebraMap_apply ℤ_[p] ℚ_[p] K]
        rfl
      rw [h2, ← Matrix.map_map]
      exact hXinv σ)
  rw [finrank_tateRep] at key
  exact key

end PDivGroup

end PadicHodge
