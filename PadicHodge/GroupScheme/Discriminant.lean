import Mathlib.RingTheory.Discriminant
import Mathlib.RingTheory.Trace.Basic
import Mathlib.RingTheory.TensorProduct.Free
import Mathlib.LinearAlgebra.Determinant

/-!
# Discriminant ideals of finite free algebras

For a finite free algebra `A` over a commutative ring `R`, the **discriminant ideal**
`disc(A/R) ⊆ R` (`discIdeal R A`) is generated by `det (Tr_{A/R}(a_i a_j))` for any `R`-basis
`(a_i)` of `A` (`discIdeal_eq_span_discr`: independent of the basis, since a change of basis
multiplies the discriminant by the square of a unit).

The algebraic core of [Hong, Lemma 3.5.2] (`bijective_of_discIdeal_eq`, `bijective_of_discr`): let
`R` be a domain with fraction field `K` and `α : B → A` a map of finite free `R`-algebras of the
same rank such that `K ⊗ α : K ⊗ B → K ⊗ A` is bijective. Then `α` preserves traces
(`trace_algebraMap_of_bijective_baseChange`), so `disc(α(b)) = disc(b)` for a basis `b` of `B`,
while `disc(α(b)) = det(M)^2 disc(a)` for a basis `a` of `A` and the matrix `M` of `α` (Mathlib's
`Algebra.discr_of_matrix_vecMul`). Hence if `disc(A/R) = disc(B/R) ≠ 0`, `det M` is a unit and `α`
is an isomorphism ([Hong, proof of Lemma 3.5.2]: "it suffices to show that `A_v` and `B_v` have the
same discriminant ideal").

## References

* [Hong] S. Hong, *Notes on p-adic Hodge theory*, Lemma 3.5.2 and its proof.
-/

noncomputable section

open Module Matrix TensorProduct

namespace PadicHodge

variable (R A : Type*) [CommRing R] [CommRing A] [Algebra R A]

/-- **The discriminant ideal** of a finite free `R`-algebra `A`: generated by the discriminant
of any `R`-basis (`discIdeal_eq_span_discr`). -/
def discIdeal [Module.Free R A] [Module.Finite R A] : Ideal R :=
  Ideal.span {Algebra.discr R (Module.Free.chooseBasis R A)}

variable {R A}

/-- Change of basis multiplies the discriminant by the square of a unit. -/
theorem span_discr_eq {ι : Type*} [Fintype ι] [DecidableEq ι] (b b' : Basis ι R A) :
    Ideal.span {Algebra.discr R b'} = Ideal.span {Algebra.discr R b} := by
  have h1 : (b' : ι → A) = (b : ι → A) ᵥ* (b.toMatrix b').map (algebraMap R A) := by
    funext j
    rw [vecMul, dotProduct]
    conv_lhs => rw [← b.sum_toMatrix_smul_self b' j]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_apply, Algebra.smul_def, mul_comm]
  have hu : IsUnit (b.toMatrix b').det := by
    have := (Basis.invertibleToMatrix b b')
    exact (Matrix.isUnit_iff_isUnit_det _).mp (isUnit_of_invertible _)
  rw [h1, Algebra.discr_of_matrix_vecMul]
  exact Ideal.span_singleton_mul_left_unit (hu.pow 2) _

/-- **The discriminant ideal is the span of the discriminant of any basis.** -/
theorem discIdeal_eq_span_discr [Nontrivial R] [Module.Free R A] [Module.Finite R A]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (b : Basis ι R A) :
    discIdeal R A = Ideal.span {Algebra.discr R b} := by
  classical
  let c := Module.Free.chooseBasis R A
  let e : Module.Free.ChooseBasisIndex R A ≃ ι := c.indexEquiv b
  have h1 : Algebra.discr R (b.reindex e.symm) = Algebra.discr R b := by
    rw [Basis.coe_reindex]
    exact Algebra.discr_reindex R b e.symm
  rw [discIdeal, span_discr_eq (b.reindex e.symm) c, h1]

/-! ### Traces and base change -/

variable {B : Type*} [CommRing B] [Algebra R B] (K : Type*) [CommRing K] [Algebra R K]

theorem lmul_tmul_eq_baseChange (x : A) :
    Algebra.lmul K (K ⊗[R] A) (1 ⊗ₜ x) = (Algebra.lmul R A x).baseChange K := by
  refine TensorProduct.AlgebraTensorModule.ext fun c y => ?_
  simp

theorem trace_tmul [Module.Free R A] [Module.Finite R A] (x : A) :
    Algebra.trace K (K ⊗[R] A) (1 ⊗ₜ x) = algebraMap R K (Algebra.trace R A x) := by
  rw [Algebra.trace_apply, lmul_tmul_eq_baseChange, LinearMap.trace_baseChange,
    Algebra.trace_apply]

/-- **A map of finite free algebras which is bijective after `⊗ K` preserves traces** (when
`R → K` is injective). -/
theorem trace_algebraMap_of_bijective_baseChange [Module.Free R A] [Module.Finite R A]
    [Module.Free R B] [Module.Finite R B] (hK : Function.Injective (algebraMap R K))
    (α : B →ₐ[R] A)
    (hα : Function.Bijective (Algebra.TensorProduct.map (AlgHom.id K K) α)) (x : B) :
    Algebra.trace R A (α x) = Algebra.trace R B x := by
  apply hK
  rw [← trace_tmul, ← trace_tmul]
  let e : K ⊗[R] B ≃ₐ[K] K ⊗[R] A := AlgEquiv.ofBijective _ hα
  have he : e (1 ⊗ₜ x) = 1 ⊗ₜ α x := by
    simp [e, Algebra.TensorProduct.map_tmul]
  rw [← he, Algebra.trace_eq_of_algEquiv]

/-! ### The isomorphism criterion -/

/-- **The algebraic core of [Hong, Lemma 3.5.2]**: a map `α : B → A` of finite free algebras of
the same rank over a domain `R`, preserving traces, with `disc(A/R) = disc(B/R) ≠ 0`, is
bijective. -/
theorem bijective_of_discr [IsDomain R] {ι : Type*} [Fintype ι] [DecidableEq ι]
    (a : Basis ι R A) (b : Basis ι R B) (α : B →ₐ[R] A)
    (hTr : ∀ x, Algebra.trace R A (α x) = Algebra.trace R B x)
    (hd : Ideal.span {Algebra.discr R a} = Ideal.span {Algebra.discr R b})
    (h0 : Algebra.discr R b ≠ 0) : Function.Bijective α := by
  classical
  set M := a.toMatrix (α ∘ b)
  have h1 : (α ∘ b : ι → A) = (a : ι → A) ᵥ* M.map (algebraMap R A) := by
    funext j
    rw [vecMul, dotProduct]
    conv_lhs => rw [← a.sum_toMatrix_smul_self (α ∘ b) j]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_apply, Algebra.smul_def, mul_comm]
  have h2 : Algebra.discr R (α ∘ b) = Algebra.discr R b := by
    rw [Algebra.discr_def, Algebra.discr_def]
    congr 1
    ext i j
    simp only [Algebra.traceMatrix_apply, Algebra.traceForm_apply, Function.comp_apply,
      ← map_mul, hTr]
  rw [h1, Algebra.discr_of_matrix_vecMul] at h2
  -- `disc a = u · disc b`
  obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hd
  have hunit : IsUnit M.det := by
    have h4 : (M.det ^ 2 * ↑u⁻¹) * Algebra.discr R b = 1 * Algebra.discr R b :=
      calc (M.det ^ 2 * ↑u⁻¹) * Algebra.discr R b
          = (M.det ^ 2 * ↑u⁻¹) * (Algebra.discr R a * ↑u) := by rw [hu]
        _ = M.det ^ 2 * Algebra.discr R a * (↑u⁻¹ * ↑u) := by ring
        _ = 1 * Algebra.discr R b := by rw [Units.inv_mul, mul_one, h2, one_mul]
    have h5 := mul_right_cancel₀ h0 h4
    have h6 : IsUnit (M.det ^ 2) := IsUnit.of_mul_eq_one _ h5
    exact (isUnit_pow_iff two_ne_zero).mp h6
  rw [← Basis.det_apply] at hunit
  obtain ⟨hli, hsp⟩ := a.is_basis_iff_det.mpr hunit
  let a' : Basis ι R A := Basis.mk hli hsp.ge
  let φ : B ≃ₗ[R] A := b.equiv a' (Equiv.refl ι)
  have hφ : (α : B →ₗ[R] A) = φ := by
    refine b.ext fun i => ?_
    simp [φ, a']
  have : (α : B → A) = φ := by
    funext x
    exact LinearMap.congr_fun hφ x
  rw [this]
  exact φ.bijective

/-- **The algebraic core of [Hong, Lemma 3.5.2]**, with discriminant ideals: a map `α : B → A`
of finite free algebras of the same rank over a domain `R`, which becomes bijective after
`K ⊗_R -` for an `R`-algebra `K` with `R → K` injective (e.g. the fraction field), and with
`disc(A/R) = disc(B/R) ≠ 0`, is bijective. -/
theorem bijective_of_discIdeal_eq [IsDomain R] [Module.Free R A] [Module.Finite R A]
    [Module.Free R B] [Module.Finite R B] (hrank : finrank R A = finrank R B)
    (hK : Function.Injective (algebraMap R K)) (α : B →ₐ[R] A)
    (hα : Function.Bijective (Algebra.TensorProduct.map (AlgHom.id K K) α))
    (hd : discIdeal R A = discIdeal R B) (h0 : discIdeal R B ≠ ⊥) : Function.Bijective α := by
  let b := Module.finBasis R B
  let a := Module.finBasisOfFinrankEq R A hrank
  rw [discIdeal_eq_span_discr a, discIdeal_eq_span_discr b] at hd
  rw [discIdeal_eq_span_discr b, Ne, Ideal.span_singleton_eq_bot] at h0
  exact bijective_of_discr a b α (trace_algebraMap_of_bijective_baseChange K hK α hα) hd h0

end PadicHodge
