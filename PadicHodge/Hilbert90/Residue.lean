import PadicHodge.Galois.Basic
import Mathlib.LinearAlgebra.LinearIndependent.Basic
import Mathlib.RingTheory.LocalRing.ResidueField.Basic

/-!
# Hilbert 90 for unramified extensions: the finite levels

Let `M ⊆ ℚ̄_p` be a finite extension of `ℚ_p` which is stable under `Gal(ℚ̄_p/ℚ_p)`, *unramified*
in the sense that `|z| < 1` implies `|z| ≤ |p|` for `z ∈ M`, and *rigid*: an automorphism which
acts trivially on the residue field of `M` fixes `M` (`IsUnrStable`). For such `M` (in the
application: the field generated by the points of an étale group scheme over `ℤ_p`):

* `OM M = {z ∈ M | |z| ≤ 1}` is a local ring (`instIsLocalRingOM`), with residue field `κ_M`;
  every `σ ∈ Gal(ℚ̄_p/ℚ_p)` induces `resAut σ : κ_M → κ_M`;
* `resAut_injective`: distinct embeddings `M → ℚ̄_p` induce distinct maps on `κ_M`
  (rigidity), so they are linearly independent over `κ_M` (Dedekind);
* **`exists_trace_one`**: there is `b ∈ O_M` with `∑_e e(b) = 1` (sum over the embeddings
  `e : M → ℚ̄_p`, realised by lifts `liftE e ∈ Gal(ℚ̄_p/ℚ_p)`);
* **`exists_additive`** (additive Hilbert 90 modulo `p`): a function `c : Gal → O_M` which is a
  cocycle modulo `p` and is `≡ 0 mod p` on `Gal(ℚ̄_p/M)` is a coboundary modulo `p`:
  `Z − σ Z ≡ c(σ) mod p` for some `Z ∈ O_M` (`Z = ∑_e c(σ_e) σ_e(b)`).

Standard arguments (e.g. [Serre, Local Fields, Ch. X, §1], not available locally); written up
here.
-/

noncomputable section

open IsLocalRing

namespace PadicHodge

namespace Hilbert90

variable {p : ℕ} [hp : Fact p.Prime]

/-- `Gal(ℚ̄_p/ℚ_p)`. -/
abbrev GalQp (p : ℕ) [Fact p.Prime] := PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p

theorem norm_p_pos : 0 < ‖(p : PadicAlgCl p)‖ := by
  rw [norm_pos_iff]
  exact_mod_cast hp.out.ne_zero

theorem norm_p_lt_one : ‖(p : PadicAlgCl p)‖ < 1 := by
  have : ((p : ℚ_[p]) : PadicAlgCl p) = (p : PadicAlgCl p) := by simp
  rw [← this, PadicAlgCl.norm_extends, Padic.norm_p]
  exact inv_lt_one_of_one_lt₀ (by exact_mod_cast hp.out.one_lt)

variable (M : IntermediateField ℚ_[p] (PadicAlgCl p))

/-- The valuation ring `O_M = {z ∈ M | |z| ≤ 1}`. -/
def OM : Subring (PadicAlgCl p) where
  carrier := {z | z ∈ M ∧ ‖z‖ ≤ 1}
  mul_mem' := fun ha hb => ⟨M.mul_mem ha.1 hb.1, by
    rw [norm_mul]; exact mul_le_one₀ ha.2 (norm_nonneg _) hb.2⟩
  one_mem' := ⟨M.one_mem, by simp⟩
  add_mem' := fun ha hb => ⟨M.add_mem ha.1 hb.1,
    (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ha.2 hb.2)⟩
  zero_mem' := ⟨M.zero_mem, by simp⟩
  neg_mem' := fun ha => ⟨M.neg_mem ha.1, by rw [norm_neg]; exact ha.2⟩

variable {M}

theorem mem_OM {z : PadicAlgCl p} : z ∈ OM M ↔ z ∈ M ∧ ‖z‖ ≤ 1 := Iff.rfl

theorem isUnit_OM_iff (x : OM M) : IsUnit x ↔ ‖(x : PadicAlgCl p)‖ = 1 := by
  constructor
  · rintro ⟨u, rfl⟩
    have h1 : ‖((u : OM M) : PadicAlgCl p)‖ * ‖((↑u⁻¹ : OM M) : PadicAlgCl p)‖ = 1 := by
      rw [← norm_mul]
      have : ((u : OM M) : PadicAlgCl p) * ((↑u⁻¹ : OM M) : PadicAlgCl p) = 1 := by
        rw [← Subring.coe_mul, Units.mul_inv]; rfl
      rw [this, norm_one]
    have h2 := (u : OM M).2.2
    have h3 := (↑u⁻¹ : OM M).2.2
    nlinarith [norm_nonneg ((u : OM M) : PadicAlgCl p),
      norm_nonneg ((↑u⁻¹ : OM M) : PadicAlgCl p)]
  · intro h
    have hx0 : (x : PadicAlgCl p) ≠ 0 := by
      intro h0; rw [h0, norm_zero] at h; exact zero_ne_one h
    have hinv : (x : PadicAlgCl p)⁻¹ ∈ OM M :=
      ⟨M.inv_mem x.2.1, by rw [norm_inv, h, inv_one]⟩
    refine IsUnit.of_mul_eq_one (⟨_, hinv⟩ : OM M) ?_
    apply Subtype.ext
    change (x : PadicAlgCl p) * (x : PadicAlgCl p)⁻¹ = 1
    exact mul_inv_cancel₀ hx0

theorem not_isUnit_OM_iff (x : OM M) : ¬ IsUnit x ↔ ‖(x : PadicAlgCl p)‖ < 1 := by
  rw [isUnit_OM_iff]
  exact ⟨fun h => lt_of_le_of_ne x.2.2 h, fun h => h.ne⟩

instance instIsLocalRingOM : IsLocalRing (OM M) := by
  haveI : Nontrivial (OM M) := ⟨⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩⟩
  refine IsLocalRing.of_nonunits_add fun a b ha hb => ?_
  change ¬ IsUnit _ at ha hb ⊢
  rw [not_isUnit_OM_iff] at ha hb ⊢
  exact (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt ha hb)

theorem residue_eq_zero_iff (x : OM M) : residue (OM M) x = 0 ↔ ‖(x : PadicAlgCl p)‖ < 1 := by
  rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
    not_isUnit_OM_iff]

theorem residue_eq_iff (x y : OM M) :
    residue (OM M) x = residue (OM M) y ↔ ‖(x : PadicAlgCl p) - y‖ < 1 := by
  rw [← sub_eq_zero, ← map_sub, residue_eq_zero_iff]
  rfl

variable (M) in
/-- `M` is `Gal(ℚ̄_p/ℚ_p)`-stable, finite and unramified over `ℚ_p`, and automorphisms acting
trivially on its residue field fix it. -/
structure IsUnrStable : Prop where
  stable : ∀ σ : GalQp p, ∀ z ∈ M, σ z ∈ M
  unr : ∀ z ∈ M, ‖z‖ < 1 → ‖z‖ ≤ ‖(p : PadicAlgCl p)‖
  rigid : ∀ σ : GalQp p, (∀ z ∈ M, ‖z‖ ≤ 1 → ‖σ z - z‖ < 1) → ∀ z ∈ M, σ z = z

variable (hM : IsUnrStable M)

include hM in
theorem mem_OM_gal (σ : GalQp p) {z : PadicAlgCl p} (hz : z ∈ OM M) : σ z ∈ OM M :=
  ⟨hM.stable σ z hz.1, by rw [norm_aut_apply]; exact hz.2⟩

/-- `σ` acting on `O_M`. -/
def sO (σ : GalQp p) : OM M →+* OM M :=
  ((σ : PadicAlgCl p →+* PadicAlgCl p).comp (OM M).subtype).codRestrict (OM M)
    fun x => mem_OM_gal hM σ x.2

@[simp] theorem sO_coe (σ : GalQp p) (x : OM M) : (sO hM σ x : PadicAlgCl p) = σ x := rfl

instance (σ : GalQp p) : IsLocalHom (sO hM σ) := by
  refine ⟨fun a ha => ?_⟩
  rw [isUnit_OM_iff] at ha ⊢
  rwa [sO_coe, norm_aut_apply] at ha

/-- `σ` acting on the residue field `κ_M`. -/
def resAut (σ : GalQp p) : ResidueField (OM M) →+* ResidueField (OM M) :=
  ResidueField.map (sO hM σ)

theorem resAut_residue (σ : GalQp p) (x : OM M) :
    resAut hM σ (residue (OM M) x) = residue (OM M) (sO hM σ x) :=
  ResidueField.map_residue _ _

/-! ### Embeddings and their lifts -/

instance : Normal ℚ_[p] (PadicAlgCl p) := inferInstance

variable (M) in
/-- An automorphism of `ℚ̄_p` extending an embedding `M → ℚ̄_p`. -/
def liftE (e : M →ₐ[ℚ_[p]] PadicAlgCl p) : GalQp p :=
  AlgEquiv.ofBijective (e.liftNormal (PadicAlgCl p)) (AlgHom.normal_bijective ℚ_[p] _ _ _)

theorem liftE_apply (e : M →ₐ[ℚ_[p]] PadicAlgCl p) (m : M) :
    liftE M e (m : PadicAlgCl p) = e m :=
  e.liftNormal_commutes (PadicAlgCl p) m

theorem liftE_apply' (e : M →ₐ[ℚ_[p]] PadicAlgCl p) {z : PadicAlgCl p} (hz : z ∈ M) :
    liftE M e z = e ⟨z, hz⟩ :=
  liftE_apply e ⟨z, hz⟩

variable (M) in
/-- Composition with `σ` permutes the embeddings. -/
def reindex (σ : GalQp p) : (M →ₐ[ℚ_[p]] PadicAlgCl p) ≃ (M →ₐ[ℚ_[p]] PadicAlgCl p) where
  toFun e := (σ : PadicAlgCl p →ₐ[ℚ_[p]] PadicAlgCl p).comp e
  invFun e := (σ.symm : PadicAlgCl p →ₐ[ℚ_[p]] PadicAlgCl p).comp e
  left_inv e := by ext; simp
  right_inv e := by ext; simp

theorem liftE_reindex_apply (σ : GalQp p) (e : M →ₐ[ℚ_[p]] PadicAlgCl p) {z : PadicAlgCl p}
    (hz : z ∈ M) : liftE M (reindex M σ e) z = σ (liftE M e z) := by
  rw [liftE_apply' _ hz, liftE_apply' _ hz]
  rfl

/-- `σ_{σ∘e}⁻¹ σ σ_e` fixes `M`. -/
theorem fix_liftE_reindex (σ : GalQp p) (e : M →ₐ[ℚ_[p]] PadicAlgCl p) :
    ∀ z ∈ M, ((liftE M (reindex M σ e))⁻¹ * σ * liftE M e) z = z := by
  intro z hz
  change (liftE M (reindex M σ e)).symm (σ (liftE M e z)) = z
  rw [AlgEquiv.symm_apply_eq, liftE_reindex_apply σ e hz]

/-- Every `σ` is `σ_e ν` with `ν` fixing `M`, for `e = σ|_M`. -/
theorem fix_liftE_restrict (σ : GalQp p) :
    ∀ z ∈ M, ((liftE M ((σ : PadicAlgCl p →ₐ[ℚ_[p]] PadicAlgCl p).comp M.val))⁻¹ * σ) z = z := by
  intro z hz
  change (liftE M _).symm (σ z) = z
  rw [AlgEquiv.symm_apply_eq, liftE_apply' _ hz]
  rfl

include hM in
/-- **Rigidity**: distinct embeddings induce distinct maps on the residue field. -/
theorem resAut_injective :
    Function.Injective fun e : M →ₐ[ℚ_[p]] PadicAlgCl p => resAut hM (liftE M e) := by
  intro e e' h
  simp only at h
  have hclose : ∀ z ∈ M, ‖z‖ ≤ 1 →
      ‖((liftE M e')⁻¹ * liftE M e) z - z‖ < 1 := by
    intro z hz hz1
    have := congrArg (fun f => f (residue (OM M) ⟨z, hz, hz1⟩)) h
    simp only [resAut_residue] at this
    rw [residue_eq_iff, sO_coe, sO_coe] at this
    change ‖(liftE M e').symm (liftE M e z) - z‖ < 1
    rw [← norm_aut_apply (liftE M e'), map_sub, AlgEquiv.apply_symm_apply]
    exact this
  have hfix := hM.rigid _ hclose
  ext m
  have := hfix m m.2
  change (liftE M e').symm (liftE M e m) = m at this
  rw [AlgEquiv.symm_apply_eq, liftE_apply, liftE_apply] at this
  exact this

include hM in
/-- **Dedekind** over the residue field. -/
theorem linearIndependent_resAut :
    LinearIndependent (ResidueField (OM M))
      fun e : M →ₐ[ℚ_[p]] PadicAlgCl p =>
        ((resAut hM (liftE M e) : ResidueField (OM M) →* ResidueField (OM M)) :
          ResidueField (OM M) → ResidueField (OM M)) := by
  let f : (M →ₐ[ℚ_[p]] PadicAlgCl p) →
      (ResidueField (OM M) →* ResidueField (OM M)) := fun e => (resAut hM (liftE M e) :
        ResidueField (OM M) →* ResidueField (OM M))
  have hf : Function.Injective f := by
    intro e e' h
    apply resAut_injective hM
    exact RingHom.ext fun x => DFunLike.congr_fun h x
  exact (linearIndependent_monoidHom (ResidueField (OM M)) (ResidueField (OM M))).comp f hf

/-! ### Trace one -/

variable [FiniteDimensional ℚ_[p] M]

include hM in
/-- **An element of trace one**: `∑_e σ_e(b) = 1` for some `b ∈ O_M`. -/
theorem exists_trace_one : ∃ b ∈ OM M, ∑ e : M →ₐ[ℚ_[p]] PadicAlgCl p, liftE M e b = 1 := by
  classical
  set κ := ResidueField (OM M)
  -- some `z̄` with nonzero trace
  have hex : ∃ x : κ, ∑ e : M →ₐ[ℚ_[p]] PadicAlgCl p, resAut hM (liftE M e) x ≠ 0 := by
    by_contra hcon
    push Not at hcon
    have hli := linearIndependent_resAut hM
    rw [Fintype.linearIndependent_iff] at hli
    have := hli (fun _ => 1) (by
      funext x
      simp only [one_smul, Finset.sum_apply]
      exact hcon x) (IntermediateField.val M)
    exact one_ne_zero this
  obtain ⟨x, hx⟩ := hex
  obtain ⟨z, rfl⟩ := residue_surjective x
  set s : PadicAlgCl p := ∑ e : M →ₐ[ℚ_[p]] PadicAlgCl p, liftE M e z
  have hsO : s = ((∑ e : M →ₐ[ℚ_[p]] PadicAlgCl p, sO hM (liftE M e) z : OM M) :
      PadicAlgCl p) := by
    rw [← (OM M).coe_subtype, map_sum]; rfl
  have hs1 : ‖s‖ = 1 := by
    rw [hsO, ← isUnit_OM_iff, ← not_not (a := IsUnit _), ← mem_nonunits_iff,
      ← IsLocalRing.mem_maximalIdeal, ← IsLocalRing.residue_eq_zero_iff, map_sum]
    simpa only [resAut_residue] using hx
  have hs0 : s ≠ 0 := by
    intro h0; rw [h0, norm_zero] at hs1; exact zero_ne_one hs1
  have hsM : s ∈ M := M.sum_mem fun e _ => (mem_OM_gal hM _ z.2).1
  -- `s` is Galois invariant
  have hsfix : ∀ τ : GalQp p, τ s = s := by
    intro τ
    simp only [s, map_sum]
    conv_rhs => rw [← Equiv.sum_comp (reindex M τ)]
    refine Finset.sum_congr rfl fun e _ => ?_
    rw [liftE_reindex_apply τ e z.2.1]
  refine ⟨s⁻¹ * z, ⟨M.mul_mem (M.inv_mem hsM) z.2.1, ?_⟩, ?_⟩
  · rw [norm_mul, norm_inv, hs1, inv_one, one_mul]; exact z.2.2
  · simp only [map_mul, map_inv₀, hsfix, ← Finset.mul_sum]
    exact inv_mul_cancel₀ hs0

/-! ### Additive Hilbert 90 modulo `p` -/

include hM in
/-- **Additive Hilbert 90 modulo `p`**: a cocycle modulo `p` with values in `O_M`, trivial
modulo `p` on `Gal(ℚ̄_p/M)`, is a coboundary modulo `p`. -/
theorem exists_additive (c : GalQp p → PadicAlgCl p) (hc : ∀ σ, c σ ∈ OM M)
    (hcoc : ∀ σ τ, ‖c (σ * τ) - c σ - σ (c τ)‖ ≤ ‖(p : PadicAlgCl p)‖)
    (hfix : ∀ ν : GalQp p, (∀ z ∈ M, ν z = z) → ‖c ν‖ ≤ ‖(p : PadicAlgCl p)‖) :
    ∃ Z ∈ OM M, ∀ σ : GalQp p, ‖Z - σ Z - c σ‖ ≤ ‖(p : PadicAlgCl p)‖ := by
  classical
  obtain ⟨b, hb, htr⟩ := exists_trace_one hM
  set E := M →ₐ[ℚ_[p]] PadicAlgCl p
  let Z : PadicAlgCl p := ∑ e : E, c (liftE M e) * liftE M e b
  refine ⟨Z, Subring.sum_mem _ fun e _ => Subring.mul_mem _ (hc _) (mem_OM_gal hM _ hb), ?_⟩
  intro σ
  set P := ‖(p : PadicAlgCl p)‖
  -- the error terms
  let err : E → PadicAlgCl p := fun e =>
    σ (c (liftE M e)) - (c (liftE M (reindex M σ e)) - c σ)
  have herr : ∀ e, ‖err e‖ ≤ P := by
    intro e
    set ν := (liftE M (reindex M σ e))⁻¹ * σ * liftE M e
    have hν := fix_liftE_reindex σ e
    have hσe : σ * liftE M e = liftE M (reindex M σ e) * ν := by
      simp only [ν, ← mul_assoc, mul_inv_cancel, one_mul]
    have h1 := hcoc σ (liftE M e)
    have h2 := hcoc (liftE M (reindex M σ e)) ν
    rw [← hσe] at h2
    have h3 : ‖liftE M (reindex M σ e) (c ν)‖ ≤ P := by
      rw [norm_aut_apply]; exact hfix ν hν
    have : err e = -(c (σ * liftE M e) - c σ - σ (c (liftE M e))) +
        (c (σ * liftE M e) - c (liftE M (reindex M σ e)) -
          liftE M (reindex M σ e) (c ν)) + liftE M (reindex M σ e) (c ν) := by
      simp only [err]; ring
    rw [this]
    refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ h3)
    refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ h2)
    rw [norm_neg]; exact h1
  have hσZ : σ Z = Z - c σ + ∑ e : E, err e * liftE M (reindex M σ e) b := by
    have h1 : σ Z = ∑ e : E, (c (liftE M (reindex M σ e)) - c σ + err e) *
        liftE M (reindex M σ e) b := by
      simp only [Z, map_sum, map_mul]
      refine Finset.sum_congr rfl fun e _ => ?_
      rw [liftE_reindex_apply σ e hb.1]
      simp only [err]; ring
    have h2 : ∑ e : E, c (liftE M (reindex M σ e)) * liftE M (reindex M σ e) b = Z :=
      Equiv.sum_comp (reindex M σ) (fun e => c (liftE M e) * liftE M e b)
    have h3 : ∑ e : E, liftE M (reindex M σ e) b = 1 := by
      exact (Equiv.sum_comp (reindex M σ) (fun e => liftE M e b)).trans htr
    rw [h1, ← h2]
    simp only [add_mul, sub_mul, Finset.sum_add_distrib, Finset.sum_sub_distrib,
      ← Finset.mul_sum, h3, mul_one]
  rw [hσZ]
  have : Z - (Z - c σ + ∑ e : E, err e * liftE M (reindex M σ e) b) - c σ =
      -∑ e : E, err e * liftE M (reindex M σ e) b := by ring
  rw [this, norm_neg]
  refine IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg norm_p_pos.le fun e _ => ?_
  rw [norm_mul, norm_aut_apply]
  calc ‖err e‖ * ‖b‖ ≤ P * 1 := mul_le_mul (herr e) hb.2 (norm_nonneg _) norm_p_pos.le
    _ = P := mul_one P

end Hilbert90

end PadicHodge
