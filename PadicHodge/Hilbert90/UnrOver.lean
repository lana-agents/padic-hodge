import PadicHodge.GroupScheme.EtaleFrobenius

/-!
# Fields generated by Frobenius-periodic integral elements are unramified, over a base `F`

Let `F` be a field with `ℚ_p → F → ℚ̄_p` and `π ∈ F` with `0 < |π| < 1` such that Frobenius is
periodic modulo `π` on `O_F = {c ∈ F | |c| ≤ 1}` (`FrobPeriodicMod F π`; for `F = K'` finite
over `ℚ_p` and `π` a uniformiser this follows from finiteness of the residue field,
`OL.exists_frobenius_period_OL`).
Let `S ⊆ ℚ̄_p` consist of elements of absolute value `≤ 1` such that every `z ∈ S` satisfies
`z^{p^N} − z ∈ π D` for some `N ≥ 1`, where `D = ℤ_p[S ∪ O_F]` (`FrobClosedOver F π S`; in the
application `S` is the set of values of points of finite étale `O_F`-algebras). Then:

* `periodic_adjoin_over`: every `d ∈ D` satisfies `d^{p^N} − d ∈ π D` for some `N ≥ 1`;
* `norm_eq_pow_of_mem_adjoin_over`: `|d| ∈ |π|^ℕ` for `0 ≠ d ∈ D`;
* **`unr_adjoin_over`**: `|z| < 1 ⇒ |z| ≤ |π|` on `F(S)`: it is unramified relative to `π`;
* **`isUnrStableOver_adjoin`**: if moreover `S` is `G_F`-stable and rigid, `F(S)` satisfies
  `IsUnrStableOver F π`.

This generalises `unr_adjoin` (`GroupScheme/EtaleFrobenius.lean`, the case `F = ℚ_p`, `π = p`).
Standard arguments, written up here.
-/

noncomputable section

namespace PadicHodge

namespace Hilbert90

variable {p : ℕ} [hp : Fact p.Prime]

local notation "K" => PadicAlgCl p

variable (F : Type*) [Field F] [Algebra F (PadicAlgCl p)] [Algebra ℚ_[p] F]
  [IsScalarTower ℚ_[p] F (PadicAlgCl p)]

/-- `O_F = {c ∈ F | |c| ≤ 1}`, as a subset of `ℚ̄_p`. -/
def intSet : Set (PadicAlgCl p) := {z | ∃ c : F, algebraMap F (PadicAlgCl p) c = z ∧ ‖z‖ ≤ 1}

/-- Frobenius is periodic modulo `π` on `O_F`. -/
def FrobPeriodicMod (π : F) : Prop :=
  ∃ N, 0 < N ∧ ∀ c : F, ‖algebraMap F (PadicAlgCl p) c‖ ≤ 1 → ∃ e : F,
    ‖algebraMap F (PadicAlgCl p) e‖ ≤ 1 ∧
    algebraMap F (PadicAlgCl p) c ^ (p ^ N) - algebraMap F (PadicAlgCl p) c =
      algebraMap F (PadicAlgCl p) π * algebraMap F (PadicAlgCl p) e

/-- Every `z ∈ S` satisfies `z^{p^N} − z ∈ π ℤ_p[S ∪ O_F]` for some `N ≥ 1`. -/
def FrobClosedOver (π : F) (S : Set (PadicAlgCl p)) : Prop :=
  ∀ z ∈ S, ∃ N, 0 < N ∧ ∃ e ∈ Algebra.adjoin ℤ_[p] (S ∪ intSet (p := p) F),
    z ^ (p ^ N) - z = algebraMap F (PadicAlgCl p) π * e

variable {F} {π : F} (hπ0 : π ≠ 0) (hπ1 : ‖algebraMap F (PadicAlgCl p) π‖ < 1)
  (hF : FrobPeriodicMod (p := p) F π)

omit [Algebra ℚ_[p] F] [IsScalarTower ℚ_[p] F (PadicAlgCl p)] in
theorem algebraMap_mem_intSet {c : F} (hc : ‖algebraMap F K c‖ ≤ 1) :
    algebraMap F K c ∈ intSet (p := p) F := ⟨c, rfl, hc⟩

theorem algebraMap_padicInt_mem_intSet (r : ℤ_[p]) :
    algebraMap ℤ_[p] K r ∈ intSet (p := p) F := by
  refine ⟨algebraMap ℚ_[p] F r, ?_, norm_algebraMap_le_one r⟩
  rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply ℤ_[p] ℚ_[p] K]
  rfl

include hF in
omit [Algebra ℚ_[p] F] [IsScalarTower ℚ_[p] F (PadicAlgCl p)] in
/-- Elements of `𝔪_F` are divisible by `π`: `|c| < 1 ⇒ |c| ≤ |π|`. -/
theorem norm_le_of_frobPeriodicMod {c : F} (hc : ‖algebraMap F K c‖ < 1) :
    ‖algebraMap F K c‖ ≤ ‖algebraMap F K π‖ := by
  obtain ⟨N, hN, hper⟩ := hF
  obtain ⟨e, he, hce⟩ := hper c hc.le
  set x := algebraMap F K c
  rcases eq_or_ne x 0 with h0 | hx0
  · rw [h0, norm_zero]; exact norm_nonneg _
  have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx0
  have hlt : ‖x ^ (p ^ N)‖ < ‖x‖ := by
    rw [norm_pow]
    have h2 : 1 < p ^ N := Nat.one_lt_pow hN.ne' hp.out.one_lt
    calc ‖x‖ ^ (p ^ N) < ‖x‖ ^ 1 := pow_lt_pow_right_of_lt_one₀ hxpos hc h2
      _ = ‖x‖ := pow_one _
  have hnorm : ‖x ^ (p ^ N) - x‖ = ‖x‖ := by
    rw [sub_eq_add_neg, IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm (by
      rw [norm_neg]; exact hlt.ne), norm_neg]
    exact max_eq_right hlt.le
  rw [hce, norm_mul] at hnorm
  rw [← hnorm]
  calc ‖algebraMap F K π‖ * ‖algebraMap F K e‖ ≤ ‖algebraMap F K π‖ * 1 :=
        mul_le_mul_of_nonneg_left he (norm_nonneg _)
    _ = _ := mul_one _

variable {S : Set (PadicAlgCl p)} (hS1 : ∀ z ∈ S, ‖z‖ ≤ 1)

include hS1 in
omit [Algebra ℚ_[p] F] [IsScalarTower ℚ_[p] F (PadicAlgCl p)] in
theorem norm_le_one_of_mem_adjoin_over {d : K}
    (hd : d ∈ Algebra.adjoin ℤ_[p] (S ∪ intSet (p := p) F)) : ‖d‖ ≤ 1 :=
  norm_le_one_of_mem_adjoin (fun z hz => hz.elim (hS1 z) fun h => h.choose_spec.2) hd

omit [Algebra ℚ_[p] F] [IsScalarTower ℚ_[p] F (PadicAlgCl p)] in
theorem mem_adjoin_of_intSet {z : K} (hz : z ∈ intSet (p := p) F) :
    z ∈ Algebra.adjoin ℤ_[p] (S ∪ intSet (p := p) F) :=
  Algebra.subset_adjoin (Or.inr hz)

variable (hS : FrobClosedOver F π S)

include hπ1 hF hS1 hS in
/-- **Frobenius periodicity modulo `π`** on `D = ℤ_p[S ∪ O_F]`. -/
theorem periodic_adjoin_over {d : K} (hd : d ∈ Algebra.adjoin ℤ_[p] (S ∪ intSet (p := p) F)) :
    ∃ N, 0 < N ∧ ∃ e ∈ Algebra.adjoin ℤ_[p] (S ∪ intSet (p := p) F),
      d ^ (p ^ N) - d = algebraMap F K π * e := by
  set D := Algebra.adjoin ℤ_[p] (S ∪ intSet (p := p) F)
  have hπD : algebraMap F K π ∈ D := mem_adjoin_of_intSet (algebraMap_mem_intSet hπ1.le)
  set ϖ : D := ⟨_, hπD⟩
  set J : Ideal D := Ideal.span {ϖ}
  have hJ : ∀ x : D, Ideal.Quotient.mk J x = 0 ↔ ∃ e ∈ D, (x : K) = algebraMap F K π * e := by
    intro x
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton']
    constructor
    · rintro ⟨e, he⟩
      exact ⟨e, e.2, by rw [← he, Subalgebra.coe_mul, mul_comm]⟩
    · rintro ⟨e, he, hxe⟩
      exact ⟨⟨e, he⟩, Subtype.ext (by rw [Subalgebra.coe_mul, hxe, mul_comm])⟩
  have hnt : Nontrivial (D ⧸ J) := by
    rw [Ideal.Quotient.nontrivial_iff]
    intro htop
    have h1 : (1 : D) ∈ J := htop ▸ Submodule.mem_top
    rw [← Ideal.Quotient.eq_zero_iff_mem, hJ] at h1
    obtain ⟨e, he, h1e⟩ := h1
    have hn := congrArg norm h1e
    rw [OneMemClass.coe_one, norm_one, norm_mul] at hn
    have := norm_le_one_of_mem_adjoin_over hS1 he
    nlinarith [norm_nonneg (algebraMap F K π), norm_nonneg e]
  haveI : CharP (D ⧸ J) p := by
    rw [CharP.charP_iff_prime_eq_zero hp.out]
    rw [← map_natCast (Ideal.Quotient.mk J), hJ]
    -- `p = π · (p / π)` with `p / π ∈ O_F`
    have hpF : ‖algebraMap F K (p : F)‖ < 1 := by rw [map_natCast]; exact norm_p_lt_one
    have hle := norm_le_of_frobPeriodicMod hF hpF
    have hπK : algebraMap F K π ≠ 0 := by
      intro h0; rw [h0] at hle
      rw [map_natCast, norm_zero] at hle
      exact (norm_p_pos (p := p)).ne' (le_antisymm hle (norm_nonneg _))
    have hπpos : 0 < ‖algebraMap F K π‖ := norm_pos_iff.mpr hπK
    refine ⟨algebraMap F K ((p : F) / π), mem_adjoin_of_intSet (algebraMap_mem_intSet ?_), ?_⟩
    · rw [map_div₀, norm_div, div_le_one hπpos]; exact hle
    · rw [map_div₀, mul_div_cancel₀ _ hπK, map_natCast]; rfl
  suffices hQ : ∃ N, 0 < N ∧ (Ideal.Quotient.mk J ⟨d, hd⟩) ^ (p ^ N) =
      Ideal.Quotient.mk J ⟨d, hd⟩ by
    obtain ⟨N, hN, h⟩ := hQ
    rw [← map_pow, ← sub_eq_zero, ← map_sub, hJ] at h
    exact ⟨N, hN, h⟩
  have hint : ∀ z ∈ intSet (p := p) F, ∃ N, 0 < N ∧ ∃ e ∈ D, z ^ (p ^ N) - z =
      algebraMap F K π * e := by
    rintro _ ⟨c, rfl, hc⟩
    obtain ⟨N, hN, hper⟩ := hF
    obtain ⟨e, he, hce⟩ := hper c hc
    exact ⟨N, hN, _, mem_adjoin_of_intSet (algebraMap_mem_intSet he), hce⟩
  have hgen : ∀ z ∈ S ∪ intSet (p := p) F, ∃ N, 0 < N ∧ ∃ e ∈ D, z ^ (p ^ N) - z =
      algebraMap F K π * e := fun z hz => hz.elim (hS z) (hint z)
  induction hd using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨N, hN, e, he, hxe⟩ := hgen x hx
    refine ⟨N, hN, ?_⟩
    rw [← map_pow, ← sub_eq_zero, ← map_sub, hJ]
    exact ⟨e, he, hxe⟩
  | algebraMap r =>
    obtain ⟨N, hN, e, he, hxe⟩ := hint _ (algebraMap_padicInt_mem_intSet r)
    refine ⟨N, hN, ?_⟩
    rw [← map_pow, ← sub_eq_zero, ← map_sub, hJ]
    exact ⟨e, he, hxe⟩
  | add x y hx hy ihx ihy =>
    obtain ⟨N₁, hN₁, h₁⟩ := ihx
    obtain ⟨N₂, hN₂, h₂⟩ := ihy
    refine ⟨N₁ * N₂, Nat.mul_pos hN₁ hN₂, ?_⟩
    have e1 : (⟨x + y, Subalgebra.add_mem _ hx hy⟩ : D) = ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
    rw [e1, map_add, add_pow_char_pow, pow_pow_mul_eq h₁, mul_comm, pow_pow_mul_eq h₂]
  | mul x y hx hy ihx ihy =>
    obtain ⟨N₁, hN₁, h₁⟩ := ihx
    obtain ⟨N₂, hN₂, h₂⟩ := ihy
    refine ⟨N₁ * N₂, Nat.mul_pos hN₁ hN₂, ?_⟩
    have e1 : (⟨x * y, Subalgebra.mul_mem _ hx hy⟩ : D) = ⟨x, hx⟩ * ⟨y, hy⟩ := rfl
    rw [e1, map_mul, mul_pow, pow_pow_mul_eq h₁, mul_comm N₁ N₂, pow_pow_mul_eq h₂]

include hπ0 hπ1 hF hS1 hS in
/-- **Absolute values on `D` are powers of `|π|`.** -/
theorem norm_eq_pow_of_mem_adjoin_over {d : K}
    (hd : d ∈ Algebra.adjoin ℤ_[p] (S ∪ intSet (p := p) F)) (hd0 : d ≠ 0) :
    ∃ n : ℕ, ‖d‖ = ‖algebraMap F K π‖ ^ n := by
  set P := ‖algebraMap F K π‖
  have hP0 : 0 < P := norm_pos_iff.mpr ((map_ne_zero _).mpr hπ0)
  have hP1 : P < 1 := hπ1
  suffices H : ∀ j : ℕ, ∀ d ∈ Algebra.adjoin ℤ_[p] (S ∪ intSet (p := p) F), P ^ j < ‖d‖ →
      ∃ n : ℕ, ‖d‖ = P ^ n by
    obtain ⟨j, hj⟩ := exists_pow_lt_of_lt_one (norm_pos_iff.mpr hd0) hP1
    exact H j d hd hj
  intro j
  induction j with
  | zero =>
    intro d hd h
    rw [pow_zero] at h
    exact absurd (norm_le_one_of_mem_adjoin_over hS1 hd) (not_le.mpr h)
  | succ j ih =>
    intro d hd h
    rcases (norm_le_one_of_mem_adjoin_over hS1 hd).lt_or_eq with hlt | heq
    · obtain ⟨N, hN, e, he, hde⟩ := periodic_adjoin_over hπ1 hF hS1 hS hd
      have hdpos : 0 < ‖d‖ := lt_of_le_of_lt (pow_nonneg hP0.le _) h
      have hlt' : ‖d ^ (p ^ N)‖ < ‖d‖ := by
        rw [norm_pow]
        have h2 : 1 < p ^ N := Nat.one_lt_pow hN.ne' hp.out.one_lt
        calc ‖d‖ ^ (p ^ N) < ‖d‖ ^ 1 := pow_lt_pow_right_of_lt_one₀ hdpos hlt h2
          _ = ‖d‖ := pow_one _
      have hnorm : ‖d ^ (p ^ N) - d‖ = ‖d‖ := by
        rw [sub_eq_add_neg, IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm (by
          rw [norm_neg]; exact hlt'.ne), norm_neg]
        exact max_eq_right hlt'.le
      rw [hde, norm_mul] at hnorm
      have he' : P ^ j < ‖e‖ := by
        have : P ^ j * P < ‖e‖ * P := by
          rw [← pow_succ, mul_comm, hnorm]; exact h
        exact lt_of_mul_lt_mul_right this hP0.le
      obtain ⟨n, hn⟩ := ih e he he'
      exact ⟨n + 1, by rw [← hnorm, hn, pow_succ, mul_comm]⟩
    · exact ⟨0, by rw [heq, pow_zero]⟩

include hπ0 hπ1 hF hS1 hS in
/-- **The field `F(S)` is unramified relative to `π`**: `|z| < 1 ⇒ |z| ≤ |π|`. -/
theorem unr_adjoin_over {z : K} (hz : z ∈ IntermediateField.adjoin F S) (hz1 : ‖z‖ < 1) :
    ‖z‖ ≤ ‖algebraMap F K π‖ := by
  set P := ‖algebraMap F K π‖
  have hπK : algebraMap F K π ≠ 0 := (map_ne_zero _).mpr hπ0
  have hP0 : 0 < P := norm_pos_iff.mpr hπK
  have hP1 : P < 1 := hπ1
  set D := Algebra.adjoin ℤ_[p] (S ∪ intSet (p := p) F)
  have hπD : algebraMap F K π ∈ D := mem_adjoin_of_intSet (algebraMap_mem_intSet hπ1.le)
  rcases eq_or_ne z 0 with rfl | hz0
  · rw [norm_zero]; exact hP0.le
  -- `π^m z ∈ D`
  have key : ∀ w ∈ Algebra.adjoin F S, ∃ m : ℕ, algebraMap F K π ^ m * w ∈ D := by
    intro w hw
    induction hw using Algebra.adjoin_induction with
    | mem x hx =>
      exact ⟨0, by rw [pow_zero, one_mul]; exact Algebra.subset_adjoin (Or.inl hx)⟩
    | algebraMap c =>
      obtain ⟨m, hm⟩ : ∃ m : ℕ, ‖algebraMap F K π ^ m * algebraMap F K c‖ ≤ 1 := by
        rcases eq_or_ne (algebraMap F K c) 0 with hc | hc
        · exact ⟨0, by simp [hc]⟩
        obtain ⟨m, hm⟩ := exists_pow_lt_of_lt_one (inv_pos.mpr (norm_pos_iff.mpr hc)) hP1
        refine ⟨m, ?_⟩
        rw [norm_mul, norm_pow]
        have := mul_lt_mul_of_pos_right hm (norm_pos_iff.mpr hc)
        rw [inv_mul_cancel₀ (norm_pos_iff.mpr hc).ne'] at this
        exact this.le
      refine ⟨m, ?_⟩
      have h1 : algebraMap F K π ^ m * algebraMap F K c = algebraMap F K (π ^ m * c) := by
        rw [map_mul, map_pow]
      rw [h1] at hm ⊢
      exact mem_adjoin_of_intSet (algebraMap_mem_intSet hm)
    | add x y _ _ hx hy =>
      obtain ⟨m₁, h₁⟩ := hx
      obtain ⟨m₂, h₂⟩ := hy
      refine ⟨m₁ + m₂, ?_⟩
      have : algebraMap F K π ^ (m₁ + m₂) * (x + y) =
          algebraMap F K π ^ m₂ * (algebraMap F K π ^ m₁ * x) +
            algebraMap F K π ^ m₁ * (algebraMap F K π ^ m₂ * y) := by ring
      rw [this]
      exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hπD _) h₁)
        (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hπD _) h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨m₁, h₁⟩ := hx
      obtain ⟨m₂, h₂⟩ := hy
      refine ⟨m₁ + m₂, ?_⟩
      have : algebraMap F K π ^ (m₁ + m₂) * (x * y) =
          (algebraMap F K π ^ m₁ * x) * (algebraMap F K π ^ m₂ * y) := by ring
      rw [this]
      exact Subalgebra.mul_mem _ h₁ h₂
  haveI : Algebra.IsAlgebraic F K :=
    Algebra.IsAlgebraic.extendScalars (algebraMap ℚ_[p] F).injective
  have hz' : z ∈ (IntermediateField.adjoin F S).toSubalgebra := hz
  rw [IntermediateField.adjoin_toSubalgebra_of_isAlgebraic
    (fun x _ => Algebra.IsAlgebraic.isAlgebraic x)] at hz'
  obtain ⟨m, hm⟩ := key z hz'
  have hne : algebraMap F K π ^ m * z ≠ 0 := mul_ne_zero (pow_ne_zero _ hπK) hz0
  obtain ⟨n, hn⟩ := norm_eq_pow_of_mem_adjoin_over hπ0 hπ1 hF hS1 hS hm hne
  rw [norm_mul, norm_pow] at hn
  have hlt : P ^ n < P ^ m := by
    rw [← hn]
    calc P ^ m * ‖z‖ < P ^ m * 1 := mul_lt_mul_of_pos_left hz1 (pow_pos hP0 _)
      _ = P ^ m := mul_one _
  have hmn : m < n := (pow_lt_pow_iff_right_of_lt_one₀ hP0 hP1).mp hlt
  have hz' : ‖z‖ = P ^ (n - m) := by
    have h1 : P ^ n = P ^ m * P ^ (n - m) := by rw [← pow_add]; congr 1; omega
    rw [h1] at hn
    exact mul_left_cancel₀ (pow_pos hP0 _).ne' hn
  rw [hz']
  calc P ^ (n - m) ≤ P ^ 1 := pow_le_pow_of_le_one hP0.le hP1.le (by omega)
    _ = P := pow_one P

include hπ0 hπ1 hF hS1 hS in
/-- **`F(S)` is `G_F`-stable, unramified relative to `π` and rigid** if `S` is `G_F`-stable and
every element of `G_F` which moves no element of `S` by `≥ 1` fixes `S`. -/
theorem isUnrStableOver_adjoin (hstab : ∀ σ : GalOver p F, ∀ z ∈ S, σ z ∈ S)
    (hrig : ∀ σ : GalOver p F, (∀ z ∈ S, ‖σ z - z‖ < 1) → ∀ z ∈ S, σ z = z) :
    IsUnrStableOver F π (IntermediateField.adjoin F S) where
  stable σ z hz := by
    have h1 : σ z ∈ (IntermediateField.adjoin F S).map (σ : K →ₐ[F] K) :=
      (IntermediateField.map_mem_map _ _).mpr hz
    rw [IntermediateField.adjoin_map] at h1
    refine (IntermediateField.adjoin_le_iff.mpr ?_) h1
    rintro _ ⟨y, hy, rfl⟩
    exact IntermediateField.subset_adjoin _ _ (hstab σ y hy)
  unr z hz hz1 := unr_adjoin_over hπ0 hπ1 hF hS1 hS hz hz1
  rigid σ hσ := by
    have hfix : ∀ z ∈ S, σ z = z := hrig σ fun z hz =>
      hσ z (IntermediateField.subset_adjoin _ _ hz) (hS1 z hz)
    have hle : IntermediateField.adjoin F S ≤
        IntermediateField.fixedField (Subgroup.zpowers σ) := by
      refine IntermediateField.adjoin_le_iff.mpr fun z hz => ?_
      rw [SetLike.mem_coe, IntermediateField.mem_fixedField_iff]
      intro f hf
      have hσ' : σ ∈ MulAction.stabilizer (GalOver p F) z := hfix z hz
      exact (Subgroup.zpowers_le.mpr hσ') hf
    intro z hz
    exact (IntermediateField.mem_fixedField_iff _ _).mp (hle hz) σ (Subgroup.mem_zpowers σ)

end Hilbert90

end PadicHodge
