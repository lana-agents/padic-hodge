import PadicHodge.Fontaine.OLExt
import PadicHodge.Fontaine.Monogenic
import PadicHodge.FormalGroup.OLFraction
import PadicHodge.FormalGroup.OLFrob
import PadicHodge.AxSenTate.AxLemma

/-!
# `O_E` over `O_L` for finite extensions `L ⊆ E` inside `ℚ̄_p`

For finite extensions `L ⊆ E` of `ℚ_p` inside `ℚ̄_p` (with `Fact (L ≤ E)`):

* `OL.ofLE : O_L →+* O_E`, the instances `Algebra (OL L) (OL E)`, `Algebra L E`,
  `Algebra (OL L) E` and the scalar towers;
* `OL.norm_coeff_minpoly_le_one'`: for `z ∈ ℚ̄_p` with `|z| ≤ 1` the coefficients of the minimal
  polynomial of `z` over `L` have absolute value `≤ 1` (its roots are the `G_L`-conjugates of `z`,
  and the coefficients are elementary symmetric functions of the roots);
* **`OL.isIntegralClosure`**: `O_E` is the integral closure of `O_L` in `E`;
  hence **`OL.instModuleFinite`**: `O_E` is a finite `O_L`-module;
* `IsLocalHom`, separability of the residue field extension (finite fields), `𝔪_L O_E ≠ 0`;
* **`OL.exists_kaehler_cyclic'`** ([Fo, Lemme 1 (i)] for `O_E/O_L`): `O_E = O_L[b]`,
  `Ω_{O_E/O_L}` is generated by `db`, and its annihilator is the different `𝔇_{E/L}`.

## References

* [Fo] J.-M. Fontaine, *Formes différentielles et modules de Tate des variétés abéliennes sur
  les corps locaux*, Invent. Math. 65 (1982), §2.1.
-/

noncomputable section

open IsLocalRing Polynomial Module

namespace PadicHodge

variable {p : ℕ} [hp : Fact p.Prime]

namespace OL

/-! ### Conjugates and integrality over `O_L` -/

/-- The coefficients of the minimal polynomial over `L` of `z ∈ ℚ̄_p` with `|z| ≤ 1` have
absolute value `≤ 1`. -/
theorem norm_coeff_minpoly_le_one' (L : IntermediateField ℚ_[p] (PadicAlgCl p))
    {z : PadicAlgCl p} (hz : ‖z‖ ≤ 1) (n : ℕ) :
    ‖((minpoly L z).coeff n : PadicAlgCl p)‖ ≤ 1 := by
  set P := (minpoly L z).map (algebraMap L (PadicAlgCl p)) with hPdef
  have hint : IsIntegral L z := Algebra.IsIntegral.isIntegral z
  have hmon : P.Monic := (minpoly.monic hint).map _
  have hspl : P.Splits := IsAlgClosed.splits P
  have hroots : ∀ r ∈ P.roots, ‖r‖ ≤ 1 := by
    intro r hr
    have hP : P ≠ 0 := Polynomial.map_ne_zero (minpoly.ne_zero hint)
    rw [mem_roots hP, IsRoot.def, hPdef, eval_map_algebraMap] at hr
    obtain ⟨σ, rfl⟩ := exists_gal_apply_eq_of_aeval_eq_zero L hr
    rw [norm_gal_apply]; exact hz
  have hc : ((minpoly L z).coeff n : PadicAlgCl p) = P.coeff n := by
    rw [hPdef, coeff_map]; rfl
  rw [hc]
  by_cases hn : n ≤ Multiset.card P.roots
  · rw [hspl.eq_prod_roots_of_monic hmon]
    have := norm_coeff_prod_X_sub_C_le P.roots zero_le_one hroots hn
    rwa [one_pow] at this
  · push Not at hn
    rw [← hspl.natDegree_eq_card_roots] at hn
    rw [coeff_eq_zero_of_natDegree_lt hn, norm_zero]
    exact zero_le_one

/-- `z ∈ ℚ̄_p` with `|z| ≤ 1` is integral over `O_L`. -/
theorem isIntegral_of_norm_le_one (L : IntermediateField ℚ_[p] (PadicAlgCl p))
    {z : PadicAlgCl p} (hz : ‖z‖ ≤ 1) : IsIntegral (OL L) z := by
  have hint : IsIntegral L z := Algebra.IsIntegral.isIntegral z
  have hl : minpoly L z ∈ lifts (algebraMap (OL L) L) := by
    rw [lifts_iff_coeff_lifts]
    intro n
    exact ⟨ofL _ (norm_coeff_minpoly_le_one' L hz n), Subtype.val_injective (algebraMap_ofL _ _)⟩
  obtain ⟨P, hP, -, hmon⟩ := lifts_and_natDegree_eq_and_monic hl (minpoly.monic hint)
  refine ⟨P, hmon, ?_⟩
  rw [← aeval_def, ← aeval_map_algebraMap L, hP, minpoly.aeval]

/-! ### The tower `O_L → O_E` -/

variable {L E : IntermediateField ℚ_[p] (PadicAlgCl p)}

theorem cpSubmodule_mono (h : L ≤ E) : cpSubmodule L ≤ cpSubmodule E := fun x hx => by
  obtain ⟨a, ha, rfl⟩ := mem_cpSubmodule.mp hx
  exact coe_mem_cpSubmodule (h ha)

/-- `O_L → O_E` for `L ≤ E`. -/
def ofLE (h : L ≤ E) : OL L →+* OL E where
  toFun x := mk (toOC x) (cpSubmodule_mono h (mem x))
  map_one' := toOC_injective (by rw [toOC_mk, map_one, map_one])
  map_mul' x y := toOC_injective (by rw [toOC_mk, map_mul, map_mul, toOC_mk, toOC_mk])
  map_zero' := toOC_injective (by rw [toOC_mk, map_zero, map_zero])
  map_add' x y := toOC_injective (by rw [toOC_mk, map_add, map_add, toOC_mk, toOC_mk])

theorem toOC_ofLE (h : L ≤ E) (x : OL L) : toOC (ofLE h x) = toOC x := rfl

theorem nrm_ofLE (h : L ≤ E) (x : OL L) : nrm (ofLE h x) = nrm x := rfl

theorem ofLE_injective (h : L ≤ E) : Function.Injective (ofLE h) := fun x y hxy =>
  toOC_injective (by rw [← toOC_ofLE h x, hxy, toOC_ofLE])

variable [hLE : Fact (L ≤ E)]

instance algebraOfLE : Algebra (OL L) (OL E) := (ofLE hLE.out).toAlgebra

theorem algebraMap_OL_eq (x : OL L) : algebraMap (OL L) (OL E) x = ofLE hLE.out x := rfl

instance algebraFieldOfLE : Algebra L E := (IntermediateField.inclusion hLE.out).toRingHom.toAlgebra

theorem coe_algebraMap_field (x : L) : ((algebraMap L E x : E) : PadicAlgCl p) = x := rfl

instance algebraOLField : Algebra (OL L) E :=
  ((algebraMap L E).comp (algebraMap (OL L) L)).toAlgebra

instance : IsScalarTower (OL L) L E := IsScalarTower.of_algebraMap_eq fun _ => rfl

theorem coe_algebraMap_OL (x : OL L) :
    ((algebraMap (OL L) E x : E) : PadicAlgCl p) = algebraMap (OL L) (PadicAlgCl p) x := rfl

instance : IsScalarTower (OL L) (OL E) E := IsScalarTower.of_algebraMap_eq fun x => by
  apply Subtype.val_injective
  apply (algebraMap (PadicAlgCl p) ℂ_[p]).injective
  change ((algebraMap (OL L) (PadicAlgCl p) x : PadicAlgCl p) : ℂ_[p]) =
    ((algebraMap (OL E) (PadicAlgCl p) (algebraMap (OL L) (OL E) x) : PadicAlgCl p) : ℂ_[p])
  rw [algebraMap_qbar_cp, algebraMap_qbar_cp]
  rfl

instance : IsScalarTower ℚ_[p] L E := IsScalarTower.of_algebraMap_eq fun _ => rfl

instance [FiniteDimensional ℚ_[p] E] : FiniteDimensional L E :=
  Module.Finite.of_restrictScalars_finite ℚ_[p] L E

instance : IsLocalHom (algebraMap (OL L) (OL E)) where
  map_nonunit x hx := by
    rw [isUnit_iff] at hx ⊢
    exact hx

theorem algebraMap_mem_cpSubmodule_iff {z : PadicAlgCl p} :
    (z : ℂ_[p]) ∈ cpSubmodule E ↔ z ∈ E := by
  refine ⟨fun h => ?_, coe_mem_cpSubmodule⟩
  obtain ⟨a, ha, hax⟩ := mem_cpSubmodule.mp h
  exact (algebraMap (PadicAlgCl p) ℂ_[p]).injective hax ▸ ha

/-- **`O_E` is the integral closure of `O_L` in `E`.** -/
instance isIntegralClosure [FiniteDimensional ℚ_[p] E] : IsIntegralClosure (OL E) (OL L) E where
  algebraMap_injective := toL_injective
  isIntegral_iff {x} := by
    constructor
    · intro hx
      have hx' : IsIntegral (OL E) x := hx.tower_top
      exact IsIntegrallyClosed.isIntegral_iff.mp hx'
    · rintro ⟨y, rfl⟩
      have h := isIntegral_of_norm_le_one L (norm_algebraMap_le_one y)
      let f : E →ₐ[OL L] PadicAlgCl p :=
        { toRingHom := algebraMap E (PadicAlgCl p)
          commutes' := fun _ => rfl }
      refine (isIntegral_algHom_iff f (algebraMap E (PadicAlgCl p)).injective).mp ?_
      exact h

instance instModuleFinite [FiniteDimensional ℚ_[p] L] [FiniteDimensional ℚ_[p] E] :
    Module.Finite (OL L) (OL E) :=
  haveI : IsNoetherianRing (OL L) := PrincipalIdealRing.isNoetherianRing
  haveI : IsIntegrallyClosed (OL L) := inferInstance
  IsIntegralClosure.finite (OL L) L E (OL E)

instance : Module.IsTorsionFree (OL L) (OL E) :=
  isTorsionFree_iff_algebraMap_injective.mpr (ofLE_injective hLE.out)

instance [FiniteDimensional ℚ_[p] L] [FiniteDimensional ℚ_[p] E] :
    Algebra.IsSeparable (ResidueField (OL L)) (ResidueField (OL E)) := by
  haveI : Module.Finite (ResidueField (OL L)) (ResidueField (OL E)) := Module.Finite.of_finite
  haveI : Algebra.IsAlgebraic (ResidueField (OL L)) (ResidueField (OL E)) :=
    Algebra.IsIntegral.isAlgebraic (R := ResidueField (OL L))
  haveI : PerfectField (ResidueField (OL L)) := PerfectField.ofFinite
  exact Algebra.IsAlgebraic.isSeparable_of_perfectField

theorem map_maximalIdeal_ne_bot :
    (maximalIdeal (OL L)).map (algebraMap (OL L) (OL E)) ≠ ⊥ := by
  intro h
  have : algebraMap (OL L) (OL E) (p : OL L) ∈ (maximalIdeal (OL L)).map (algebraMap _ _) :=
    Ideal.mem_map_of_mem _ p_mem
  rw [h, Ideal.mem_bot, map_natCast] at this
  exact natCast_p_ne_zero this

set_option linter.overlappingInstances false in
/-- **[Fo, §2.1, Lemme 1 (i)] for `O_E/O_L`**: `O_E = O_L[b]`, `Ω_{O_E/O_L}` is generated by
`db`, and its annihilator is the different `𝔇_{O_E/O_L}`. -/
theorem exists_kaehler_cyclic' [FiniteDimensional ℚ_[p] L] [FiniteDimensional ℚ_[p] E] :
    ∃ b : OL E, Algebra.adjoin (OL L) {b} = ⊤ ∧
      Submodule.span (OL E) {KaehlerDifferential.D (OL L) (OL E) b} = ⊤ ∧
      Module.annihilator (OL E) Ω[OL E⁄OL L] = differentIdeal (OL L) (OL E) :=
  exists_kaehler_cyclic L E map_maximalIdeal_ne_bot

end OL

end PadicHodge
