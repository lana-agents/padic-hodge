import Mathlib.RingTheory.Kaehler.Polynomial
import Mathlib.RingTheory.DedekindDomain.Different
import Mathlib.RingTheory.Conductor

/-!
# Kähler differentials of monogenic algebras and the different

First step of [Fo] (J.-M. Fontaine, *Formes différentielles et modules de Tate des variétés
abéliennes sur les corps locaux*, Invent. Math. 65 (1982)), §2.1, Lemma 1 (i) (citing Serre,
*Corps locaux*, III): if `B = A[b]`, then `Ω_{B/A}` is generated by `db`, and its annihilator is
the ideal generated by `P'(b)` (`P` generating the relations of `b`); for Dedekind domains this
is the different `𝔇_{B/A}`.

* `span_D_eq_top_of_adjoin`: `Ω_{B/R} = B · db` if `R[b] = B`;
* `mem_span_of_smul_D_eq_zero`, **`annihilator_kaehler_eq`**: `Ann_B(Ω_{B/R}) = (P'(b))` if
  `ker(R[X] → B, X ↦ b) = (P)` (from the conormal sequence
  `I/I² → B ⊗ Ω_{R[X]/R} → Ω_{B/R}`,
  `KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange`);
* **`differentIdeal_eq_annihilator`**: `𝔇_{B/A} = Ann_B(Ω_{B/A})` for a monogenic extension
  `B = A[x]` of Dedekind domains with separable fraction field extension (Mathlib's
  `conductor_mul_differentIdeal` with conductor `⊤`).
-/

open Polynomial KaehlerDifferential TensorProduct

namespace PadicHodge

variable {R B : Type*} [CommRing R] [CommRing B] [Algebra R B]

/-- If `b` generates `B` as an `R`-algebra, `Ω_{B/R}` is generated by `db`. -/
theorem span_D_eq_top_of_adjoin {b : B} (hb : Algebra.adjoin R {b} = ⊤) :
    Submodule.span B {D R B b} = ⊤ := by
  rw [eq_top_iff, ← span_range_derivation, Submodule.span_le]
  rintro _ ⟨x, rfl⟩
  have hx : x ∈ Algebra.adjoin R {b} := hb ▸ Algebra.mem_top
  obtain ⟨q, rfl⟩ := (Algebra.adjoin_singleton_eq_range_aeval R b ▸ hx : x ∈ (aeval b).range)
  change D R B (aeval b q) ∈ _
  rw [Derivation.map_aeval]
  exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)

/-- `P'(b) · db = 0` if `P(b) = 0`. -/
theorem aeval_derivative_smul_D {b : B} {P : R[X]} (hP : aeval b P = 0) :
    aeval b (derivative P) • D R B b = 0 := by
  rw [← Derivation.map_aeval, hP, map_zero]

/-- **The annihilator of `db`** (Fontaine, Lemma 1 (i); Serre, *Corps locaux*, III §2): if
`b` generates `B` over `R` and the relations of `b` are generated by `P`, then
`c · db = 0` iff `c ∈ (P'(b))`. -/
theorem mem_span_of_smul_D_eq_zero {b : B} (hb : Algebra.adjoin R {b} = ⊤) {P : R[X]}
    (hP : RingHom.ker (aeval b : R[X] →ₐ[R] B) = Ideal.span {P}) {c : B}
    (hc : c • D R B b = 0) : c ∈ Ideal.span {aeval b (derivative P)} := by
  letI : Algebra R[X] B := (aeval b).toRingHom.toAlgebra
  haveI : IsScalarTower R R[X] B := IsScalarTower.of_algebraMap_eq fun r => by
    change algebraMap R B r = aeval b (C r)
    rw [aeval_C]
  have hsurj : Function.Surjective (algebraMap R[X] B) := by
    intro x
    have hx : x ∈ Algebra.adjoin R {b} := hb ▸ Algebra.mem_top
    obtain ⟨q, rfl⟩ := (Algebra.adjoin_singleton_eq_range_aeval R b ▸ hx : x ∈ (aeval b).range)
    exact ⟨q, rfl⟩
  -- `φ : B ⊗_{R[X]} Ω_{R[X]/R} → B`, `y ⊗ ω ↦ y · (dω/dX)(b)`
  let ψ : Ω[R[X]⁄R] →ₗ[R[X]] B :=
    (Algebra.linearMap R[X] B).comp (polynomialEquiv R).toLinearMap
  let φ : B ⊗[R[X]] Ω[R[X]⁄R] →ₗ[R[X]] B :=
    TensorProduct.lift ((LinearMap.mul R[X] B).compl₂ ψ)
  have hφ : ∀ (y : B) (ω : Ω[R[X]⁄R]), φ (y ⊗ₜ ω) = y * aeval b (polynomialEquiv R ω) :=
    fun _ _ => rfl
  -- `c ⊗ dX` lies in the kernel of `B ⊗ Ω_{R[X]/R} → Ω_{B/R}`
  have hker : mapBaseChange R R[X] B (c ⊗ₜ D R R[X] X) = 0 := by
    rw [mapBaseChange_tmul, map_D]
    change c • D R B (aeval b X) = 0
    rw [aeval_X, hc]
  obtain ⟨y, hy⟩ := (exact_kerCotangentToTensor_mapBaseChange R R[X] B hsurj
    (c ⊗ₜ D R R[X] X)).mp hker
  obtain ⟨q, rfl⟩ := Ideal.toCotangent_surjective _ y
  rw [kerCotangentToTensor_toCotangent] at hy
  have hq : (q : R[X]) ∈ Ideal.span {P} := by
    rw [← hP]
    exact q.2
  obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp hq
  have hPb : aeval b P = 0 :=
    RingHom.mem_ker.mp (by rw [hP]; exact Ideal.mem_span_singleton_self P)
  have h1 := congrArg φ hy
  rw [hφ, hφ, polynomialEquiv_D, polynomialEquiv_D, derivative_X, map_one, mul_one,
    one_mul] at h1
  rw [← h1, ← hg, derivative_mul, map_add, map_mul, map_mul, hPb, mul_zero, zero_add]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

/-- **`Ann(Ω_{B/R}) = (P'(b))`** for `B = R[b]` with relations generated by `P`
(Fontaine, Lemma 1 (i); Serre, *Corps locaux*, III §2). -/
theorem annihilator_kaehler_eq {b : B} (hb : Algebra.adjoin R {b} = ⊤) {P : R[X]}
    (hP : RingHom.ker (aeval b : R[X] →ₐ[R] B) = Ideal.span {P}) :
    Module.annihilator B Ω[B⁄R] = Ideal.span {aeval b (derivative P)} := by
  have hPb : aeval b P = 0 :=
    RingHom.mem_ker.mp (by rw [hP]; exact Ideal.mem_span_singleton_self P)
  ext c
  rw [Module.mem_annihilator]
  constructor
  · exact fun h => mem_span_of_smul_D_eq_zero hb hP (h _)
  · intro hc ω
    have hω : ω ∈ Submodule.span B {D R B b} := by rw [span_D_eq_top_of_adjoin hb]; trivial
    obtain ⟨y, rfl⟩ := Submodule.mem_span_singleton.mp hω
    obtain ⟨x, rfl⟩ := Ideal.mem_span_singleton'.mp hc
    rw [smul_comm, mul_smul, aeval_derivative_smul_D hPb, smul_zero, smul_zero]

section Different

variable (A K L : Type*) {B' : Type*} [CommRing A] [Field K] [CommRing B'] [Field L]
  [Algebra A K] [Algebra B' L] [Algebra A B'] [Algebra K L] [Algebra A L]
  [IsScalarTower A K L] [IsScalarTower A B' L] [IsDomain A] [IsFractionRing A K]
  [IsIntegrallyClosed A] [IsDedekindDomain B'] [Module.IsTorsionFree A B'] [FiniteDimensional K L]
  [IsIntegralClosure B' A L] [Algebra.IsSeparable K L]

/-- **The different is the annihilator of the Kähler differentials** for a monogenic extension
`B' = A[x]` of Dedekind domains (Fontaine, Lemma 1 (i)). -/
theorem differentIdeal_eq_annihilator {x : B'} (hxB : Algebra.adjoin A {x} = ⊤)
    (hx : Algebra.adjoin K {algebraMap B' L x} = ⊤) :
    differentIdeal A B' = Module.annihilator B' Ω[B'⁄A] := by
  have hAx : IsIntegral A x := IsIntegralClosure.isIntegral A L x
  have h := conductor_mul_differentIdeal A K L x hx
  rw [conductor_eq_top_of_adjoin_eq_top hxB, Ideal.top_mul] at h
  rw [h, annihilator_kaehler_eq hxB]
  apply le_antisymm
  · intro q hq
    rw [Ideal.mem_span_singleton]
    exact minpoly.isIntegrallyClosed_dvd hAx (RingHom.mem_ker.mp hq)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact minpoly.aeval A x

end Different

end PadicHodge
