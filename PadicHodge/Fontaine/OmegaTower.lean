import PadicHodge.Fontaine.OLTower

/-!
# `Ω_{O_E/O_L}` in towers ([Fo, Lemmes 1–4])

For finite extensions `L ⊆ E` inside `ℚ̄_p` let `δ_{E/L}` be a generator of the different
`𝔇_{E/L} ⊆ O_E` and `‖𝔇_{E/L}‖ := |δ_{E/L}|` (`OL.dnorm L E`, in `(0, 1]`; `= p^{-v(𝔇_{E/L})}`
with `v(p) = 1`). If `O_E = O_L[b]` then every `ω ∈ Ω_{O_E/O_L}` is `x · db` and

* `OL.smul_D_eq_zero_iff`: `x · db = 0 ↔ |x| ≤ ‖𝔇_{E/L}‖` ([Fo, Lemme 1 (i)]);
* `OL.dnorm_tower`: `‖𝔇_{E'/L}‖ = ‖𝔇_{E'/E}‖ · ‖𝔇_{E/L}‖` ([Fo, Lemme 1 (iii)]);
* **`OL.smul_map_smul_D_eq_zero_iff`** ([Fo, Lemme 4]): for `L ⊆ E ⊆ E'`, `x ∈ O_E`,
  `y ∈ O_{E'}`: `y · (x · db) = 0` in `Ω_{O_{E'}/O_L}` iff `|y| |x| ≤ ‖𝔇_{E/L}‖`. In particular
  `Ω_{O_E/O_L} → Ω_{O_{E'}/O_L}` is injective (`OL.map_injective`) and the annihilator of the
  image of `ω` is generated by the annihilator of `ω`.

Fontaine proves Lemme 4 by dévissage (unramified / totally ramified); we use instead the exact
sequence `O_{E'} ⊗ Ω_{O_E/O_L} → Ω_{O_{E'}/O_L} → Ω_{O_{E'}/O_E} → 0`
(`KaehlerDifferential.exact_mapBaseChange_map`), the cyclicity of the three modules and the
multiplicativity of the different.

## References

* [Fo] J.-M. Fontaine, *Formes différentielles et modules de Tate des variétés abéliennes sur
  les corps locaux*, Invent. Math. 65 (1982), §2.1–2.4.
-/

noncomputable section

open IsLocalRing Polynomial Module KaehlerDifferential

attribute [local instance] FractionRing.liftAlgebra FractionRing.isScalarTower_liftAlgebra

namespace PadicHodge

variable {p : ℕ} [hp : Fact p.Prime]

namespace OL

variable {L : IntermediateField ℚ_[p] (PadicAlgCl p)}

theorem dvd_iff_nrm_le {x y : OL L} (hy : y ≠ 0) : y ∣ x ↔ nrm x ≤ nrm y := by
  refine ⟨fun ⟨c, hc⟩ => ?_, dvd_of_nrm_le hy⟩
  rw [hc, nrm_mul]
  exact mul_le_of_le_one_right (nrm_nonneg _) (nrm_le_one c)

theorem nrm_eq_of_associated {x y : OL L} (h : Associated x y) : nrm x = nrm y := by
  obtain ⟨u, rfl⟩ := h
  rw [nrm_mul, isUnit_iff.mp u.isUnit, mul_one]

variable {E E' : IntermediateField ℚ_[p] (PadicAlgCl p)}

section Level

variable [Fact (L ≤ E)] [FiniteDimensional ℚ_[p] L] [FiniteDimensional ℚ_[p] E]

instance isSeparable_fractionRing :
    Algebra.IsSeparable (FractionRing (OL L)) (FractionRing (OL E)) := by
  refine Algebra.IsSeparable.of_equiv_equiv (FractionRing.algEquiv (OL L) L).symm.toRingEquiv
    (FractionRing.algEquiv (OL E) E).symm.toRingEquiv ?_
  ext _
  exact IsFractionRing.algEquiv_commutes (FractionRing.algEquiv (OL L) L).symm
    (FractionRing.algEquiv (OL E) E).symm _

variable (L E) in
/-- A generator `δ_{E/L}` of the different `𝔇_{E/L}`. -/
def dgen : OL E := Submodule.IsPrincipal.generator (differentIdeal (OL L) (OL E))

variable (L E) in
/-- `‖𝔇_{E/L}‖ = |δ_{E/L}|`. -/
def dnorm : ℝ := nrm (dgen L E)

omit [FiniteDimensional ℚ_[p] L] in
theorem span_dgen : Ideal.span {dgen L E} = differentIdeal (OL L) (OL E) :=
  Ideal.span_singleton_generator _

omit [FiniteDimensional ℚ_[p] L] in
theorem dnorm_le_one : dnorm L E ≤ 1 := nrm_le_one _

set_option linter.overlappingInstances false in
theorem differentIdeal_ne_bot' : differentIdeal (OL L) (OL E) ≠ ⊥ := differentIdeal_ne_bot

theorem dgen_ne_zero : dgen L E ≠ 0 := by
  intro h
  apply differentIdeal_ne_bot' (L := L) (E := E)
  rw [← span_dgen, h, Ideal.span_singleton_eq_bot]

theorem dnorm_pos : 0 < dnorm L E := nrm_pos dgen_ne_zero

theorem mem_differentIdeal_iff {x : OL E} :
    x ∈ differentIdeal (OL L) (OL E) ↔ nrm x ≤ dnorm L E := by
  rw [← span_dgen, Ideal.mem_span_singleton, dvd_iff_nrm_le dgen_ne_zero, dnorm]

set_option linter.overlappingInstances false in
/-- If `O_E = O_L[b]`, the annihilator of `Ω_{O_E/O_L}` is the different ([Fo, Lemme 1 (i)]). -/
theorem annihilator_eq_differentIdeal {b : OL E} (hb : Algebra.adjoin (OL L) {b} = ⊤) :
    Module.annihilator (OL E) Ω[OL E⁄OL L] = differentIdeal (OL L) (OL E) := by
  have halg : IsAlgebraic L (algebraMap (OL E) E b) := Algebra.IsAlgebraic.isAlgebraic _
  exact (differentIdeal_eq_annihilator (OL L) L E hb (adjoin_field_eq_top L E hb halg)).symm

/-- **[Fo, Lemme 1 (i)]**: if `O_E = O_L[b]`, then `x · db = 0` iff `|x| ≤ ‖𝔇_{E/L}‖`. -/
theorem smul_D_eq_zero_iff {b : OL E} (hb : Algebra.adjoin (OL L) {b} = ⊤) (x : OL E) :
    x • D (OL L) (OL E) b = 0 ↔ nrm x ≤ dnorm L E := by
  rw [← mem_differentIdeal_iff, ← annihilator_eq_differentIdeal hb, Module.mem_annihilator]
  refine ⟨fun h ω => ?_, fun h => h _⟩
  have hω : ω ∈ Submodule.span (OL E) {D (OL L) (OL E) b} := by
    rw [span_D_eq_top_of_adjoin hb]; trivial
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hω
  rw [smul_comm, h, smul_zero]

omit [FiniteDimensional ℚ_[p] L] [FiniteDimensional ℚ_[p] E] in
/-- If `O_E = O_L[b]`, every element of `Ω_{O_E/O_L}` is `x · db`. -/
theorem exists_eq_smul_D {b : OL E} (hb : Algebra.adjoin (OL L) {b} = ⊤)
    (ω : Ω[OL E⁄OL L]) : ∃ x : OL E, x • D (OL L) (OL E) b = ω := by
  have hω : ω ∈ Submodule.span (OL E) {D (OL L) (OL E) b} := by
    rw [span_D_eq_top_of_adjoin hb]; trivial
  exact Submodule.mem_span_singleton.mp hω

set_option linter.overlappingInstances false in
/-- If `O_E = O_L[b]`, the different is generated by `f'(b)`, `f` the minimal polynomial of `b`
over `O_L`. -/
theorem differentIdeal_eq_span {b : OL E} (hb : Algebra.adjoin (OL L) {b} = ⊤) :
    differentIdeal (OL L) (OL E) =
      Ideal.span {aeval b (derivative (minpoly (OL L) b))} := by
  have halg : IsAlgebraic L (algebraMap (OL E) E b) := Algebra.IsAlgebraic.isAlgebraic _
  have h := conductor_mul_differentIdeal (OL L) L E b (adjoin_field_eq_top L E hb halg)
  rwa [conductor_eq_top_of_adjoin_eq_top hb, Ideal.top_mul] at h

variable (L E) in
/-- A generator of `O_E` over `O_L`. -/
theorem exists_adjoin_eq_top' : ∃ b : OL E, Algebra.adjoin (OL L) {b} = ⊤ :=
  let ⟨b, hb, _⟩ := exists_kaehler_cyclic' (L := L) (E := E)
  ⟨b, hb⟩

end Level

/-! ### Towers `L ⊆ E ⊆ E'` -/

section Tower

variable [hLE : Fact (L ≤ E)] [hEE' : Fact (E ≤ E')] [hLE' : Fact (L ≤ E')]

instance : IsScalarTower (OL L) (OL E) (OL E') := IsScalarTower.of_algebraMap_eq fun _ => rfl

variable [FiniteDimensional ℚ_[p] L] [FiniteDimensional ℚ_[p] E] [FiniteDimensional ℚ_[p] E']

omit [FiniteDimensional ℚ_[p] L] [FiniteDimensional ℚ_[p] E] [FiniteDimensional ℚ_[p] E'] in
theorem adjoin_eq_top_of_tower {c : OL E'} (hc : Algebra.adjoin (OL L) {c} = ⊤) :
    Algebra.adjoin (OL E) {c} = ⊤ := by
  rw [eq_top_iff]
  intro x _
  have hx : x ∈ Algebra.adjoin (OL L) {c} := hc ▸ Algebra.mem_top
  exact (Algebra.adjoin_le (s := {c}) (S := (Algebra.adjoin (OL E) {c}).restrictScalars (OL L))
    Algebra.subset_adjoin) hx

set_option linter.overlappingInstances false in
/-- **Multiplicativity of the different** ([Fo, Lemme 1 (iii)]):
`‖𝔇_{E'/L}‖ = ‖𝔇_{E'/E}‖ · ‖𝔇_{E/L}‖`. -/
theorem dnorm_tower : dnorm L E' = dnorm E E' * dnorm L E := by
  have h := differentIdeal_eq_differentIdeal_mul_differentIdeal (OL L) (OL E) (OL E')
  rw [← span_dgen, ← span_dgen, ← span_dgen, Ideal.map_span, Set.image_singleton,
    Ideal.span_singleton_mul_span_singleton, Ideal.span_singleton_eq_span_singleton] at h
  rw [dnorm, nrm_eq_of_associated h, nrm_mul]
  rfl

omit [FiniteDimensional ℚ_[p] L] [FiniteDimensional ℚ_[p] E] [FiniteDimensional ℚ_[p] E'] in
/-- Elements of the image of `O_{E'} ⊗ Ω_{O_E/O_L} → Ω_{O_{E'}/O_L}` are multiples of the
image of `db`. -/
theorem mem_span_of_mem_range_mapBaseChange {b : OL E} (hb : Algebra.adjoin (OL L) {b} = ⊤)
    {ω : Ω[OL E'⁄OL L]} (hω : ω ∈ LinearMap.range (mapBaseChange (OL L) (OL E) (OL E'))) :
    ω ∈ Submodule.span (OL E') {D (OL L) (OL E') (algebraMap (OL E) (OL E') b)} := by
  obtain ⟨t, rfl⟩ := hω
  induction t using TensorProduct.induction_on with
  | zero => rw [map_zero]; exact zero_mem _
  | tmul z η =>
    obtain ⟨x, rfl⟩ := exists_eq_smul_D hb η
    rw [mapBaseChange_tmul, map_smul, map_D]
    exact Submodule.smul_mem _ _
      (Submodule.smul_of_tower_mem _ _ (Submodule.mem_span_singleton_self _))
  | add s t hs ht => rw [map_add]; exact add_mem hs ht

/-- The key computation for [Fo, Lemme 4]: with `O_{E'} = O_L[c]` and `db = u · dc`, if `E/L` is
ramified then `|u| = ‖𝔇_{E'/E}‖`. -/
theorem nrm_eq_dnorm_of_D_eq {b : OL E} (hb : Algebra.adjoin (OL L) {b} = ⊤) {c : OL E'}
    (hc : Algebra.adjoin (OL L) {c} = ⊤) {u : OL E'}
    (hu : u • D (OL L) (OL E') c = D (OL L) (OL E') (algebraMap (OL E) (OL E') b))
    (hram : dnorm L E < 1) : nrm u = dnorm E E' := by
  have hcE := adjoin_eq_top_of_tower (L := L) (E := E) hc
  have hex := exact_mapBaseChange_map (OL L) (OL E) (OL E')
  have hg : ∀ z : OL E', map (OL L) (OL E) (OL E') (OL E') (z • D (OL L) (OL E') c) =
      z • D (OL E) (OL E') c := fun z => by
    rw [map_smul, map_D, Algebra.algebraMap_self, RingHom.id_apply]
  apply le_antisymm
  · -- `u · dc = db` lies in the image of `Ω_{O_E/O_L}`, hence vanishes in `Ω_{O_{E'}/O_E}`.
    rw [← smul_D_eq_zero_iff hcE, ← hg, hu, map_D, Algebra.algebraMap_self, RingHom.id_apply,
      Derivation.map_algebraMap]
  · -- `δ_{E'/E} · dc` vanishes in `Ω_{O_{E'}/O_E}`, hence is a multiple of `u · dc`.
    have h1 : dgen E E' • D (OL E) (OL E') c = 0 := (smul_D_eq_zero_iff hcE _).mpr le_rfl
    have h2 : dgen E E' • D (OL L) (OL E') c ∈
        LinearMap.range (mapBaseChange (OL L) (OL E) (OL E')) :=
      LinearMap.mem_range.mpr ((hex _).mp (by rw [hg]; exact h1))
    obtain ⟨w, hw⟩ := Submodule.mem_span_singleton.mp (mem_span_of_mem_range_mapBaseChange hb h2)
    rw [← hu, smul_smul, eq_comm, ← sub_eq_zero, ← sub_smul, smul_D_eq_zero_iff hc] at hw
    have hlt : nrm (dgen E E' - w * u) < nrm (dgen E E') := by
      refine hw.trans_lt ?_
      rw [dnorm_tower (L := L) (E := E) (E' := E')]
      exact mul_lt_of_lt_one_right (dnorm_pos (L := E) (E := E')) hram
    have := nrm_add_le (dgen E E' - w * u) (w * u)
    rw [sub_add_cancel] at this
    have h3 : nrm (dgen E E') ≤ nrm (w * u) := by
      rcases le_max_iff.mp this with h | h
      · exact absurd h (not_le.mpr hlt)
      · exact h
    rw [nrm_mul] at h3
    exact h3.trans (mul_le_of_le_one_left (nrm_nonneg _) (nrm_le_one w))

omit [FiniteDimensional ℚ_[p] L] [FiniteDimensional ℚ_[p] E] [FiniteDimensional ℚ_[p] E'] in
theorem nrm_algebraMap (x : OL E) : nrm (algebraMap (OL E) (OL E') x) = nrm x := rfl

/-- **[Fo, Lemme 4]**: for `L ⊆ E ⊆ E'`, `O_E = O_L[b]`, `x ∈ O_E` and `y ∈ O_{E'}`, the element
`y · (x · db)` of `Ω_{O_{E'}/O_L}` vanishes iff `|y| |x| ≤ ‖𝔇_{E/L}‖`. -/
theorem smul_map_smul_D_eq_zero_iff {b : OL E} (hb : Algebra.adjoin (OL L) {b} = ⊤) (x : OL E)
    (y : OL E') :
    y • map (OL L) (OL L) (OL E) (OL E') (x • D (OL L) (OL E) b) = 0 ↔
      nrm y * nrm x ≤ dnorm L E := by
  by_cases hram : dnorm L E < 1
  · obtain ⟨c, hc⟩ := exists_adjoin_eq_top' L E'
    obtain ⟨u, hu⟩ := exists_eq_smul_D hc (D (OL L) (OL E') (algebraMap (OL E) (OL E') b))
    have hmap : map (OL L) (OL L) (OL E) (OL E') (x • D (OL L) (OL E) b) =
        (algebraMap (OL E) (OL E') x * u) • D (OL L) (OL E') c := by
      rw [map_smul, map_D, ← hu, ← algebraMap_smul (OL E') x, smul_smul]
    rw [hmap, smul_smul, smul_D_eq_zero_iff hc, nrm_mul, nrm_mul, nrm_algebraMap,
      nrm_eq_dnorm_of_D_eq hb hc hu hram, dnorm_tower (L := L) (E := E) (E' := E'), ← mul_assoc,
      mul_comm (dnorm E E')]
    exact mul_le_mul_iff_of_pos_right (dnorm_pos (L := E) (E := E'))
  · have h1 : dnorm L E = 1 := le_antisymm dnorm_le_one (not_lt.mp hram)
    have h0 : x • D (OL L) (OL E) b = 0 := (smul_D_eq_zero_iff hb x).mpr (h1 ▸ nrm_le_one x)
    rw [h0, map_zero, smul_zero, h1]
    exact iff_of_true rfl (mul_le_one₀ (nrm_le_one y) (nrm_nonneg x) (nrm_le_one x))

/-- **[Fo, Lemme 4]**: `Ω_{O_E/O_L} → Ω_{O_{E'}/O_L}` is injective. -/
theorem map_injective :
    Function.Injective (map (OL L) (OL L) (OL E) (OL E')) := by
  obtain ⟨b, hb⟩ := exists_adjoin_eq_top' L E
  refine (injective_iff_map_eq_zero _).mpr fun ω hω => ?_
  obtain ⟨x, rfl⟩ := exists_eq_smul_D hb ω
  have h := (smul_map_smul_D_eq_zero_iff (E' := E') hb x 1).mp (by rw [one_smul]; exact hω)
  rw [nrm_one, one_mul] at h
  exact (smul_D_eq_zero_iff hb x).mpr h

end Tower

end OL

end PadicHodge
