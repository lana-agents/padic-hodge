import PadicHodge.Fontaine.Differentials
import Mathlib.FieldTheory.PrimitiveElement
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.RingTheory.Nakayama
import Mathlib.Algebra.Polynomial.Identities
import Mathlib.Tactic.LinearCombination

/-!
# Monogenicity of finite extensions of DVRs ([Fo, Lemme 1 (i)])

[Fo, §2.1, Lemme 1 (i)] (quoting Serre, *Corps locaux*, III §6, Prop. 12): if `B` is a DVR,
finite over a local ring `A` with `𝔪_A B ≠ 0`, and the residue field extension is separable,
then `B = A[x]` for one element `x` (`exists_adjoin_eq_top`). Proof: lift a primitive element
`x̄` of `κ_B/κ_A`, adjust the lift so that `f(x)` is a uniformiser (`f` lifting the minimal
polynomial of `x̄`, `f'(x)` a unit by separability, `binomExpansion`); then
`B = A[x] + f(x)^n B` for all `n` and Nakayama gives `B = A[x]`.

With `Fontaine/Differentials.lean`: **`exists_kaehler_cyclic`**: `Ω_{B/A} = B · db` and
`Ann_B(Ω_{B/A}) = 𝔇_{B/A}` (the different).
-/

open Polynomial IsLocalRing nonZeroDivisors

namespace PadicHodge

variable {A B : Type*} [CommRing A] [IsLocalRing A] [CommRing B] [IsDomain B]
  [IsDiscreteValuationRing B] [Algebra A B] [IsLocalHom (algebraMap A B)]

/-- Every element of `B` is congruent modulo `𝔪_B` to an element of `A[x]` if `x` reduces to a
generator of `κ_B/κ_A`. -/
theorem exists_aeval_sub_mem [Module.Finite A B]
    [Algebra.IsSeparable (ResidueField A) (ResidueField B)] {x : B}
    (hx : IntermediateField.adjoin (ResidueField A) {residue B x} = ⊤) (z : B) :
    ∃ q : A[X], z - aeval x q ∈ maximalIdeal B := by
  have hint : IsIntegral (ResidueField A) (residue B x) := Algebra.IsIntegral.isIntegral _
  have hz : residue B z ∈ Algebra.adjoin (ResidueField A) {residue B x} := by
    rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic, hx]
    trivial
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hz
  obtain ⟨qb, hqb⟩ := hz
  obtain ⟨q, rfl⟩ := Polynomial.map_surjective (residue A) residue_surjective qb
  refine ⟨q, ?_⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  change residue B (z - aeval x q) = 0
  rw [map_sub, ← hqb, sub_eq_zero]
  change aeval (residue B x) (q.map (algebraMap A (ResidueField A))) = _
  rw [aeval_map_algebraMap]
  exact Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom A B (ResidueField B)) x q

theorem residue_aeval (z : B) (f : A[X]) :
    residue B (aeval z f) = aeval (residue B z) (f.map (residue A)) := by
  change _ = aeval (residue B z) (f.map (algebraMap A (ResidueField A)))
  rw [aeval_map_algebraMap]
  exact (Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom A B (ResidueField B)) z f).symm

omit [IsLocalRing A] [Algebra A B] [IsLocalHom (algebraMap A B)] in
/-- In a DVR, an element of `𝔪 ∖ 𝔪²` is a uniformiser. -/
theorem irreducible_of_mem_of_not_mem_sq {z : B} (hz : z ∈ maximalIdeal B)
    (hz2 : z ∉ maximalIdeal B ^ 2) : Irreducible z := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible B
  have hz0 : z ≠ 0 := by rintro rfl; exact hz2 (Ideal.zero_mem _)
  obtain ⟨n, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hz0 hϖ
  have hm : maximalIdeal B = Ideal.span {ϖ} := hϖ.maximalIdeal_eq
  rcases n with _ | _ | n
  · exact absurd hz (by simp)
  · rw [zero_add, pow_one]
    exact (irreducible_units_mul u).mpr hϖ
  · exfalso
    apply hz2
    rw [hm, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    exact ⟨u * ϖ ^ n, by ring⟩

/-- **Monogenicity** ([Serre, *Corps locaux*, III §6, Prop. 12]; [Fo, Lemme 1 (i)]): a DVR `B`,
finite over a local ring `A` with `𝔪_A B ≠ 0` and separable residue field extension, is
generated by one element, `B = A[x]`. -/
theorem exists_adjoin_eq_top [Module.Finite A B]
    [Algebra.IsSeparable (ResidueField A) (ResidueField B)]
    (hmA : (maximalIdeal A).map (algebraMap A B) ≠ ⊥) :
    ∃ x : B, Algebra.adjoin A {x} = ⊤ := by
  obtain ⟨xb, hxb⟩ := Field.exists_primitive_element (ResidueField A) (ResidueField B)
  obtain ⟨x0, hx0⟩ := residue_surjective xb
  obtain ⟨f, hf⟩ := Polynomial.map_surjective (residue A) residue_surjective
    (minpoly (ResidueField A) xb)
  have hsep : aeval xb (derivative (minpoly (ResidueField A) xb)) ≠ 0 :=
    (Algebra.IsSeparable.isSeparable _ _).aeval_derivative_ne_zero (minpoly.aeval _ _)
  have hres : ∀ y ∈ maximalIdeal B, residue B (x0 + y) = xb := fun y hy => by
    rw [map_add, hx0, (residue_eq_zero_iff y).mpr hy, add_zero]
  have hfm : ∀ y ∈ maximalIdeal B, aeval (x0 + y) f ∈ maximalIdeal B := fun y hy => by
    rw [← residue_eq_zero_iff, residue_aeval, hres y hy, hf, minpoly.aeval]
  have hf'u : IsUnit (aeval x0 (derivative f)) := by
    rw [← residue_ne_zero_iff_isUnit, residue_aeval, hx0, ← derivative_map, hf]
    exact hsep
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible B
  have hm : maximalIdeal B = Ideal.span {ϖ} := hϖ.maximalIdeal_eq
  have hϖm : ϖ ∈ maximalIdeal B := by rw [hm]; exact Ideal.mem_span_singleton_self _
  -- a lift `x` of `xb` with `f(x)` a uniformiser
  obtain ⟨x, hxr, hy⟩ : ∃ x : B, residue B x = xb ∧ Irreducible (aeval x f) := by
    by_cases h2 : aeval x0 f ∈ maximalIdeal B ^ 2
    · refine ⟨x0 + ϖ, hres ϖ hϖm, irreducible_of_mem_of_not_mem_sq (hfm ϖ hϖm) ?_⟩
      intro h
      obtain ⟨k, hk⟩ := binomExpansion (f.map (algebraMap A B)) x0 ϖ
      rw [eval_map_algebraMap, eval_map_algebraMap, derivative_map, eval_map_algebraMap] at hk
      have hsq : maximalIdeal B ^ 2 = Ideal.span {ϖ ^ 2} := by
        rw [hm, Ideal.span_singleton_pow]
      have h3 : aeval x0 (derivative f) * ϖ ∈ maximalIdeal B ^ 2 := by
        have : aeval x0 (derivative f) * ϖ =
            aeval (x0 + ϖ) f - aeval x0 f - k * ϖ ^ 2 := by rw [hk]; ring
        rw [this]
        refine Ideal.sub_mem _ (Ideal.sub_mem _ h h2) ?_
        rw [hsq]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      rw [hsq, Ideal.mem_span_singleton, pow_two, hf'u.dvd_mul_left] at h3
      have h4 : ϖ ∣ 1 := (mul_dvd_mul_iff_left hϖ.ne_zero).mp (by rwa [mul_one])
      exact hϖ.not_isUnit (isUnit_of_dvd_one h4)
    · exact ⟨x0, hx0, irreducible_of_mem_of_not_mem_sq (by simpa using hfm 0 (Ideal.zero_mem _))
        h2⟩
  have hyS : aeval x f ∈ Algebra.adjoin A {x} := aeval_mem_adjoin_singleton A x
  have hmy : maximalIdeal B = Ideal.span {aeval x f} := hy.maximalIdeal_eq
  have hx : IntermediateField.adjoin (ResidueField A) {residue B x} = ⊤ := by
    rw [hxr]; exact hxb
  have step : ∀ (n : ℕ) (z : B), ∃ s ∈ Algebra.adjoin A {x},
      z - s ∈ Ideal.span {aeval x f ^ n} := by
    intro n
    induction n with
    | zero => exact fun z => ⟨0, Subalgebra.zero_mem _, by simp⟩
    | succ n ih =>
      intro z
      obtain ⟨s, hs, hzs⟩ := ih z
      obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hzs
      obtain ⟨q, hq⟩ := exists_aeval_sub_mem hx w
      rw [hmy] at hq
      obtain ⟨w', hw'⟩ := Ideal.mem_span_singleton'.mp hq
      refine ⟨s + aeval x q * aeval x f ^ n,
        add_mem hs (mul_mem (aeval_mem_adjoin_singleton A x) (pow_mem hyS _)), ?_⟩
      rw [Ideal.mem_span_singleton']
      exact ⟨w', by linear_combination aeval x f ^ n * hw' + hw⟩
  obtain ⟨e, he⟩ := IsDiscreteValuationRing.ideal_eq_span_pow_irreducible hmA hy
  have hle : (⊤ : Submodule A B) ≤ Subalgebra.toSubmodule (Algebra.adjoin A {x}) := by
    refine Submodule.le_of_le_smul_of_le_jacobson_bot (I := maximalIdeal A) Module.Finite.fg_top
      (maximalIdeal_le_jacobson _) fun z _ => ?_
    obtain ⟨s, hs, hzs⟩ := step e z
    have h1 : z - s ∈ maximalIdeal A • (⊤ : Submodule A B) := by
      rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem, he]
      exact hzs
    have h2 := Submodule.add_mem_sup (S := Subalgebra.toSubmodule (Algebra.adjoin A {x})) hs h1
    rwa [add_sub_cancel] at h2
  exact ⟨x, eq_top_iff.mpr fun z _ => hle Submodule.mem_top⟩

section Different

variable (K L : Type*) [Field K] [Field L] [Algebra A K] [Algebra B L] [Algebra K L]
  [Algebra A L] [IsScalarTower A K L] [IsScalarTower A B L] [IsFractionRing B L]

omit [IsLocalRing A] [IsDomain B] [IsDiscreteValuationRing B] [IsLocalHom (algebraMap A B)] in
/-- `B = A[x]` with `L = Frac B` gives `L = K[x]`. -/
theorem adjoin_field_eq_top {x : B} (hx : Algebra.adjoin A {x} = ⊤)
    (halg : IsAlgebraic K (algebraMap B L x)) :
    Algebra.adjoin K {algebraMap B L x} = ⊤ := by
  rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic halg,
    ← IntermediateField.top_toSubalgebra]
  congr 1
  have hB : ∀ b : B, algebraMap B L b ∈ IntermediateField.adjoin K {algebraMap B L x} := by
    intro b
    have hb : b ∈ Algebra.adjoin A {x} := hx ▸ Algebra.mem_top
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hb
    obtain ⟨q, rfl⟩ := hb
    change algebraMap B L (aeval x q) ∈ _
    rw [← aeval_algebraMap_apply, ← aeval_map_algebraMap K]
    exact IntermediateField.algebra_adjoin_le_adjoin K _
      (aeval_mem_adjoin_singleton K (algebraMap B L x))
  refine eq_top_iff.mpr fun l _ => ?_
  obtain ⟨⟨b1, b2⟩, rfl⟩ := IsLocalization.mk'_surjective B⁰ l
  dsimp only
  rw [IsFractionRing.mk'_eq_div]
  exact div_mem (hB b1) (hB b2)

variable [IsDomain A] [IsFractionRing A K] [IsIntegrallyClosed A] [IsDedekindDomain B]
  [Module.IsTorsionFree A B] [FiniteDimensional K L] [IsIntegralClosure B A L]
  [Algebra.IsSeparable K L]

include K L in
set_option linter.overlappingInstances false in
/-- **[Fo, §2.1, Lemme 1 (i)]**: for a finite extension `B/A` of DVRs (`B` integrally closed in
`L`, separable residue field extension, `𝔪_A B ≠ 0`), `Ω_{B/A}` is generated by one element
`db` and its annihilator is the different `𝔇_{B/A}`. -/
theorem exists_kaehler_cyclic [Module.Finite A B]
    [Algebra.IsSeparable (ResidueField A) (ResidueField B)]
    (hmA : (maximalIdeal A).map (algebraMap A B) ≠ ⊥) :
    ∃ b : B, Algebra.adjoin A {b} = ⊤ ∧
      Submodule.span B {KaehlerDifferential.D A B b} = ⊤ ∧
      Module.annihilator B Ω[B⁄A] = differentIdeal A B := by
  obtain ⟨b, hb⟩ := exists_adjoin_eq_top hmA
  have halg : IsAlgebraic K (algebraMap B L b) := Algebra.IsAlgebraic.isAlgebraic _
  refine ⟨b, hb, span_D_eq_top_of_adjoin hb, ?_⟩
  exact (differentIdeal_eq_annihilator A K L hb (adjoin_field_eq_top K L hb halg)).symm

end Different

end PadicHodge
