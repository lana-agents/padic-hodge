import PadicHodge.FormalGroup.KummerTate
import PadicHodge.FormalGroup.InvDiff
import PadicHodge.Fontaine.XiTate
import PadicHodge.Cohomology.KummerZp


/-!
# Fontaine's pairing `u^* ω` and the integral map `ρ : ω_F → Hom(T_p F, ℂ_p(1))`

[Fo] J.-M. Fontaine, *Formes différentielles et modules de Tate des variétés abéliennes sur les
corps locaux*, Invent. Math. 65 (1982), §3.3–3.4 (the pairing `⟨u, ω⟩ = u^*(ω) ∈ Ω`), §5.6
(`ρ_H`), Thm 1′ (`V_p(Ω) ≅ ℂ(1)`). Here `Ω = Ω_{O_K̄/O_L}` for a finite `L/ℚ_p` and `F` is a formal
group law over `O_L` (MR7-plan, "(FoInt) (a)").

* `OL.evK f u ∈ O_K̄`: the value of `f ∈ O_L[[X_σ]]` at `u` in the open polydisc of `O_K̄^σ`
  (`f(u)` lies in the finite extension generated by `u`, Ax–Sen–Tate, `ev_mem_cpSubmodule`);
  `evKHom`, `evK_subst`, `galOK_evK`.
* `OL.exists_pow_smul_D_eq_zero`: `p^N · dy = 0` in `Ω` for all `y ∈ O_E` (`E` finite, [Fo, §2]).
* **`OL.D_evK`** (chain rule): `d(f(u)) = ∑_s (∂_s f)(u) du_s` in `Ω`. Since `Ω` is `p^N`-torsion
  on `O_E`, `f` may be replaced by a polynomial truncation.
* `FGL.pullback l u = u^* ω_l = ∑_j ω_{lj}(u) du_j` for the invariant differentials
  `ω_l = ∑_j (F.invDiff l j) dX_j`; **`FGL.pullback_addK`**: `(u +_F v)^* ω = u^* ω + v^* ω`;
  `galΩ_pullback`.
* `FGL.IsAlg`, `FGL.coordK`, `FGL.pairing`: points of `F(m_{ℂ_p})` with coordinates in `O_K̄`
  (torsion points are such, `PDivFGL.isAlg_of_mem_torsionBy`), the pairing is additive.
* `PDivFGL.rhoSeq l x = (x_k^* ω_l)_k ∈ T_p(Ω)` and **`PDivFGL.rho`** `= τ ∘ rhoSeq` with
  `τ : T_p(Ω) ≅ 𝔞̂_L(1) ⊂ ℂ_p(1)` (`OL.tau`, via `ξ`); `rho_add`, **`norm_rho_le`**
  (`v(ρ(ω)(x)) ≥ -v(𝔇_{L/ℚ_p}) - 1/(p-1)`), **`rho_tpRep`** (`ρ(ω)(σx) = χ(σ)σ(ρ(ω)(x))`),
  `rhoLin` (the `ℂ_p`-linear extension), **`exists_pow_mul_rhoLin_le`** (`p^{c_a} ρ` is
  integral), **`tau_map_rhoSeq`** (the same `ℂ_p`-valued map is obtained over every finite
  `K' ⊇ L`, in particular every tame `K'`, so `c_a` is uniform).
-/

noncomputable section

open MvPowerSeries KaehlerDifferential IsLocalRing

namespace PadicHodge

variable {p : ℕ} [hp : Fact p.Prime]

namespace OL

variable {L : IntermediateField ℚ_[p] (PadicAlgCl p)} [FiniteDimensional ℚ_[p] L]

section EvK

/-- `u` lies in the open polydisc of `O_K̄^σ`. -/
def Small {σ : Type} (u : σ → OKbar p) : Prop := ∀ s, ‖(u s : PadicAlgCl p)‖ < 1

omit [FiniteDimensional ℚ_[p] L] in
theorem norm_incOK (y : OKbar p) :
    ‖((incOK L y : OC p) : ℂ_[p])‖ = ‖(y : PadicAlgCl p)‖ := by
  rw [coe_incOK, PadicComplex.norm_extends]

omit [FiniteDimensional ℚ_[p] L] in
theorem norm_incOK_lt {σ : Type} {u : σ → OKbar p} (hu : Small u) (s : σ) :
    ‖((incOK L (u s) : OC p) : ℂ_[p])‖ < 1 := by
  rw [norm_incOK]; exact hu s

variable {σ : Type} [Finite σ]

omit [FiniteDimensional ℚ_[p] L] in
/-- **Values of power series at algebraic points are algebraic**: if the coordinates of `u` lie
in a finite extension `E ⊇ L`, so does `f(u)` (Ax–Sen–Tate). -/
theorem ev_mem_cpSubmodule (E : IntermediateField ℚ_[p] (PadicAlgCl p)) [FiniteDimensional ℚ_[p] E]
    (hLE : L ≤ E) (f : MvPowerSeries σ (OL L)) {u : σ → OKbar p} (hu : Small u)
    (huE : ∀ s, (u s : PadicAlgCl p) ∈ E) :
    ((FGL.ev p f (fun s => incOK L (u s)) : OC p) : ℂ_[p]) ∈ cpSubmodule E := by
  have hfix : FGL.GalFixedOver p (OL L) E :=
    FGL.galFixedOver_of_mem E fun r => cpSubmodule_mono hLE (algebraMap_mem r)
  refine (galCp_eq_self_iff_mem (L := E) _).mp fun τ => ?_
  change autCp (AlgEquiv.restrictScalarsHom ℚ_[p] τ) _ = _
  rw [FGL.ev_autCp_of (hfix τ) f (norm_incOK_lt hu)]
  congr 2
  funext s
  apply Subtype.ext
  rw [FGL.autOC_coe, coe_incOK, autCp_coe]
  congr 1
  exact τ.commutes ⟨_, huE s⟩

theorem exists_evK (f : MvPowerSeries σ (OL L)) {u : σ → OKbar p} (hu : Small u) :
    ∃ y : OKbar p, incOK L y = FGL.ev p f (fun s => incOK L (u s)) := by
  classical
  have := Fintype.ofFinite σ
  obtain ⟨E, hLE, hFD, hE⟩ := exists_extend (E := L)
    (Finset.univ.image fun s => (u s : PadicAlgCl p))
  have h := ev_mem_cpSubmodule E hLE f hu fun s =>
    hE _ (Finset.mem_image_of_mem _ (Finset.mem_univ s))
  obtain ⟨a, -, ha⟩ := mem_cpSubmodule.mp h
  refine ⟨⟨a, ?_⟩, Subtype.ext ?_⟩
  · change ‖a‖ ≤ 1
    rw [← PadicComplex.norm_extends, ha]
    exact (FGL.ev p f fun s => incOK L (u s)).2
  · rw [coe_incOK]; exact ha

/-- `f(u) ∈ O_K̄` for `u` in the open polydisc of `O_K̄^σ`. -/
def evK (f : MvPowerSeries σ (OL L)) (u : σ → OKbar p) : OKbar p :=
  open Classical in
  if hu : Small u then (exists_evK (L := L) f hu).choose else 0

theorem incOK_evK (f : MvPowerSeries σ (OL L)) {u : σ → OKbar p} (hu : Small u) :
    incOK L (evK f u) = FGL.ev p f (fun s => incOK L (u s)) := by
  rw [evK, dif_pos hu]
  exact (exists_evK f hu).choose_spec

theorem evK_coe (P : MvPolynomial σ (OL L)) {u : σ → OKbar p} (hu : Small u) :
    evK (P : MvPowerSeries σ (OL L)) u = MvPolynomial.aeval u P := by
  apply incOK_injective (L := L)
  rw [incOK_evK _ hu, FGL.ev, MvPowerSeries.eval₂_coe, ← AlgHom.comp_apply,
    MvPolynomial.comp_aeval, MvPolynomial.aeval_def]

theorem evK_sub (f g : MvPowerSeries σ (OL L)) {u : σ → OKbar p} (hu : Small u) :
    evK (f - g) u = evK f u - evK g u := by
  apply incOK_injective (L := L)
  rw [map_sub, incOK_evK _ hu, incOK_evK _ hu, incOK_evK _ hu, FGL.ev, FGL.ev, FGL.ev,
    ← coe_eval₂Hom (FGL.continuous_algebraMap_OC (p := p) (R := OL L))
      (hasEval_of_norm_lt_one (norm_incOK_lt hu)), map_sub]

theorem evK_mem (E : IntermediateField ℚ_[p] (PadicAlgCl p)) [FiniteDimensional ℚ_[p] E]
    (hLE : L ≤ E) (f : MvPowerSeries σ (OL L)) {u : σ → OKbar p} (hu : Small u)
    (huE : ∀ s, (u s : PadicAlgCl p) ∈ E) : (evK f u : PadicAlgCl p) ∈ E := by
  have h := ev_mem_cpSubmodule E hLE f hu huE
  rw [← incOK_evK f hu, coe_incOK] at h
  obtain ⟨a, ha, hae⟩ := mem_cpSubmodule.mp h
  have h2 : a = (evK f u : PadicAlgCl p) := (algebraMap (PadicAlgCl p) ℂ_[p]).injective hae
  exact h2 ▸ ha

/-- `|f(u)| ≤ r^k` if `f` has no monomials of degree `< k` and `|u_s| ≤ r ≤ 1`. -/
theorem norm_evK_le (f : MvPowerSeries σ (OL L)) {u : σ → OKbar p} (hu : Small u) {k : ℕ}
    {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r ≤ 1) (hur : ∀ s, ‖(u s : PadicAlgCl p)‖ ≤ r)
    (hf : ∀ m : σ →₀ ℕ, coeff m f ≠ 0 → k ≤ m.degree) :
    ‖(evK f u : PadicAlgCl p)‖ ≤ r ^ k := by
  rw [← norm_incOK (L := L), incOK_evK f hu]
  exact norm_eval₂_le (FGL.continuous_algebraMap_OC (p := p) (R := OL L))
    (hasEval_of_norm_lt_one (norm_incOK_lt hu)) f hr0 hr1
    (fun s => by rw [norm_incOK]; exact hur s) hf

end EvK

section Torsion

/-- Elements of `E` of absolute value `≤ |p|^N` are `p^N` times elements of `O_K̄ ∩ E`. -/
theorem exists_pow_mul_eq {E : IntermediateField ℚ_[p] (PadicAlgCl p)} {y : OKbar p} {N : ℕ}
    (hyE : (y : PadicAlgCl p) ∈ E) (hy : ‖(y : PadicAlgCl p)‖ ≤ ‖(p : PadicAlgCl p)‖ ^ N) :
    ∃ w : OKbar p, (w : PadicAlgCl p) ∈ E ∧ (p : OKbar p) ^ N * w = y := by
  have hp0 : (p : PadicAlgCl p) ^ N ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr hp.out.ne_zero)
  have hpn : 0 < ‖(p : PadicAlgCl p)‖ ^ N := pow_pos (norm_pos_iff.mpr
    (Nat.cast_ne_zero.mpr hp.out.ne_zero)) N
  refine ⟨⟨(y : PadicAlgCl p) / (p : PadicAlgCl p) ^ N, ?_⟩, ?_, Subtype.ext ?_⟩
  · change ‖(y : PadicAlgCl p) / (p : PadicAlgCl p) ^ N‖ ≤ 1
    rw [norm_div, norm_pow, div_le_one hpn]
    exact hy
  · exact E.div_mem hyE (pow_mem (E.natCast_mem p) N)
  · simp only [Subring.coe_mul, SubmonoidClass.coe_pow, Subring.coe_natCast]
    field_simp

variable (L) in
/-- **`Ω_{O_E/O_L}` has bounded exponent in `Ω_{O_K̄/O_L}`**: `p^N · dy = 0` for all `y ∈ O_E`. -/
theorem exists_pow_smul_D_eq_zero (E : IntermediateField ℚ_[p] (PadicAlgCl p)) [Fact (L ≤ E)]
    [FiniteDimensional ℚ_[p] E] :
    ∃ N : ℕ, ∀ y : OKbar p, (y : PadicAlgCl p) ∈ E →
      ((p : OKbar p) ^ N) • D (OL L) (OKbar p) y = 0 := by
  obtain ⟨b, hb⟩ := exists_adjoin_eq_top' L E
  obtain ⟨N, hN⟩ := exists_pow_lt_of_lt_one (dnorm_pos (L := L) (E := E))
    (Padic.norm_p_lt_one (p := p))
  refine ⟨N, fun y hy => ?_⟩
  obtain ⟨y', rfl⟩ := exists_algebraMap_eq hy
  rw [← map_D (OL L) (OL L) (OL E) (OKbar p)]
  obtain ⟨x, hx⟩ := exists_eq_smul_D hb (D (OL L) (OL E) y')
  rw [← hx, smul_mapOK_smul_D_eq_zero_iff hb]
  have h1 : ‖(((p : OKbar p) ^ N : OKbar p) : PadicAlgCl p)‖ = ‖(p : ℚ_[p])‖ ^ N := by
    rw [SubmonoidClass.coe_pow, Subring.coe_natCast, norm_pow,
      ← map_natCast (algebraMap ℚ_[p] (PadicAlgCl p)), norm_algebraMap']
  rw [h1]
  calc ‖(p : ℚ_[p])‖ ^ N * nrm x ≤ ‖(p : ℚ_[p])‖ ^ N * 1 :=
        mul_le_mul_of_nonneg_left (nrm_le_one x) (pow_nonneg (norm_nonneg _) _)
    _ ≤ dnorm L E := by rw [mul_one]; exact hN.le

end Torsion

section Chain

variable {σ : Type} [Fintype σ]

omit [FiniteDimensional ℚ_[p] L] in
/-- `D(p^N w) = p^N dw`. -/
theorem D_pow_mul (N : ℕ) (w : OKbar p) :
    D (OL L) (OKbar p) ((p : OKbar p) ^ N * w) = ((p : OKbar p) ^ N) • D (OL L) (OKbar p) w := by
  rw [Derivation.leibniz]
  have h0 : D (OL L) (OKbar p) ((p : OKbar p) ^ N) = 0 := by
    rw [← map_natCast (algebraMap (OL L) (OKbar p)), ← map_pow, Derivation.map_algebraMap]
  rw [h0, smul_zero, add_zero]

/-- **Chain rule** in `Ω_{O_K̄/O_L}`: `d(f(u)) = ∑_s (∂_s f)(u) du_s` for a power series `f` over
`O_L` and `u` in the open polydisc of `O_K̄^σ`. (`Ω` is killed by `p^N` on a finite level `O_E`,
so `f` may be replaced by a polynomial truncation, for which this is the Leibniz rule.) -/
theorem D_evK (f : MvPowerSeries σ (OL L)) {u : σ → OKbar p} (hu : Small u) :
    D (OL L) (OKbar p) (evK f u) =
      ∑ s, evK (MvPowerSeries.pderiv (OL L) s f) u • D (OL L) (OKbar p) (u s) := by
  classical
  obtain ⟨E, hLE, hFD, hE⟩ := exists_extend (E := L)
    (Finset.univ.image fun s => (u s : PadicAlgCl p))
  haveI : Fact (L ≤ E) := ⟨hLE⟩
  have huE : ∀ s, (u s : PadicAlgCl p) ∈ E := fun s =>
    hE _ (Finset.mem_image_of_mem _ (Finset.mem_univ s))
  obtain ⟨N, hN⟩ := exists_pow_smul_D_eq_zero L E
  obtain ⟨r, hr0, hr1, hr⟩ := FGL.exists_bound (fun s => ‖(u s : PadicAlgCl p)‖) hu
  have hpN : 0 < ‖(p : PadicAlgCl p)‖ ^ N :=
    pow_pos (norm_pos_iff.mpr (Nat.cast_ne_zero.mpr hp.out.ne_zero)) N
  obtain ⟨M, hM⟩ := exists_pow_lt_of_lt_one hpN hr1
  have hsmall : ∀ y : OKbar p, (y : PadicAlgCl p) ∈ E →
      ‖(y : PadicAlgCl p)‖ ≤ ‖(p : PadicAlgCl p)‖ ^ N →
      D (OL L) (OKbar p) y = 0 ∧ ∀ s, y • D (OL L) (OKbar p) (u s) = 0 := by
    intro y hyE hy
    obtain ⟨w, hwE, rfl⟩ := exists_pow_mul_eq hyE hy
    refine ⟨by rw [D_pow_mul, hN w hwE], fun s => ?_⟩
    rw [mul_comm, mul_smul, hN _ (huE s), smul_zero]
  set P := MvPowerSeries.truncTotal (M + 1) f
  have htail : ∀ m : σ →₀ ℕ, coeff m (f - (P : MvPowerSeries σ (OL L))) ≠ 0 →
      M + 1 ≤ m.degree := by
    intro m hm
    by_contra h
    rw [not_le] at h
    rw [map_sub, MvPolynomial.coeff_coe, MvPowerSeries.coeff_truncTotal _ h, sub_self] at hm
    exact hm rfl
  have hT := hsmall _ (evK_mem E hLE _ hu huE)
    ((norm_evK_le _ hu hr0 hr1.le hr htail).trans
      ((pow_le_pow_of_le_one hr0 hr1.le (Nat.le_succ M)).trans hM.le))
  have e1 : evK f u = MvPolynomial.aeval u P + evK (f - (P : MvPowerSeries σ (OL L))) u := by
    rw [evK_sub _ _ hu, evK_coe _ hu]; ring
  have e2 : ∀ s, evK (MvPowerSeries.pderiv (OL L) s f) u =
      MvPolynomial.aeval u (MvPolynomial.pderiv s P) +
        evK (MvPowerSeries.pderiv (OL L) s (f - (P : MvPowerSeries σ (OL L)))) u := by
    intro s
    rw [map_sub, evK_sub _ _ hu, MvPowerSeries.pderiv_coe, evK_coe _ hu]; ring
  have hT' : ∀ s, evK (MvPowerSeries.pderiv (OL L) s (f - (P : MvPowerSeries σ (OL L)))) u •
      D (OL L) (OKbar p) (u s) = 0 := by
    intro s
    refine (hsmall _ (evK_mem E hLE _ hu huE) ?_).2 s
    refine (norm_evK_le _ hu hr0 hr1.le hr (k := M) fun m hm => ?_).trans hM.le
    rw [MvPowerSeries.coeff_pderiv] at hm
    have h1 := htail _ (left_ne_zero_of_mul hm)
    rw [map_add, Finsupp.degree_single] at h1
    omega
  rw [e1, map_add, hT.1, add_zero, MvPolynomial.derivation_aeval]
  refine Finset.sum_congr rfl fun s _ => ?_
  rw [e2, add_smul, hT', add_zero]

end Chain

section Ring

variable {σ : Type} [Finite σ]

/-- `f ↦ f(u)` as a ring homomorphism `O_L[[X_σ]] → O_K̄`. -/
def evKHom {u : σ → OKbar p} (hu : Small u) : MvPowerSeries σ (OL L) →+* OKbar p where
  toFun f := evK f u
  map_one' := incOK_injective (L := L) (by
    rw [incOK_evK _ hu, FGL.ev, ← coe_eval₂Hom (FGL.continuous_algebraMap_OC (p := p) (R := OL L))
      (hasEval_of_norm_lt_one (norm_incOK_lt hu)), map_one, map_one])
  map_mul' f g := incOK_injective (L := L) (by
    rw [map_mul, incOK_evK _ hu, incOK_evK _ hu, incOK_evK _ hu, FGL.ev, FGL.ev, FGL.ev,
      ← coe_eval₂Hom (FGL.continuous_algebraMap_OC (p := p) (R := OL L))
        (hasEval_of_norm_lt_one (norm_incOK_lt hu)), map_mul])
  map_zero' := incOK_injective (L := L) (by
    rw [incOK_evK _ hu, FGL.ev, ← coe_eval₂Hom (FGL.continuous_algebraMap_OC (p := p) (R := OL L))
      (hasEval_of_norm_lt_one (norm_incOK_lt hu)), map_zero, map_zero])
  map_add' f g := incOK_injective (L := L) (by
    rw [map_add, incOK_evK _ hu, incOK_evK _ hu, incOK_evK _ hu, FGL.ev, FGL.ev, FGL.ev,
      ← coe_eval₂Hom (FGL.continuous_algebraMap_OC (p := p) (R := OL L))
        (hasEval_of_norm_lt_one (norm_incOK_lt hu)), map_add])

theorem evKHom_apply {u : σ → OKbar p} (hu : Small u) (f : MvPowerSeries σ (OL L)) :
    evKHom hu f = evK f u := rfl

theorem evK_X {u : σ → OKbar p} (hu : Small u) (s : σ) :
    evK (X s : MvPowerSeries σ (OL L)) u = u s :=
  incOK_injective (L := L) (by rw [incOK_evK _ hu, FGL.ev_X])

theorem small_evK {τ : Type} [Finite τ] {a : τ → MvPowerSeries σ (OL L)}
    (ha : ∀ t, constantCoeff (a t) = 0) {u : σ → OKbar p} (hu : Small u) :
    Small fun t => evK (a t) u := fun t => by
  rw [← norm_incOK (L := L), incOK_evK _ hu]
  exact FGL.norm_ev_lt (ha t) (norm_incOK_lt hu)

/-- **Evaluation commutes with substitution.** -/
theorem evK_subst {τ : Type} [Finite τ] {a : τ → MvPowerSeries σ (OL L)}
    (ha : ∀ t, constantCoeff (a t) = 0) {u : σ → OKbar p} (hu : Small u)
    (h : MvPowerSeries τ (OL L)) :
    evK (h.subst a) u = evK h (fun t => evK (a t) u) := by
  apply incOK_injective (L := L)
  rw [incOK_evK _ hu, incOK_evK _ (small_evK ha hu), FGL.ev_subst ha (norm_incOK_lt hu)]
  congr 1
  funext t
  rw [incOK_evK _ hu]

/-- **Galois equivariance of evaluation.** -/
theorem galOK_evK (τ : PadicAlgCl p ≃ₐ[L] PadicAlgCl p) (f : MvPowerSeries σ (OL L))
    {u : σ → OKbar p} (hu : Small u) :
    galOK τ (evK f u) = evK f (fun s => galOK τ (u s)) := by
  have hu' : Small fun s => galOK τ (u s) := fun s => by
    rw [coe_galOK, norm_gal_apply]; exact hu s
  apply incOK_injective (L := L)
  apply Subtype.ext
  rw [incOK_evK _ hu', coe_incOK, coe_galOK]
  change (((τ.restrictScalars ℚ_[p]) (evK f u : PadicAlgCl p) : PadicAlgCl p) : ℂ_[p]) = _
  rw [← autCp_coe (τ.restrictScalars ℚ_[p]), ← coe_incOK (L := L), incOK_evK _ hu]
  change autCp (AlgEquiv.restrictScalarsHom ℚ_[p] τ) _ = _
  rw [FGL.ev_autCp_of (galFixedOver τ) f (norm_incOK_lt hu)]
  congr 2
  funext s
  apply Subtype.ext
  rw [FGL.autOC_coe, coe_incOK, coe_incOK, autCp_coe, coe_galOK]
  rfl

end Ring

end OL

namespace FGL

open OL

variable {L : IntermediateField ℚ_[p] (PadicAlgCl p)} [FiniteDimensional ℚ_[p] L]

section Pairing

variable {d : ℕ}

/-- `(t_j ↦ u_j, u_j ↦ v_j)` with values in `O_K̄`. -/
def pairK (u v : Fin d → OKbar p) : Fin 2 × Fin d → OKbar p :=
  fun t => if t.1 = 0 then u t.2 else v t.2

omit [FiniteDimensional ℚ_[p] L] in
theorem small_pairK {u v : Fin d → OKbar p} (hu : Small u) (hv : Small v) :
    Small (pairK u v) := fun t => by
  unfold pairK; split_ifs
  · exact hu _
  · exact hv _

variable (F : FGL (OL L) d)

/-- The group law on points with coordinates in `O_K̄`. -/
def addK (u v : Fin d → OKbar p) : Fin d → OKbar p := fun i => evK (F.Φ i) (pairK u v)

theorem small_addK {u v : Fin d → OKbar p} (hu : Small u) (hv : Small v) :
    Small (F.addK u v) :=
  small_evK F.constantCoeff_Φ (small_pairK hu hv)

theorem incOK_addK {u v : Fin d → OKbar p} (hu : Small u) (hv : Small v) (i : Fin d) :
    incOK L (F.addK u v i) =
      FGL.ev p (F.Φ i) (FGL.pairPt (fun j => incOK L (u j)) (fun j => incOK L (v j))) := by
  rw [addK, incOK_evK _ (small_pairK hu hv)]
  congr 1
  funext t
  unfold pairK FGL.pairPt
  split_ifs <;> rfl

/-- **Fontaine's pairing** `u^* ω_l = ∑_j ω_{lj}(u) du_j ∈ Ω_{O_K̄/O_L}` of a point `u` with
coordinates in the maximal ideal of `O_K̄` and the invariant differential
`ω_l = ∑_j (F.invDiff l j) dX_j` ([Fo, §3.3, §5.6]). -/
def pullback (l : Fin d) (u : Fin d → OKbar p) : Ω[OKbar p⁄OL L] :=
  ∑ j, evK (F.invDiff l j) u • D (OL L) (OKbar p) (u j)

/-- **Invariance**: `(u +_F v)^* ω = u^* ω + v^* ω` (chain rule and `Φ^* ω = pr₁^* ω + pr₂^* ω`,
`FGL.sum_invDiff_subst_Φ_mul_pderiv_zero/one`). -/
theorem pullback_addK (l : Fin d) {u v : Fin d → OKbar p} (hu : Small u) (hv : Small v) :
    F.pullback l (F.addK u v) = F.pullback l u + F.pullback l v := by
  set w := pairK u v with hw
  have hw' : Small w := small_pairK hu hv
  have key : ∀ t : Fin 2 × Fin d,
      ∑ i, evK (F.invDiff l i) (F.addK u v) * evK (MvPowerSeries.pderiv (OL L) t (F.Φ i)) w =
        evK (F.invDiff l t.2) (fun m => w (t.1, m)) := by
    intro t
    have h1 : ∀ i, evK (F.invDiff l i) (F.addK u v) = evK ((F.invDiff l i).subst F.Φ) w :=
      fun i => (evK_subst F.constantCoeff_Φ hw' _).symm
    simp_rw [h1, ← evKHom_apply hw', ← map_mul, ← map_sum]
    obtain ⟨k, j⟩ := t
    have h2 : ∑ i, (F.invDiff l i).subst F.Φ * MvPowerSeries.pderiv (OL L) (k, j) (F.Φ i) =
        (F.invDiff l j).subst (fun m => (X (k, m) : MvPowerSeries (Fin 2 × Fin d) (OL L))) := by
      fin_cases k
      · exact F.sum_invDiff_subst_Φ_mul_pderiv_zero l j
      · exact F.sum_invDiff_subst_Φ_mul_pderiv_one l j
    rw [h2, evKHom_apply, evK_subst (fun m => constantCoeff_X _) hw']
    congr 1
    funext m
    exact evK_X hw' _
  have hD : ∀ i, D (OL L) (OKbar p) (F.addK u v i) =
      ∑ t, evK (MvPowerSeries.pderiv (OL L) t (F.Φ i)) w • D (OL L) (OKbar p) (w t) :=
    fun i => D_evK _ hw'
  simp only [pullback, hD, Finset.smul_sum, smul_smul]
  rw [Finset.sum_comm]
  simp_rw [← Finset.sum_smul, key]
  rw [Fintype.sum_prod_type, Fin.sum_univ_two]
  rfl

theorem pullback_zero (l : Fin d) : F.pullback l (0 : Fin d → OKbar p) = 0 := by
  simp [pullback]

/-- **Galois equivariance of the pairing.** -/
theorem galΩ_pullback (τ : PadicAlgCl p ≃ₐ[L] PadicAlgCl p) (l : Fin d) {u : Fin d → OKbar p}
    (hu : Small u) :
    KaehlerUnion.galΩ (galOK τ) (F.pullback l u) = F.pullback l (fun j => galOK τ (u j)) := by
  simp only [pullback, map_sum, KaehlerUnion.galΩ_smul, KaehlerUnion.galΩ_D]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [galOK_evK τ _ hu]

/-! ### Points with algebraic coordinates -/

/-- A point of `F(m_{ℂ_p})` with coordinates in `O_K̄`. -/
def IsAlg (x : F.Pt p) : Prop := ∃ u : Fin d → OKbar p, ∀ j, incOK L (u j) = x.1 j

/-- The `O_K̄`-coordinates of an algebraic point (`0` otherwise). -/
def coordK (x : F.Pt p) : Fin d → OKbar p :=
  open Classical in if h : F.IsAlg x then h.choose else 0

omit [FiniteDimensional ℚ_[p] L] in
theorem incOK_coordK {x : F.Pt p} (hx : F.IsAlg x) (j : Fin d) :
    incOK L (F.coordK x j) = x.1 j := by
  rw [coordK, dif_pos hx]
  exact hx.choose_spec j

omit [FiniteDimensional ℚ_[p] L] in
theorem coordK_eq {x : F.Pt p} {u : Fin d → OKbar p} (hu : ∀ j, incOK L (u j) = x.1 j) :
    F.coordK x = u := funext fun j =>
  incOK_injective (L := L) (by rw [F.incOK_coordK ⟨u, hu⟩, hu])

omit [FiniteDimensional ℚ_[p] L] in
theorem small_coordK (x : F.Pt p) : Small (F.coordK x) := by
  by_cases hx : F.IsAlg x
  · intro j
    rw [← norm_incOK (L := L), F.incOK_coordK hx]
    exact x.2 j
  · intro j
    rw [coordK, dif_neg hx]
    simp

omit [FiniteDimensional ℚ_[p] L] in
theorem isAlg_zero : F.IsAlg 0 := ⟨0, fun j => by simp⟩

omit [FiniteDimensional ℚ_[p] L] in
theorem coordK_zero : F.coordK 0 = 0 := F.coordK_eq fun j => by simp

theorem incOK_addK_coordK {x y : F.Pt p} (hx : F.IsAlg x) (hy : F.IsAlg y) (j : Fin d) :
    incOK L (F.addK (F.coordK x) (F.coordK y) j) = (x + y).1 j := by
  rw [F.incOK_addK (F.small_coordK x) (F.small_coordK y), add_val]
  congr 1
  funext t
  unfold pairPt
  split_ifs
  · exact F.incOK_coordK hx _
  · exact F.incOK_coordK hy _

theorem isAlg_add {x y : F.Pt p} (hx : F.IsAlg x) (hy : F.IsAlg y) : F.IsAlg (x + y) :=
  ⟨_, F.incOK_addK_coordK hx hy⟩

theorem coordK_add {x y : F.Pt p} (hx : F.IsAlg x) (hy : F.IsAlg y) :
    F.coordK (x + y) = F.addK (F.coordK x) (F.coordK y) :=
  F.coordK_eq (F.incOK_addK_coordK hx hy)

/-- Fontaine's pairing on points: `⟨x, ω_l⟩ = x^* ω_l`. -/
def pairing (l : Fin d) (x : F.Pt p) : Ω[OKbar p⁄OL L] := F.pullback l (F.coordK x)

theorem pairing_zero (l : Fin d) : F.pairing l 0 = 0 := by
  rw [pairing, coordK_zero, pullback_zero]

theorem pairing_add (l : Fin d) {x y : F.Pt p} (hx : F.IsAlg x) (hy : F.IsAlg y) :
    F.pairing l (x + y) = F.pairing l x + F.pairing l y := by
  rw [pairing, F.coordK_add hx hy, F.pullback_addK l (F.small_coordK x) (F.small_coordK y)]
  rfl

theorem isAlg_nsmul {x : F.Pt p} (hx : F.IsAlg x) (n : ℕ) : F.IsAlg (n • x) := by
  induction n with
  | zero => rw [zero_smul]; exact F.isAlg_zero
  | succ n ih => rw [succ_nsmul]; exact F.isAlg_add ih hx

theorem pairing_nsmul (l : Fin d) {x : F.Pt p} (hx : F.IsAlg x) (n : ℕ) :
    F.pairing l (n • x) = n • F.pairing l x := by
  induction n with
  | zero => rw [zero_smul, zero_smul, pairing_zero]
  | succ n ih => rw [succ_nsmul, F.pairing_add l (F.isAlg_nsmul hx n) hx, ih, succ_nsmul]

end Pairing

end FGL

namespace PDivFGL

open OL FGL

variable {L : IntermediateField ℚ_[p] (PadicAlgCl p)} [FiniteDimensional ℚ_[p] L] {d : ℕ}
  (P : PDivFGL (OL L) d p)

omit [FiniteDimensional ℚ_[p] L] in
/-- **Torsion points have coordinates in `O_K̄`** (they are points of the finite flat group
scheme `F[p^v]`, whose coordinate ring is finite over `O_L`). -/
theorem isAlg_of_mem_torsionBy {v : ℕ} {x : P.F.Pt p} (hx : x ∈ P.F.torsionBy v) :
    P.F.IsAlg x := by
  choose u hu using fun j => exists_incOK_eq_of_isIntegral (L := L)
    ((Algebra.IsIntegral.isIntegral (R := OL L) (P.t v j)).map (P.F.layerPt v ⟨x, hx⟩))
  exact ⟨u, fun j => (hu j).trans (P.F.layerPt_X ⟨x, hx⟩ j)⟩

omit [FiniteDimensional ℚ_[p] L] in
theorem isAlg_val (x : Kummer.Tp (P.F.Pt p) p) (k : ℕ) : P.F.IsAlg (Kummer.val _ p x k) :=
  P.isAlg_of_mem_torsionBy (v := k) ((P.F.mem_torsionBy).mpr (Kummer.pow_smul_val x k))

/-- **Fontaine's map on the Tate module** `ρ_l(x) = (x_k^* ω_l)_k ∈ T_p(Ω_{O_K̄/O_L})`. -/
def rhoSeq (l : Fin d) (x : Kummer.Tp (P.F.Pt p) p) : ℕ → Ω[OKbar p⁄OL L] :=
  fun k => P.F.pairing l (Kummer.val _ p x k)

theorem rhoSeq_zero (l : Fin d) (x : Kummer.Tp (P.F.Pt p) p) : P.rhoSeq l x 0 = 0 := by
  rw [rhoSeq, Kummer.val_zero, pairing_zero]

theorem rhoSeq_succ (l : Fin d) (x : Kummer.Tp (P.F.Pt p) p) (k : ℕ) :
    (p : OKbar p) • P.rhoSeq l x (k + 1) = P.rhoSeq l x k := by
  rw [rhoSeq, rhoSeq, Nat.cast_smul_eq_nsmul, ← P.F.pairing_nsmul l (P.isAlg_val x (k + 1)),
    Kummer.val_succ]

theorem rhoSeq_add (l : Fin d) (x y : Kummer.Tp (P.F.Pt p) p) :
    P.rhoSeq l (x + y) = P.rhoSeq l x + P.rhoSeq l y := by
  funext k
  rw [rhoSeq, map_add, Pi.add_apply, P.F.pairing_add l (P.isAlg_val x k) (P.isAlg_val y k)]
  rfl

omit [FiniteDimensional ℚ_[p] L] in
theorem coordK_galPt (σ : L.fixingSubgroup) {x : P.F.Pt p} (hx : P.F.IsAlg x) :
    P.F.coordK (galPt (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) x) =
      fun j => galOK (IntermediateField.fixingSubgroupEquiv L σ) (P.F.coordK x j) := by
  refine P.F.coordK_eq fun j => Subtype.ext ?_
  rw [coe_incOK, coe_galOK, galPt_val, ← P.F.incOK_coordK hx j, coe_incOK, autCp_coe]
  rfl

theorem rhoSeq_tpRep (l : Fin d) (σ : L.fixingSubgroup) (x : Kummer.Tp (P.F.Pt p) p) :
    P.rhoSeq l (Kummer.tpRep P.galRepOL p σ x) = fun k =>
      KaehlerUnion.galΩ (galOK (IntermediateField.fixingSubgroupEquiv L σ)) (P.rhoSeq l x k) := by
  funext k
  rw [rhoSeq, rhoSeq, Kummer.val_tpRep, pairing, pairing, FGL.galRep_apply,
    P.coordK_galPt σ (P.isAlg_val x k), galΩ_pullback _ _ _ (P.F.small_coordK _)]

variable {ε : ℕ → PadicAlgCl p} (hε : ∀ n, IsPrimitiveRoot (ε (n + 1)) (p ^ (n + 1)))
  (hεp : ∀ n, ε (n + 2) ^ p = ε (n + 1))

/-- **Fontaine's pairing with values in `ℂ_p(1)`** ([Fo, §5.6]): `ρ(ω_l)(x) = τ((x_k^* ω_l)_k)`,
`T_p(Ω_{O_K̄/O_L}) ≅ 𝔞̂_L(1) ⊂ ℂ_p(1)` via `ξ` ([Fo, Thm 1′], `OL.tau`; the twist is trivialised
by `ε`). -/
def rho (l : Fin d) (x : Kummer.Tp (P.F.Pt p) p) : ℂ_[p] := tau L hε (P.rhoSeq l x)

variable {hε}

include hεp in
theorem rho_add (l : Fin d) (x y : Kummer.Tp (P.F.Pt p) p) :
    P.rho hε l (x + y) = P.rho hε l x + P.rho hε l y := by
  rw [rho, rho, rho, rhoSeq_add, tau_add hεp (P.rhoSeq_succ l x) (P.rhoSeq_succ l y)]

include hεp in
/-- **Integrality** ([Fo, Thm 1′]): `|ρ(ω_l)(x)| ≤ (‖𝔇_{L/ℚ_p}‖ |ε_1 - 1|)⁻¹`, i.e.
`v(ρ(ω_l)(x)) ≥ -v(𝔇_{L/ℚ_p}) - 1/(p-1)`. -/
theorem norm_rho_le (l : Fin d) (x : Kummer.Tp (P.F.Pt p) p) :
    ‖P.rho hε l x‖ ≤ (dL L * ‖ε 1 - 1‖)⁻¹ :=
  norm_tau_le hεp (P.rhoSeq_succ l x) (P.rhoSeq_zero l x)

include hεp in
/-- **Galois equivariance**: `ρ(ω_l)(σ x) = χ(σ) σ(ρ(ω_l)(x))` for `σ ∈ G_L`. -/
theorem rho_tpRep (l : Fin d) (σ : L.fixingSubgroup) (x : Kummer.Tp (P.F.Pt p) p) :
    P.rho hε l (Kummer.tpRep P.galRepOL p σ x) =
      algebraMap ℚ_[p] ℂ_[p] ((chi ((IntermediateField.fixingSubgroupEquiv L σ).restrictScalars
          ℚ_[p]) : ℤ_[p]ˣ) : ℤ_[p]) *
        galCp L (IntermediateField.fixingSubgroupEquiv L σ) (P.rho hε l x) := by
  rw [rho, rhoSeq_tpRep, tau_galΩ hεp (P.rhoSeq_succ l x)]
  rfl

/-- **The `ℂ_p`-linear Fontaine map** `ρ : ℂ_p ⊗ ω_F → Hom_{ℤ_p}(T_p F, ℂ_p(1))`,
`ρ(∑_l c_l ω_l)(x) = ∑_l c_l ρ(ω_l)(x)`. -/
def rhoLin (c : Fin d → ℂ_[p]) (x : Kummer.Tp (P.F.Pt p) p) : ℂ_[p] :=
  ∑ l, c l * P.rho hε l x

include hεp in
theorem rhoLin_add (c : Fin d → ℂ_[p]) (x y : Kummer.Tp (P.F.Pt p) p) :
    P.rhoLin (hε := hε) c (x + y) = P.rhoLin (hε := hε) c x + P.rhoLin (hε := hε) c y := by
  simp only [rhoLin, P.rho_add hεp, mul_add, Finset.sum_add_distrib]

include hεp in
/-- **(FoInt)(a), integrality**: for `c ∈ O_{ℂ_p}^d` (in particular `c ∈ O_{K'}^d`),
`|ρ(ω_c)(x)| ≤ (‖𝔇_{L/ℚ_p}‖ |ε_1 - 1|)⁻¹`. -/
theorem norm_rhoLin_le {c : Fin d → ℂ_[p]} (hc : ∀ l, ‖c l‖ ≤ 1) (x : Kummer.Tp (P.F.Pt p) p) :
    ‖P.rhoLin (hε := hε) c x‖ ≤ (dL L * ‖ε 1 - 1‖)⁻¹ := by
  have hR : 0 ≤ (dL L * ‖ε 1 - 1‖)⁻¹ :=
    inv_nonneg.mpr (mul_nonneg (dnorm_pos (L := ⊥) (E := L)).le (norm_nonneg _))
  refine IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg hR fun l _ => ?_
  rw [norm_mul]
  calc ‖c l‖ * ‖P.rho hε l x‖ ≤ 1 * (dL L * ‖ε 1 - 1‖)⁻¹ :=
        mul_le_mul (hc l) (P.norm_rho_le hεp l x) (norm_nonneg _) zero_le_one
    _ = _ := one_mul _

include hεp in
/-- **(FoInt)(a)**: there is `c_a` (depending only on `L`) such that `p^{c_a} ρ` maps
`O_{ℂ_p}^d × T_p F` into `O_{ℂ_p}`. -/
theorem exists_pow_mul_rhoLin_le :
    ∃ N : ℕ, ∀ c : Fin d → ℂ_[p], (∀ l, ‖c l‖ ≤ 1) → ∀ x : Kummer.Tp (P.F.Pt p) p,
      ‖(p : ℂ_[p]) ^ N * P.rhoLin (hε := hε) c x‖ ≤ 1 := by
  have hp1 : ‖(p : ℂ_[p])‖ < 1 := by
    rw [← map_natCast (algebraMap ℚ_[p] ℂ_[p]), norm_algebraMap', Padic.norm_p]
    exact inv_lt_one_of_one_lt₀ (by exact_mod_cast hp.out.one_lt)
  have hRpos : 0 < dL L * ‖ε 1 - 1‖ := mul_pos (dnorm_pos (L := ⊥) (E := L))
    (norm_eps_one_sub_one_pos hε)
  obtain ⟨N, hN⟩ := exists_pow_lt_of_lt_one hRpos hp1
  refine ⟨N, fun c hc x => ?_⟩
  rw [norm_mul, norm_pow]
  calc ‖(p : ℂ_[p])‖ ^ N * ‖P.rhoLin (hε := hε) c x‖ ≤
        (dL L * ‖ε 1 - 1‖) * (dL L * ‖ε 1 - 1‖)⁻¹ :=
        mul_le_mul hN.le (P.norm_rhoLin_le hεp hc x) (norm_nonneg _) hRpos.le
    _ = 1 := mul_inv_cancel₀ hRpos.ne'

/-- **Independence of the base** `K' ⊇ L`: computing the pairing in `Ω_{O_K̄/O_{K'}}` and
identifying its Tate module via `ξ_{K'}` gives the same `ℂ_p`-valued map. -/
theorem tau_map_rhoSeq (hεp : ∀ n, ε (n + 2) ^ p = ε (n + 1))
    {E : IntermediateField ℚ_[p] (PadicAlgCl p)} [Fact (L ≤ E)] [FiniteDimensional ℚ_[p] E]
    (l : Fin d) (x : Kummer.Tp (P.F.Pt p) p) :
    tau E hε (fun k => KaehlerDifferential.map (OL L) (OL E) (OKbar p) (OKbar p)
      (P.rhoSeq l x k)) = P.rho hε l x :=
  tau_map hεp (P.rhoSeq_succ l x)

end PDivFGL

end PadicHodge
