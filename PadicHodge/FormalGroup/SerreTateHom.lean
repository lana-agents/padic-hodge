import PadicHodge.FormalGroup.LayerLimit
import PadicHodge.FormalGroup.FGLHom

/-!
# Serre–Tate: `Hom(F, F') = Hom(F[p^∞], F'[p^∞])` ([Hong, Thm. 2.2.16], full faithfulness)

Let `P`, `P'` be `p`-divisible formal group laws (dimensions `d`, `d'`) over a complete local
ring `R` with `p ∈ 𝔪_R`. The functor `F ↦ F[p^∞]` (`FGL.Hom.toPDiv`) is bijective on
homomorphisms (`FGL.Hom.pdivEquiv`):

* injectivity: `f ≡ f'` modulo every `J_v` forces `f = f'` (`⋂_v J_v = 0`);
* surjectivity: a homomorphism `(ψ_v : A'_v → A_v)` gives the compatible family
  `(ψ_v(t'_k))_v`, hence a power series `f_k ∈ R[[T]]` (`R[[T]] ≅ lim_v A_v`,
  [Hong, Lemma 2.2.15]); the identity `f(Φ(T, U)) = Φ'(f(T), f(U))` holds in every
  `A_v ⊗ A_v` (the `ψ_v` respect the comultiplications), and **a power series in `(T, U)`
  vanishing in all `A_v ⊗ A_v` is zero** (`eq_zero_of_evF_pair`). For the latter we compare
  `R[[T, U]] → A_v ⊗ A_v → R[[T, U]]/K_v` (`K_v` generated by `[p^v](T)`, `[p^v](U)`) with the
  quotient map: they agree on polynomials and on `(T, U)^D` up to `(T, U)^D`, so the kernel of
  `R[[T, U]] → A_v ⊗ A_v` lies in `⋂_D (K_v + (T, U)^D) ⊆ N_v` (coefficient filtration).

This is [Hong, Thm. 2.2.16, proof, first paragraph] ("`Hom(μ, ν) = … = Hom(μ[p^∞], ν[p^∞])`"),
where the identification `A ⊗̂ A = lim_v A_v ⊗ A_v` is used implicitly.
-/

noncomputable section

open MvPowerSeries IsLocalRing PadicHodge.AdicEval TensorProduct

namespace PadicHodge

universe u

namespace PDivFGL

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsAdicComplete (maximalIdeal R) R]
  {d p : ℕ} [hp : Fact p.Prime] (P : PDivFGL R d p)

attribute [local instance] isAdicComplete_free

local notation "𝔪R" => maximalIdeal R

/-- The substitution `T ↦ T` (`a = 0`) or `T ↦ U` (`a = 1`), `R[[T]] → R[[T, U]]`. -/
def substXv (a : Fin 2) : MvPowerSeries (Fin d) R →ₐ[R] MvPowerSeries (Fin 2 × Fin d) R :=
  substAlgHom (FGL.hasSubst_of_noConst (FGL.noConst_Xv (R := R) (d := d) a))

omit [IsLocalRing R] [IsAdicComplete (maximalIdeal R) R] hp in
theorem substXv_X (a : Fin 2) (j : Fin d) :
    substXv (R := R) a (X j) = Xv (R := R) a j := by
  rw [substXv, coe_substAlgHom, subst_X (FGL.hasSubst_of_noConst (FGL.noConst_Xv a))]

/-- `K_v = ([p^v](T), [p^v](U))`. -/
def pairIdeal (v : ℕ) : Ideal (MvPowerSeries (Fin 2 × Fin d) R) :=
  Ideal.map (substXv 0) (P.F.layerIdeal p v) ⊔ Ideal.map (substXv 1) (P.F.layerIdeal p v)

omit [IsLocalRing R] [IsAdicComplete (maximalIdeal R) R] hp in
theorem map_substXv_maxPS_le (𝔪 : Ideal R) (a : Fin 2) :
    Ideal.map (substXv (R := R) (d := d) a) (FGL.maxPS (Fin d) 𝔪) ≤ FGL.coeffFilt 𝔪 1 := by
  rw [FGL.maxPS, Ideal.map_sup]
  refine sup_le ?_ ?_
  · rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
    intro r hr
    have hC : substXv (R := R) (d := d) a (C r) = C r := by
      have := (substXv (R := R) (d := d) a).commutes r
      rwa [MvPowerSeries.algebraMap_apply, MvPowerSeries.algebraMap_apply, Algebra.algebraMap_self,
        RingHom.id_apply] at this
    change substXv (R := R) (d := d) a (C r) ∈ FGL.coeffFilt 𝔪 1
    rw [hC]
    exact FGL.C_mem_coeffFilt hr
  · rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
    rw [SetLike.mem_coe, substXv_X]
    exact FGL.X_mem_coeffFilt _

omit [IsAdicComplete (maximalIdeal R) R] hp in
theorem pairIdeal_le_coeffFilt (hpm : (p : R) ∈ 𝔪R) (v : ℕ) :
    P.pairIdeal v ≤ FGL.coeffFilt 𝔪R v := by
  have key : ∀ a : Fin 2, Ideal.map (substXv (R := R) (d := d) a) (P.F.layerIdeal p v) ≤
      FGL.coeffFilt 𝔪R v := by
    intro a
    refine (Ideal.map_mono (P.F.layerIdeal_le_pow p hpm v)).trans ?_
    rw [Ideal.map_pow]
    exact (Ideal.pow_right_mono (map_substXv_maxPS_le 𝔪R a) _).trans
      ((FGL.coeffFilt_pow_le _).trans (FGL.coeffFilt_antitone (Nat.le_succ v)))
  exact sup_le (key 0) (key 1)

/-- `A_v → R[[T, U]]/K_v`, `t ↦ T` or `t ↦ U`. -/
def toPairQuot (v : ℕ) (a : Fin 2) :
    P.A v →ₐ[R] MvPowerSeries (Fin 2 × Fin d) R ⧸ P.pairIdeal v :=
  P.liftL v ((Ideal.Quotient.mkₐ R (P.pairIdeal v)).comp (substXv a)) fun j => by
    rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
    have := Ideal.mem_map_of_mem (substXv (R := R) (d := d) a) (P.F.mulPS_mem_layerIdeal p v j)
    fin_cases a
    · exact Ideal.mem_sup_left this
    · exact Ideal.mem_sup_right this

/-- `α : A_v ⊗ A_v → R[[T, U]]/K_v`. -/
def pairQuot (v : ℕ) : P.A v ⊗[R] P.A v →ₐ[R] MvPowerSeries (Fin 2 × Fin d) R ⧸ P.pairIdeal v :=
  Algebra.TensorProduct.lift (P.toPairQuot v 0) (P.toPairQuot v 1) fun _ _ => Commute.all _ _

/-- `R[[T, U]] → A_v ⊗ A_v`, `(T, U) ↦ (t ⊗ 1, 1 ⊗ t)`. -/
def evPair (v : ℕ) : MvPowerSeries (Fin 2 × Fin d) R →ₐ[R] P.A v ⊗[R] P.A v :=
  evalT (FGL.pairS (P.tL v) (P.tR v)) (FGL.tnf_pairS (P.tnf_tL v) (P.tnf_tR v))

theorem pairQuot_evPair_X (v : ℕ) (x : Fin 2 × Fin d) :
    P.pairQuot v (P.evPair v (X x)) = Ideal.Quotient.mk (P.pairIdeal v) (X x) := by
  obtain ⟨a, j⟩ := x
  rw [evPair, evalT_X]
  unfold FGL.pairS
  fin_cases a
  · simp only [Fin.zero_eta, Fin.isValue, if_true, tL, pairQuot,
      Algebra.TensorProduct.lift_tmul, map_one, mul_one, toPairQuot, liftL_t, AlgHom.comp_apply,
      substXv_X, Ideal.Quotient.mkₐ_eq_mk, Xv]
  · simp only [Fin.mk_one, Fin.isValue, one_ne_zero, if_false, tR, pairQuot,
      Algebra.TensorProduct.lift_tmul, map_one, one_mul, toPairQuot, liftL_t, AlgHom.comp_apply,
      substXv_X, Ideal.Quotient.mkₐ_eq_mk, Xv]

/-- **The kernel of `R[[T, U]] → A_v ⊗ A_v` lies in `K_v + (T, U)^D` for every `D`.** -/
theorem mem_pairIdeal_sup_of_evPair (v D : ℕ) {g : MvPowerSeries (Fin 2 × Fin d) R}
    (hg : P.evPair v g = 0) :
    g ∈ P.pairIdeal v ⊔ Ideal.span (Set.range X) ^ D := by
  set φ1 := (P.pairQuot v).comp (P.evPair v)
  set φ2 := Ideal.Quotient.mkₐ R (P.pairIdeal v)
  have hX : ∀ x, φ1 (X x) = φ2 (X x) := fun x => P.pairQuot_evPair_X v x
  -- agreement on polynomials
  have hpoly : ∀ q : MvPolynomial (Fin 2 × Fin d) R, φ1 q = φ2 q := by
    intro q
    have : φ1.toRingHom.comp MvPolynomial.coeToMvPowerSeries.ringHom =
        φ2.toRingHom.comp MvPolynomial.coeToMvPowerSeries.ringHom := by
      refine MvPolynomial.ringHom_ext (fun r => ?_) fun x => ?_
      · simp only [RingHom.comp_apply, MvPolynomial.coeToMvPowerSeries.ringHom_apply,
          MvPolynomial.coe_C]
        have e : (C r : MvPowerSeries (Fin 2 × Fin d) R) =
            algebraMap R (MvPowerSeries (Fin 2 × Fin d) R) r := by
          rw [MvPowerSeries.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
        rw [e]
        exact (φ1.commutes r).trans (φ2.commutes r).symm
      · simp only [RingHom.comp_apply, MvPolynomial.coeToMvPowerSeries.ringHom_apply,
          MvPolynomial.coe_X]
        exact hX x
    exact congrArg (fun φ => φ q) this
  -- the ideal images
  have hI : ∀ φ : MvPowerSeries (Fin 2 × Fin d) R →ₐ[R]
      MvPowerSeries (Fin 2 × Fin d) R ⧸ P.pairIdeal v, (∀ x, φ (X x) = φ2 (X x)) →
      Ideal.map φ (Ideal.span (Set.range X) ^ D) =
        Ideal.map φ2 (Ideal.span (Set.range X) ^ D) := by
    intro φ hφ
    rw [Ideal.map_pow, Ideal.map_pow, Ideal.map_span, Ideal.map_span, ← Set.range_comp,
      ← Set.range_comp]
    congr 3
    funext x
    exact hφ x
  set q := truncTotal D g
  have hr := AdicEval.sub_truncTotal_mem D g
  have h1 := Ideal.mem_map_of_mem φ1 hr
  rw [hI φ1 hX] at h1
  have h2 := Ideal.mem_map_of_mem φ2 hr
  have hφ1 : φ1 g = 0 := by
    change P.pairQuot v (P.evPair v g) = 0
    rw [hg, map_zero]
  rw [map_sub, hφ1, hpoly, zero_sub, neg_mem_iff] at h1
  have h3 := sub_mem h2 (neg_mem h1)
  rw [map_sub, sub_neg_eq_add, sub_add_cancel] at h3
  obtain ⟨x, hx, hxg⟩ := (Ideal.mem_map_iff_of_surjective φ2
    (Ideal.Quotient.mkₐ_surjective R (P.pairIdeal v))).mp h3
  have hgx : g - x ∈ P.pairIdeal v := by
    rw [← Ideal.Quotient.eq]
    exact hxg.symm
  have := Submodule.add_mem_sup hgx hx
  rwa [sub_add_cancel] at this

/-- **A power series in `(T, U)` vanishing in every `A_v ⊗ A_v` is zero.** -/
theorem eq_zero_of_evPair (hpm : (p : R) ∈ 𝔪R) {g : MvPowerSeries (Fin 2 × Fin d) R}
    (hg : ∀ v, P.evPair v g = 0) : g = 0 :=
  FGL.eq_zero_of_mem_coeffFilt fun v =>
    sup_le (P.pairIdeal_le_coeffFilt hpm v) (FGL.pow_span_X_le_coeffFilt v)
      (P.mem_pairIdeal_sup_of_evPair v v (hg v))

theorem evPair_eq (v : ℕ) (g : MvPowerSeries (Fin 2 × Fin d) R) :
    P.evPair v g = FGL.evF 𝔪R (FGL.pairS (P.tL v) (P.tR v)) g := by
  rw [FGL.evF_of (FGL.tnf_pairS (P.tnf_tL v) (P.tnf_tR v))]
  rfl

/-- `f(T)` evaluated at `(t ⊗ 1, 1 ⊗ t)` is `f(t) ⊗ 1`, `f(U)` gives `1 ⊗ f(t)`. -/
theorem evF_pair_subst_Xv (v : ℕ) {f : MvPowerSeries (Fin d) R} (a : Fin 2) :
    FGL.evF 𝔪R (FGL.pairS (P.tL v) (P.tR v)) (f.subst (Xv (R := R) a)) =
      if a = 0 then Ideal.Quotient.mk _ f ⊗ₜ 1 else 1 ⊗ₜ Ideal.Quotient.mk _ f := by
  have hx := FGL.tnf_pairS (P.tnf_tL v) (P.tnf_tR v)
  rw [FGL.evF_subst hx (FGL.noConst_Xv a)]
  simp only [FGL.evF_pairS_Xv (P.tnf_tL v) (P.tnf_tR v)]
  split_ifs
  · rw [show (fun j => P.tL v j) = fun j => (Algebra.TensorProduct.includeLeft (S := R) (R := R)
        (A := P.A v) (B := P.A v)) (P.t v j) from rfl,
      ← FGL.evF_comp _ (P.tnf_t v), evF_t]
    rfl
  · rw [show (fun j => P.tR v j) = fun j => (Algebra.TensorProduct.includeRight (R := R)
        (A := P.A v) (B := P.A v)) (P.t v j) from rfl,
      ← FGL.evF_comp _ (P.tnf_t v), evF_t]
    rfl

/-- `f(Φ(T, U))` evaluated at `(t ⊗ 1, 1 ⊗ t)` is `Δ(f(t))`. -/
theorem evF_pair_subst_addPS (v : ℕ) (f : MvPowerSeries (Fin d) R) :
    FGL.evF 𝔪R (FGL.pairS (P.tL v) (P.tR v))
        (f.subst (P.F.addPS (Xv (R := R) (n := 2) 0) (Xv 1))) =
      P.comul v (Ideal.Quotient.mk _ f) := by
  have hx := FGL.tnf_pairS (P.tnf_tL v) (P.tnf_tR v)
  rw [FGL.evF_subst hx (P.F.noConst_addPS (FGL.noConst_Xv 0) (FGL.noConst_Xv 1))]
  have e : (fun j => FGL.evF 𝔪R (FGL.pairS (P.tL v) (P.tR v))
      (P.F.addPS (Xv (R := R) (n := 2) 0) (Xv 1) j)) = fun j => P.comul v (P.t v j) := by
    funext j
    rw [P.F.evF_addPS hx (FGL.noConst_Xv 0) (FGL.noConst_Xv 1), comul_t, wΔ]
    congr 1 <;> funext i <;> rw [FGL.evF_pairS_Xv (P.tnf_tL v) (P.tnf_tR v)] <;> simp
  rw [e, ← FGL.evF_comp _ (P.tnf_t v), evF_t]

end PDivFGL

namespace FGL.Hom

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsAdicComplete (maximalIdeal R) R]
  {d d' p : ℕ} [hp : Fact p.Prime] {P : PDivFGL R d p} {P' : PDivFGL R d' p}

attribute [local instance] PDivFGL.isAdicComplete_free

local notation "𝔪R" => maximalIdeal R

omit [IsLocalRing R] [IsAdicComplete (maximalIdeal R) R] in
/-- Equality of homomorphisms of formal group laws is equality of the power series. -/
theorem ext_f {F : FGL R d} {F' : FGL R d'} {φ φ' : FGL.Hom F F'} (h : φ.f = φ'.f) :
    φ = φ' := by
  cases φ; cases φ'; cases h; rfl

theorem layerMap_apply_t (φ : FGL.Hom P.F P'.F) (v : ℕ) (k : Fin d') :
    φ.layerMap v (P'.t v k) = Ideal.Quotient.mk _ (φ.f k) := by
  rw [layerMap_t, fE, PDivFGL.evF_t]

/-- **Faithfulness of `F ↦ F[p^∞]`.** -/
theorem toPDiv_injective (hpm : (p : R) ∈ 𝔪R) :
    Function.Injective (toPDiv (P := P) (P' := P')) := by
  intro φ φ' h
  refine ext_f (funext fun k => sub_eq_zero.mp (FGL.eq_zero_of_mem_layerIdeal P.F p hpm
    fun v => ?_))
  rw [← Ideal.Quotient.eq, ← layerMap_apply_t, ← layerMap_apply_t]
  have := congrArg (fun ψ : PDivGroup.Hom P.pdivGroup P'.pdivGroup => ψ.f v (P'.t v k)) h
  exact this

theorem pdiv_compat (ψ : PDivGroup.Hom P.pdivGroup P'.pdivGroup) (k : Fin d') (v : ℕ) :
    P.F.layerIncl p v (ψ.f (v + 1) (P'.t (v + 1) k)) = ψ.f v (P'.t v k) := by
  have h := DFunLike.congr_fun (ψ.comm v) (P'.t (v + 1) k)
  simp only [BialgHom.coe_comp, Function.comp_apply] at h
  rw [← PDivFGL.layerIncl_t P' v k]
  exact h

/-- The power series `f_k = lim_v ψ_v(t'_k)`. -/
def ofPDivF (hpm : (p : R) ∈ 𝔪R)
    (ψ : PDivGroup.Hom P.pdivGroup P'.pdivGroup) (k : Fin d') :
    MvPowerSeries (Fin d) R :=
  (P.exists_mk_eq hpm (fun v => ψ.f v (P'.t v k)) (pdiv_compat ψ k)).choose

theorem mk_ofPDivF (hpm : (p : R) ∈ 𝔪R)
    (ψ : PDivGroup.Hom P.pdivGroup P'.pdivGroup) (k : Fin d') (v : ℕ) :
    Ideal.Quotient.mk (P.F.layerIdeal p v) (ofPDivF hpm ψ k) = ψ.f v (P'.t v k) :=
  (P.exists_mk_eq hpm (fun v => ψ.f v (P'.t v k)) (pdiv_compat ψ k)).choose_spec v

theorem noConst_ofPDivF (hpm : (p : R) ∈ 𝔪R)
    (ψ : PDivGroup.Hom P.pdivGroup P'.pdivGroup) (k : Fin d') :
    constantCoeff (ofPDivF hpm ψ k) = 0 := by
  have h := congrArg (P.counit 0) (mk_ofPDivF hpm ψ k 0)
  rw [PDivFGL.counit, PDivFGL.liftL_mk] at h
  letI := P.hopfAlgebra 0
  letI := P'.hopfAlgebra 0
  have hc : P.counit 0 (ψ.f 0 (P'.t 0 k)) = P'.counit 0 (P'.t 0 k) :=
    CoalgHomClass.counit_comp_apply (ψ.f 0) (P'.t 0 k)
  rw [← PDivFGL.counit, hc, PDivFGL.counit_t] at h
  exact h

theorem map_add_ofPDivF (hpm : (p : R) ∈ 𝔪R)
    (ψ : PDivGroup.Hom P.pdivGroup P'.pdivGroup) (k : Fin d') :
    (ofPDivF hpm ψ k).subst (P.F.addPS (Xv (R := R) (n := 2) 0) (Xv 1)) =
      P'.F.addPS (fun l => (ofPDivF hpm ψ l).subst (Xv (R := R) (d := d) (n := 2) 0))
        (fun l => (ofPDivF hpm ψ l).subst (Xv (R := R) (d := d) (n := 2) 1)) k := by
  refine sub_eq_zero.mp (P.eq_zero_of_evPair hpm fun v => ?_)
  rw [map_sub, sub_eq_zero, PDivFGL.evPair_eq, PDivFGL.evPair_eq, P.evF_pair_subst_addPS,
    P'.F.evF_addPS (FGL.tnf_pairS (P.tnf_tL v) (P.tnf_tR v))
      (fun l => constantCoeff_subst_eq_zero (FGL.hasSubst_of_noConst (FGL.noConst_Xv 0))
        (FGL.noConst_Xv 0) (noConst_ofPDivF hpm ψ l))
      (fun l => constantCoeff_subst_eq_zero (FGL.hasSubst_of_noConst (FGL.noConst_Xv 1))
        (FGL.noConst_Xv 1) (noConst_ofPDivF hpm ψ l))]
  simp only [P.evF_pair_subst_Xv, if_true, show (1 : Fin 2) ≠ 0 from by decide, if_false,
    mk_ofPDivF]
  letI := P.hopfAlgebra v
  letI := P'.hopfAlgebra v
  have hc : P.comul v (ψ.f v (P'.t v k)) =
      Algebra.TensorProduct.map (ψ.f v : P'.A v →ₐ[R] P.A v) (ψ.f v : P'.A v →ₐ[R] P.A v)
        (P'.comul v (P'.t v k)) :=
    (CoalgHomClass.map_comp_comul_apply (ψ.f v) (P'.t v k)).symm
  rw [hc, PDivFGL.comul_t, PDivFGL.wΔ]
  refine P'.addE_map _ (P'.tnf_tL v) (P'.tnf_tR v) (fun l => ?_) (fun l => ?_) k
  · simp [PDivFGL.tL]
  · simp [PDivFGL.tR]

/-- **The homomorphism of formal group laws `F → F'` induced by `ψ : F[p^∞] → F'[p^∞]`.** -/
def ofPDiv (hpm : (p : R) ∈ 𝔪R)
    (ψ : PDivGroup.Hom P.pdivGroup P'.pdivGroup) : FGL.Hom P.F P'.F where
  f := ofPDivF hpm ψ
  noConst := noConst_ofPDivF hpm ψ
  map_add := map_add_ofPDivF hpm ψ

theorem toPDiv_ofPDiv (hpm : (p : R) ∈ 𝔪R)
    (ψ : PDivGroup.Hom P.pdivGroup P'.pdivGroup) :
    (ofPDiv hpm ψ).toPDiv = ψ := by
  obtain ⟨f, comm⟩ := ψ
  have hf : (ofPDiv hpm ⟨f, comm⟩).toPDiv.f = f := by
    funext v
    refine BialgHom.coe_toAlgHom_injective (P'.algHom_ext_A v fun k => ?_)
    change (ofPDiv hpm ⟨f, comm⟩).layerMap v (P'.t v k) = f v (P'.t v k)
    rw [layerMap_apply_t]
    exact mk_ofPDivF hpm ⟨f, comm⟩ k v
  change PDivGroup.Hom.mk _ _ = _
  congr

/-- **Serre–Tate, full faithfulness** ([Hong, Thm. 2.2.16]): for `p`-divisible formal group
laws over a complete local ring with `p ∈ 𝔪`, `Hom(F, F') ≃ Hom(F[p^∞], F'[p^∞])`. -/
def pdivEquiv (hpm : (p : R) ∈ 𝔪R) :
    FGL.Hom P.F P'.F ≃ PDivGroup.Hom P.pdivGroup P'.pdivGroup where
  toFun := toPDiv
  invFun := ofPDiv hpm
  left_inv φ := toPDiv_injective hpm (toPDiv_ofPDiv hpm φ.toPDiv)
  right_inv := toPDiv_ofPDiv hpm

end FGL.Hom


end PadicHodge
