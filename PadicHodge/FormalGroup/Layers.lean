import PadicHodge.FormalGroup.Formal

/-!
# The layers `A_v = R[[T]]/[p^v]_F(I)` of a formal group law

Towards [Hong, Prop. 2.2.10] (the connected `p`-divisible group `F[p^∞]` of a `p`-divisible
formal group law): for a formal group law `F` of dimension `d` over `R`,

* `mem_span_X`: a power series in finitely many variables without constant term lies in the
  ideal `I = (t_1, …, t_d)`; hence `f([g]) ∈ (g_1, …, g_d)` for such `f` (`subst_mem_span`);
* `layerIdeal F p v = ([p^v]_F(t_1), …, [p^v]_F(t_d)) = [p^v]_F(I) A` and
  `layerIdeal_succ_le`: `J_{v+1} ⊆ J_v` (as `[p^{v+1}] = [p] ∘ [p^v]`);
* `Layer F p v = A / J_v` (`A = R[[t_1, …, t_d]]`), the closed immersion
  `layerIncl : A_{v+1} ↠ A_v` (`G_v ↪ G_{v+1}`) and the map `layerP : A_v → A_{v+1}`,
  `f ↦ f([p]_F)` (multiplication by `p`, `G_{v+1} → G_v`; `map_layerIdeal_le`).

Finite freeness of `A_v` (from `[p]_F` finite flat) and the group scheme structure are not done
here (see `Blueprint.md`).
-/

noncomputable section

open MvPowerSeries

namespace PadicHodge

namespace FGL

variable {R : Type*} [CommRing R]

/-- **A power series in `t_1, …, t_d` without constant term lies in `(t_1, …, t_d)`.** -/
theorem mem_span_X {d : ℕ} {f : MvPowerSeries (Fin d) R} (hf : constantCoeff f = 0) :
    f ∈ Ideal.span (Set.range (X : Fin d → MvPowerSeries (Fin d) R)) := by
  classical
  let g : Fin d → MvPowerSeries (Fin d) R := fun j m =>
    if ∀ k < j, m k = 0 then coeff (m + Finsupp.single j 1) f else 0
  have hg : ∀ j m, coeff m (g j) =
      if ∀ k < j, m k = 0 then coeff (m + Finsupp.single j 1) f else 0 := fun _ _ => rfl
  have key : f = ∑ j, X j * g j := by
    ext n
    rw [map_sum]
    simp only [X_def, coeff_monomial_mul, one_mul, hg]
    by_cases hn : n = 0
    · subst hn
      rw [coeff_zero_eq_constantCoeff_apply, hf]
      refine (Finset.sum_eq_zero fun j _ => ?_).symm
      rw [if_neg]
      rw [Finsupp.single_le_iff]
      simp
    · have hne : n.support.Nonempty := Finsupp.support_nonempty_iff.mpr hn
      set j0 := n.support.min' hne
      have hj0 : n j0 ≠ 0 := Finsupp.mem_support_iff.mp (n.support.min'_mem hne)
      have hmin : ∀ k < j0, n k = 0 := fun k hk => by
        by_contra h
        exact absurd (n.support.min'_le k (Finsupp.mem_support_iff.mpr h)) (not_le.mpr hk)
      rw [Finset.sum_eq_single j0]
      · have hle : Finsupp.single j0 1 ≤ n := by
          rw [Finsupp.single_le_iff]; omega
        rw [if_pos hle, if_pos, tsub_add_cancel_of_le hle]
        intro k hk
        rw [Finsupp.tsub_apply, hmin k hk, Nat.zero_sub]
      · intro j _ hj
        by_cases hle : Finsupp.single j 1 ≤ n
        · rw [if_pos hle, if_neg]
          intro hall
          rcases lt_or_gt_of_ne hj with h | h
          · rw [Finsupp.single_le_iff, hmin j h] at hle
            omega
          · have := hall j0 h
            rw [Finsupp.tsub_apply, Finsupp.single_apply, if_neg h.ne'] at this
            omega
        · rw [if_neg hle]
      · intro h; exact absurd (Finset.mem_univ j0) h
  rw [key]
  exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨j, rfl⟩)

/-- `f([g]) ∈ (g_1, …, g_d)` if `f` has no constant term. -/
theorem subst_mem_span {d : ℕ} {τ : Type*} {f : MvPowerSeries (Fin d) R}
    (hf : constantCoeff f = 0) {g : Fin d → MvPowerSeries τ R} (hg : HasSubst g) :
    f.subst g ∈ Ideal.span (Set.range g) := by
  have h := Ideal.mem_map_of_mem (substAlgHom (R := R) hg) (mem_span_X hf)
  rw [Ideal.map_span, coe_substAlgHom] at h
  convert h using 2
  ext a
  simp only [Set.mem_range, Set.mem_image, exists_exists_eq_and, subst_X hg]

variable {d : ℕ} (F : FGL R d) (p : ℕ)

/-- **The ideal `J_v = [p^v]_F(I) A`** generated by the coordinates of `[p^v]_F`. -/
def layerIdeal (v : ℕ) : Ideal (MvPowerSeries (Fin d) R) :=
  Ideal.span (Set.range (F.mulPS (p ^ v)))

theorem mulPS_mem_layerIdeal (v : ℕ) (i : Fin d) : F.mulPS (p ^ v) i ∈ F.layerIdeal p v :=
  Ideal.subset_span ⟨i, rfl⟩

/-- **`J_{v+1} ⊆ J_v`.** -/
theorem layerIdeal_succ_le (v : ℕ) : F.layerIdeal p (v + 1) ≤ F.layerIdeal p v := by
  rw [layerIdeal, Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  rw [mulPS_pow_succ]
  exact subst_mem_span (F.constantCoeff_mulPS p i) (hasSubst_of_noConst (F.noConst_mulPS _))

/-- **The layer `A_v = R[[T]]/[p^v]_F(I)`** (coordinate ring of `F[p^v]`). -/
abbrev Layer (v : ℕ) : Type _ := MvPowerSeries (Fin d) R ⧸ F.layerIdeal p v

/-- **The closed immersion `G_v ↪ G_{v+1}`**: `A_{v+1} ↠ A_v`. -/
def layerIncl (v : ℕ) : F.Layer p (v + 1) →ₐ[R] F.Layer p v :=
  Ideal.Quotient.factorₐ R (F.layerIdeal_succ_le p v)

theorem layerIncl_surjective (v : ℕ) : Function.Surjective (F.layerIncl p v) :=
  Ideal.Quotient.factor_surjective (F.layerIdeal_succ_le p v)

/-- The endomorphism `f ↦ f([p]_F)` of `R[[T]]`. -/
def pSubst : MvPowerSeries (Fin d) R →ₐ[R] MvPowerSeries (Fin d) R :=
  substAlgHom (hasSubst_of_noConst (F.noConst_mulPS p))

theorem map_layerIdeal_le (v : ℕ) :
    F.layerIdeal p v ≤ (F.layerIdeal p (v + 1)).comap (F.pSubst p) := by
  rw [layerIdeal, Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  rw [SetLike.mem_coe, Ideal.mem_comap, pSubst, coe_substAlgHom, subst_mulPS, ← pow_succ]
  exact F.mulPS_mem_layerIdeal p (v + 1) i

/-- **Multiplication by `p`, `G_{v+1} → G_v`**: `A_v → A_{v+1}`, `f ↦ f([p]_F)`. -/
def layerP (v : ℕ) : F.Layer p v →ₐ[R] F.Layer p (v + 1) :=
  Ideal.quotientMapₐ (F.layerIdeal p (v + 1)) (F.pSubst p) (F.map_layerIdeal_le p v)

end FGL

end PadicHodge
