import PadicHodge.FormalGroup.HodgeTateFGL
import PadicHodge.GroupScheme.EtaleHT
import PadicHodge.GroupScheme.Faithful
import PadicHodge.GroupScheme.TateDualRep

/-!
# `dim D_{-1}(V_p G) = dim G⁰` for non-connected `G` over `ℤ_p`

For a `p`-divisible group `G` over `ℤ_p` (`ZpD p`) with connected part `G⁰ ≅ F[p^∞]`, `F` of
dimension `d` (`PDivGroup.exists_connPart_iso`), we show **`dim_{ℚ_p} D_{-1}(V_p G) = d`**, the
input [Hong, Lemma 3.5.2] needs ([Hong, Cor. 3.4.11] for `G` itself).

Write `T = T_p G(ℚ̄_p)` and `T⁰ ⊆ T` for the image of `T_p(G⁰)(ℚ̄_p)`.

* **Lower bound**: `V_p(G⁰) ↪ V_p G` is Galois equivariant, and `dim D_{-1}(V_p(G⁰)) = d`
  ([Hong, Cor. 3.4.11] for `F[p^∞]`, `PDivFGL.finrank_DHT_tateRep_neg_one`).
* **`T / T⁰` is torsion free** (`mem_range_of_p_smul_mem`): `x ∈ T⁰` iff every level `x_v` is a
  point of `G_v⁰`, i.e. kills `1 - e₀` (`e₀` the idempotent of the unit section), and
  `i_v^*(e₀) = e₀`, while `(p x)_{v+1} = i_v(x_v)`.
* **Upper bound, without building `G^{et}` as a `p`-divisible group** (direct Hilbert 90 route):
  `etCoordField G k = ℚ_p(x(a) : x ∈ G_w(ℚ̄_p), a ∈ A_w^{et}, w ≤ k)` is generated by the
  coordinates of the étale quotients; it is finite, Galois stable, unramified and rigid
  (`isUnrStable_etCoordField`, as in `EtaleHT.lean`, since `A_w^{et}` is finite étale). For `ν`
  fixing it, `ν x` and `x` have the same image in `G_k^{et}`, so `ν x - x ∈ T⁰ + p^k T`
  (`exists_galLin_sub`: the kernel of `G_k → G_k^{et}` is `G_k⁰`, `T_p(G⁰) ↠ G_k⁰(ℚ̄_p)` and
  `ker(T → G_k) = p^k T`). Hence the matrix of `ν` on the free `ℤ_p`-module `T / T⁰` is
  `≡ 1 mod p^k`, and `Hilbert90.exists_hilbert90` trivialises `V_p G / V_p(G⁰)` over `ℂ_p`: it is
  Hodge–Tate of weight `0` (`finrank_DHT_etRep_neg_one`), and
  `0 → D_{-1}(V_p G⁰) → D_{-1}(V_p G) → D_{-1}(V_p G / V_p G⁰)` gives `≤ d`.

Main results: **`PDivGroup.finrank_DHT_tateRep_neg_one_of_iso`** and
**`PDivGroup.exists_finrank_DHT_tateRep_neg_one`**.

The mismatch between `ℤ_[p]` (`EtaleHT.lean`) and `ZpD p` (formal group files) is bridged by
`exists_frobenius_period_zpD`; all statements here are over `ZpD p`.
-/

noncomputable section

open WithConv TensorProduct IsLocalRing PadicHodge.Hilbert90 Module

namespace PadicHodge

namespace PDivGroup

open FFGroupScheme

variable {p : ℕ} [hp : Fact p.Prime]

local notation "K" => PadicAlgCl p

attribute [local instance] SerreTate.isDomain_zpD isPrincipalIdealRing_zpD

/-- **Frobenius on `B / p` is periodic** for a finite étale `ZpD p`-algebra `B` (transport of
`exists_frobenius_period` along `ZpD p = ℤ_p`). -/
theorem exists_frobenius_period_zpD (B : Type*) [CommRing B] [Algebra (ZpD p) B]
    [Module.Free (ZpD p) B] [Module.Finite (ZpD p) B] [Algebra.Etale (ZpD p) B] :
    ∃ N, 0 < N ∧ ∀ a : B, ∃ b : B, a ^ (p ^ N) - a = (p : B) * b := by
  letI : Algebra ℤ_[p] B := ‹Algebra (ZpD p) B›
  haveI : Module.Free ℤ_[p] B := ‹Module.Free (ZpD p) B›
  haveI : Module.Finite ℤ_[p] B := ‹Module.Finite (ZpD p) B›
  haveI : Algebra.Etale ℤ_[p] B := ‹Algebra.Etale (ZpD p) B›
  exact exists_frobenius_period (p := p) B

theorem norm_algebraMap_zpD_le_one (r : ZpD p) : ‖algebraMap (ZpD p) K r‖ ≤ 1 := by
  rw [IsScalarTower.algebraMap_apply (ZpD p) ℚ_[p] K, PadicAlgCl.norm_extends,
    ZpD.algebraMap_Qp]
  exact PadicInt.norm_le_one _

/-! ### The field generated by the étale coordinates -/

variable (G : PDivGroup (ZpD p) p)

/-- The values `x(a)` of the points `x ∈ G_w(ℚ̄_p)`, `w ≤ k`, on `a ∈ A_w^{et}`. -/
def etCoordSet (k : ℕ) : Set K :=
  {z | ∃ w ≤ k, ∃ φ : (G.G w).A →ₐ[ZpD p] K, ∃ b : (G.G w).etaleQuotient.A,
    φ ((G.G w).etaleQuotientHom b) = z}

/-- The field generated by the coordinates of the étale quotients `G_w^{et}`, `w ≤ k`. -/
def etCoordField (k : ℕ) : IntermediateField ℚ_[p] K :=
  IntermediateField.adjoin ℚ_[p] (G.etCoordSet k)

theorem etCoordSet_mono (k : ℕ) : G.etCoordSet k ⊆ G.etCoordSet (k + 1) := by
  rintro _ ⟨w, hw, φ, b, rfl⟩
  exact ⟨w, hw.trans (Nat.le_succ k), φ, b, rfl⟩

theorem etCoordField_mono (k : ℕ) : G.etCoordField k ≤ G.etCoordField (k + 1) :=
  IntermediateField.adjoin.mono _ _ _ (G.etCoordSet_mono k)

theorem gal_mem_etCoordSet (σ : GalQp p) {k : ℕ} {z : K} (hz : z ∈ G.etCoordSet k) :
    σ z ∈ G.etCoordSet k := by
  obtain ⟨w, hw, φ, b, rfl⟩ := hz
  exact ⟨w, hw, ((σ : K →ₐ[ℚ_[p]] K).restrictScalars (ZpD p)).comp φ, b, rfl⟩

theorem gal_mem_etCoordField (σ : GalQp p) {k : ℕ} {z : K} (hz : z ∈ G.etCoordField k) :
    σ z ∈ G.etCoordField k := by
  have h1 : σ z ∈ (G.etCoordField k).map (σ : K →ₐ[ℚ_[p]] K) :=
    (IntermediateField.map_mem_map _ _).mpr hz
  rw [etCoordField, IntermediateField.adjoin_map] at h1
  refine (IntermediateField.adjoin_le_iff.mpr ?_) h1
  rintro _ ⟨y, hy, rfl⟩
  exact IntermediateField.subset_adjoin _ _ (G.gal_mem_etCoordSet σ hy)

theorem norm_coord_zpD_le {w : ℕ} (φ : (G.G w).A →ₐ[ZpD p] K) (a : (G.G w).A) : ‖φ a‖ ≤ 1 :=
  norm_le_one_of_isIntegral norm_algebraMap_zpD_le_one φ (Algebra.IsIntegral.isIntegral a)

theorem norm_le_one_of_mem_etCoordSet {k : ℕ} {z : K} (hz : z ∈ G.etCoordSet k) : ‖z‖ ≤ 1 := by
  obtain ⟨w, -, φ, b, rfl⟩ := hz
  exact G.norm_coord_zpD_le φ _

theorem frobClosed_etCoordSet (k : ℕ) : FrobClosed (p := p) (G.etCoordSet k) := by
  rintro _ ⟨w, hw, φ, b, rfl⟩
  haveI : Algebra.Etale (ZpD p) (G.G w).etaleQuotient.A := (G.G w).isEtale_etaleQuotient
  obtain ⟨N, hN, hper⟩ := exists_frobenius_period_zpD (p := p) (G.G w).etaleQuotient.A
  obtain ⟨c, hc⟩ := hper b
  refine ⟨N, hN, φ ((G.G w).etaleQuotientHom c), ⟨w, hw, φ, c, rfl⟩, ?_⟩
  have h := congrArg (fun y => φ ((G.G w).etaleQuotientHom y)) hc
  simp only [map_sub, map_pow, map_mul, map_natCast] at h
  exact h

theorem finite_algHom_zpD (w : ℕ) : Finite ((G.G w).A →ₐ[ZpD p] K) := by
  have h1 : Nat.card ((G.G w).points K) ≠ 0 := by
    rw [G.card_points_sepClosed K Hilbert90.p_ne_zero w]
    exact pow_ne_zero _ hp.out.ne_zero
  have h2 : Finite ((G.G w).points K) := Nat.finite_of_card_ne_zero h1
  exact Finite.of_equiv _ (WithConv.equiv ((G.G w).A →ₐ[ZpD p] K))

theorem finiteDimensional_etCoordField (k : ℕ) : FiniteDimensional ℚ_[p] (G.etCoordField k) := by
  classical
  let bas := fun w => Module.Free.chooseBasis (ZpD p) (G.G w).etaleQuotient.A
  let F : Set K := ⋃ w ∈ Finset.range (k + 1), ⋃ φ : (G.G w).A →ₐ[ZpD p] K,
    Set.range fun i => φ ((G.G w).etaleQuotientHom (bas w i))
  have hF : F.Finite := by
    refine Set.Finite.biUnion (Finset.finite_toSet _) fun w _ => ?_
    haveI := G.finite_algHom_zpD w
    exact Set.finite_iUnion fun φ => Set.finite_range _
  have hFS : F ⊆ G.etCoordSet k := by
    intro z hz
    simp only [F, Set.mem_iUnion, Finset.mem_range, Set.mem_range] at hz
    obtain ⟨w, hw, φ, i, rfl⟩ := hz
    exact ⟨w, by omega, φ, _, rfl⟩
  have hSF : G.etCoordSet k ⊆ IntermediateField.adjoin ℚ_[p] F := by
    rintro _ ⟨w, hw, φ, a, rfl⟩
    rw [← (bas w).sum_repr a, map_sum, map_sum]
    refine IntermediateField.sum_mem _ fun i _ => ?_
    rw [map_smul, map_smul, Algebra.smul_def, IsScalarTower.algebraMap_apply (ZpD p) ℚ_[p] K]
    refine IntermediateField.mul_mem _ (IntermediateField.algebraMap_mem _ _) ?_
    refine IntermediateField.subset_adjoin _ _ ?_
    simp only [F, Set.mem_iUnion, Finset.mem_range, Set.mem_range]
    exact ⟨w, by omega, φ, i, rfl⟩
  have heq : G.etCoordField k = IntermediateField.adjoin ℚ_[p] F :=
    le_antisymm (IntermediateField.adjoin_le_iff.mpr hSF)
      (IntermediateField.adjoin.mono _ _ _ hFS)
  rw [heq]
  haveI : Finite F := hF.to_subtype
  exact IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x

/-- **The fields `etCoordField G k` are Galois-stable, unramified and rigid.** -/
theorem isUnrStable_etCoordField (k : ℕ) : IsUnrStable (G.etCoordField k) where
  stable σ z hz := G.gal_mem_etCoordField σ hz
  unr z hz hz1 := unr_adjoin (fun _ h => G.norm_le_one_of_mem_etCoordSet h)
    (G.frobClosed_etCoordSet k) hz hz1
  rigid σ hσ := by
    have hfix : ∀ z ∈ G.etCoordSet k, σ z = z := by
      rintro _ ⟨w, hw, φ, b, rfl⟩
      haveI : Algebra.Etale (ZpD p) (G.G w).etaleQuotient.A := (G.G w).isEtale_etaleQuotient
      let ψ : (G.G w).etaleQuotient.A →ₐ[ZpD p] K :=
        φ.comp ((G.G w).etaleQuotientHom : (G.G w).etaleQuotient.A →ₐ[ZpD p] (G.G w).A)
      have h1 := algHom_eq_of_norm_sub_lt_one ψ
        (((σ : K →ₐ[ℚ_[p]] K).restrictScalars (ZpD p)).comp ψ)
        (fun c => G.norm_coord_zpD_le φ _)
        (fun c => by
          rw [norm_sub_rev]
          exact hσ _ (IntermediateField.subset_adjoin _ _ ⟨w, hw, φ, c, rfl⟩)
            (G.norm_coord_zpD_le φ _))
      exact (DFunLike.congr_fun h1 b).symm
    have hle : G.etCoordField k ≤ IntermediateField.fixedField (Subgroup.zpowers σ) := by
      refine IntermediateField.adjoin_le_iff.mpr fun z hz => ?_
      rw [SetLike.mem_coe, IntermediateField.mem_fixedField_iff]
      intro f hf
      have hσ' : σ ∈ MulAction.stabilizer (GalQp p) z := hfix z hz
      exact (Subgroup.zpowers_le.mpr hσ') hf
    intro z hz
    exact (IntermediateField.mem_fixedField_iff _ _).mp (hle hz) σ
      (Subgroup.mem_zpowers σ)

/-! ### `T_p(G⁰) ⊆ T_p G` -/

/-- Levelwise injective homomorphisms are injective on Tate modules of generic fibres. -/
theorem tateLin_baseChange_injective {G₁ G₂ : PDivGroup (ZpD p) p} (ι : Hom G₁ G₂)
    (hι : ∀ v, Function.Injective ((ι.f v).mapPoints K)) :
    Function.Injective (Hom.baseChange (S := ℚ_[p]) ι).tateLin := by
  intro x y h
  refine (G₁.baseChange ℚ_[p]).addTate_ext K fun v => ?_
  have h1 := congrArg (fun z => (G₂.G v).baseChangePointsEquiv (S := ℚ_[p]) K
    ((Additive.toMul z).1 v)) h
  have h2 : (ι.f v).mapPoints K ((G₁.G v).baseChangePointsEquiv (S := ℚ_[p]) K
      ((Additive.toMul x).1 v)) = (ι.f v).mapPoints K
      ((G₁.G v).baseChangePointsEquiv (S := ℚ_[p]) K ((Additive.toMul y).1 v)) := h1
  exact ((G₁.G v).baseChangePointsEquiv (S := ℚ_[p]) K).injective (hι v h2)

/-- `φ ∘ ψ = id` gives `φ_* ∘ ψ_* = id` on Tate modules of generic fibres. -/
theorem tateLin_baseChange_comp_eq {G₁ G₂ : PDivGroup (ZpD p) p} (φ : Hom G₁ G₂)
    (ψ : Hom G₂ G₁) (h : φ.comp ψ = Hom.id _)
    (y : Additive ((G₂.baseChange ℚ_[p]).TateModule K)) :
    (Hom.baseChange (S := ℚ_[p]) φ).tateLin ((Hom.baseChange (S := ℚ_[p]) ψ).tateLin y) = y := by
  refine (G₂.baseChange ℚ_[p]).addTate_ext K fun v => ?_
  apply ((G₂.G v).baseChangePointsEquiv (S := ℚ_[p]) K).injective
  change ((φ.comp ψ).f v).mapPoints K
    ((G₂.G v).baseChangePointsEquiv (S := ℚ_[p]) K ((Additive.toMul y).1 v)) = _
  rw [h]
  rfl

/-- `T_p(G⁰) → T_p G` on generic fibres. -/
def connTateLin : Additive ((G.connPart.baseChange ℚ_[p]).TateModule K) →ₗ[ℤ_[p]]
    Additive ((G.baseChange ℚ_[p]).TateModule K) :=
  (Hom.baseChange (S := ℚ_[p]) G.connPartHom).tateLin

theorem connTateLin_injective : Function.Injective G.connTateLin :=
  tateLin_baseChange_injective G.connPartHom fun v => G.connPartHom_mapPoints_injective v K

theorem bc_connTateLin (y : Additive ((G.connPart.baseChange ℚ_[p]).TateModule K)) (v : ℕ) :
    (G.G v).baseChangePointsEquiv (S := ℚ_[p]) K ((Additive.toMul (G.connTateLin y)).1 v) =
      (G.G v).connectedComponentHom.mapPoints K
        ((G.G v).connectedComponent.baseChangePointsEquiv (S := ℚ_[p]) K
          ((Additive.toMul y).1 v)) := rfl

/-- `T⁰ = T_p(G⁰) ⊆ T_p G`. -/
abbrev connTate : Submodule ℤ_[p] (Additive ((G.baseChange ℚ_[p]).TateModule K)) :=
  LinearMap.range G.connTateLin

/-- **`x ∈ T⁰` iff all levels of `x` are points of `G_v⁰`.** -/
theorem mem_connTate_iff (x : Additive ((G.baseChange ℚ_[p]).TateModule K)) :
    x ∈ G.connTate ↔ ∀ v, (G.G v).baseChangePointsEquiv (S := ℚ_[p]) K ((Additive.toMul x).1 v) ∈
      ((G.G v).connectedComponentHom.mapPoints K).range := by
  constructor
  · rintro ⟨y, rfl⟩ v
    exact ⟨_, (G.bc_connTateLin y v).symm⟩
  · intro hx
    simp only [MonoidHom.mem_range] at hx
    choose y hy using hx
    have hcomp : ∀ v, (G.connIncl v).mapPoints K (y v) = (y (v + 1)) ^ p := by
      intro v
      apply (G.G (v + 1)).mapPoints_connectedComponentHom_injective K
      rw [map_pow, hy (v + 1)]
      unfold connIncl
      rw [mapPoints_connectedComponentMap, hy v]
      exact (congrArg ((G.G (v + 1)).baseChangePointsEquiv (S := ℚ_[p]) K)
        ((Additive.toMul x).2 v)).trans (map_pow _ _ _)
    let yT : G.connPart.TateModule K := ⟨y, hcomp⟩
    refine ⟨Additive.ofMul ((G.connPart.baseChangeTateEquiv (S := ℚ_[p]) K).symm yT), ?_⟩
    refine (G.baseChange ℚ_[p]).addTate_ext K fun v => ?_
    apply ((G.G v).baseChangePointsEquiv (S := ℚ_[p]) K).injective
    rw [bc_connTateLin, ← hy v]
    congr 1
    exact ((G.G v).connectedComponent.baseChangePointsEquiv (S := ℚ_[p]) K).apply_symm_apply (y v)

/-- A point lies in `G⁰` iff it kills `1 - e₀`. -/
theorem mem_range_connectedComponentHom_iff (Gs : FFGroupScheme (ZpD p)) (x : Gs.points K) :
    x ∈ (Gs.connectedComponentHom.mapPoints K).range ↔ ofConv x (1 - Gs.idemConn) = 0 := by
  constructor
  · rintro ⟨y, rfl⟩
    change ofConv y (Gs.connectedComponentHom (1 - Gs.idemConn)) = 0
    rw [map_sub, map_one, connectedComponentHom_idemConn, sub_self, map_zero]
  · intro hx
    exact Gs.exists_connectedComponentHom_mapPoints_eq x hx

theorem toMul_p_smul_succ (z : Additive ((G.baseChange ℚ_[p]).TateModule K)) (v : ℕ) :
    (Additive.toMul ((p : ℤ_[p]) • z)).1 (v + 1) =
      ((G.baseChange ℚ_[p]).incl v).mapPoints K ((Additive.toMul z).1 v) := by
  rw [(Additive.toMul z).2 v, Nat.cast_smul_eq_nsmul, toMul_nsmul]
  rfl

/-- **`T / T⁰` has no `p`-torsion.** -/
theorem mem_connTate_of_p_smul_mem (z : Additive ((G.baseChange ℚ_[p]).TateModule K))
    (hz : (p : ℤ_[p]) • z ∈ G.connTate) : z ∈ G.connTate := by
  rw [mem_connTate_iff] at hz ⊢
  intro v
  have h := hz (v + 1)
  rw [toMul_p_smul_succ, mem_range_connectedComponentHom_iff] at h
  rw [mem_range_connectedComponentHom_iff]
  have e : ofConv ((G.G v).baseChangePointsEquiv (S := ℚ_[p]) K ((Additive.toMul z).1 v))
      (G.incl v (1 - (G.G (v + 1)).idemConn)) = 0 := h
  rwa [map_sub, map_one, G.incl_idemConn v] at e

theorem mem_connTate_of_pow_smul_mem (n : ℕ) :
    ∀ z : Additive ((G.baseChange ℚ_[p]).TateModule K),
      (p : ℤ_[p]) ^ n • z ∈ G.connTate → z ∈ G.connTate := by
  induction n with
  | zero => intro z hz; simpa using hz
  | succ n ih =>
    intro z hz
    rw [pow_succ, mul_smul] at hz
    exact G.mem_connTate_of_p_smul_mem z (ih _ hz)

/-- **`T / T⁰` is torsion free.** -/
theorem mem_connTate_of_smul_mem {a : ℤ_[p]} (ha : a ≠ 0)
    (z : Additive ((G.baseChange ℚ_[p]).TateModule K)) (hz : a • z ∈ G.connTate) :
    z ∈ G.connTate := by
  have hspec := PadicInt.unitCoeff_spec ha
  refine G.mem_connTate_of_pow_smul_mem a.valuation z ?_
  have h1 : (↑(PadicInt.unitCoeff ha)⁻¹ : ℤ_[p]) • a • z ∈ G.connTate := G.connTate.smul_mem _ hz
  have h2 : (↑(PadicInt.unitCoeff ha)⁻¹ : ℤ_[p]) * a = (p : ℤ_[p]) ^ a.valuation :=
    (congrArg (fun t => (↑(PadicInt.unitCoeff ha)⁻¹ : ℤ_[p]) * t) hspec).trans
      (Units.inv_mul_cancel_left _ _)
  rwa [← mul_smul, h2] at h1

/-! ### The quotient `T / T⁰` and its Galois action -/

/-- `T / T⁰`, the Tate module of the étale part. -/
abbrev EtTate : Type := Additive ((G.baseChange ℚ_[p]).TateModule K) ⧸ G.connTate

theorem galLin_mem_connTate (σ : GalQp p) {x : Additive ((G.baseChange ℚ_[p]).TateModule K)}
    (hx : x ∈ G.connTate) : (G.baseChange ℚ_[p]).galLin σ x ∈ G.connTate := by
  obtain ⟨y, rfl⟩ := hx
  exact ⟨(G.connPart.baseChange ℚ_[p]).galLin σ y, rfl⟩

/-- The Galois action on `T / T⁰`. -/
def galQ (σ : GalQp p) : G.EtTate →ₗ[ℤ_[p]] G.EtTate :=
  G.connTate.mapQ G.connTate ((G.baseChange ℚ_[p]).galLin σ) fun _ hx =>
    G.galLin_mem_connTate σ hx

theorem galQ_mk (σ : GalQp p) (x : Additive ((G.baseChange ℚ_[p]).TateModule K)) :
    G.galQ σ (G.connTate.mkQ x) = G.connTate.mkQ ((G.baseChange ℚ_[p]).galLin σ x) := rfl

theorem galQ_one : G.galQ 1 = LinearMap.id :=
  LinearMap.ext fun q => by
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ q
    rfl

theorem galQ_mul (σ τ : GalQp p) : G.galQ (σ * τ) = G.galQ σ ∘ₗ G.galQ τ :=
  LinearMap.ext fun q => by
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ q
    rfl

/-- **The representation `V_p G / V_p(G⁰)` of `G_L`.** -/
def etRep (L : IntermediateField ℚ_[p] K) :
    Representation ℚ_[p] (K ≃ₐ[L] K) (ℚ_[p] ⊗[ℤ_[p]] G.EtTate) where
  toFun σ := (G.galQ (σ.restrictScalars ℚ_[p])).baseChange ℚ_[p]
  map_one' := by
    rw [Module.End.one_eq_id, ← LinearMap.baseChange_id]
    congr 1
    exact LinearMap.ext fun q => by
      obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ q
      rfl
  map_mul' σ τ := by
    rw [Module.End.mul_eq_comp, ← LinearMap.baseChange_comp]
    congr 1
    exact LinearMap.ext fun q => by
      obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ q
      rfl

/-- **`ν x - x ∈ T⁰ + p^k T`** for `ν` fixing the étale coordinates up to level `k`. -/
theorem etaleQuotientHom_galLin {k : ℕ} (ν : GalQp p) (hν : ∀ z ∈ G.etCoordField k, ν z = z)
    (x : Additive ((G.baseChange ℚ_[p]).TateModule K)) :
    (G.G k).etaleQuotientHom.mapPoints K ((G.G k).baseChangePointsEquiv (S := ℚ_[p]) K
        ((Additive.toMul ((G.baseChange ℚ_[p]).galLin ν x)).1 k)) =
      (G.G k).etaleQuotientHom.mapPoints K ((G.G k).baseChangePointsEquiv (S := ℚ_[p]) K
        ((Additive.toMul x).1 k)) := by
  apply WithConv.ofConv_injective
  refine AlgHom.ext fun b => ?_
  set φ := ofConv ((G.G k).baseChangePointsEquiv (S := ℚ_[p]) K ((Additive.toMul x).1 k))
  have h := hν (φ ((G.G k).etaleQuotientHom b))
    (IntermediateField.subset_adjoin _ _ ⟨k, le_rfl, φ, b, rfl⟩)
  exact h

theorem exists_galLin_sub {k : ℕ} (ν : GalQp p) (hν : ∀ z ∈ G.etCoordField k, ν z = z)
    (x : Additive ((G.baseChange ℚ_[p]).TateModule K)) :
    ∃ c ∈ G.connTate, ∃ s, (G.baseChange ℚ_[p]).galLin ν x - x = c + (p : ℤ_[p]) ^ k • s := by
  set u := (G.baseChange ℚ_[p]).galLin ν x - x
  set bc := (G.G k).baseChangePointsEquiv (S := ℚ_[p]) K
  have hu : (G.G k).etaleQuotientHom.mapPoints K (bc ((Additive.toMul u).1 k)) = 1 := by
    have : (Additive.toMul u).1 k = (Additive.toMul ((G.baseChange ℚ_[p]).galLin ν x)).1 k /
        (Additive.toMul x).1 k := rfl
    let Φ : ((G.baseChange ℚ_[p]).G k).points K →* (G.G k).etaleQuotient.points K :=
      ((G.G k).etaleQuotientHom.mapPoints K).comp
        ((G.G k).baseChangePointsEquiv (S := ℚ_[p]) K).toMonoidHom
    have e1 : Φ ((Additive.toMul u).1 k) = 1 := by
      rw [this, map_div, div_eq_one]
      exact G.etaleQuotientHom_galLin ν hν x
    exact e1
  obtain ⟨w, hw⟩ := ((G.G k).mapPoints_etaleQuotientHom_eq_one_iff _).mp hu
  obtain ⟨y, hy⟩ := G.connPart.proj_surjective_sepClosed K Hilbert90.p_ne_zero k w
  have hy' : y.1 k = w := hy
  set c := G.connTateLin (Additive.ofMul ((G.connPart.baseChangeTateEquiv (S := ℚ_[p]) K).symm y))
  have hck : bc ((Additive.toMul c).1 k) = bc ((Additive.toMul u).1 k) := by
    change (G.G k).connectedComponentHom.mapPoints K
      ((G.G k).connectedComponent.baseChangePointsEquiv (S := ℚ_[p]) K
        (((G.connPart.baseChangeTateEquiv (S := ℚ_[p]) K).symm y).1 k)) = _
    rw [← hw, ← hy']
    congr 1
    exact ((G.G k).connectedComponent.baseChangePointsEquiv (S := ℚ_[p]) K).apply_symm_apply _
  obtain ⟨s, hs⟩ := (G.baseChange ℚ_[p]).exists_eq_p_pow_smul k (u - c) (by
    change (Additive.toMul u).1 k / (Additive.toMul c).1 k = 1
    rw [div_eq_one]
    exact (bc.injective hck).symm)
  exact ⟨c, ⟨_, rfl⟩, s, by rw [← hs]; abel⟩

/-! ### Hilbert 90 on `T / T⁰` -/

instance : Module.IsTorsionFree ℤ_[p] G.EtTate where
  isSMulRegular r hr q₁ q₂ hq := by
    have hr0 : r ≠ 0 := hr.ne_zero
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ q₁
    obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective _ q₂
    have hq1 : r • G.connTate.mkQ x = r • G.connTate.mkQ y := hq
    have hq' : G.connTate.mkQ (r • (x - y)) = 0 := by
      rw [map_smul, map_sub, smul_sub, sub_eq_zero]
      exact hq1
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hq'
    have h := G.mem_connTate_of_smul_mem hr0 _ hq'
    rw [← sub_eq_zero, ← map_sub, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact h

instance : Module.Free ℤ_[p] G.EtTate := Module.free_of_finite_type_torsion_free'

/-- The matrix of `σ` on `T / T⁰` in a `ℤ_p`-basis `b`. -/
def galQMatrix {r : ℕ} (b : Module.Basis (Fin r) ℤ_[p] G.EtTate) :
    GalQp p →* Matrix (Fin r) (Fin r) ℤ_[p] where
  toFun σ := LinearMap.toMatrix b b (G.galQ σ)
  map_one' := by rw [galQ_one, LinearMap.toMatrix_id]
  map_mul' σ τ := by rw [galQ_mul, LinearMap.toMatrix_comp b b b]

/-- **`A(ν) ≡ 1 mod p^k`** on `Gal(ℚ̄_p / etCoordField G k)`. -/
theorem galQMatrix_fix {r : ℕ} (b : Module.Basis (Fin r) ℤ_[p] G.EtTate) (k : ℕ) (ν : GalQp p)
    (hν : ∀ z ∈ G.etCoordField k, ν z = z) (i j : Fin r) :
    ‖G.galQMatrix b ν i j - (1 : Matrix (Fin r) (Fin r) ℤ_[p]) i j‖ ≤ ‖(p : ℤ_[p])‖ ^ k := by
  classical
  obtain ⟨x, hx⟩ := Submodule.mkQ_surjective G.connTate (b j)
  obtain ⟨c, hc, s, hs⟩ := G.exists_galLin_sub ν hν x
  have hc0 : G.connTate.mkQ c = 0 := by
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact hc
  have h1 : G.galQ ν (b j) - b j = (p : ℤ_[p]) ^ k • G.connTate.mkQ s := by
    rw [← hx, galQ_mk, ← map_sub, hs, map_add, hc0, zero_add, map_smul]
  have h2 : G.galQMatrix b ν i j - (1 : Matrix (Fin r) (Fin r) ℤ_[p]) i j =
      (p : ℤ_[p]) ^ k * b.repr (G.connTate.mkQ s) i := by
    have h3 := congrArg (fun q => b.repr q i) h1
    simp only [map_sub, map_smul, Finsupp.coe_sub, Pi.sub_apply, Finsupp.coe_smul,
      Pi.smul_apply, smul_eq_mul, Basis.repr_self] at h3
    rw [← h3]
    simp [galQMatrix, LinearMap.toMatrix_apply, Matrix.one_apply, Finsupp.single_apply,
      eq_comm]
  rw [h2, norm_mul, norm_pow]
  exact mul_le_of_le_one_right (by positivity) (PadicInt.norm_le_one _)

/-- **`V_p G / V_p(G⁰)` is Hodge–Tate with all weights `0`** (Hilbert 90 for
`\hat{ℚ_p^{ur}}`), in particular `D_{-1}(V_p G / V_p(G⁰)) = 0`. -/
theorem isHodgeTate_etRep (L : IntermediateField ℚ_[p] K) [FiniteDimensional ℚ_[p] L] :
    IsHodgeTate (G.etRep L) ∧
      (htWeights (G.etRep L)).count 0 = finrank ℚ_[p] (ℚ_[p] ⊗[ℤ_[p]] G.EtTate) := by
  classical
  set b := Module.finBasis ℤ_[p] G.EtTate
  set A := G.galQMatrix b
  haveI : ∀ k, FiniteDimensional ℚ_[p] (G.etCoordField k) := G.finiteDimensional_etCoordField
  obtain ⟨X, hX, hXinv⟩ := exists_hilbert90 (A := A) (Mk := G.etCoordField)
    G.isUnrStable_etCoordField G.etCoordField_mono (fun k ν hν i j => by
      have := G.galQMatrix_fix b k ν hν i j
      rw [norm_p_padicInt_eq] at this
      have h1 : ‖A ν i j - (1 : Matrix (Fin (finrank ℤ_[p] G.EtTate)) _ ℤ_[p]) i j‖ =
          ‖algebraMap ℤ_[p] K (A ν i j) -
            (1 : Matrix (Fin (finrank ℤ_[p] G.EtTate)) _ K) i j‖ := by
        rw [← norm_algebraMap_padicInt, map_sub, Matrix.one_apply, Matrix.one_apply]
        split_ifs <;> simp
      rw [Matrix.sub_apply, AK, Matrix.map_apply, ← h1]
      exact this)
  exact isHodgeTate_of_matrix (G.etRep L) (Algebra.TensorProduct.basis ℚ_[p] b) X hX
    (fun σ => by
      have h1 : LinearMap.toMatrix (Algebra.TensorProduct.basis ℚ_[p] b)
          (Algebra.TensorProduct.basis ℚ_[p] b) (G.etRep L σ) =
          (A (σ.restrictScalars ℚ_[p])).map (algebraMap ℤ_[p] ℚ_[p]) :=
        LinearMap.toMatrix_baseChange _ _ _ _
      rw [h1, Matrix.map_map]
      have h2 : (algebraMap ℚ_[p] ℂ_[p]) ∘ (algebraMap ℤ_[p] ℚ_[p]) =
          toCp ∘ algebraMap ℤ_[p] K := by
        funext a
        simp only [Function.comp_apply, UniformSpace.Completion.algebraMap_def,
          IsScalarTower.algebraMap_apply ℤ_[p] ℚ_[p] K]
        rfl
      rw [h2, ← Matrix.map_map]
      exact hXinv (σ.restrictScalars ℚ_[p]))

theorem finrank_DHT_etRep_neg_one (L : IntermediateField ℚ_[p] K) [FiniteDimensional ℚ_[p] L] :
    finrank L (DHT (G.etRep L) (-1)) = 0 := by
  have h0 := (G.isHodgeTate_etRep L).2
  rw [count_htWeights] at h0
  have hle := sum_finrank_DHT_le (G.etRep L) {0, -1}
  rw [Finset.sum_pair (by norm_num)] at hle
  omega

/-! ### `dim D_{-1}(V_p G) = dim G⁰` -/

/-- **[Hong, Cor. 3.4.11] for non-connected `G` over `ℤ_p`**: if `G⁰ ≅ F[p^∞]` with `F` of
dimension `d`, then `dim_{ℚ_p} D_{-1}(V_p G) = d`. -/
theorem finrank_DHT_tateRep_neg_one_of_iso {d : ℕ} (P : PDivFGL (ZpD p) d p)
    (φ : Hom G.connPart P.pdivGroup) (ψ : Hom P.pdivGroup G.connPart)
    (hφψ : φ.comp ψ = Hom.id _) (hψφ : ψ.comp φ = Hom.id _) :
    finrank (⊥ : IntermediateField ℚ_[p] K) (DHT ((G.baseChange ℚ_[p]).tateRep ⊥) (-1)) = d := by
  haveI : Module.Flat ℤ_[p] ℚ_[p] := IsLocalization.flat ℚ_[p] (nonZeroDivisors ℤ_[p])
  set fP : Additive (P.genericFibre.TateModule K) →ₗ[ℤ_[p]]
      Additive ((G.baseChange ℚ_[p]).TateModule K) :=
    G.connTateLin ∘ₗ (Hom.baseChange (S := ℚ_[p]) ψ).tateLin
  have hfPi : Function.Injective fP := G.connTateLin_injective.comp
    (Function.LeftInverse.injective (tateLin_baseChange_comp_eq φ ψ hφψ))
  have hfPr : LinearMap.range fP = G.connTate := by
    refine le_antisymm ?_ ?_
    · rintro _ ⟨y, rfl⟩
      exact ⟨_, rfl⟩
    · rintro _ ⟨y, rfl⟩
      refine ⟨(Hom.baseChange (S := ℚ_[p]) φ).tateLin y, ?_⟩
      change G.connTateLin _ = _
      rw [tateLin_baseChange_comp_eq ψ φ hψφ]
  set ρ := (G.baseChange ℚ_[p]).tateRep ⊥
  set ρ' := P.genericFibre.tateRep ⊥
  set ρ'' := G.etRep ⊥
  set f := fP.baseChange ℚ_[p]
  set g := G.connTate.mkQ.baseChange ℚ_[p]
  have hf : ∀ σ, f ∘ₗ ρ' σ = ρ σ ∘ₗ f := fun σ => by
    change fP.baseChange ℚ_[p] ∘ₗ (P.genericFibre.galLin _).baseChange ℚ_[p] =
      ((G.baseChange ℚ_[p]).galLin _).baseChange ℚ_[p] ∘ₗ fP.baseChange ℚ_[p]
    rw [← LinearMap.baseChange_comp, ← LinearMap.baseChange_comp]
    congr 1
  have hg : ∀ σ, g ∘ₗ ρ σ = ρ'' σ ∘ₗ g := fun σ => by
    change G.connTate.mkQ.baseChange ℚ_[p] ∘ₗ ((G.baseChange ℚ_[p]).galLin _).baseChange ℚ_[p] =
      (G.galQ _).baseChange ℚ_[p] ∘ₗ G.connTate.mkQ.baseChange ℚ_[p]
    rw [← LinearMap.baseChange_comp, ← LinearMap.baseChange_comp]
    congr 1
  have hfi : Function.Injective f := by
    change Function.Injective (fP.baseChange ℚ_[p])
    rw [LinearMap.baseChange_eq_ltensor]
    exact Module.Flat.lTensor_preserves_injective_linearMap _ hfPi
  have hex0 : Function.Exact fP G.connTate.mkQ := by
    rw [LinearMap.exact_iff, Submodule.ker_mkQ, hfPr]
  have hfg : Function.Exact f g := by
    change Function.Exact (fP.baseChange ℚ_[p]) (G.connTate.mkQ.baseChange ℚ_[p])
    rw [LinearMap.baseChange_eq_ltensor, LinearMap.baseChange_eq_ltensor]
    exact _root_.lTensor_exact ℚ_[p] hex0 (Submodule.mkQ_surjective _)
  have hup := finrank_DHT_le_add hf hg hfi hfg (-1)
  have hlow := finrank_DHT_le_of_injective hf hfi (-1)
  rw [P.finrank_DHT_tateRep_neg_one, G.finrank_DHT_etRep_neg_one] at hup
  rw [P.finrank_DHT_tateRep_neg_one] at hlow
  omega

/-- **[Hong, Cor. 3.4.11] for every `p`-divisible group `G` over `ℤ_p`**:
`dim D_{-1}(V_p G) = dim G⁰`, where `G⁰ ≅ F[p^∞]` (Serre–Tate). -/
theorem exists_finrank_DHT_tateRep_neg_one :
    ∃ (d : ℕ) (P : PDivFGL (ZpD p) d p) (φ : Hom G.connPart P.pdivGroup)
      (ψ : Hom P.pdivGroup G.connPart), φ.comp ψ = Hom.id _ ∧ ψ.comp φ = Hom.id _ ∧
      finrank (⊥ : IntermediateField ℚ_[p] K) (DHT ((G.baseChange ℚ_[p]).tateRep ⊥) (-1)) = d := by
  obtain ⟨d, P, φ, ψ, h1, h2⟩ := G.exists_connPart_iso
  exact ⟨d, P, φ, ψ, h1, h2, G.finrank_DHT_tateRep_neg_one_of_iso P φ ψ h1 h2⟩

end PDivGroup

