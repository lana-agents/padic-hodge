import PadicHodge.FormalGroup.DAlphaDual
import PadicHodge.GroupScheme.EtaleHT
import PadicHodge.GroupScheme.Faithful
import PadicHodge.GroupScheme.TateCont
import PadicHodge.GroupScheme.TateDualRep
import PadicHodge.Hilbert90.UnrOver

/-!
# `dim D_{-1}(V_p G) = dim G⁰` for non-connected `G`, over a general base

The common core of `FormalGroup/TateNonConn.lean` (`R = ℤ_p`, `F = ℚ_p`) and
`FormalGroup/TateNonConnOL.lean` (`R = O_{K'}`, `F = K'`): `G` is a `p`-divisible group over a
complete local PID `R` with `R → F → ℚ̄_p`, `F` a field with `ℚ_p → F`, and `G_L ⊆ G_{ℚ_p}`
(`L ⊆ ℚ̄_p` finite over `ℚ_p`) acts on Tate modules of `G_F` through a homomorphism
`ι : G_L → G_F` with `ι(σ) = σ` on `ℚ̄_p` (`σ ↦ σ|_{ℚ_p}` for `F = ℚ_p`, the identity for
`F = L`).

Write `T = T_p G_F(ℚ̄_p)` and `T⁰ ⊆ T` for the image of `T_p(G⁰_F)(ℚ̄_p)` (`connTateOver`).

* **`T / T⁰` is torsion free** (`mem_connTateOver_of_smul_mem`): `x ∈ T⁰` iff every level `x_v`
  is a point of `G_v⁰`, i.e. kills `1 - e₀`, and `i_v^*(e₀) = e₀`, while `(p x)_{v+1} = i_v(x_v)`.
* **Étale coordinates**: `etCoordFieldOver F G k = F(x(a) : x ∈ G_w(ℚ̄_p), a ∈ A_w^{et}, w ≤ k)`
  is finite over `F`, `G_F`-stable, unramified relative to `π` and rigid
  (`isUnrStableOver_etCoordFieldOver`), given that Frobenius is periodic modulo `π` on `O_F` and
  on finite étale `R`-algebras. For `ν` fixing it, `ν x - x ∈ T⁰ + p^k T`
  (`exists_galLin_subOver`), so the matrix of `ν` on `T / T⁰` is `≡ 1 mod p^k`
  (`galQMatrixOver_fix`), and Hilbert 90 over `F` (`Hilbert90.exists_hilbert90_over`) shows that
  `V_p G / V_p(G⁰)` is Hodge–Tate of weight `0` as a `G_L`-representation
  (`isHodgeTate_etRepVia`, `finrank_DHT_etRepVia_neg_one`).
* **[Hong, Cor. 3.4.11] for non-connected `G`** (`finrank_DHT_neg_one_of_iso_over`): if
  `G⁰ ≅ H` and `dim D_{-1}(V_p H) = d`, then `dim D_{-1}(V_p G) = d`
  (`0 → D_{-1}(V_p G⁰) → D_{-1}(V_p G) → D_{-1}(V_p G / V_p G⁰) = 0`).

## References

* [Hong] S. Hong, *Notes on p-adic Hodge theory*, Cor. 3.4.11.
-/

noncomputable section

open WithConv TensorProduct IsLocalRing PadicHodge.Hilbert90 Module

namespace PadicHodge

namespace PDivGroup

open FFGroupScheme

variable {p : ℕ} [hp : Fact p.Prime]

local notation "K" => PadicAlgCl p

variable {R : Type} [CommRing R] [IsLocalRing R] [IsAdicComplete (maximalIdeal R) R] [IsDomain R]
  [IsPrincipalIdealRing R] [Algebra R (PadicAlgCl p)]

/-! ### The field generated by the étale coordinates -/

section Coord

variable (G : PDivGroup R p)

/-- The values `x(a)` of the points `x ∈ G_w(ℚ̄_p)`, `w ≤ k`, on `a ∈ A_w^{et}`. -/
def etCoordSetOver (k : ℕ) : Set K :=
  {z | ∃ w ≤ k, ∃ φ : (G.G w).A →ₐ[R] K, ∃ b : (G.G w).etaleQuotient.A,
    φ ((G.G w).etaleQuotientHom b) = z}

theorem etCoordSetOver_mono (k : ℕ) : G.etCoordSetOver k ⊆ G.etCoordSetOver (k + 1) := by
  rintro _ ⟨w, hw, φ, b, rfl⟩
  exact ⟨w, hw.trans (Nat.le_succ k), φ, b, rfl⟩

theorem norm_le_one_of_mem_etCoordSetOver (hR : ∀ r : R, ‖algebraMap R K r‖ ≤ 1) {k : ℕ} {z : K}
    (hz : z ∈ G.etCoordSetOver k) : ‖z‖ ≤ 1 := by
  obtain ⟨w, -, φ, b, rfl⟩ := hz
  exact norm_le_one_of_isIntegral hR φ (Algebra.IsIntegral.isIntegral _)

omit [IsAdicComplete (maximalIdeal R) R] [IsDomain R] [IsPrincipalIdealRing R] in
theorem finite_algHom_over (w : ℕ) : Finite ((G.G w).A →ₐ[R] K) := by
  have h1 : Nat.card ((G.G w).points K) ≠ 0 := by
    rw [G.card_points_sepClosed K Hilbert90.p_ne_zero w]
    exact pow_ne_zero _ hp.out.ne_zero
  have h2 : Finite ((G.G w).points K) := Nat.finite_of_card_ne_zero h1
  exact Finite.of_equiv _ (WithConv.equiv ((G.G w).A →ₐ[R] K))

variable (F : Type) [Field F] [Algebra F (PadicAlgCl p)] [Algebra R F]
  [IsScalarTower R F (PadicAlgCl p)]

/-- The field generated over `F` by the coordinates of the étale quotients `G_w^{et}`,
`w ≤ k`. -/
def etCoordFieldOver (k : ℕ) : IntermediateField F K :=
  IntermediateField.adjoin F (G.etCoordSetOver k)

omit [Algebra R F] [IsScalarTower R F (PadicAlgCl p)] in
theorem etCoordFieldOver_mono (k : ℕ) : G.etCoordFieldOver F k ≤ G.etCoordFieldOver F (k + 1) :=
  IntermediateField.adjoin.mono _ _ _ (G.etCoordSetOver_mono k)

theorem gal_mem_etCoordSetOver (σ : K ≃ₐ[F] K) {k : ℕ} {z : K} (hz : z ∈ G.etCoordSetOver k) :
    σ z ∈ G.etCoordSetOver k := by
  obtain ⟨w, hw, φ, b, rfl⟩ := hz
  exact ⟨w, hw, ((σ : K →ₐ[F] K).restrictScalars R).comp φ, b, rfl⟩

theorem frobClosedOver_etCoordSetOver [Algebra ℚ_[p] F] [IsScalarTower ℚ_[p] F K] {πR : R}
    {π : F} (hπ : algebraMap R F πR = π)
    (hfrob : ∀ (B : Type) [CommRing B] [Algebra R B] [Module.Free R B] [Module.Finite R B]
      [Algebra.Etale R B], ∃ N, 0 < N ∧ ∀ a : B, ∃ b : B, a ^ (p ^ N) - a = algebraMap R B πR * b)
    (k : ℕ) : FrobClosedOver F π (G.etCoordSetOver k) := by
  rintro _ ⟨w, hw, φ, b, rfl⟩
  haveI : Algebra.Etale R (G.G w).etaleQuotient.A := (G.G w).isEtale_etaleQuotient
  obtain ⟨N, hN, hper⟩ := hfrob (G.G w).etaleQuotient.A
  obtain ⟨c, hc⟩ := hper b
  let ψ : (G.G w).etaleQuotient.A →ₐ[R] K :=
    φ.comp ((G.G w).etaleQuotientHom : (G.G w).etaleQuotient.A →ₐ[R] (G.G w).A)
  refine ⟨N, hN, ψ c, Algebra.subset_adjoin (Or.inl ⟨w, hw, φ, c, rfl⟩), ?_⟩
  have h := congrArg ψ hc
  rwa [map_sub, map_pow, map_mul, AlgHom.commutes, IsScalarTower.algebraMap_apply R F K,
    hπ] at h

theorem finiteDimensional_etCoordFieldOver [Algebra.IsAlgebraic F K] (k : ℕ) :
    FiniteDimensional F (G.etCoordFieldOver F k) := by
  classical
  let bas := fun w => Module.Free.chooseBasis R (G.G w).etaleQuotient.A
  let S : Set K := ⋃ w ∈ Finset.range (k + 1), ⋃ φ : (G.G w).A →ₐ[R] K,
    Set.range fun i => φ ((G.G w).etaleQuotientHom (bas w i))
  have hS : S.Finite := by
    refine Set.Finite.biUnion (Finset.finite_toSet _) fun w _ => ?_
    haveI := G.finite_algHom_over w
    exact Set.finite_iUnion fun φ => Set.finite_range _
  have hSS : S ⊆ G.etCoordSetOver k := by
    intro z hz
    simp only [S, Set.mem_iUnion, Finset.mem_range, Set.mem_range] at hz
    obtain ⟨w, hw, φ, i, rfl⟩ := hz
    exact ⟨w, by omega, φ, _, rfl⟩
  have hSF : G.etCoordSetOver k ⊆ IntermediateField.adjoin F S := by
    rintro _ ⟨w, hw, φ, a, rfl⟩
    rw [← (bas w).sum_repr a, map_sum, map_sum]
    refine IntermediateField.sum_mem _ fun i _ => ?_
    rw [map_smul, map_smul, Algebra.smul_def, IsScalarTower.algebraMap_apply R F K]
    refine IntermediateField.mul_mem _ (IntermediateField.algebraMap_mem _ _) ?_
    refine IntermediateField.subset_adjoin _ _ ?_
    simp only [S, Set.mem_iUnion, Finset.mem_range, Set.mem_range]
    exact ⟨w, by omega, φ, i, rfl⟩
  have heq : G.etCoordFieldOver F k = IntermediateField.adjoin F S :=
    le_antisymm (IntermediateField.adjoin_le_iff.mpr hSF)
      (IntermediateField.adjoin.mono _ _ _ hSS)
  rw [heq]
  haveI : Finite S := hS.to_subtype
  exact IntermediateField.finiteDimensional_adjoin fun x _ =>
    (Algebra.IsAlgebraic.isAlgebraic x).isIntegral

/-- **The fields `etCoordFieldOver F G k` are `G_F`-stable, unramified relative to `π` and
rigid**, if Frobenius is periodic modulo `π` on `O_F` and on finite étale `R`-algebras. -/
theorem isUnrStableOver_etCoordFieldOver [Algebra ℚ_[p] F] [IsScalarTower ℚ_[p] F K] {πR : R}
    {π : F} (hπ : algebraMap R F πR = π) (hR : ∀ r : R, ‖algebraMap R K r‖ ≤ 1) (hπ0 : π ≠ 0)
    (hπ1 : ‖algebraMap F K π‖ < 1) (hF : FrobPeriodicMod (p := p) F π)
    (hfrob : ∀ (B : Type) [CommRing B] [Algebra R B] [Module.Free R B] [Module.Finite R B]
      [Algebra.Etale R B], ∃ N, 0 < N ∧ ∀ a : B, ∃ b : B, a ^ (p ^ N) - a = algebraMap R B πR * b)
    (k : ℕ) : IsUnrStableOver F π (G.etCoordFieldOver F k) :=
  isUnrStableOver_adjoin hπ0 hπ1 hF (fun _ h => G.norm_le_one_of_mem_etCoordSetOver hR h)
    (G.frobClosedOver_etCoordSetOver F hπ hfrob k) (fun σ _ hz => G.gal_mem_etCoordSetOver F σ hz)
    (fun σ hσ => by
      rintro _ ⟨w, hw, φ, b, rfl⟩
      haveI : Algebra.Etale R (G.G w).etaleQuotient.A := (G.G w).isEtale_etaleQuotient
      let ψ : (G.G w).etaleQuotient.A →ₐ[R] K :=
        φ.comp ((G.G w).etaleQuotientHom : (G.G w).etaleQuotient.A →ₐ[R] (G.G w).A)
      have h1 := algHom_eq_of_norm_sub_lt_one ψ
        (((σ : K →ₐ[F] K).restrictScalars R).comp ψ)
        (fun c => norm_le_one_of_isIntegral hR ψ (Algebra.IsIntegral.isIntegral c))
        (fun c => by
          rw [norm_sub_rev]
          exact hσ _ ⟨w, hw, φ, c, rfl⟩)
      exact (DFunLike.congr_fun h1 b).symm)

end Coord

/-! ### `T_p(G⁰) ⊆ T_p G` -/

variable (F : Type) [Field F] [Algebra F (PadicAlgCl p)] [Algebra R F]
  [IsScalarTower R F (PadicAlgCl p)]

omit [IsAdicComplete (maximalIdeal R) R] [IsDomain R] [IsPrincipalIdealRing R] in
/-- Levelwise injective homomorphisms are injective on Tate modules of generic fibres. -/
theorem tateLin_baseChange_injectiveOver {G₁ G₂ : PDivGroup R p} (ι : Hom G₁ G₂)
    (hι : ∀ v, Function.Injective ((ι.f v).mapPoints K)) :
    Function.Injective (Hom.baseChange (S := F) ι).tateLin := by
  intro x y h
  refine (G₁.baseChange F).addTate_ext K fun v => ?_
  have h1 := congrArg (fun z => (G₂.G v).baseChangePointsEquiv (S := F) K
    ((Additive.toMul z).1 v)) h
  have h2 : (ι.f v).mapPoints K ((G₁.G v).baseChangePointsEquiv (S := F) K
      ((Additive.toMul x).1 v)) = (ι.f v).mapPoints K
      ((G₁.G v).baseChangePointsEquiv (S := F) K ((Additive.toMul y).1 v)) := h1
  exact ((G₁.G v).baseChangePointsEquiv (S := F) K).injective (hι v h2)

omit [IsAdicComplete (maximalIdeal R) R] [IsDomain R] [IsPrincipalIdealRing R] in
/-- `φ ∘ ψ = id` gives `φ_* ∘ ψ_* = id` on Tate modules of generic fibres. -/
theorem tateLin_baseChange_comp_eqOver {G₁ G₂ : PDivGroup R p} (φ : Hom G₁ G₂)
    (ψ : Hom G₂ G₁) (h : φ.comp ψ = Hom.id _)
    (y : Additive ((G₂.baseChange F).TateModule K)) :
    (Hom.baseChange (S := F) φ).tateLin ((Hom.baseChange (S := F) ψ).tateLin y) = y := by
  refine (G₂.baseChange F).addTate_ext K fun v => ?_
  apply ((G₂.G v).baseChangePointsEquiv (S := F) K).injective
  change ((φ.comp ψ).f v).mapPoints K
    ((G₂.G v).baseChangePointsEquiv (S := F) K ((Additive.toMul y).1 v)) = _
  rw [h]
  rfl

variable (G : PDivGroup R p)

/-- `T_p(G⁰) → T_p G` on generic fibres. -/
def connTateLinOver : Additive ((G.connPart.baseChange F).TateModule K) →ₗ[ℤ_[p]]
    Additive ((G.baseChange F).TateModule K) :=
  (Hom.baseChange (S := F) G.connPartHom).tateLin

theorem connTateLinOver_injective : Function.Injective (G.connTateLinOver F) :=
  tateLin_baseChange_injectiveOver F G.connPartHom fun v => G.connPartHom_mapPoints_injective v K

theorem bc_connTateLinOver (y : Additive ((G.connPart.baseChange F).TateModule K)) (v : ℕ) :
    (G.G v).baseChangePointsEquiv (S := F) K ((Additive.toMul (G.connTateLinOver F y)).1 v) =
      (G.G v).connectedComponentHom.mapPoints K
        ((G.G v).connectedComponent.baseChangePointsEquiv (S := F) K
          ((Additive.toMul y).1 v)) := rfl

/-- `T⁰ = T_p(G⁰) ⊆ T_p G`. -/
abbrev connTateOver : Submodule ℤ_[p] (Additive ((G.baseChange F).TateModule K)) :=
  LinearMap.range (G.connTateLinOver F)

/-- **`x ∈ T⁰` iff all levels of `x` are points of `G_v⁰`.** -/
theorem mem_connTateOver_iff (x : Additive ((G.baseChange F).TateModule K)) :
    x ∈ G.connTateOver F ↔ ∀ v, (G.G v).baseChangePointsEquiv (S := F) K
      ((Additive.toMul x).1 v) ∈ ((G.G v).connectedComponentHom.mapPoints K).range := by
  constructor
  · rintro ⟨y, rfl⟩ v
    exact ⟨_, (G.bc_connTateLinOver F y v).symm⟩
  · intro hx
    simp only [MonoidHom.mem_range] at hx
    choose y hy using hx
    have hcomp : ∀ v, (G.connIncl v).mapPoints K (y v) = (y (v + 1)) ^ p := by
      intro v
      apply (G.G (v + 1)).mapPoints_connectedComponentHom_injective K
      rw [map_pow, hy (v + 1)]
      unfold connIncl
      rw [mapPoints_connectedComponentMap, hy v]
      exact (congrArg ((G.G (v + 1)).baseChangePointsEquiv (S := F) K)
        ((Additive.toMul x).2 v)).trans (map_pow _ _ _)
    let yT : G.connPart.TateModule K := ⟨y, hcomp⟩
    refine ⟨Additive.ofMul ((G.connPart.baseChangeTateEquiv (S := F) K).symm yT), ?_⟩
    refine (G.baseChange F).addTate_ext K fun v => ?_
    apply ((G.G v).baseChangePointsEquiv (S := F) K).injective
    rw [bc_connTateLinOver, ← hy v]
    congr 1
    exact ((G.G v).connectedComponent.baseChangePointsEquiv (S := F) K).apply_symm_apply (y v)

omit [IsDomain R] [IsPrincipalIdealRing R] in
/-- A point lies in `G⁰` iff it kills `1 - e₀`. -/
theorem mem_range_connectedComponentHom_iffOver (Gs : FFGroupScheme R) (x : Gs.points K) :
    x ∈ (Gs.connectedComponentHom.mapPoints K).range ↔ ofConv x (1 - Gs.idemConn) = 0 := by
  constructor
  · rintro ⟨y, rfl⟩
    change ofConv y (Gs.connectedComponentHom (1 - Gs.idemConn)) = 0
    rw [map_sub, map_one, connectedComponentHom_idemConn, sub_self, map_zero]
  · intro hx
    exact Gs.exists_connectedComponentHom_mapPoints_eq x hx

omit [IsAdicComplete (maximalIdeal R) R] [IsDomain R] [IsPrincipalIdealRing R]
  [Algebra R (PadicAlgCl p)] [IsScalarTower R F (PadicAlgCl p)] in
theorem toMul_p_smul_succOver (z : Additive ((G.baseChange F).TateModule K)) (v : ℕ) :
    (Additive.toMul ((p : ℤ_[p]) • z)).1 (v + 1) =
      ((G.baseChange F).incl v).mapPoints K ((Additive.toMul z).1 v) := by
  rw [(Additive.toMul z).2 v, Nat.cast_smul_eq_nsmul, toMul_nsmul]
  rfl

/-- **`T / T⁰` has no `p`-torsion.** -/
theorem mem_connTateOver_of_p_smul_mem (z : Additive ((G.baseChange F).TateModule K))
    (hz : (p : ℤ_[p]) • z ∈ G.connTateOver F) : z ∈ G.connTateOver F := by
  rw [mem_connTateOver_iff] at hz ⊢
  intro v
  have h := hz (v + 1)
  rw [toMul_p_smul_succOver, mem_range_connectedComponentHom_iffOver] at h
  rw [mem_range_connectedComponentHom_iffOver]
  have e : ofConv ((G.G v).baseChangePointsEquiv (S := F) K ((Additive.toMul z).1 v))
      (G.incl v (1 - (G.G (v + 1)).idemConn)) = 0 := h
  rwa [map_sub, map_one, G.incl_idemConn v] at e

theorem mem_connTateOver_of_pow_smul_mem (n : ℕ) :
    ∀ z : Additive ((G.baseChange F).TateModule K),
      (p : ℤ_[p]) ^ n • z ∈ G.connTateOver F → z ∈ G.connTateOver F := by
  induction n with
  | zero => intro z hz; simpa using hz
  | succ n ih =>
    intro z hz
    rw [pow_succ, mul_smul] at hz
    exact G.mem_connTateOver_of_p_smul_mem F z (ih _ hz)

/-- **`T / T⁰` is torsion free.** -/
theorem mem_connTateOver_of_smul_mem {a : ℤ_[p]} (ha : a ≠ 0)
    (z : Additive ((G.baseChange F).TateModule K)) (hz : a • z ∈ G.connTateOver F) :
    z ∈ G.connTateOver F := by
  have hspec := PadicInt.unitCoeff_spec ha
  refine G.mem_connTateOver_of_pow_smul_mem F a.valuation z ?_
  have h1 : (↑(PadicInt.unitCoeff ha)⁻¹ : ℤ_[p]) • a • z ∈ G.connTateOver F :=
    (G.connTateOver F).smul_mem _ hz
  have h2 : (↑(PadicInt.unitCoeff ha)⁻¹ : ℤ_[p]) * a = (p : ℤ_[p]) ^ a.valuation :=
    (congrArg (fun t => (↑(PadicInt.unitCoeff ha)⁻¹ : ℤ_[p]) * t) hspec).trans
      (Units.inv_mul_cancel_left _ _)
  rwa [← mul_smul, h2] at h1

/-! ### The quotient `T / T⁰` and its Galois action -/

/-- `T / T⁰`, the Tate module of the étale part. -/
abbrev EtTateOver : Type := Additive ((G.baseChange F).TateModule K) ⧸ G.connTateOver F

omit [Algebra R (PadicAlgCl p)] [IsScalarTower R F (PadicAlgCl p)] in
theorem galLin_mem_connTateOver (σ : K ≃ₐ[F] K) {x : Additive ((G.baseChange F).TateModule K)}
    (hx : x ∈ G.connTateOver F) : (G.baseChange F).galLin σ x ∈ G.connTateOver F := by
  obtain ⟨y, rfl⟩ := hx
  exact ⟨(G.connPart.baseChange F).galLin σ y, rfl⟩

/-- The Galois action on `T / T⁰`. -/
def galQOver (σ : K ≃ₐ[F] K) : G.EtTateOver F →ₗ[ℤ_[p]] G.EtTateOver F :=
  (G.connTateOver F).mapQ (G.connTateOver F) ((G.baseChange F).galLin σ) fun _ hx =>
    G.galLin_mem_connTateOver F σ hx

omit [Algebra R (PadicAlgCl p)] [IsScalarTower R F (PadicAlgCl p)] in
theorem galQOver_mk (σ : K ≃ₐ[F] K) (x : Additive ((G.baseChange F).TateModule K)) :
    G.galQOver F σ ((G.connTateOver F).mkQ x) =
      (G.connTateOver F).mkQ ((G.baseChange F).galLin σ x) := rfl

omit [Algebra R (PadicAlgCl p)] [IsScalarTower R F (PadicAlgCl p)] in
theorem galQOver_one : G.galQOver F 1 = LinearMap.id :=
  LinearMap.ext fun q => by
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ q
    rfl

omit [Algebra R (PadicAlgCl p)] [IsScalarTower R F (PadicAlgCl p)] in
theorem galQOver_mul (σ τ : K ≃ₐ[F] K) :
    G.galQOver F (σ * τ) = G.galQOver F σ ∘ₗ G.galQOver F τ :=
  LinearMap.ext fun q => by
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ q
    rfl

/-- **The representation `V_p(G_F) / V_p(G⁰_F)` of `G_L`**, `G_L` acting through
`ι : G_L → G_F`. -/
def etRepVia (L : IntermediateField ℚ_[p] K) (ι : (K ≃ₐ[L] K) →* (K ≃ₐ[F] K)) :
    Representation ℚ_[p] (K ≃ₐ[L] K) (ℚ_[p] ⊗[ℤ_[p]] G.EtTateOver F) where
  toFun σ := (G.galQOver F (ι σ)).baseChange ℚ_[p]
  map_one' := by
    rw [map_one, galQOver_one, LinearMap.baseChange_id]
    rfl
  map_mul' σ τ := by
    rw [map_mul, galQOver_mul, LinearMap.baseChange_comp]
    rfl

omit [Algebra R (PadicAlgCl p)] [IsScalarTower R F (PadicAlgCl p)] in
theorem etRepVia_apply (L : IntermediateField ℚ_[p] K) (ι : (K ≃ₐ[L] K) →* (K ≃ₐ[F] K))
    (σ : K ≃ₐ[L] K) : G.etRepVia F L ι σ = (G.galQOver F (ι σ)).baseChange ℚ_[p] := rfl

/-- The étale quotient map does not see `ν` fixing the étale coordinates up to level `k`. -/
theorem etaleQuotientHom_galLinOver {k : ℕ} (ν : K ≃ₐ[F] K)
    (hν : ∀ z ∈ G.etCoordFieldOver F k, ν z = z) (x : Additive ((G.baseChange F).TateModule K)) :
    (G.G k).etaleQuotientHom.mapPoints K ((G.G k).baseChangePointsEquiv (S := F) K
        ((Additive.toMul ((G.baseChange F).galLin ν x)).1 k)) =
      (G.G k).etaleQuotientHom.mapPoints K ((G.G k).baseChangePointsEquiv (S := F) K
        ((Additive.toMul x).1 k)) := by
  apply WithConv.ofConv_injective
  refine AlgHom.ext fun b => ?_
  set φ := ofConv ((G.G k).baseChangePointsEquiv (S := F) K ((Additive.toMul x).1 k))
  exact hν (φ ((G.G k).etaleQuotientHom b))
    (IntermediateField.subset_adjoin _ _ ⟨k, le_rfl, φ, b, rfl⟩)

variable [CharZero F]

/-- **`ν x - x ∈ T⁰ + p^k T`** for `ν` fixing the étale coordinates up to level `k`. -/
theorem exists_galLin_subOver {k : ℕ} (ν : K ≃ₐ[F] K) (hν : ∀ z ∈ G.etCoordFieldOver F k, ν z = z)
    (x : Additive ((G.baseChange F).TateModule K)) :
    ∃ c ∈ G.connTateOver F, ∃ s,
      (G.baseChange F).galLin ν x - x = c + (p : ℤ_[p]) ^ k • s := by
  set u := (G.baseChange F).galLin ν x - x
  set bc := (G.G k).baseChangePointsEquiv (S := F) K
  have hu : (G.G k).etaleQuotientHom.mapPoints K (bc ((Additive.toMul u).1 k)) = 1 := by
    have : (Additive.toMul u).1 k = (Additive.toMul ((G.baseChange F).galLin ν x)).1 k /
        (Additive.toMul x).1 k := rfl
    let Φ : ((G.baseChange F).G k).points K →* (G.G k).etaleQuotient.points K :=
      ((G.G k).etaleQuotientHom.mapPoints K).comp
        ((G.G k).baseChangePointsEquiv (S := F) K).toMonoidHom
    have e1 : Φ ((Additive.toMul u).1 k) = 1 := by
      rw [this, map_div, div_eq_one]
      exact G.etaleQuotientHom_galLinOver F ν hν x
    exact e1
  obtain ⟨w, hw⟩ := ((G.G k).mapPoints_etaleQuotientHom_eq_one_iff _).mp hu
  obtain ⟨y, hy⟩ := G.connPart.proj_surjective_sepClosed K Hilbert90.p_ne_zero k w
  have hy' : y.1 k = w := hy
  set c := G.connTateLinOver F
    (Additive.ofMul ((G.connPart.baseChangeTateEquiv (S := F) K).symm y))
  have hck : bc ((Additive.toMul c).1 k) = bc ((Additive.toMul u).1 k) := by
    change (G.G k).connectedComponentHom.mapPoints K
      ((G.G k).connectedComponent.baseChangePointsEquiv (S := F) K
        (((G.connPart.baseChangeTateEquiv (S := F) K).symm y).1 k)) = _
    rw [← hw, ← hy']
    congr 1
    exact ((G.G k).connectedComponent.baseChangePointsEquiv (S := F) K).apply_symm_apply _
  obtain ⟨s, hs⟩ := (G.baseChange F).exists_eq_p_pow_smul k (u - c) (by
    change (Additive.toMul u).1 k / (Additive.toMul c).1 k = 1
    rw [div_eq_one]
    exact (bc.injective hck).symm)
  exact ⟨c, ⟨_, rfl⟩, s, by rw [← hs]; abel⟩

/-! ### Hilbert 90 on `T / T⁰` -/

omit [CharZero F] in
theorem isTorsionFree_etTateOver : Module.IsTorsionFree ℤ_[p] (G.EtTateOver F) where
  isSMulRegular r hr q₁ q₂ hq := by
    have hr0 : r ≠ 0 := hr.ne_zero
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ q₁
    obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective _ q₂
    have hq1 : r • (G.connTateOver F).mkQ x = r • (G.connTateOver F).mkQ y := hq
    have hq' : (G.connTateOver F).mkQ (r • (x - y)) = 0 := by
      rw [map_smul, map_sub, smul_sub, sub_eq_zero]
      exact hq1
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hq'
    have h := G.mem_connTateOver_of_smul_mem F hr0 _ hq'
    rw [← sub_eq_zero, ← map_sub, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact h

instance instIsTorsionFreeEtTateOver : Module.IsTorsionFree ℤ_[p] (G.EtTateOver F) :=
  G.isTorsionFree_etTateOver F

instance instFreeEtTateOver : Module.Free ℤ_[p] (G.EtTateOver F) :=
  Module.free_of_finite_type_torsion_free'

/-- The matrix of `σ` on `T / T⁰` in a `ℤ_p`-basis `b`. -/
def galQMatrixOver {r : ℕ} (b : Module.Basis (Fin r) ℤ_[p] (G.EtTateOver F)) :
    (K ≃ₐ[F] K) →* Matrix (Fin r) (Fin r) ℤ_[p] where
  toFun σ := LinearMap.toMatrix b b (G.galQOver F σ)
  map_one' := by rw [galQOver_one, LinearMap.toMatrix_id]
  map_mul' σ τ := by rw [galQOver_mul, LinearMap.toMatrix_comp b b b]

/-- **`A(ν) ≡ 1 mod p^k`** on `Gal(ℚ̄_p / etCoordFieldOver F G k)`. -/
theorem galQMatrixOver_fix {r : ℕ} (b : Module.Basis (Fin r) ℤ_[p] (G.EtTateOver F)) (k : ℕ)
    (ν : K ≃ₐ[F] K) (hν : ∀ z ∈ G.etCoordFieldOver F k, ν z = z) (i j : Fin r) :
    ‖G.galQMatrixOver F b ν i j - (1 : Matrix (Fin r) (Fin r) ℤ_[p]) i j‖ ≤
      ‖(p : ℤ_[p])‖ ^ k := by
  classical
  obtain ⟨x, hx⟩ := Submodule.mkQ_surjective (G.connTateOver F) (b j)
  obtain ⟨c, hc, s, hs⟩ := G.exists_galLin_subOver F ν hν x
  have hc0 : (G.connTateOver F).mkQ c = 0 := by
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact hc
  have h1 : G.galQOver F ν (b j) - b j = (p : ℤ_[p]) ^ k • (G.connTateOver F).mkQ s := by
    rw [← hx, galQOver_mk, ← map_sub, hs, map_add, hc0, zero_add, map_smul]
  have h2 : G.galQMatrixOver F b ν i j - (1 : Matrix (Fin r) (Fin r) ℤ_[p]) i j =
      (p : ℤ_[p]) ^ k * b.repr ((G.connTateOver F).mkQ s) i := by
    have h3 := congrArg (fun q => b.repr q i) h1
    rw [map_sub b.repr, map_smul b.repr, Basis.repr_self, Finsupp.sub_apply,
      Finsupp.smul_apply, smul_eq_mul] at h3
    rw [← h3]
    congr 1
    · exact LinearMap.toMatrix_apply b b _ i j
    · rw [Matrix.one_apply, Finsupp.single_apply]
      exact if_congr eq_comm rfl rfl
  rw [h2, norm_mul, norm_pow]
  exact mul_le_of_le_one_right (by positivity) (PadicInt.norm_le_one _)

section HT

variable [Algebra ℚ_[p] F] [IsScalarTower ℚ_[p] F (PadicAlgCl p)] [Normal F (PadicAlgCl p)]
  (L : IntermediateField ℚ_[p] (PadicAlgCl p)) [FiniteDimensional ℚ_[p] L]
  (ι : (PadicAlgCl p ≃ₐ[L] PadicAlgCl p) →* (PadicAlgCl p ≃ₐ[F] PadicAlgCl p))
  (hι : ∀ σ x, ι σ x = σ x) {πR : R} {π : F} (hπ : algebraMap R F πR = π)
  (hR : ∀ r : R, ‖algebraMap R (PadicAlgCl p) r‖ ≤ 1)
  (hπ0 : π ≠ 0) (hπ1 : ‖algebraMap F (PadicAlgCl p) π‖ < 1) (hF : FrobPeriodicMod (p := p) F π)
  (hfrob : ∀ (B : Type) [CommRing B] [Algebra R B] [Module.Free R B] [Module.Finite R B]
    [Algebra.Etale R B], ∃ N, 0 < N ∧ ∀ a : B, ∃ b : B, a ^ (p ^ N) - a = algebraMap R B πR * b)
  (hpπ : ‖(p : PadicAlgCl p)‖ ≤ ‖algebraMap F (PadicAlgCl p) π‖)

include hι hπ hR hπ0 hπ1 hF hfrob hpπ in
/-- **`V_p(G_F) / V_p(G⁰_F)` is Hodge–Tate with all weights `0`** as a `G_L`-representation
(Hilbert 90 for the completed maximal unramified extension of `F`), in particular
`D_{-1}(V_p G / V_p(G⁰)) = 0`. -/
theorem isHodgeTate_etRepVia :
    IsHodgeTate (G.etRepVia F L ι) ∧
      (htWeights (G.etRepVia F L ι)).count 0 =
        finrank ℚ_[p] (ℚ_[p] ⊗[ℤ_[p]] G.EtTateOver F) := by
  classical
  set b := Module.finBasis ℤ_[p] (G.EtTateOver F)
  set A := G.galQMatrixOver F b
  haveI : ∀ k, FiniteDimensional F (G.etCoordFieldOver F k) :=
    G.finiteDimensional_etCoordFieldOver F
  obtain ⟨X, hX, hXinv⟩ := exists_hilbert90_over (A := A) (Mk := G.etCoordFieldOver F)
    hπ0 hπ1 (G.isUnrStableOver_etCoordFieldOver F hπ hR hπ0 hπ1 hF hfrob)
    (G.etCoordFieldOver_mono F) (fun k ν hν i j => by
      have := G.galQMatrixOver_fix F b k ν hν i j
      rw [norm_p_padicInt_eq] at this
      have h1 : ‖A ν i j - (1 : Matrix (Fin (finrank ℤ_[p] (G.EtTateOver F))) _ ℤ_[p]) i j‖ =
          ‖algebraMap ℤ_[p] K (A ν i j) -
            (1 : Matrix (Fin (finrank ℤ_[p] (G.EtTateOver F))) _ K) i j‖ := by
        rw [← norm_algebraMap_padicInt, map_sub, Matrix.one_apply, Matrix.one_apply]
        split_ifs <;> simp
      rw [Matrix.sub_apply, AK, Matrix.map_apply, ← h1]
      exact this.trans (pow_le_pow_left₀ (norm_nonneg _) hpπ k))
  exact isHodgeTate_of_matrix (G.etRepVia F L ι) (Algebra.TensorProduct.basis ℚ_[p] b) X hX
    (fun σ => by
      have h1 : LinearMap.toMatrix (Algebra.TensorProduct.basis ℚ_[p] b)
          (Algebra.TensorProduct.basis ℚ_[p] b) (G.etRepVia F L ι σ) =
          (A (ι σ)).map (algebraMap ℤ_[p] ℚ_[p]) :=
        LinearMap.toMatrix_baseChange _ _ _ _
      rw [h1, Matrix.map_map]
      have h2 : (algebraMap ℚ_[p] ℂ_[p]) ∘ (algebraMap ℤ_[p] ℚ_[p]) =
          toCp ∘ algebraMap ℤ_[p] K := by
        funext a
        simp only [Function.comp_apply, UniformSpace.Completion.algebraMap_def,
          IsScalarTower.algebraMap_apply ℤ_[p] ℚ_[p] K]
        rfl
      have hres : (ι σ).restrictScalars ℚ_[p] = σ.restrictScalars ℚ_[p] :=
        AlgEquiv.ext (hι σ)
      have h3 := hXinv (ι σ)
      rw [hres] at h3
      rw [h2, ← Matrix.map_map]
      exact h3)

include hι hπ hR hπ0 hπ1 hF hfrob hpπ in
theorem finrank_DHT_etRepVia_neg_one : finrank L (DHT (G.etRepVia F L ι) (-1)) = 0 := by
  have h0 := (G.isHodgeTate_etRepVia F L ι hι hπ hR hπ0 hπ1 hF hfrob hpπ).2
  rw [count_htWeights] at h0
  have hle := sum_finrank_DHT_le (G.etRepVia F L ι) {0, -1}
  rw [Finset.sum_pair (by norm_num)] at hle
  omega

end HT

/-! ### `dim D_{-1}(V_p G) = dim G⁰` -/

/-- **[Hong, Cor. 3.4.11] for non-connected `G`, over a general base**: if `G⁰ ≅ H` with
`dim_L D_{-1}(V_p H) = d` and `D_{-1}(V_p G / V_p(G⁰)) = 0`, then `dim_L D_{-1}(V_p G) = d`
(all as representations of `G_L` acting through `ι : G_L → G_F`). -/
theorem finrank_DHT_neg_one_of_iso_over (L : IntermediateField ℚ_[p] K)
    [FiniteDimensional ℚ_[p] L] (ι : (K ≃ₐ[L] K) →* (K ≃ₐ[F] K))
    {ρ : Representation ℚ_[p] (K ≃ₐ[L] K)
      (ℚ_[p] ⊗[ℤ_[p]] Additive ((G.baseChange F).TateModule K))}
    (hρ : ∀ σ, ρ σ = ((G.baseChange F).galLin (ι σ)).baseChange ℚ_[p])
    {H : PDivGroup R p}
    {ρ' : Representation ℚ_[p] (K ≃ₐ[L] K)
      (ℚ_[p] ⊗[ℤ_[p]] Additive ((H.baseChange F).TateModule K))}
    (hρ' : ∀ σ, ρ' σ = ((H.baseChange F).galLin (ι σ)).baseChange ℚ_[p])
    {d : ℕ} (hd : finrank L (DHT ρ' (-1)) = d)
    (het : finrank L (DHT (G.etRepVia F L ι) (-1)) = 0)
    (φ : Hom G.connPart H) (ψ : Hom H G.connPart)
    (hφψ : φ.comp ψ = Hom.id _) (hψφ : ψ.comp φ = Hom.id _) :
    finrank L (DHT ρ (-1)) = d := by
  haveI : Module.Flat ℤ_[p] ℚ_[p] := IsLocalization.flat ℚ_[p] (nonZeroDivisors ℤ_[p])
  let fP : Additive ((H.baseChange F).TateModule K) →ₗ[ℤ_[p]]
      Additive ((G.baseChange F).TateModule K) :=
    G.connTateLinOver F ∘ₗ (Hom.baseChange (S := F) ψ).tateLin
  have hfPi : Function.Injective fP := (G.connTateLinOver_injective F).comp
    (Function.LeftInverse.injective (tateLin_baseChange_comp_eqOver F φ ψ hφψ))
  have hfPr : LinearMap.range fP = G.connTateOver F := by
    refine le_antisymm ?_ ?_
    · rintro _ ⟨y, rfl⟩
      exact ⟨_, rfl⟩
    · rintro _ ⟨y, rfl⟩
      refine ⟨(Hom.baseChange (S := F) φ).tateLin y, ?_⟩
      change G.connTateLinOver F _ = _
      rw [tateLin_baseChange_comp_eqOver F ψ φ hψφ]
  let f := fP.baseChange ℚ_[p]
  let g := (G.connTateOver F).mkQ.baseChange ℚ_[p]
  have hf : ∀ σ, f ∘ₗ ρ' σ = ρ σ ∘ₗ f := fun σ => by
    rw [hρ, hρ']
    change fP.baseChange ℚ_[p] ∘ₗ ((H.baseChange F).galLin _).baseChange ℚ_[p] =
      ((G.baseChange F).galLin _).baseChange ℚ_[p] ∘ₗ fP.baseChange ℚ_[p]
    rw [← LinearMap.baseChange_comp, ← LinearMap.baseChange_comp]
    congr 1
  have hg : ∀ σ, g ∘ₗ ρ σ = G.etRepVia F L ι σ ∘ₗ g := fun σ => by
    rw [hρ, etRepVia_apply]
    change (G.connTateOver F).mkQ.baseChange ℚ_[p] ∘ₗ
        ((G.baseChange F).galLin _).baseChange ℚ_[p] =
      (G.galQOver F _).baseChange ℚ_[p] ∘ₗ (G.connTateOver F).mkQ.baseChange ℚ_[p]
    rw [← LinearMap.baseChange_comp, ← LinearMap.baseChange_comp]
    congr 1
  have hfi : Function.Injective f := by
    change Function.Injective (fP.baseChange ℚ_[p])
    rw [LinearMap.baseChange_eq_ltensor]
    exact Module.Flat.lTensor_preserves_injective_linearMap _ hfPi
  have hex0 : Function.Exact fP (G.connTateOver F).mkQ := by
    rw [LinearMap.exact_iff, Submodule.ker_mkQ, hfPr]
  have hfg : Function.Exact f g := by
    change Function.Exact (fP.baseChange ℚ_[p]) ((G.connTateOver F).mkQ.baseChange ℚ_[p])
    rw [LinearMap.baseChange_eq_ltensor, LinearMap.baseChange_eq_ltensor]
    exact _root_.lTensor_exact ℚ_[p] hex0 (Submodule.mkQ_surjective _)
  have hup := finrank_DHT_le_add hf hg hfi hfg (-1)
  have hlow := finrank_DHT_le_of_injective hf hfi (-1)
  rw [hd, het] at hup
  rw [hd] at hlow
  exact le_antisymm (hup.trans_eq (add_zero d)) hlow

end PDivGroup

end PadicHodge
