import PadicHodge.FormalGroup.LayerPDiv
import PadicHodge.GroupScheme.DualPDivFree

/-!
# The Cartier dual of `F[p^∞]` over a complete local ring

For a `p`-divisible formal group law `F` of height `h` over a complete local ring `R` (e.g.
`ℤ_p`), the connected `p`-divisible group `G = F[p^∞]` (`PDivFGL.pdivGroup`,
[Hong, Prop. 2.2.10]) has a Cartier dual `p`-divisible group `G^∨ = (G_v^∨, quot_v^∨)` of
height `h` over `R` (`PDivFGL.dualPDiv`; [Hong, Prop. 2.1.7 (2), Def. 2.1.8], [BC, §7.2]).
We verify the freeness conditions `PDivGroup.DualPDivData` of `GroupScheme/DualPDivFree.lean`,
using that `R[[T]]` is free of rank `p^{hw}` over itself via `[p^w]^* : f ↦ f([p^w]_F)`
([Hong, Def. 2.2.9 (2)], `freeVia_psiV`):

* `FGL.exists_retr`: an `R[[T]]`-basis of `R[[T]]` over `[p^w]^*(R[[T]])` contains an element
  whose coefficient of `1` is a unit (compare constant terms; `R` local), so there is a
  `[p^w]^*`-semilinear retraction `φ_w` with `φ_w(1) = 1`;
* `FGL.layerMap`: `[p^w]^*` induces `A_k → A_{k+w}` (`A_v = R[[T]]/[p^v]_F(I)`), and `φ_w`
  descends to an `A_k`-linear retraction `A_{k+w} → A_k` (`FGL.layerRetr`), since
  `J_{k+w} = [p^w]^*(J_k) R[[T]]` ([Hong, Prop. 2.2.10, proof]);
* `PDivFGL.quot_mk`: the quotient map `quot_v^* : A_v → A_{v+1}` (characterised by
  `i_v ∘ quot_v = [p]`) is induced by `[p]^*`; `[p^v] : G_{v+1} → G_{v+1}` factors through
  `A_{v+1} ↠ A_1` and `[p^v]^* : A_1 → A_{v+1}`; the kernel of `A_{v+1} ↠ A_1` is generated by
  `[p]_F(t) = quot_v^*(t)`.

Main results: `PDivFGL.dualPDiv` (with `order_dualPDiv : |G_v^∨| = p^{hv}`),
`PDivFGL.tateModule_dualPDiv : T_p(G^∨) = DualTate G` and, for `R` a `ℚ_p`-algebra domain of
definition, `PDivFGL.dualPDivBaseChangeTateEquiv : T_p((G^∨)_{ℚ_p}) ≃* T_p((G_{ℚ_p})^∨)`.
-/

noncomputable section

open MvPowerSeries IsLocalRing WithConv

namespace PadicHodge

universe u

namespace FGL

variable {R : Type*} [CommRing R] {d : ℕ} (F : FGL R d) (p : ℕ)

theorem layerIdeal_le_ker_constantCoeff (v : ℕ) :
    F.layerIdeal p v ≤ RingHom.ker (constantCoeff (σ := Fin d) (R := R)) := by
  rw [layerIdeal, Ideal.span_le]
  rintro _ ⟨j, rfl⟩
  exact F.constantCoeff_mulPS _ j

theorem constantCoeff_psiV (w : ℕ) (f : MvPowerSeries (Fin d) R) :
    constantCoeff (F.psiV p w f) = constantCoeff f := by
  have h := F.layerIdeal_le_ker_constantCoeff p w (F.psiV_sub_C_mem p w f)
  rw [RingHom.mem_ker, map_sub, constantCoeff_C, sub_eq_zero] at h
  exact h

variable {F p}

/-- **A semilinear retraction of `[p^w]^*`** with `φ(1) = 1`, over a local ring. -/
theorem exists_retr [IsLocalRing R] {ψ : MvPowerSeries (Fin d) R →ₐ[R] MvPowerSeries (Fin d) R}
    (hψ : ∀ f, constantCoeff (ψ f) = constantCoeff f) {n : ℕ} (h : FreeVia ψ.toRingHom n) :
    ∃ φ : MvPowerSeries (Fin d) R →ₗ[R] MvPowerSeries (Fin d) R,
      (∀ a f, φ (ψ a * f) = a * φ f) ∧ φ 1 = 1 := by
  obtain ⟨b, hb⟩ := h
  let Lm : (Fin n → MvPowerSeries (Fin d) R) →ₗ[R] MvPowerSeries (Fin d) R :=
    { toFun := fun c => ∑ i, ψ (c i) * b i
      map_add' := fun c c' => by
        simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
      map_smul' := fun r c => by
        simp only [Pi.smul_apply, map_smul, smul_mul_assoc, RingHom.id_apply, Finset.smul_sum] }
  let L := LinearEquiv.ofBijective Lm hb
  have hL : ∀ c, L c = ∑ i, ψ (c i) * b i := fun c => rfl
  have hsemi : ∀ a f, L.symm (ψ a * f) = fun i => a * L.symm f i := by
    intro a f
    apply L.injective
    rw [LinearEquiv.apply_symm_apply, hL]
    simp only [map_mul, mul_assoc, ← Finset.mul_sum]
    congr 1
    rw [← hL, LinearEquiv.apply_symm_apply]
  set c := L.symm 1
  have h1 : ∑ i, ψ (c i) * b i = 1 := by rw [← hL, LinearEquiv.apply_symm_apply]
  obtain ⟨k, hk⟩ : ∃ k, IsUnit (constantCoeff (c k)) := by
    by_contra hcon
    simp only [not_exists] at hcon
    have hmem : ∑ i, constantCoeff (ψ (c i) * b i) ∈ maximalIdeal R :=
      Ideal.sum_mem _ fun i _ => by
        rw [map_mul, hψ]
        exact Ideal.mul_mem_right _ _ ((mem_maximalIdeal _).mpr (hcon i))
    rw [← map_sum, h1, map_one] at hmem
    exact (maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr hmem)
  have hu : IsUnit (c k) := MvPowerSeries.isUnit_iff_constantCoeff.mpr hk
  refine ⟨LinearMap.mulLeft R (↑hu.unit⁻¹ : MvPowerSeries (Fin d) R) ∘ₗ LinearMap.proj k ∘ₗ
    L.symm.toLinearMap, fun a f => ?_, ?_⟩
  · simp only [LinearMap.comp_apply, LinearMap.mulLeft_apply, LinearEquiv.coe_coe,
      LinearMap.coe_proj, Function.eval, hsemi]
    ring
  · simp only [LinearMap.comp_apply, LinearMap.mulLeft_apply, LinearEquiv.coe_coe,
      LinearMap.coe_proj, Function.eval]
    exact hu.val_inv_mul

variable (F p)

theorem psiV_mulPS (k w : ℕ) (j : Fin d) :
    F.psiV p w (F.mulPS (p ^ k) j) = F.mulPS (p ^ (k + w)) j := by
  rw [psiV_apply, subst_mulPS, pow_add]

theorem layerIdeal_le_comap_psiV {k w n : ℕ} (h : n = k + w) :
    F.layerIdeal p k ≤ (F.layerIdeal p n).comap (F.psiV p w) := by
  subst h
  rw [layerIdeal, Ideal.span_le]
  rintro _ ⟨j, rfl⟩
  rw [SetLike.mem_coe, Ideal.mem_comap, psiV_mulPS]
  exact F.mulPS_mem_layerIdeal p _ j

/-- `[p^w]^* : A_k → A_n` for `n = k + w` (multiplication by `p^w`, `G_n → G_k`). -/
def layerMap {k w n : ℕ} (h : n = k + w) : F.Layer p k →ₐ[R] F.Layer p n :=
  Ideal.quotientMapₐ (F.layerIdeal p n) (F.psiV p w) (F.layerIdeal_le_comap_psiV p h)

theorem layerMap_mk {k w n : ℕ} (h : n = k + w) (f : MvPowerSeries (Fin d) R) :
    F.layerMap p h (Ideal.Quotient.mk _ f) = Ideal.Quotient.mk _ (F.psiV p w f) := rfl

variable {F p}

theorem retr_mem {w : ℕ} {φ : MvPowerSeries (Fin d) R →ₗ[R] MvPowerSeries (Fin d) R}
    (hφ : ∀ a f, φ (F.psiV p w a * f) = a * φ f) {k n : ℕ} (h : n = k + w)
    {x : MvPowerSeries (Fin d) R} (hx : x ∈ F.layerIdeal p n) : φ x ∈ F.layerIdeal p k := by
  subst h
  suffices H : ∀ c, φ (c * x) ∈ F.layerIdeal p k by simpa using H 1
  induction hx using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨j, rfl⟩ := hz
    intro c
    rw [← psiV_mulPS, mul_comm, hφ]
    exact Ideal.mul_mem_right _ _ (F.mulPS_mem_layerIdeal p k j)
  | zero => intro c; simp
  | add z z' _ _ hz hz' => intro c; rw [mul_add, map_add]; exact Ideal.add_mem _ (hz c) (hz' c)
  | smul a z _ hz => intro c; rw [smul_eq_mul, ← mul_assoc]; exact hz _

/-- The retraction `A_n → A_k` (`n = k + w`) induced by a semilinear retraction of `[p^w]^*`. -/
def layerRetr {w : ℕ} (φ : MvPowerSeries (Fin d) R →ₗ[R] MvPowerSeries (Fin d) R)
    (hφ : ∀ a f, φ (F.psiV p w a * f) = a * φ f) {k n : ℕ} (h : n = k + w) :
    F.Layer p n →ₗ[R] F.Layer p k :=
  (Submodule.Quotient.restrictScalarsEquiv R (F.layerIdeal p k)).toLinearMap ∘ₗ
    ((F.layerIdeal p n).restrictScalars R).mapQ ((F.layerIdeal p k).restrictScalars R) φ
      (fun _ hx => retr_mem hφ h hx) ∘ₗ
    (Submodule.Quotient.restrictScalarsEquiv R (F.layerIdeal p n)).symm.toLinearMap

theorem layerRetr_mk {w : ℕ} (φ : MvPowerSeries (Fin d) R →ₗ[R] MvPowerSeries (Fin d) R)
    (hφ : ∀ a f, φ (F.psiV p w a * f) = a * φ f) {k n : ℕ} (h : n = k + w)
    (f : MvPowerSeries (Fin d) R) :
    layerRetr φ hφ h (Ideal.Quotient.mk _ f) = Ideal.Quotient.mk _ (φ f) := rfl

theorem layerRetr_layerMap_mul {w : ℕ}
    (φ : MvPowerSeries (Fin d) R →ₗ[R] MvPowerSeries (Fin d) R)
    (hφ : ∀ a f, φ (F.psiV p w a * f) = a * φ f) {k n : ℕ} (h : n = k + w)
    (b : F.Layer p k) (x : F.Layer p n) :
    layerRetr φ hφ h (F.layerMap p h b * x) = b * layerRetr φ hφ h x := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective b
  obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [layerMap_mk, ← map_mul, layerRetr_mk, layerRetr_mk, hφ, map_mul]

theorem layerRetr_one {w : ℕ} (φ : MvPowerSeries (Fin d) R →ₗ[R] MvPowerSeries (Fin d) R)
    (hφ : ∀ a f, φ (F.psiV p w a * f) = a * φ f) (hφ1 : φ 1 = 1) {k n : ℕ} (h : n = k + w) :
    layerRetr φ hφ h 1 = 1 := by
  rw [← map_one (Ideal.Quotient.mk (F.layerIdeal p n)), layerRetr_mk, hφ1, map_one]

end FGL

namespace PDivFGL

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsAdicComplete (maximalIdeal R) R]
  {d p : ℕ} [hp : Fact p.Prime] (P : PDivFGL R d p)

attribute [local instance] isAdicComplete_free

local notation "𝔪R" => maximalIdeal R

omit [IsAdicComplete (maximalIdeal R) R] hp in
theorem exists_retrPS (w : ℕ) :
    ∃ φ : MvPowerSeries (Fin d) R →ₗ[R] MvPowerSeries (Fin d) R,
      (∀ a f, φ (P.F.psiV p w a * f) = a * φ f) ∧ φ 1 = 1 :=
  FGL.exists_retr (P.F.constantCoeff_psiV p w) (FGL.freeVia_psiV P.F p P.isPDivisible w)

/-- The semilinear retraction `φ_w` of `[p^w]^* : R[[T]] → R[[T]]`. -/
def retrPS (w : ℕ) : MvPowerSeries (Fin d) R →ₗ[R] MvPowerSeries (Fin d) R :=
  (P.exists_retrPS w).choose

omit [IsAdicComplete (maximalIdeal R) R] hp in
theorem retrPS_mul (w : ℕ) (a f : MvPowerSeries (Fin d) R) :
    P.retrPS w (P.F.psiV p w a * f) = a * P.retrPS w f :=
  (P.exists_retrPS w).choose_spec.1 a f

omit [IsAdicComplete (maximalIdeal R) R] hp in
theorem retrPS_one (w : ℕ) : P.retrPS w 1 = 1 := (P.exists_retrPS w).choose_spec.2

theorem mulMap_mk' (v n : ℕ) (f : MvPowerSeries (Fin d) R) :
    P.mulMap v n (Ideal.Quotient.mk _ f) = Ideal.Quotient.mk _ (f.subst (P.F.mulPS n)) := by
  rw [mulMap, liftL_mk, ← FGL.evF_of (P.F.tnf_mulE n (P.tnf_t v)), ← evF_t,
    FGL.evF_subst (P.tnf_t v) (P.F.constantCoeff_mulPS n)]
  rfl

/-- `[n]^*` on `A_v` is the `n`-th power of the universal point. -/
theorem univPt_pow (v n : ℕ) :
    ofConv ((P.pdivGroup.G v).univPt ^ n) = P.mulMap v n := by
  rw [P.pow_eq v]
  rfl

/-- **`quot_v^* : A_v → A_{v+1}` is induced by `[p]^*`.** -/
theorem quot_mk (v : ℕ) (f : MvPowerSeries (Fin d) R) :
    P.pdivGroup.quot v (Ideal.Quotient.mk _ f) = Ideal.Quotient.mk _ (P.F.psiV p 1 f) := by
  have h := congrArg (fun z : (P.pdivGroup.G (v + 1)).points (P.pdivGroup.G (v + 1)).A =>
    ofConv z (Ideal.Quotient.mk (P.F.layerIdeal p (v + 1)) f)) (P.pdivGroup.incl_quotAlg v)
  simp only at h
  rw [univPt_pow, mulMap_mk'] at h
  rw [PDivGroup.quot_apply, FGL.psiV_apply, pow_one, ← h]
  change _ = P.pdivGroup.quotAlg v (P.F.layerIncl p v (Ideal.Quotient.mk _ f))
  rw [layerIncl_mk]

theorem quot_eq_layerMap (v : ℕ) (b : P.A v) :
    P.pdivGroup.quot v b = P.F.layerMap p (k := v) (w := 1) rfl b := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective b
  rw [quot_mk, FGL.layerMap_mk]

omit [IsLocalRing R] [IsAdicComplete (maximalIdeal R) R] hp in
theorem layerIdeal_le_one (v : ℕ) : P.F.layerIdeal p (v + 1) ≤ P.F.layerIdeal p 1 := by
  induction v with
  | zero => exact le_rfl
  | succ v ih => exact (P.F.layerIdeal_succ_le p (v + 1)).trans ih

/-- The restriction `A_{v+1} ↠ A_1` (the closed immersion `G_1 ↪ G_{v+1}`). -/
def res (v : ℕ) : P.A (v + 1) →ₐ[R] P.A 1 := Ideal.Quotient.factorₐ R (P.layerIdeal_le_one v)

omit [IsLocalRing R] [IsAdicComplete (maximalIdeal R) R] hp in
theorem res_mk (v : ℕ) (f : MvPowerSeries (Fin d) R) :
    P.res v (Ideal.Quotient.mk _ f) = Ideal.Quotient.mk _ f := rfl

theorem ker_res (v : ℕ) : RingHom.ker (P.res v) ≤
    Ideal.span ((P.pdivGroup.quot v : (P.pdivGroup.G v).A → (P.pdivGroup.G (v + 1)).A) ''
      {b | P.counit v b = 0}) := by
  intro x hx
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [RingHom.mem_ker, res_mk, Ideal.Quotient.eq_zero_iff_mem] at hx
  have h2 : Ideal.Quotient.mk (P.F.layerIdeal p (v + 1)) f ∈
      Ideal.map (Ideal.Quotient.mk (P.F.layerIdeal p (v + 1)))
        (Ideal.span (Set.range (P.F.mulPS (p ^ 1)))) := Ideal.mem_map_of_mem _ hx
  rw [Ideal.map_span, ← Set.range_comp] at h2
  refine Ideal.span_mono ?_ h2
  rintro _ ⟨j, rfl⟩
  refine ⟨P.t v j, ?_, ?_⟩
  · exact P.counit_t v j
  · rw [t, quot_mk, FGL.psiV_X]
    rfl

/-- `[p^v]^* : A_1 → A_{v+1}`. -/
def mulP (v : ℕ) : P.A 1 →ₐ[R] P.A (v + 1) := P.F.layerMap p (k := 1) (w := v) (Nat.add_comm v 1)

theorem mulP_res (v : ℕ) (a : P.A (v + 1)) :
    P.mulP v (P.res v a) = ofConv ((P.pdivGroup.G (v + 1)).univPt ^ (p ^ v)) a := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [univPt_pow, mulMap_mk', res_mk, mulP, FGL.layerMap_mk, FGL.psiV_apply]

/-- The retraction `A_{v+1} → A_1` of `mulP v`. -/
def mulPRetr (v : ℕ) : P.A (v + 1) →ₗ[R] P.A 1 :=
  FGL.layerRetr (P.retrPS v) (P.retrPS_mul v) (Nat.add_comm v 1)

omit [IsAdicComplete (maximalIdeal R) R] hp in
theorem mulPRetr_mulP (v : ℕ) (c : P.A 1) : P.mulPRetr v (P.mulP v c) = c := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective c
  rw [mulP, FGL.layerMap_mk, mulPRetr, FGL.layerRetr_mk, ← mul_one (P.F.psiV p v f),
    P.retrPS_mul, P.retrPS_one, mul_one]

/-- The `A_v`-linear retraction `A_{v+1} → A_v` of `quot_v^*`. -/
def retr (v : ℕ) : P.A (v + 1) →ₗ[R] P.A v :=
  FGL.layerRetr (P.retrPS 1) (P.retrPS_mul 1) (k := v) rfl

/-- **The freeness data for `(F[p^∞])^∨`.** -/
def dualPDivData : P.pdivGroup.DualPDivData where
  retr := P.retr
  retr_mul v b x := by
    rw [quot_eq_layerMap]
    exact FGL.layerRetr_layerMap_mul _ _ _ b x
  retr_one v := FGL.layerRetr_one _ _ (P.retrPS_one 1) _
  res := P.res
  res_surjective v := Ideal.Quotient.factor_surjective (P.layerIdeal_le_one v)
  ker_res := P.ker_res
  mulP v := (P.mulP v).toLinearMap
  mulP_res := P.mulP_res
  mulPRetr := P.mulPRetr
  mulPRetr_mulP := P.mulPRetr_mulP

/-- **The Cartier dual `p`-divisible group `(F[p^∞])^∨`** over `R`, with layers `G_v^∨` and
transition maps `quot_v^∨`. -/
abbrev dualPDiv : PDivGroup R p := PDivGroup.dualPDivOf P.dualPDivData

theorem dualPDiv_G (v : ℕ) : P.dualPDiv.G v = (P.groupScheme v).dual := rfl

theorem dualPDiv_incl (v : ℕ) : P.dualPDiv.incl v = (P.pdivGroup.quot v).dual := rfl

theorem dualPDiv_height : P.dualPDiv.height = P.height := rfl

/-- **`|G_v^∨| = p^{hv}`.** -/
theorem order_dualPDiv (v : ℕ) : (P.dualPDiv.G v).order = p ^ (P.height * v) :=
  P.dualPDiv.order_eq v

/-- **`T_p((F[p^∞])^∨) = DualTate`**: the Tate module of the dual is the limit of the `G_v^∨`
along the transposes of the inclusions. -/
theorem tateModule_dualPDiv (S : Type u) [CommRing S] [Algebra R S] :
    haveI : NeZero p := ⟨hp.out.ne_zero⟩
    P.dualPDiv.TateModule S = P.pdivGroup.DualTate S :=
  haveI : NeZero p := ⟨hp.out.ne_zero⟩
  PDivGroup.tateModule_dualPDivOf P.dualPDivData S

end PDivFGL

namespace PDivFGL

variable {R : Type} [CommRing R] [IsLocalRing R] [IsAdicComplete (maximalIdeal R) R]
  {d p : ℕ} [hp : Fact p.Prime] (P : PDivFGL R d p)
  (F : Type) [Field F] [CharZero F] [Algebra F (PadicAlgCl p)] [Algebra R F]
  (T : Type) [CommRing T] [Algebra R T] [Algebra F T] [IsScalarTower R F T]

/-- **Cartier duality for `F[p^∞]` commutes with base change to a field `F`** (e.g. `ℚ_p`) on
Tate modules: `T_p(((F[p^∞])^∨)_F)(T) ≃* T_p((F[p^∞]_F)^∨)(T)` (levelwise
`PDivGroup.dualPDivOfBaseChangePointsEquiv`). -/
def dualPDivBaseChangeTateEquiv :
    (P.dualPDiv.baseChange F).TateModule T ≃*
      ((P.pdivGroup.baseChange F).dualPDiv).TateModule T :=
  PDivGroup.dualPDivOfBaseChangeTateEquiv F P.dualPDivData T

end PDivFGL

end PadicHodge
