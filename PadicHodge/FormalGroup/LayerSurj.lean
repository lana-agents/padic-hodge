import PadicHodge.FormalGroup.LayerHopf
import PadicHodge.FormalGroup.LayerPoints

/-!
# `F[p^v](O_{ℂ_p}) = F(m_{ℂ_p})[p^v]`

For a `p`-divisible formal group law `F` over a local ring `R` (with the discrete topology and
an algebra map `R → O_{ℂ_p}` sending the maximal ideal into the open unit disc), every
`R`-algebra map `φ : A_v → O_{ℂ_p}` comes from a torsion point (`PDivFGL.layerPt_surjective`):

* `|φ(t_j)| < 1`, since `t_j^N ∈ 𝔪 A_v` (`PDivFGL.tnf_t`);
* `φ` agrees with evaluation at `x = (φ(t_j))_j` on `R[[T]]`: both are `R`-algebra maps into
  `O_{ℂ_p}`, which is separated for the ideal `(x_j)` (`isHausdorff_span`: its `n`-th power lies
  in the disc of radius `max|x_j|^n`), so `AdicEval.algHom_ext` applies;
* hence `[p^v]_F(x) = 0` and `layerPt v x = φ`.

With `layerPt_injective` this identifies `F(m_{ℂ_p})[p^v]` with the `O_{ℂ_p}`-points of
`F[p^v]` (`PDivFGL.layerPtEquiv`), Galois-equivariantly (`FGL.layerPt_galPt`)
([Hong, Prop. 2.2.10, remark after it; Cor. 3.2.4]).
-/

noncomputable section

open MvPowerSeries IsLocalRing PadicHodge.AdicEval

namespace PadicHodge

universe u

variable {p : ℕ} [hp : Fact p.Prime]

/-- The ideal `{z ∈ O_{ℂ_p} | |z| ≤ c}` (`0 ≤ c ≤ 1`). -/
def normIdeal (c : ℝ) (hc0 : 0 ≤ c) : Ideal (OC p) where
  carrier := {x | ‖(x : ℂ_[p])‖ ≤ c}
  add_mem' := fun {a b} ha hb => by
    simp only [Set.mem_setOf_eq, Subring.coe_add] at *
    exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ha hb)
  zero_mem' := by simpa using hc0
  smul_mem' := fun c' {x} hx => by
    simp only [Set.mem_setOf_eq, smul_eq_mul, Subring.coe_mul, norm_mul] at *
    calc ‖(c' : ℂ_[p])‖ * ‖(x : ℂ_[p])‖ ≤ 1 * ‖(x : ℂ_[p])‖ :=
          mul_le_mul_of_nonneg_right (norm_OC_le c') (norm_nonneg _)
      _ ≤ c := by rw [one_mul]; exact hx

theorem norm_le_of_mem_pow {ι : Type*} (x : ι → OC p) {c : ℝ} (hc0 : 0 ≤ c)
    (hc : ∀ i, ‖(x i : ℂ_[p])‖ ≤ c) (n : ℕ) {z : OC p}
    (hz : z ∈ Ideal.span (Set.range x) ^ n) : ‖(z : ℂ_[p])‖ ≤ c ^ n := by
  have h1 : Ideal.span (Set.range x) ≤ normIdeal c hc0 := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact hc i
  have key : ∀ n, Ideal.span (Set.range x) ^ n ≤ normIdeal (c ^ n) (pow_nonneg hc0 n) := by
    intro n
    induction n with
    | zero => intro z _; simpa [normIdeal] using norm_OC_le z
    | succ n ih =>
      rw [pow_succ, Ideal.mul_le]
      intro a ha b hb
      have ha' : ‖(a : ℂ_[p])‖ ≤ c ^ n := ih ha
      have hb' : ‖(b : ℂ_[p])‖ ≤ c := h1 hb
      change ‖((a * b : OC p) : ℂ_[p])‖ ≤ c ^ (n + 1)
      rw [Subring.coe_mul, norm_mul, pow_succ]
      exact mul_le_mul ha' hb' (norm_nonneg _) (pow_nonneg hc0 n)
  exact key n hz

/-- **`O_{ℂ_p}` is separated for an ideal generated by finitely many elements of the open disc.** -/
theorem isHausdorff_span {ι : Type*} [Finite ι] (x : ι → OC p)
    (hx : ∀ i, ‖(x i : ℂ_[p])‖ < 1) : IsHausdorff (Ideal.span (Set.range x)) (OC p) := by
  obtain ⟨c, hc0, hc1, hc⟩ := FGL.exists_bound _ hx
  rw [isHausdorff_iff]
  intro z hz
  simp only [smul_eq_mul, Ideal.mul_top, SModEq.zero] at hz
  have hle : ∀ n, ‖(z : ℂ_[p])‖ ≤ c ^ n := fun n =>
    norm_le_of_mem_pow x hc0 hc n (hz n)
  have h0 : ‖(z : ℂ_[p])‖ ≤ 0 :=
    ge_of_tendsto' (tendsto_pow_atTop_nhds_zero_of_lt_one hc0 hc1) hle
  exact Subtype.ext (by simpa using h0)

namespace PDivFGL

variable {R : Type u} [CommRing R] [IsLocalRing R] [UniformSpace R] [DiscreteUniformity R]
  [Algebra R (OC p)] {d : ℕ} (P : PDivFGL R d p)

omit [UniformSpace R] [DiscreteUniformity R] in
theorem norm_lt_of_mem_map (hR : ∀ r ∈ maximalIdeal R, ‖(algebraMap R (OC p) r : ℂ_[p])‖ < 1)
    {z : OC p} (hz : z ∈ (maximalIdeal R).map (algebraMap R (OC p))) : ‖(z : ℂ_[p])‖ < 1 := by
  have h : (maximalIdeal R).map (algebraMap R (OC p)) ≤ ballIdeal (p := p) 0 := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    simpa [ballIdeal] using hR r hr
  simpa [ballIdeal] using h hz

/-- **Every `O_{ℂ_p}`-point of `F[p^v]` comes from a `p^v`-torsion point of `F(m_{ℂ_p})`.** -/
theorem layerPt_surjective
    (hR : ∀ r ∈ maximalIdeal R, ‖(algebraMap R (OC p) r : ℂ_[p])‖ < 1) (v : ℕ) :
    Function.Surjective (P.F.layerPt (p := p) v) := by
  intro φ
  let x : Fin d → OC p := fun j => φ (P.t v j)
  have hx : ∀ j, ‖(x j : ℂ_[p])‖ < 1 := by
    intro j
    obtain ⟨N, hN⟩ := P.tnf_t v j
    have h1 : x j ^ N ∈ (maximalIdeal R).map (algebraMap R (OC p)) := by
      have := Ideal.mem_map_of_mem (φ : P.A v →+* OC p) hN
      rwa [Ideal.map_map, AlgHom.comp_algebraMap, map_pow] at this
    have h2 := norm_lt_of_mem_map hR h1
    rw [SubmonoidClass.coe_pow, norm_pow] at h2
    rcases Nat.eq_zero_or_pos N with hN0 | hN0
    · rw [hN0, pow_zero] at h2; exact absurd h2 (lt_irrefl _)
    · exact (pow_lt_one_iff_of_nonneg (norm_nonneg _) hN0.ne').mp h2
  let X0 : P.F.Pt p := ⟨x, hx⟩
  have key : φ.comp (Ideal.Quotient.mkₐ R _) = P.F.evAlgHom X0 := by
    haveI := isHausdorff_span x hx
    refine AdicEval.algHom_ext (Ideal.span (Set.range x)) (fun i => ?_) fun i => ?_
    · exact Ideal.subset_span ⟨i, rfl⟩
    · rw [FGL.evAlgHom_apply, FGL.ev_X]
      rfl
  have htors : X0 ∈ P.F.torsionBy v := by
    rw [FGL.mem_torsionBy_iff_ev]
    intro i
    have := congrArg (fun g => g (P.F.mulPS (p ^ v) i)) key
    simp only [AlgHom.comp_apply, FGL.evAlgHom_apply] at this
    rw [← this, Ideal.Quotient.mkₐ_eq_mk, P.mk_mulPS, map_zero]
  refine ⟨⟨X0, htors⟩, ?_⟩
  apply Ideal.Quotient.algHom_ext R
  ext f
  rw [AlgHom.comp_apply, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, FGL.layerPt_mk]
  have := congrArg (fun g => g f) key
  simp only [AlgHom.comp_apply, FGL.evAlgHom_apply, Ideal.Quotient.mkₐ_eq_mk] at this
  rw [this]

/-- **`F(m_{ℂ_p})[p^v] ≃ F[p^v](O_{ℂ_p})`.** -/
def layerPtEquiv (hR : ∀ r ∈ maximalIdeal R, ‖(algebraMap R (OC p) r : ℂ_[p])‖ < 1) (v : ℕ) :
    P.F.torsionBy (p := p) v ≃ (P.A v →ₐ[R] OC p) :=
  Equiv.ofBijective _ ⟨P.F.layerPt_injective v, P.layerPt_surjective hR v⟩

end PDivFGL

end PadicHodge
