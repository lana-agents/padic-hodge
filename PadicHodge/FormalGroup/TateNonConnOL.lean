import PadicHodge.FormalGroup.HodgeTateOL
import PadicHodge.FormalGroup.TateNonConn
import PadicHodge.GroupScheme.EtaleHTOL

/-!
# `dim D_{-1}(V_p G) = dim G⁰` for non-connected `G` over `O_{K'}`

The analogue of `FormalGroup/TateNonConn.lean` over the ring of integers `O_L = O_{K'}` (`OL L`)
of a finite extension `L = K'` of `ℚ_p` inside `ℚ̄_p`: for a `p`-divisible group `G` over `O_L`
with connected part `G⁰ ≅ F[p^∞]` (`PDivGroup.exists_connPart_iso_OL`), `F` of dimension `d`,
**`dim_L D_{-1}(V_p(G_L)) = d`** for `V_p(G_L)` as a representation of `G_L = Gal(ℚ̄_p/L)`
(`PDivGroup.finrank_DHT_tateRepOver_neg_one_of_iso_OL`,
`PDivGroup.exists_finrank_DHT_tateRepOver_neg_one_OL`): [Hong, Cor. 3.4.11] over `K'` for `G`
itself.

The proof is the one of `TateNonConn.lean`, with `T = T_p G(ℚ̄_p)`, `T⁰` the image of
`T_p(G⁰)(ℚ̄_p)`:

* lower bound from `V_p(G⁰) ↪ V_p G` and [Hong, Cor. 3.4.11] over `K'` for `F[p^∞]`
  (`PDivFGL.finrank_DHT_tateRepOL_neg_one`);
* `T / T⁰` is torsion free (`mem_connTateOL_of_smul_mem`);
* upper bound: `etCoordFieldOL G k = L(x(a) : x ∈ G_w(ℚ̄_p), a ∈ A_w^{et}, w ≤ k)` is finite over
  `L`, `G_L`-stable, unramified relative to `π_L` and rigid (`isUnrStableOver_etCoordFieldOL`,
  since `A_w^{et}` is finite étale over `O_L`: Frobenius on `A_w^{et} / π_L` is periodic because
  `κ_L` is finite); the matrix of `ν ∈ Gal(ℚ̄_p/etCoordFieldOL G k)` on `T / T⁰` is `≡ 1 mod p^k`,
  and Hilbert 90 over `L` (`Hilbert90.exists_hilbert90_over`) shows that `V_p G / V_p(G⁰)` is
  Hodge–Tate of weight `0` (`finrank_DHT_etRepOL_neg_one`).

## References

* [Hong] S. Hong, *Notes on p-adic Hodge theory*, Cor. 3.4.11.
-/

noncomputable section

open WithConv TensorProduct IsLocalRing PadicHodge.Hilbert90 Module

namespace PadicHodge

namespace PDivGroup

open FFGroupScheme

variable {p : ℕ} [hp : Fact p.Prime] {L : IntermediateField ℚ_[p] (PadicAlgCl p)}
  [FiniteDimensional ℚ_[p] L]

local notation "K" => PadicAlgCl p

local instance instNormalL' : Normal L (PadicAlgCl p) :=
  Normal.tower_top_of_normal ℚ_[p] L (PadicAlgCl p)

/-- Shortcut instance (avoids slow searches through normed-space instances on `L`). -/
local instance (priority := high) instAddCommGroupTateL (H : PDivGroup L p) :
    AddCommGroup (Additive (H.TateModule K)) := Additive.addCommGroup

/-- Shortcut instance (avoids slow searches through normed-space instances on `L`). -/
local instance (priority := high) instModuleTateL (H : PDivGroup L p) :
    Module ℤ_[p] (Additive (H.TateModule K)) := PDivGroup.instModuleZp H K

omit [FiniteDimensional ℚ_[p] L] in
/-- Shortcut instance (avoids a slow search through normed-space instances on `L`). -/
local instance (priority := high) instModuleDHT {V : Type*} [AddCommGroup V] [Module ℚ_[p] V]
    (ρ : Representation ℚ_[p] (PadicAlgCl p ≃ₐ[L] PadicAlgCl p) V) (q : ℤ) :
    Module L (DHT ρ q) :=
  (DHT ρ q).module

omit [FiniteDimensional ℚ_[p] L] in
/-- Shortcut instance (avoids a slow search through normed-space instances on `L`). -/
local instance (priority := high) instAddCommGroupDHT {V : Type*} [AddCommGroup V]
    [Module ℚ_[p] V] (ρ : Representation ℚ_[p] (PadicAlgCl p ≃ₐ[L] PadicAlgCl p) V) (q : ℤ) :
    AddCommGroup (DHT ρ q) :=
  (DHT ρ q).addCommGroup

/-! ### The field generated by the étale coordinates -/

variable (G : PDivGroup (OL L) p)

/-- The values `x(a)` of the points `x ∈ G_w(ℚ̄_p)`, `w ≤ k`, on `a ∈ A_w^{et}`. -/
def etCoordSetOL (k : ℕ) : Set K :=
  {z | ∃ w ≤ k, ∃ φ : (G.G w).A →ₐ[OL L] K, ∃ b : (G.G w).etaleQuotient.A,
    φ ((G.G w).etaleQuotientHom b) = z}

/-- The field generated over `L` by the coordinates of the étale quotients `G_w^{et}`,
`w ≤ k`. -/
def etCoordFieldOL (k : ℕ) : IntermediateField L K :=
  IntermediateField.adjoin L (G.etCoordSetOL k)

theorem etCoordSetOL_mono (k : ℕ) : G.etCoordSetOL k ⊆ G.etCoordSetOL (k + 1) := by
  rintro _ ⟨w, hw, φ, b, rfl⟩
  exact ⟨w, hw.trans (Nat.le_succ k), φ, b, rfl⟩

theorem etCoordFieldOL_mono (k : ℕ) : G.etCoordFieldOL k ≤ G.etCoordFieldOL (k + 1) :=
  IntermediateField.adjoin.mono _ _ _ (G.etCoordSetOL_mono k)

theorem gal_mem_etCoordSetOL (σ : K ≃ₐ[L] K) {k : ℕ} {z : K} (hz : z ∈ G.etCoordSetOL k) :
    σ z ∈ G.etCoordSetOL k := by
  obtain ⟨w, hw, φ, b, rfl⟩ := hz
  exact ⟨w, hw, ((σ : K →ₐ[L] K).restrictScalars (OL L)).comp φ, b, rfl⟩

theorem norm_le_one_of_mem_etCoordSetOL {k : ℕ} {z : K} (hz : z ∈ G.etCoordSetOL k) :
    ‖z‖ ≤ 1 := by
  obtain ⟨w, -, φ, b, rfl⟩ := hz
  exact OL.norm_le_one_et φ _

theorem frobClosedOver_etCoordSetOL (k : ℕ) :
    FrobClosedOver L (OL.uniformizerL L) (G.etCoordSetOL k) := by
  rintro _ ⟨w, hw, φ, b, rfl⟩
  haveI : Algebra.Etale (OL L) (G.G w).etaleQuotient.A := (G.G w).isEtale_etaleQuotient
  obtain ⟨N, hN, hper⟩ := OL.exists_frobenius_period_et (L := L) (G.G w).etaleQuotient.A
  obtain ⟨c, hc⟩ := hper b
  let ψ : (G.G w).etaleQuotient.A →ₐ[OL L] K :=
    φ.comp ((G.G w).etaleQuotientHom : (G.G w).etaleQuotient.A →ₐ[OL L] (G.G w).A)
  exact ⟨N, hN, ψ c, Algebra.subset_adjoin (Or.inl ⟨w, hw, φ, c, rfl⟩), OL.frob_et hc ψ⟩

theorem finiteDimensional_etCoordFieldOL (k : ℕ) :
    FiniteDimensional L (G.etCoordFieldOL k) := by
  classical
  let bas := fun w => Module.Free.chooseBasis (OL L) (G.G w).etaleQuotient.A
  let F : Set K := ⋃ w ∈ Finset.range (k + 1), ⋃ φ : (G.G w).A →ₐ[OL L] K,
    Set.range fun i => φ ((G.G w).etaleQuotientHom (bas w i))
  have hF : F.Finite := by
    refine Set.Finite.biUnion (Finset.finite_toSet _) fun w _ => ?_
    haveI := G.finite_algHom_OL w
    exact Set.finite_iUnion fun φ => Set.finite_range _
  have hFS : F ⊆ G.etCoordSetOL k := by
    intro z hz
    simp only [F, Set.mem_iUnion, Finset.mem_range, Set.mem_range] at hz
    obtain ⟨w, hw, φ, i, rfl⟩ := hz
    exact ⟨w, by omega, φ, _, rfl⟩
  have hSF : G.etCoordSetOL k ⊆ IntermediateField.adjoin L F := by
    rintro _ ⟨w, hw, φ, a, rfl⟩
    rw [← (bas w).sum_repr a, map_sum, map_sum]
    refine IntermediateField.sum_mem _ fun i _ => ?_
    rw [map_smul, map_smul, Algebra.smul_def, IsScalarTower.algebraMap_apply (OL L) L K]
    refine IntermediateField.mul_mem _ (IntermediateField.algebraMap_mem _ _) ?_
    refine IntermediateField.subset_adjoin _ _ ?_
    simp only [F, Set.mem_iUnion, Finset.mem_range, Set.mem_range]
    exact ⟨w, by omega, φ, i, rfl⟩
  have heq : G.etCoordFieldOL k = IntermediateField.adjoin L F :=
    le_antisymm (IntermediateField.adjoin_le_iff.mpr hSF)
      (IntermediateField.adjoin.mono _ _ _ hFS)
  rw [heq]
  haveI : Finite F := hF.to_subtype
  exact IntermediateField.finiteDimensional_adjoin fun x _ =>
    (Algebra.IsAlgebraic.isAlgebraic x).isIntegral

/-- **The fields `etCoordFieldOL G k` are `G_L`-stable, unramified relative to `π_L` and
rigid.** -/
theorem isUnrStableOver_etCoordFieldOL (k : ℕ) :
    IsUnrStableOver L (OL.uniformizerL L) (G.etCoordFieldOL k) :=
  isUnrStableOver_adjoin OL.uniformizerL_ne_zero OL.norm_uniformizerL_lt_one
    (OL.frobPeriodicMod L) (fun _ h => G.norm_le_one_of_mem_etCoordSetOL h)
    (G.frobClosedOver_etCoordSetOL k) (fun σ _ hz => G.gal_mem_etCoordSetOL σ hz)
    (fun σ hσ => by
      rintro _ ⟨w, hw, φ, b, rfl⟩
      haveI : Algebra.Etale (OL L) (G.G w).etaleQuotient.A := (G.G w).isEtale_etaleQuotient
      let ψ : (G.G w).etaleQuotient.A →ₐ[OL L] K :=
        φ.comp ((G.G w).etaleQuotientHom : (G.G w).etaleQuotient.A →ₐ[OL L] (G.G w).A)
      have h1 := algHom_eq_of_norm_sub_lt_one ψ
        (((σ : K →ₐ[L] K).restrictScalars (OL L)).comp ψ) (OL.norm_le_one_et ψ)
        (fun c => by
          rw [norm_sub_rev]
          exact hσ _ ⟨w, hw, φ, c, rfl⟩)
      exact (DFunLike.congr_fun h1 b).symm)

/-! ### `T_p(G⁰) ⊆ T_p G` -/

omit [FiniteDimensional ℚ_[p] L] in
/-- Levelwise injective homomorphisms are injective on Tate modules of generic fibres. -/
theorem tateLin_baseChange_injectiveOL {G₁ G₂ : PDivGroup (OL L) p} (ι : Hom G₁ G₂)
    (hι : ∀ v, Function.Injective ((ι.f v).mapPoints K)) :
    Function.Injective (Hom.baseChange (S := L) ι).tateLin := by
  intro x y h
  refine (G₁.baseChange L).addTate_ext K fun v => ?_
  have h1 := congrArg (fun z => (G₂.G v).baseChangePointsEquiv (S := L) K
    ((Additive.toMul z).1 v)) h
  have h2 : (ι.f v).mapPoints K ((G₁.G v).baseChangePointsEquiv (S := L) K
      ((Additive.toMul x).1 v)) = (ι.f v).mapPoints K
      ((G₁.G v).baseChangePointsEquiv (S := L) K ((Additive.toMul y).1 v)) := h1
  exact ((G₁.G v).baseChangePointsEquiv (S := L) K).injective (hι v h2)

omit [FiniteDimensional ℚ_[p] L] in
/-- `φ ∘ ψ = id` gives `φ_* ∘ ψ_* = id` on Tate modules of generic fibres. -/
theorem tateLin_baseChange_comp_eqOL {G₁ G₂ : PDivGroup (OL L) p} (φ : Hom G₁ G₂)
    (ψ : Hom G₂ G₁) (h : φ.comp ψ = Hom.id _)
    (y : Additive ((G₂.baseChange L).TateModule K)) :
    (Hom.baseChange (S := L) φ).tateLin ((Hom.baseChange (S := L) ψ).tateLin y) = y := by
  refine (G₂.baseChange L).addTate_ext K fun v => ?_
  apply ((G₂.G v).baseChangePointsEquiv (S := L) K).injective
  change ((φ.comp ψ).f v).mapPoints K
    ((G₂.G v).baseChangePointsEquiv (S := L) K ((Additive.toMul y).1 v)) = _
  rw [h]
  rfl

/-- `T_p(G⁰) → T_p G` on generic fibres. -/
def connTateLinOL : Additive ((G.connPart.baseChange L).TateModule K) →ₗ[ℤ_[p]]
    Additive ((G.baseChange L).TateModule K) :=
  (Hom.baseChange (S := L) G.connPartHom).tateLin

theorem connTateLin_injectiveOL : Function.Injective G.connTateLinOL :=
  tateLin_baseChange_injectiveOL G.connPartHom fun v => G.connPartHom_mapPoints_injective v K

theorem bc_connTateLinOL (y : Additive ((G.connPart.baseChange L).TateModule K)) (v : ℕ) :
    (G.G v).baseChangePointsEquiv (S := L) K ((Additive.toMul (G.connTateLinOL y)).1 v) =
      (G.G v).connectedComponentHom.mapPoints K
        ((G.G v).connectedComponent.baseChangePointsEquiv (S := L) K
          ((Additive.toMul y).1 v)) := rfl

/-- `T⁰ = T_p(G⁰) ⊆ T_p G`. -/
abbrev connTateOL : Submodule ℤ_[p] (Additive ((G.baseChange L).TateModule K)) :=
  LinearMap.range G.connTateLinOL

/-- **`x ∈ T⁰` iff all levels of `x` are points of `G_v⁰`.** -/
theorem mem_connTate_iffOL (x : Additive ((G.baseChange L).TateModule K)) :
    x ∈ G.connTateOL ↔ ∀ v, (G.G v).baseChangePointsEquiv (S := L) K ((Additive.toMul x).1 v) ∈
      ((G.G v).connectedComponentHom.mapPoints K).range := by
  constructor
  · rintro ⟨y, rfl⟩ v
    exact ⟨_, (G.bc_connTateLinOL y v).symm⟩
  · intro hx
    simp only [MonoidHom.mem_range] at hx
    choose y hy using hx
    have hcomp : ∀ v, (G.connIncl v).mapPoints K (y v) = (y (v + 1)) ^ p := by
      intro v
      apply (G.G (v + 1)).mapPoints_connectedComponentHom_injective K
      rw [map_pow, hy (v + 1)]
      unfold connIncl
      rw [mapPoints_connectedComponentMap, hy v]
      exact (congrArg ((G.G (v + 1)).baseChangePointsEquiv (S := L) K)
        ((Additive.toMul x).2 v)).trans (map_pow _ _ _)
    let yT : G.connPart.TateModule K := ⟨y, hcomp⟩
    refine ⟨Additive.ofMul ((G.connPart.baseChangeTateEquiv (S := L) K).symm yT), ?_⟩
    refine (G.baseChange L).addTate_ext K fun v => ?_
    apply ((G.G v).baseChangePointsEquiv (S := L) K).injective
    rw [bc_connTateLinOL, ← hy v]
    congr 1
    exact ((G.G v).connectedComponent.baseChangePointsEquiv (S := L) K).apply_symm_apply (y v)

/-- A point lies in `G⁰` iff it kills `1 - e₀`. -/
theorem mem_range_connectedComponentHom_iffOL (Gs : FFGroupScheme (OL L)) (x : Gs.points K) :
    x ∈ (Gs.connectedComponentHom.mapPoints K).range ↔ ofConv x (1 - Gs.idemConn) = 0 := by
  constructor
  · rintro ⟨y, rfl⟩
    change ofConv y (Gs.connectedComponentHom (1 - Gs.idemConn)) = 0
    rw [map_sub, map_one, connectedComponentHom_idemConn, sub_self, map_zero]
  · intro hx
    exact Gs.exists_connectedComponentHom_mapPoints_eq x hx

omit [FiniteDimensional ℚ_[p] L] in
theorem toMul_p_smul_succOL (z : Additive ((G.baseChange L).TateModule K)) (v : ℕ) :
    (Additive.toMul ((p : ℤ_[p]) • z)).1 (v + 1) =
      ((G.baseChange L).incl v).mapPoints K ((Additive.toMul z).1 v) := by
  rw [(Additive.toMul z).2 v, Nat.cast_smul_eq_nsmul, toMul_nsmul]
  rfl

/-- **`T / T⁰` has no `p`-torsion.** -/
theorem mem_connTate_of_p_smul_memOL (z : Additive ((G.baseChange L).TateModule K))
    (hz : (p : ℤ_[p]) • z ∈ G.connTateOL) : z ∈ G.connTateOL := by
  rw [mem_connTate_iffOL] at hz ⊢
  intro v
  have h := hz (v + 1)
  rw [toMul_p_smul_succOL, mem_range_connectedComponentHom_iffOL] at h
  rw [mem_range_connectedComponentHom_iffOL]
  have e : ofConv ((G.G v).baseChangePointsEquiv (S := L) K ((Additive.toMul z).1 v))
      (G.incl v (1 - (G.G (v + 1)).idemConn)) = 0 := h
  rwa [map_sub, map_one, G.incl_idemConn v] at e

theorem mem_connTate_of_pow_smul_memOL (n : ℕ) :
    ∀ z : Additive ((G.baseChange L).TateModule K),
      (p : ℤ_[p]) ^ n • z ∈ G.connTateOL → z ∈ G.connTateOL := by
  induction n with
  | zero => intro z hz; simpa using hz
  | succ n ih =>
    intro z hz
    rw [pow_succ, mul_smul] at hz
    exact G.mem_connTate_of_p_smul_memOL z (ih _ hz)

/-- **`T / T⁰` is torsion free.** -/
theorem mem_connTate_of_smul_memOL {a : ℤ_[p]} (ha : a ≠ 0)
    (z : Additive ((G.baseChange L).TateModule K)) (hz : a • z ∈ G.connTateOL) :
    z ∈ G.connTateOL := by
  have hspec := PadicInt.unitCoeff_spec ha
  refine G.mem_connTate_of_pow_smul_memOL a.valuation z ?_
  have h1 : (↑(PadicInt.unitCoeff ha)⁻¹ : ℤ_[p]) • a • z ∈ G.connTateOL :=
    G.connTateOL.smul_mem _ hz
  have h2 : (↑(PadicInt.unitCoeff ha)⁻¹ : ℤ_[p]) * a = (p : ℤ_[p]) ^ a.valuation :=
    (congrArg (fun t => (↑(PadicInt.unitCoeff ha)⁻¹ : ℤ_[p]) * t) hspec).trans
      (Units.inv_mul_cancel_left _ _)
  rwa [← mul_smul, h2] at h1

/-! ### The quotient `T / T⁰` and its Galois action -/

/-- `T / T⁰`, the Tate module of the étale part. -/
abbrev EtTateOL : Type := Additive ((G.baseChange L).TateModule K) ⧸ G.connTateOL

theorem galLin_mem_connTateOL (σ : K ≃ₐ[L] K) {x : Additive ((G.baseChange L).TateModule K)}
    (hx : x ∈ G.connTateOL) : (G.baseChange L).galLin σ x ∈ G.connTateOL := by
  obtain ⟨y, rfl⟩ := hx
  exact ⟨(G.connPart.baseChange L).galLin σ y, rfl⟩

/-- The Galois action on `T / T⁰`. -/
def galQOL (σ : K ≃ₐ[L] K) : G.EtTateOL →ₗ[ℤ_[p]] G.EtTateOL :=
  G.connTateOL.mapQ G.connTateOL ((G.baseChange L).galLin σ) fun _ hx =>
    G.galLin_mem_connTateOL σ hx

theorem galQ_mkOL (σ : K ≃ₐ[L] K) (x : Additive ((G.baseChange L).TateModule K)) :
    G.galQOL σ (G.connTateOL.mkQ x) = G.connTateOL.mkQ ((G.baseChange L).galLin σ x) := rfl

theorem galQ_oneOL : G.galQOL 1 = LinearMap.id :=
  LinearMap.ext fun q => by
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ q
    rfl

theorem galQ_mulOL (σ τ : K ≃ₐ[L] K) : G.galQOL (σ * τ) = G.galQOL σ ∘ₗ G.galQOL τ :=
  LinearMap.ext fun q => by
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ q
    rfl

/-- **The representation `V_p(G_L) / V_p(G⁰_L)` of `G_L`.** -/
def etRepOL : Representation ℚ_[p] (K ≃ₐ[L] K) (ℚ_[p] ⊗[ℤ_[p]] G.EtTateOL) where
  toFun σ := (G.galQOL σ).baseChange ℚ_[p]
  map_one' := by
    rw [Module.End.one_eq_id, ← LinearMap.baseChange_id]
    congr 1
    exact LinearMap.ext fun q => by
      obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ q
      rfl
  map_mul' σ τ := by
    rw [Module.End.mul_eq_comp, ← LinearMap.baseChange_comp]
    congr 1
    exact LinearMap.ext fun q => by
      obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ q
      rfl

/-- **`ν x - x ∈ T⁰ + p^k T`** for `ν` fixing the étale coordinates up to level `k`. -/
theorem etaleQuotientHom_galLinOL {k : ℕ} (ν : K ≃ₐ[L] K) (hν : ∀ z ∈ G.etCoordFieldOL k, ν z = z)
    (x : Additive ((G.baseChange L).TateModule K)) :
    (G.G k).etaleQuotientHom.mapPoints K ((G.G k).baseChangePointsEquiv (S := L) K
        ((Additive.toMul ((G.baseChange L).galLin ν x)).1 k)) =
      (G.G k).etaleQuotientHom.mapPoints K ((G.G k).baseChangePointsEquiv (S := L) K
        ((Additive.toMul x).1 k)) := by
  apply WithConv.ofConv_injective
  refine AlgHom.ext fun b => ?_
  set φ := ofConv ((G.G k).baseChangePointsEquiv (S := L) K ((Additive.toMul x).1 k))
  have h := hν (φ ((G.G k).etaleQuotientHom b))
    (IntermediateField.subset_adjoin _ _ ⟨k, le_rfl, φ, b, rfl⟩)
  exact h

theorem exists_galLin_subOL {k : ℕ} (ν : K ≃ₐ[L] K) (hν : ∀ z ∈ G.etCoordFieldOL k, ν z = z)
    (x : Additive ((G.baseChange L).TateModule K)) :
    ∃ c ∈ G.connTateOL, ∃ s, (G.baseChange L).galLin ν x - x = c + (p : ℤ_[p]) ^ k • s := by
  set u := (G.baseChange L).galLin ν x - x
  set bc := (G.G k).baseChangePointsEquiv (S := L) K
  have hu : (G.G k).etaleQuotientHom.mapPoints K (bc ((Additive.toMul u).1 k)) = 1 := by
    have : (Additive.toMul u).1 k = (Additive.toMul ((G.baseChange L).galLin ν x)).1 k /
        (Additive.toMul x).1 k := rfl
    let Φ : ((G.baseChange L).G k).points K →* (G.G k).etaleQuotient.points K :=
      ((G.G k).etaleQuotientHom.mapPoints K).comp
        ((G.G k).baseChangePointsEquiv (S := L) K).toMonoidHom
    have e1 : Φ ((Additive.toMul u).1 k) = 1 := by
      rw [this, map_div, div_eq_one]
      exact G.etaleQuotientHom_galLinOL ν hν x
    exact e1
  obtain ⟨w, hw⟩ := ((G.G k).mapPoints_etaleQuotientHom_eq_one_iff _).mp hu
  obtain ⟨y, hy⟩ := G.connPart.proj_surjective_sepClosed K Hilbert90.p_ne_zero k w
  have hy' : y.1 k = w := hy
  set c := G.connTateLinOL (Additive.ofMul ((G.connPart.baseChangeTateEquiv (S := L) K).symm y))
  have hck : bc ((Additive.toMul c).1 k) = bc ((Additive.toMul u).1 k) := by
    change (G.G k).connectedComponentHom.mapPoints K
      ((G.G k).connectedComponent.baseChangePointsEquiv (S := L) K
        (((G.connPart.baseChangeTateEquiv (S := L) K).symm y).1 k)) = _
    rw [← hw, ← hy']
    congr 1
    exact ((G.G k).connectedComponent.baseChangePointsEquiv (S := L) K).apply_symm_apply _
  obtain ⟨s, hs⟩ := (G.baseChange L).exists_eq_p_pow_smul k (u - c) (by
    change (Additive.toMul u).1 k / (Additive.toMul c).1 k = 1
    rw [div_eq_one]
    exact (bc.injective hck).symm)
  exact ⟨c, ⟨_, rfl⟩, s, by rw [← hs]; abel⟩

/-! ### Hilbert 90 on `T / T⁰` -/

instance : Module.IsTorsionFree ℤ_[p] G.EtTateOL where
  isSMulRegular r hr q₁ q₂ hq := by
    have hr0 : r ≠ 0 := hr.ne_zero
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ q₁
    obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective _ q₂
    have hq1 : r • G.connTateOL.mkQ x = r • G.connTateOL.mkQ y := hq
    have hq' : G.connTateOL.mkQ (r • (x - y)) = 0 := by
      rw [map_smul, map_sub, smul_sub, sub_eq_zero]
      exact hq1
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hq'
    have h := G.mem_connTate_of_smul_memOL hr0 _ hq'
    rw [← sub_eq_zero, ← map_sub, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact h

instance : Module.Free ℤ_[p] G.EtTateOL := Module.free_of_finite_type_torsion_free'

/-- The matrix of `σ` on `T / T⁰` in a `ℤ_p`-basis `b`. -/
def galQMatrixOL {r : ℕ} (b : Module.Basis (Fin r) ℤ_[p] G.EtTateOL) :
    (K ≃ₐ[L] K) →* Matrix (Fin r) (Fin r) ℤ_[p] where
  toFun σ := LinearMap.toMatrix b b (G.galQOL σ)
  map_one' := by rw [galQ_oneOL, LinearMap.toMatrix_id]
  map_mul' σ τ := by rw [galQ_mulOL, LinearMap.toMatrix_comp b b b]

set_option synthInstance.maxHeartbeats 80000 in
-- instance terms over `L = K'` are large: the `AddMonoidHomClass` searches for `b.repr` on
-- `T / T⁰` take ~0.6 s each
set_option maxHeartbeats 400000 in
-- (same reason)
/-- **`A(ν) ≡ 1 mod p^k`** on `Gal(ℚ̄_p / etCoordFieldOL G k)`. -/
theorem galQMatrix_fixOL {r : ℕ} (b : Module.Basis (Fin r) ℤ_[p] G.EtTateOL) (k : ℕ)
    (ν : K ≃ₐ[L] K)
    (hν : ∀ z ∈ G.etCoordFieldOL k, ν z = z) (i j : Fin r) :
    ‖G.galQMatrixOL b ν i j - (1 : Matrix (Fin r) (Fin r) ℤ_[p]) i j‖ ≤ ‖(p : ℤ_[p])‖ ^ k := by
  classical
  obtain ⟨x, hx⟩ := Submodule.mkQ_surjective G.connTateOL (b j)
  obtain ⟨c, hc, s, hs⟩ := G.exists_galLin_subOL ν hν x
  have hc0 : G.connTateOL.mkQ c = 0 := by
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact hc
  have h1 : G.galQOL ν (b j) - b j = (p : ℤ_[p]) ^ k • G.connTateOL.mkQ s := by
    rw [← hx, galQ_mkOL, ← map_sub, hs, map_add, hc0, zero_add, map_smul]
  have h2 : G.galQMatrixOL b ν i j - (1 : Matrix (Fin r) (Fin r) ℤ_[p]) i j =
      (p : ℤ_[p]) ^ k * b.repr (G.connTateOL.mkQ s) i := by
    have h3 := congrArg (fun q => b.repr q i) h1
    rw [map_sub b.repr, map_smul b.repr, Basis.repr_self, Finsupp.sub_apply,
      Finsupp.smul_apply, smul_eq_mul] at h3
    rw [← h3]
    congr 1
    · exact LinearMap.toMatrix_apply b b _ i j
    · rw [Matrix.one_apply, Finsupp.single_apply]
      exact if_congr eq_comm rfl rfl
  rw [h2, norm_mul, norm_pow]
  exact mul_le_of_le_one_right (by positivity) (PadicInt.norm_le_one _)

/-- **`V_p(G_L) / V_p(G⁰_L)` is Hodge–Tate with all weights `0`** as a `G_L`-representation
(Hilbert 90 for the completed maximal unramified extension of `L`), in particular
`D_{-1}(V_p G / V_p(G⁰)) = 0`. -/
theorem isHodgeTate_etRepOL :
    IsHodgeTate G.etRepOL ∧
      (htWeights G.etRepOL).count 0 = finrank ℚ_[p] (ℚ_[p] ⊗[ℤ_[p]] G.EtTateOL) := by
  classical
  set b := Module.finBasis ℤ_[p] G.EtTateOL
  set A := G.galQMatrixOL b
  haveI : ∀ k, FiniteDimensional L (G.etCoordFieldOL k) := G.finiteDimensional_etCoordFieldOL
  obtain ⟨X, hX, hXinv⟩ := exists_hilbert90_over (A := A) (Mk := G.etCoordFieldOL)
    OL.uniformizerL_ne_zero OL.norm_uniformizerL_lt_one G.isUnrStableOver_etCoordFieldOL
    G.etCoordFieldOL_mono (fun k ν hν i j => by
      have := G.galQMatrix_fixOL b k ν hν i j
      rw [norm_p_padicInt_eq] at this
      have h1 : ‖A ν i j - (1 : Matrix (Fin (finrank ℤ_[p] G.EtTateOL)) _ ℤ_[p]) i j‖ =
          ‖algebraMap ℤ_[p] K (A ν i j) -
            (1 : Matrix (Fin (finrank ℤ_[p] G.EtTateOL)) _ K) i j‖ := by
        rw [← norm_algebraMap_padicInt, map_sub, Matrix.one_apply, Matrix.one_apply]
        split_ifs <;> simp
      rw [Matrix.sub_apply, AK, Matrix.map_apply, ← h1]
      exact this.trans (pow_le_pow_left₀ (norm_nonneg _) (norm_p_le_norm_uniformizerL (L := L)) k))
  exact isHodgeTate_of_matrix G.etRepOL (Algebra.TensorProduct.basis ℚ_[p] b) X hX
    (fun σ => by
      have h1 : LinearMap.toMatrix (Algebra.TensorProduct.basis ℚ_[p] b)
          (Algebra.TensorProduct.basis ℚ_[p] b) (G.etRepOL σ) =
          (A σ).map (algebraMap ℤ_[p] ℚ_[p]) :=
        LinearMap.toMatrix_baseChange _ _ _ _
      rw [h1, Matrix.map_map]
      have h2 : (algebraMap ℚ_[p] ℂ_[p]) ∘ (algebraMap ℤ_[p] ℚ_[p]) =
          toCp ∘ algebraMap ℤ_[p] K := by
        funext a
        simp only [Function.comp_apply, UniformSpace.Completion.algebraMap_def,
          IsScalarTower.algebraMap_apply ℤ_[p] ℚ_[p] K]
        rfl
      rw [h2, ← Matrix.map_map]
      exact hXinv σ)

theorem finrank_DHT_etRepOL_neg_one : finrank L (DHT G.etRepOL (-1)) = 0 := by
  have h0 := G.isHodgeTate_etRepOL.2
  rw [count_htWeights] at h0
  have hle := sum_finrank_DHT_le G.etRepOL {0, -1}
  rw [Finset.sum_pair (by norm_num)] at hle
  omega

/-! ### `dim D_{-1}(V_p G) = dim G⁰` over `O_L` -/

set_option maxHeartbeats 800000 in
-- instance terms over `L = K'` are large: each step below takes ~0.5 s
/-- **[Hong, Cor. 3.4.11] over `K'` for non-connected `G`**: if `G⁰ ≅ F[p^∞]` with `F` of
dimension `d` over `O_L`, then `dim_L D_{-1}(V_p(G_L)) = d`. -/
theorem finrank_DHT_tateRepOver_neg_one_of_iso_OL {d : ℕ} (P : PDivFGL (OL L) d p)
    (φ : Hom G.connPart P.pdivGroup) (ψ : Hom P.pdivGroup G.connPart)
    (hφψ : φ.comp ψ = Hom.id _) (hψφ : ψ.comp φ = Hom.id _) :
    finrank L (DHT (G.baseChange L).tateRepOver (-1)) = d := by
  haveI : Module.Flat ℤ_[p] ℚ_[p] := IsLocalization.flat ℚ_[p] (nonZeroDivisors ℤ_[p])
  let fP : Additive (P.genericFibreOL.TateModule K) →ₗ[ℤ_[p]]
      Additive ((G.baseChange L).TateModule K) :=
    G.connTateLinOL ∘ₗ (Hom.baseChange (S := L) ψ).tateLin
  have hfPi : Function.Injective fP := G.connTateLin_injectiveOL.comp
    (Function.LeftInverse.injective (tateLin_baseChange_comp_eqOL φ ψ hφψ))
  have hfPr : LinearMap.range fP = G.connTateOL := by
    refine le_antisymm ?_ ?_
    · rintro _ ⟨y, rfl⟩
      exact ⟨_, rfl⟩
    · rintro _ ⟨y, rfl⟩
      refine ⟨(Hom.baseChange (S := L) φ).tateLin y, ?_⟩
      change G.connTateLinOL _ = _
      rw [tateLin_baseChange_comp_eqOL ψ φ hψφ]
  let ρ := (G.baseChange L).tateRepOver
  let ρ' := P.tateRepOL
  let ρ'' := G.etRepOL
  let f := fP.baseChange ℚ_[p]
  let g := G.connTateOL.mkQ.baseChange ℚ_[p]
  have hf : ∀ σ, f ∘ₗ ρ' σ = ρ σ ∘ₗ f := fun σ => by
    change fP.baseChange ℚ_[p] ∘ₗ (P.genericFibreOL.galLin _).baseChange ℚ_[p] =
      ((G.baseChange L).galLin _).baseChange ℚ_[p] ∘ₗ fP.baseChange ℚ_[p]
    rw [← LinearMap.baseChange_comp, ← LinearMap.baseChange_comp]
    congr 1
  have hg : ∀ σ, g ∘ₗ ρ σ = ρ'' σ ∘ₗ g := fun σ => by
    change G.connTateOL.mkQ.baseChange ℚ_[p] ∘ₗ ((G.baseChange L).galLin _).baseChange ℚ_[p] =
      (G.galQOL _).baseChange ℚ_[p] ∘ₗ G.connTateOL.mkQ.baseChange ℚ_[p]
    rw [← LinearMap.baseChange_comp, ← LinearMap.baseChange_comp]
    congr 1
  have hfi : Function.Injective f := by
    change Function.Injective (fP.baseChange ℚ_[p])
    rw [LinearMap.baseChange_eq_ltensor]
    exact Module.Flat.lTensor_preserves_injective_linearMap _ hfPi
  have hex0 : Function.Exact fP G.connTateOL.mkQ := by
    rw [LinearMap.exact_iff, Submodule.ker_mkQ, hfPr]
  have hfg : Function.Exact f g := by
    change Function.Exact (fP.baseChange ℚ_[p]) (G.connTateOL.mkQ.baseChange ℚ_[p])
    rw [LinearMap.baseChange_eq_ltensor, LinearMap.baseChange_eq_ltensor]
    exact _root_.lTensor_exact ℚ_[p] hex0 (Submodule.mkQ_surjective _)
  have hup := finrank_DHT_le_add hf hg hfi hfg (-1)
  have hlow := finrank_DHT_le_of_injective hf hfi (-1)
  rw [P.finrank_DHT_tateRepOL_neg_one, G.finrank_DHT_etRepOL_neg_one] at hup
  rw [P.finrank_DHT_tateRepOL_neg_one] at hlow
  exact le_antisymm (hup.trans_eq (add_zero d)) hlow

/-- **[Hong, Cor. 3.4.11] over `K'` for every `p`-divisible group `G` over `O_{K'}`**:
`dim_L D_{-1}(V_p(G_L)) = dim G⁰`, where `G⁰ ≅ F[p^∞]` (Serre–Tate over `O_L`). -/
theorem exists_finrank_DHT_tateRepOver_neg_one_OL :
    ∃ (d : ℕ) (P : PDivFGL (OL L) d p) (φ : Hom G.connPart P.pdivGroup)
      (ψ : Hom P.pdivGroup G.connPart), φ.comp ψ = Hom.id _ ∧ ψ.comp φ = Hom.id _ ∧
      finrank L (DHT (G.baseChange L).tateRepOver (-1)) = d := by
  obtain ⟨d, P, φ, ψ, h1, h2⟩ := G.exists_connPart_iso_OL
  exact ⟨d, P, φ, ψ, h1, h2, G.finrank_DHT_tateRepOver_neg_one_of_iso_OL P φ ψ h1 h2⟩

