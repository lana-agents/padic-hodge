import PadicHodge.AlmostEtale.Euler
import Mathlib.NumberTheory.Padics.ProperSpace
import Mathlib.Analysis.Normed.Module.FiniteDimension

/-!
# Rings of integers of finite extensions of `ℚ_p` are monogenic

For a finite extension `L / ℚ_p` inside `ℚ̄_p` there is `z ∈ O_L` with `O_L = ℤ_p[z]`
(`exists_monogenic`). This is the classical argument of Serre (*Local Fields*, Ch. III, §6,
Prop. 12; not available locally, the proof is written out here):

* the value group of `L` is discrete (`norm_pow_finrank_eq_zpow`), so there is a uniformizer `Π`
  (`exists_uniformizer`);
* `O_L` is compact, so the residue field `k_L = O_L / m_L` is finite (`exists_residue_reps`); its
  unit group is cyclic, generated by the residue of some `ω ∈ O_L`; with `q = |k_L|`,
  `ω^q ≡ ω`, and `p ∣ q` (`exists_residue_gen`);
* replacing `ω` by `ω + Π` if necessary, `Pi1 = ω^q − ω` has `‖Pi1‖ = ‖Π‖` (Taylor expansion,
  `norm_taylor_sub_le`), and then every `y ∈ O_L` is approximated to any order `‖Π‖^n` by
  elements of `ℤ_p[ω]` (successive `Pi1`-adic digits), while `ℤ_p[ω]` is closed (a continuous image
  of the compact `ℤ_p^d`).
-/

noncomputable section

open Polynomial IntermediateField Module Topology

namespace PadicHodge

variable {p : ℕ} [hp : Fact p.Prime]

local notation "K̄" => PadicAlgCl p

/-! ### Taylor expansion to second order -/

theorem norm_taylor_sub_le {f : (PadicAlgCl p)[X]} (hf : f ∈ polyOver (ballK p))
    {x y : PadicAlgCl p} (hx : ‖x‖ ≤ 1) (hy : ‖y‖ ≤ 1) :
    ‖f.eval (x + y) - f.eval x - (derivative f).eval x * y‖ ≤ ‖y‖ ^ 2 := by
  set t := taylor x f
  have ht : ∀ n, ‖t.coeff n‖ ≤ 1 := by
    intro n
    rw [taylor_coeff]
    refine eval_mem (S := ballK p) (mem_polyOver.mpr fun k => ?_) (mem_ballK.mpr hx)
    rw [hasseDeriv_coeff]
    exact mul_mem (_root_.natCast_mem (ballK p) _) (mem_polyOver.mp hf _)
  have he : f.eval (x + y) = t.eval y := by rw [taylor_eval, add_comm]
  have h0 : t.coeff 0 = f.eval x := by rw [taylor_coeff_zero]
  have h1 : t.coeff 1 = (derivative f).eval x := by rw [taylor_coeff_one]
  set M := t.natDegree
  have hsum : t.eval y = ∑ i ∈ Finset.range (M + 1 + 1), t.coeff i * y ^ i :=
    eval_eq_sum_range' (by omega) y
  rw [Finset.sum_range_succ', Finset.sum_range_succ'] at hsum
  rw [he, hsum, ← h0, ← h1]
  simp only [zero_add, pow_zero, mul_one, pow_one]
  rw [show ∑ i ∈ Finset.range M, t.coeff (i + 1 + 1) * y ^ (i + 1 + 1) + t.coeff 1 * y +
      t.coeff 0 - t.coeff 0 - t.coeff 1 * y =
      ∑ i ∈ Finset.range M, t.coeff (i + 1 + 1) * y ^ (i + 1 + 1) by ring]
  refine IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (by positivity) fun i _ => ?_
  rw [norm_mul, norm_pow]
  calc ‖t.coeff (i + 1 + 1)‖ * ‖y‖ ^ (i + 1 + 1) ≤ 1 * ‖y‖ ^ 2 :=
        mul_le_mul (ht _) (pow_le_pow_of_le_one (norm_nonneg _) hy (by omega)) (by positivity)
          zero_le_one
    _ = ‖y‖ ^ 2 := one_mul _

variable (L : IntermediateField ℚ_[p] (PadicAlgCl p)) [FiniteDimensional ℚ_[p] L]

/-! ### Discreteness: a uniformizer -/

theorem exists_uniformizer : ∃ π ∈ L, 0 < ‖π‖ ∧ ‖π‖ < 1 ∧
    ∀ y ∈ L, ‖y‖ < 1 → ‖y‖ ≤ ‖π‖ := by
  classical
  set D := finrank ℚ_[p] L with hD
  have hD0 : 0 < D := finrank_pos
  have hp1 : (1 : ℝ) < p := by exact_mod_cast hp.out.one_lt
  have hp0 : (0 : ℝ) < p := by positivity
  have hex : ∃ k : ℕ, 0 < k ∧ ∃ y ∈ L, ‖y‖ ^ D = (p : ℝ) ^ (-(k : ℤ)) := by
    refine ⟨D, hD0, (p : PadicAlgCl p), IntermediateField.natCast_mem L p, ?_⟩
    rw [show ‖(p : PadicAlgCl p)‖ = (p : ℝ)⁻¹ by
      rw [← map_natCast (algebraMap ℚ_[p] (PadicAlgCl p)), PadicAlgCl.norm_extends,
        Padic.norm_p]]
    rw [inv_pow, zpow_neg, zpow_natCast]
  set k₀ := Nat.find hex
  obtain ⟨hk₀, π, hπL, hπ⟩ := Nat.find_spec hex
  have hπpos : 0 < ‖π‖ := by
    rcases (norm_nonneg π).lt_or_eq with h | h
    · exact h
    · rw [← h, zero_pow hD0.ne'] at hπ
      exact absurd hπ.symm (zpow_ne_zero _ hp0.ne')
  have hπ1 : ‖π‖ < 1 := by
    have : ‖π‖ ^ D < 1 := by
      rw [hπ]; exact zpow_lt_one_of_neg₀ hp1 (by omega)
    exact (pow_lt_one_iff_of_nonneg (norm_nonneg _) hD0.ne').mp this
  refine ⟨π, hπL, hπpos, hπ1, fun y hy hy1 => ?_⟩
  by_cases hy0 : y = 0
  · rw [hy0, norm_zero]; exact hπpos.le
  obtain ⟨v, hv⟩ := norm_pow_finrank_eq_zpow L ⟨y, hy⟩ (fun h => hy0 (congrArg Subtype.val h))
  change ‖y‖ ^ D = _ at hv
  have hvneg : v < 0 := by
    have : ‖y‖ ^ D < 1 := pow_lt_one₀ (norm_nonneg _) hy1 hD0.ne'
    rw [hv] at this
    by_contra h
    push Not at h
    exact absurd this (not_lt.mpr (one_le_zpow₀ hp1.le h))
  have hmem : 0 < v.natAbs ∧ ∃ y' ∈ L, ‖y'‖ ^ D = (p : ℝ) ^ (-(v.natAbs : ℤ)) :=
    ⟨by omega, y, hy, by rw [hv]; congr 1; omega⟩
  have hle : k₀ ≤ v.natAbs := Nat.find_min' hex hmem
  have : ‖y‖ ^ D ≤ ‖π‖ ^ D := by
    rw [hv, hπ]
    exact zpow_le_zpow_right₀ hp1.le (by omega)
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) hD0.ne').mp this

/-! ### Finiteness of the residue field -/

theorem isCompact_OK : IsCompact ((OK L : Set (PadicAlgCl p))) := by
  set V : Submodule ℚ_[p] (PadicAlgCl p) := Subalgebra.toSubmodule L.toSubalgebra
  haveI : FiniteDimensional ℚ_[p] V := by
    change FiniteDimensional ℚ_[p] L.toSubalgebra; infer_instance
  haveI : ProperSpace V := FiniteDimensional.proper ℚ_[p] V
  have hc : IsCompact (Metric.closedBall (0 : V) 1) := isCompact_closedBall 0 1
  have := hc.image (continuous_subtype_val (p := fun x => x ∈ V))
  convert this using 1
  ext y
  simp only [Set.mem_image, Metric.mem_closedBall, dist_zero_right, SetLike.mem_coe]
  constructor
  · intro hy
    exact ⟨⟨y, hy.1⟩, hy.2, rfl⟩
  · rintro ⟨w, hw, rfl⟩
    exact ⟨w.2, hw⟩

theorem exists_residue_reps : ∃ R : Set (PadicAlgCl p), R ⊆ OK L ∧ R.Finite ∧
    ∀ y ∈ OK L, ∃ r ∈ R, ‖y - r‖ < 1 := by
  obtain ⟨R, hRs, hRf, hcov⟩ := (isCompact_OK L).finite_cover_balls (e := 1) one_pos
  refine ⟨R, hRs, hRf, fun y hy => ?_⟩
  obtain ⟨r, hr, hyr⟩ := Set.mem_iUnion₂.mp (hcov hy)
  exact ⟨r, hr, by rwa [Metric.mem_ball, dist_eq_norm] at hyr⟩

/-! ### The residue field -/

/-- The maximal ideal `m_L = {‖y‖ < 1}` of `O_L`. -/
def mOK : Ideal (OK L) where
  carrier := {y | ‖(y : PadicAlgCl p)‖ < 1}
  add_mem' {a b} ha hb := lt_of_le_of_lt (IsUltrametricDist.norm_add_le_max _ _) (max_lt ha hb)
  zero_mem' := by simp
  smul_mem' c y hy := by
    simp only [smul_eq_mul, Set.mem_setOf_eq, Subring.coe_mul, norm_mul] at hy ⊢
    exact lt_of_le_of_lt (mul_le_of_le_one_left (norm_nonneg _) c.2.2) hy

omit [FiniteDimensional ℚ_[p] L] in
theorem isMaximal_mOK : (mOK L).IsMaximal := by
  rw [Ideal.isMaximal_iff]
  refine ⟨fun h => by simp [mOK] at h, fun J x _ hx hxJ => ?_⟩
  have hx1 : ‖(x : PadicAlgCl p)‖ = 1 := le_antisymm x.2.2 (not_lt.mp hx)
  have hx0 : (x : PadicAlgCl p) ≠ 0 := by
    intro h; rw [h, norm_zero] at hx1; exact zero_ne_one hx1
  set xi : OK L := ⟨(x : PadicAlgCl p)⁻¹,
    (inv_mem (show (x : PadicAlgCl p) ∈ L from x.2.1) : (x : PadicAlgCl p)⁻¹ ∈ L),
    show ‖(x : PadicAlgCl p)⁻¹‖ ≤ 1 by rw [norm_inv, hx1, inv_one]⟩
  have : (1 : OK L) = xi * x := Subtype.ext (by simp [xi, hx0])
  rw [this]
  exact J.mul_mem_left _ hxJ

/-- A generator of the residue field: every unit of `O_L` is congruent to a power of `ω`
modulo `m_L`; `ω^q ≡ ω` with `q = |k_L|` divisible by `p`. -/
theorem exists_residue_gen : ∃ ω ∈ L, ‖ω‖ ≤ 1 ∧ ∃ q : ℕ, ‖(q : PadicAlgCl p)‖ < 1 ∧
    ‖ω ^ q - ω‖ < 1 ∧ ∀ y ∈ L, ‖y‖ ≤ 1 → ‖y‖ < 1 ∨ ∃ k : ℕ, ‖y - ω ^ k‖ < 1 := by
  classical
  haveI := isMaximal_mOK L
  letI : Field (OK L ⧸ mOK L) := Ideal.Quotient.field _
  have hmk : ∀ a b : OK L, Ideal.Quotient.mk (mOK L) a = Ideal.Quotient.mk (mOK L) b ↔
      ‖(a : PadicAlgCl p) - b‖ < 1 := by
    intro a b; rw [Ideal.Quotient.eq]; rfl
  obtain ⟨R, hRs, hRf, hcov⟩ := exists_residue_reps L
  haveI : Finite (OK L ⧸ mOK L) := by
    haveI : Finite R := hRf.to_subtype
    have hsurj : Function.Surjective
        (fun r : R => Ideal.Quotient.mk (mOK L) (⟨r, hRs r.2⟩ : OK L)) := by
      intro c
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective c
      obtain ⟨r, hr, hyr⟩ := hcov y y.2
      exact ⟨⟨r, hr⟩, (hmk _ _).mpr (by rw [norm_sub_rev]; exact hyr)⟩
    exact Finite.of_surjective _ hsurj
  haveI := Fintype.ofFinite (OK L ⧸ mOK L)
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := (OK L ⧸ mOK L)ˣ)
  obtain ⟨ω, hω⟩ := Ideal.Quotient.mk_surjective (g : OK L ⧸ mOK L)
  refine ⟨ω, ω.2.1, ω.2.2, Fintype.card (OK L ⧸ mOK L), ?_, ?_, ?_⟩
  · have h := FiniteField.cast_card_eq_zero (OK L ⧸ mOK L)
    rw [← map_natCast (Ideal.Quotient.mk (mOK L)), Ideal.Quotient.eq_zero_iff_mem] at h
    simpa [mOK] using h
  · have h := FiniteField.pow_card (g : OK L ⧸ mOK L)
    rw [← hω, ← map_pow] at h
    simpa using (hmk _ _).mp h
  · intro y hyL hy1
    by_cases hy : ‖y‖ < 1
    · exact Or.inl hy
    right
    set Y : OK L := ⟨y, hyL, hy1⟩
    have hY0 : Ideal.Quotient.mk (mOK L) Y ≠ 0 := by
      rw [Ne, Ideal.Quotient.eq_zero_iff_mem]; exact hy
    obtain ⟨k, hk⟩ := (mem_powers_iff_mem_zpowers (y := Units.mk0 _ hY0)).mpr (hg _)
    refine ⟨k, ?_⟩
    have : Ideal.Quotient.mk (mOK L) Y = Ideal.Quotient.mk (mOK L) (ω ^ k) := by
      rw [map_pow, hω]
      have := congrArg Units.val hk
      simpa using this.symm
    simpa using (hmk _ _).mp this

/-! ### Monogenicity -/

theorem norm_pow_sub_pow_le {a b : PadicAlgCl p} (ha : ‖a‖ ≤ 1) (hb : ‖b‖ ≤ 1) (k : ℕ) :
    ‖a ^ k - b ^ k‖ ≤ ‖a - b‖ := by
  rw [← Commute.geom_sum₂_mul (Commute.all a b), norm_mul]
  refine mul_le_of_le_one_left (norm_nonneg _) ?_
  refine IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg zero_le_one fun i _ => ?_
  rw [norm_mul, norm_pow, norm_pow]
  exact mul_le_one₀ (pow_le_one₀ (norm_nonneg _) ha) (by positivity)
    (pow_le_one₀ (norm_nonneg _) hb)

theorem norm_add_eq_of_lt {a b : PadicAlgCl p} (h : ‖b‖ < ‖a‖) : ‖a + b‖ = ‖a‖ := by
  rw [IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm h.ne', max_eq_left h.le]

/-- `O_{ℚ_p}[z]` is closed in `ℚ̄_p`. -/
theorem isClosed_adj_bot {z : PadicAlgCl p} (hz : ‖z‖ ≤ 1) :
    IsClosed ((adj (OK (⊥ : IntermediateField ℚ_[p] (PadicAlgCl p))) z : Set (PadicAlgCl p))) := by
  set B : IntermediateField ℚ_[p] (PadicAlgCl p) := ⊥
  set d := dg B z
  set Φ : (Fin d → ℤ_[p]) → PadicAlgCl p :=
    fun c => ∑ i : Fin d, algebraMap ℚ_[p] (PadicAlgCl p) (c i : ℚ_[p]) * z ^ (i : ℕ)
  have hΦc : Continuous Φ := by
    refine continuous_finsetSum _ fun i _ => ?_
    exact ((continuous_algebraMap ℚ_[p] (PadicAlgCl p)).comp
      ((continuous_subtype_val (p := fun x : ℚ_[p] => ‖x‖ ≤ 1)).comp
        (continuous_apply i))).mul continuous_const
  have hrange : Set.range Φ = (adj (OK B) z : Set (PadicAlgCl p)) := by
    ext u
    constructor
    · rintro ⟨c, rfl⟩
      refine sum_mem fun i _ => mul_mem ?_ (pow_mem (self_mem_adj _ _) _)
      refine le_adj _ _ ⟨IntermediateField.algebraMap_mem _ _, ?_⟩
      change ‖algebraMap ℚ_[p] (PadicAlgCl p) (c i : ℚ_[p])‖ ≤ 1
      rw [PadicAlgCl.norm_extends]
      exact PadicInt.norm_le_one (c i)
    · intro hu
      obtain ⟨q, hq, rfl⟩ := mem_adj.mp (SetLike.mem_coe.mp hu)
      have hg := mp_mem_polyOver B hz
      have hm := mp_monic B z
      set r := q %ₘ mp B z
      have hrO : r ∈ polyOver (OK B) := (divByMonic_mem_polyOver hq hg hm).2
      have hrz : q.eval z = r.eval z := by
        have := congrArg (eval z) (modByMonic_add_div q (mp B z))
        rw [eval_add, eval_mul, eval_mp, zero_mul, add_zero] at this
        exact this.symm
      have hdeg : r.natDegree < d := by
        change r.natDegree < (minpoly B z).natDegree
        rw [← natDegree_mp]
        refine natDegree_modByMonic_lt _ hm fun h1 => ?_
        have := congrArg natDegree h1
        rw [natDegree_one, natDegree_mp] at this
        exact (dg_pos B z).ne' this
      have hc : ∀ i, ∃ c : ℤ_[p], algebraMap ℚ_[p] (PadicAlgCl p) (c : ℚ_[p]) = r.coeff i := by
        intro i
        obtain ⟨h1, h2⟩ := mem_polyOver.mp hrO i
        obtain ⟨a, ha⟩ := IntermediateField.mem_bot.mp h1
        refine ⟨⟨a, ?_⟩, ha⟩
        have h2' : ‖algebraMap ℚ_[p] (PadicAlgCl p) a‖ ≤ 1 := by rw [ha]; exact h2
        rwa [PadicAlgCl.norm_extends] at h2'
      choose c hc using hc
      rw [Set.mem_range]
      refine ⟨fun i => c i, ?_⟩
      rw [hrz, eval_eq_sum_range' hdeg, ← Fin.sum_univ_eq_sum_range]
      exact Finset.sum_congr rfl fun i _ => by rw [hc]
  rw [← hrange]
  exact (isCompact_range hΦc).isClosed

/-- **`O_L` is monogenic over `ℤ_p`.** -/
theorem exists_monogenic : ∃ z ∈ L, ‖z‖ ≤ 1 ∧ ∀ y ∈ L, ‖y‖ ≤ 1 →
    y ∈ adj (OK (⊥ : IntermediateField ℚ_[p] (PadicAlgCl p))) z := by
  set B : IntermediateField ℚ_[p] (PadicAlgCl p) := ⊥
  obtain ⟨π, hπL, hπ0, hπ1, hπmax⟩ := exists_uniformizer L
  obtain ⟨ω, hωL, hω1, q, hq, hωq, hres⟩ := exists_residue_gen L
  set P : (PadicAlgCl p)[X] := X ^ q - X with hPdef
  have hP : P ∈ polyOver (OK B) := sub_mem (pow_mem (X_mem_polyOver _) _) (X_mem_polyOver _)
  have hPb : P ∈ polyOver (ballK p) := polyOver_mono (OK_le_ballK B) hP
  have hPe : ∀ w, P.eval w = w ^ q - w := fun w => by simp [hPdef]
  have hP' : ∀ w, ‖w‖ ≤ 1 → ‖(derivative P).eval w‖ = 1 := by
    intro w hw
    have : (derivative P).eval w = -1 + (q : PadicAlgCl p) * w ^ (q - 1) := by
      rw [hPdef, derivative_sub, derivative_X_pow, derivative_X, eval_sub, eval_mul, eval_C,
        eval_pow, eval_X, eval_one]
      ring
    rw [this, norm_add_eq_of_lt, norm_neg, norm_one]
    rw [norm_neg, norm_one, norm_mul, norm_pow]
    calc ‖(q : PadicAlgCl p)‖ * ‖w‖ ^ (q - 1) ≤ ‖(q : PadicAlgCl p)‖ * 1 :=
          mul_le_mul_of_nonneg_left (pow_le_one₀ (norm_nonneg _) hw) (norm_nonneg _)
      _ < 1 := by rw [mul_one]; exact hq
  -- the element `z`
  obtain ⟨z, hzL, hz1, hzω, hPz⟩ : ∃ z ∈ L, ‖z‖ ≤ 1 ∧ ‖z - ω‖ < 1 ∧ ‖P.eval z‖ = ‖π‖ := by
    have hPω : ‖P.eval ω‖ ≤ ‖π‖ := hπmax _ (by rw [hPe]; exact sub_mem (pow_mem hωL _) hωL)
      (by rw [hPe]; exact hωq)
    rcases hPω.lt_or_eq with hlt | heq
    · refine ⟨ω + π, add_mem hωL hπL, (IsUltrametricDist.norm_add_le_max _ _).trans
        (max_le hω1 hπ1.le), by simpa using hπ1, ?_⟩
      have ht := norm_taylor_sub_le hPb hω1 hπ1.le
      have hdom : ‖(derivative P).eval ω * π‖ = ‖π‖ := by rw [norm_mul, hP' ω hω1, one_mul]
      have hrest : ‖P.eval ω + (P.eval (ω + π) - P.eval ω - (derivative P).eval ω * π)‖ < ‖π‖ :=
        lt_of_le_of_lt (IsUltrametricDist.norm_add_le_max _ _) (max_lt hlt
          (lt_of_le_of_lt ht (by nlinarith)))
      have : P.eval (ω + π) = (derivative P).eval ω * π +
          (P.eval ω + (P.eval (ω + π) - P.eval ω - (derivative P).eval ω * π)) := by ring
      rw [this, norm_add_eq_of_lt (hdom ▸ hrest), hdom]
    · exact ⟨ω, hωL, hω1, by simp, heq⟩
  set Pi1 := P.eval z with hPi1
  have hPi1adj : Pi1 ∈ adj (OK B) z := eval_mem_adj hP z
  have hzO : z ∈ OK L := ⟨hzL, hz1⟩
  have hadjL : adj (OK B) z ≤ OK L := adj_le (OK_mono bot_le) hzO
  -- residues of `z`
  have hres' : ∀ w ∈ L, ‖w‖ ≤ 1 → ∃ r ∈ adj (OK B) z, ‖w - r‖ < 1 := by
    intro w hwL hw1
    rcases hres w hwL hw1 with h | ⟨k, hk⟩
    · exact ⟨0, zero_mem _, by simpa using h⟩
    · refine ⟨z ^ k, pow_mem (self_mem_adj _ _) _, ?_⟩
      have : w - z ^ k = (w - ω ^ k) + (ω ^ k - z ^ k) := by ring
      rw [this]
      refine lt_of_le_of_lt (IsUltrametricDist.norm_add_le_max _ _) (max_lt hk ?_)
      exact lt_of_le_of_lt (norm_pow_sub_pow_le hω1 hz1 k) (by rwa [norm_sub_rev])
  -- successive approximation
  have happrox : ∀ y ∈ L, ‖y‖ ≤ 1 → ∀ n : ℕ, ∃ u ∈ adj (OK B) z, ‖y - u‖ ≤ ‖π‖ ^ n := by
    intro y hyL hy1 n
    induction n with
    | zero => exact ⟨0, zero_mem _, by simpa using hy1⟩
    | succ n ih =>
      obtain ⟨u, hu, hyu⟩ := ih
      have hPi0 : Pi1 ≠ 0 := by
        intro h; rw [h, norm_zero] at hPz; exact hπ0.ne' hPz.symm
      set w := (y - u) / Pi1 ^ n
      have hwL : w ∈ L := div_mem (sub_mem hyL (hadjL hu).1) (pow_mem (hadjL hPi1adj).1 _)
      have hw1 : ‖w‖ ≤ 1 := by
        rw [norm_div, norm_pow, hPz]
        exact div_le_one_of_le₀ hyu (by positivity)
      obtain ⟨r, hr, hwr⟩ := hres' w hwL hw1
      have hwr' : ‖w - r‖ ≤ ‖π‖ := hπmax _ (sub_mem hwL (hadjL hr).1) hwr
      refine ⟨u + Pi1 ^ n * r, add_mem hu (mul_mem (pow_mem hPi1adj _) hr), ?_⟩
      have : y - (u + Pi1 ^ n * r) = Pi1 ^ n * (w - r) := by
        simp only [w]; field_simp; ring
      rw [this, norm_mul, norm_pow, hPz, pow_succ]
      exact mul_le_mul_of_nonneg_left hwr' (by positivity)
  refine ⟨z, hzL, hz1, fun y hyL hy1 => ?_⟩
  have hcl := isClosed_adj_bot hz1
  refine hcl.closure_subset_iff.mpr le_rfl (Metric.mem_closure_iff.mpr fun ε hε => ?_)
  obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one hε hπ1
  obtain ⟨u, hu, hyu⟩ := happrox y hyL hy1 n
  exact ⟨u, hu, by rw [dist_eq_norm]; exact lt_of_le_of_lt hyu hn⟩

end PadicHodge
