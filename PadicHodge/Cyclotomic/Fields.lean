import PadicHodge.Cyclotomic.Trace
import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed

/-!
# The cyclotomic fields `ℚ_p(μ_{p^k})` inside `ℚ̄_p`

`cycField p k = ℚ_p(μ_{p^k})`, defined as the field generated by all `p^k`-th roots of unity;
it is `ℚ_p(ζ)` for any primitive `p^k`-th root of unity `ζ`, is stable under every automorphism,
and the fields increase with `k`. `cycFieldInf p = ℚ_p(μ_{p^∞})` is their union.
-/

noncomputable section

open IntermediateField

namespace PadicHodge

variable (p : ℕ) [hp : Fact p.Prime]

/-- `ℚ_p(μ_{p^k}) ⊆ ℚ̄_p`. -/
def cycField (k : ℕ) : IntermediateField ℚ_[p] (PadicAlgCl p) :=
  adjoin ℚ_[p] {x | x ^ (p ^ k) = 1}

/-- `ℚ_p(μ_{p^∞}) ⊆ ℚ̄_p`. -/
def cycFieldInf : IntermediateField ℚ_[p] (PadicAlgCl p) := ⨆ k, cycField p k

variable {p}

theorem exists_isPrimitiveRoot (k : ℕ) : ∃ ζ : PadicAlgCl p, IsPrimitiveRoot ζ (p ^ k) :=
  HasEnoughRootsOfUnity.exists_primitiveRoot (PadicAlgCl p) (p ^ k)

theorem cycField_mono {k l : ℕ} (h : k ≤ l) : cycField p k ≤ cycField p l := by
  refine adjoin.mono _ _ _ fun x hx => ?_
  simp only [Set.mem_setOf_eq] at hx ⊢
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
  rw [pow_add, pow_mul, hx, one_pow]

theorem cycField_eq {ζ : PadicAlgCl p} {k : ℕ} (hζ : IsPrimitiveRoot ζ (p ^ k)) :
    cycField p k = ℚ_[p]⟮ζ⟯ := by
  refine le_antisymm (adjoin_le_iff.mpr fun x hx => ?_)
    (adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr (subset_adjoin _ _ hζ.pow_eq_one)))
  haveI : NeZero (p ^ k) := ⟨pow_ne_zero _ hp.out.ne_zero⟩
  obtain ⟨i, -, hi⟩ := hζ.eq_pow_of_pow_eq_one hx
  rw [← hi]
  exact pow_mem (mem_adjoin_simple_self _ _) _

theorem gal_mem_cycField (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) {k : ℕ} {y : PadicAlgCl p}
    (hy : y ∈ cycField p k) : σ y ∈ cycField p k := by
  have h : (cycField p k).map (σ : PadicAlgCl p →ₐ[ℚ_[p]] PadicAlgCl p) ≤ cycField p k := by
    rw [cycField, adjoin_map]
    refine adjoin.mono _ _ _ ?_
    rintro _ ⟨x, hx, rfl⟩
    simp only [Set.mem_setOf_eq] at hx ⊢
    rw [AlgEquiv.coe_toAlgHom, ← map_pow, hx, map_one]
  exact h ⟨y, hy, rfl⟩

theorem mem_cycFieldInf {y : PadicAlgCl p} : y ∈ cycFieldInf p ↔ ∃ k, y ∈ cycField p k := by
  have hdir : Directed (· ≤ ·) (cycField p) := fun k l =>
    ⟨max k l, cycField_mono (le_max_left _ _), cycField_mono (le_max_right _ _)⟩
  rw [cycFieldInf, ← SetLike.mem_coe, coe_iSup_of_directed hdir, Set.mem_iUnion]
  rfl

theorem pow_mem_cycField {ζ : PadicAlgCl p} {k : ℕ} (hζ : ζ ^ (p ^ k) = 1) :
    ζ ∈ cycField p k :=
  subset_adjoin _ _ hζ

end PadicHodge
